status\"\n    aria-live=\"polite\"\n  >\n    <strong>Offline mode</strong>\n    <span>The application shell is available, but signing in, loading test content, and saving require a connection.</span>\n  </section>\n  <section\n    id=\"requiredAdminPasswordChangeDialog\"\n    class=\"required-password-backdrop\"\n    *ngIf=\"app.requiresAdminPasswordChange\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"requiredAdminPasswordChangeTitle\"\n  >\n    <form class=\"required-password-card\" (submit)=\"$event.preventDefault(); submitRequiredAdminPassword()\">\n      <span class=\"eyebrow\">Account security</span>\n      <h2 id=\"requiredAdminPasswordChangeTitle\">Choose your own password</h2>\n      <p>An administrator set the current password. Change it before opening workspace administration.</p>\n      <p id=\"requiredAdminPasswordPolicy\">Use {{ adminPasswordMinimumLength }}–{{ adminPasswordMaximumLength }} characters and match <code>{{ adminPasswordPattern }}</code>.</p>\n      <label>\n        New password\n        <input\n          id=\"requiredAdminPassword\"\n          name=\"requiredAdminPassword\"\n          type=\"password\"\n          autocomplete=\"new-password\"\n          [attr.minlength]=\"adminPasswordMinimumLength\"\n          [attr.maxlength]=\"adminPasswordMaximumLength\"\n          [attr.pattern]=\"adminPasswordPattern\"\n          required\n          [value]=\"requiredAdminPassword\"\n          (input)=\"updateRequiredAdminPassword($event)\"\n        />\n      </label>\n      <label>\n        Confirm new password\n        <input\n          id=\"requiredAdminPasswordConfirmation\"\n          name=\"requiredAdminPasswordConfirmation\"\n.is-participant-page {\n  max-width: 980px;\n  padding-top: 22px;\n}\n\n.participant-topbar {\n  display: flex;\n  justify-content: space-between;\n  gap: 18px;\n  align-items: center;\n  margin-bottom: 18px;\n  padding: 18px 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-xl);\n  background: linear-gradient(135deg, rgba(255, 252, 246, 0.94), rgba(215, 235, 231, 0.7));\n  box-shadow: var(--shadow);\n}\n\n.application-brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  min-width: 0;\n}\n\n.operator-brand {\n  justify-content: space-between;\n  margin-bottom: 18px;\n}\n\n.application-logo {\n  display: block;\n  width: auto;\n  max-width: 148px;\n  height: 58px;\n  object-fit: contain;\n  flex: 0 0 auto;\n}\n\n.application-logo-button {\n  display: inline-flex;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  cursor: pointer;\n}\n\n.application-logo-button:focus-visible {\n  outline: 3px solid currentColor;\n  outline-offset: 4px;\n}\n\n.participant-topbar h1 {\n  margin: 10px 0 0;\n  font-size: clamp(30px, 7vw, 52px);\n}\n\n.participant-topbar > span {\n  display: inline-flex;\n  align-items: center;\nimport { Component, inject, signal } from \"@angular/core\";\nimport type { OnInit } from \"@angular/core\";\nimport { RouterLink } from \"@angular/router\";\n\nimport {\n  productionApiRoutes,\n  type GetSystemCheckAccessResponse,\n  type SystemCheckAccessMode\n} from \"@testcenter-rewrite-app/contracts\";\n\nimport { AppShellFacade } from \"./app-shell.facade\";\nimport { RewriteAppApiService } from \"./rewrite-app-api.service\";\nimport { RewriteAppViewStateService } from \"./rewrite-app-view-state.service\";\n\ntype SystemCheckEntryState = SystemCheckAccessMode | \"loading\" | \"unavailable\";\n\n@Component({\n  selector: \"app-home-view\",\n  standalone: true,\n  imports: [RouterLink],\n  templateUrl: \"./home-view.component.html\",\n  styleUrl: \"./home-view.component.css\"\n})\nexport class HomeViewComponent implements OnInit {\n  readonly app = inject(AppShellFacade);\n  readonly systemCheckEntryState = signal<SystemCheckEntryState>(\"loading\");\n  private readonly api = inject(RewriteAppApiService);\n  private readonly viewState = inject(RewriteAppViewStateService);\n\n  constructor() {\n    this.viewState.setActiveView(\"home\");\n  }\n\n  ngOnInit(): void {\n    void this.loadSystemCheckAccess();\n  }\n\n  async loadSystemCheckAccess(): Promise<void> {\n    this.systemCheckEntryState.set(\"loading\");\n    try {\n      const { payload } = await this.api.send<GetSystemCheckAccessResponse>(\n        \"GET\",\n        productionApiRoutes.system.getSystemCheckAccess\n      );\n      this.systemCheckEntryState.set(payload.accessMode);\n    } catch {\n      this.systemCheckEntryState.set(\"unavailable\");\n    }\n  }\n}\n","stderr":"","aggregated_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n<div\n  class=\"page\"\n  [class.is-busy]=\"app.activeRequestLabel() !== null\"\n  [class.is-participant-page]=\"isParticipantView\"\n>\n  <span hidden>{{ app.renderVersion() }}</span>\n  @defer (when confirmation.dialog() !== null) {\n    <app-confirmation-dialog></app-confirmation-dialog>\n  }\n  @defer (when bugReports.isOpen()) {\n    <app-bug-report-dialog></app-bug-report-dialog>\n  }\n  <section\n    id=\"globalApplicationWarning\"\n    class=\"application-warning-banner\"\n    *ngIf=\"applicationSettings.activeWarningText() as warningText\"\n    role=\"alert\"\n    aria-live=\"assertive\"\n  >\n    <strong>Service notice</strong>\n    <span>{{ warningText }}</span>\n  </section>\n  <section\n    id=\"appOfflineShellNotice\"\n    class=\"offline-shell-banner\"\n    *ngIf=\"isOffline()\"\n    role=\"status\"\n    aria-live=\"polite\"\n  >\n    <strong>Offline mode</strong>\n    <span>The application shell is available, but signing in, loading test content, and saving require a connection.</span>\n  </section>\n  <section\n    id=\"requiredAdminPasswordChangeDialog\"\n    class=\"required-password-backdrop\"\n    *ngIf=\"app.requiresAdminPasswordChange\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"requiredAdminPasswordChangeTitle\"\n  >\n    <form class=\"required-password-card\" (submit)=\"$event.preventD