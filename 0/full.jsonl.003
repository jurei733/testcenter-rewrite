le[(crc ^ byte) & 0xff] ^ (crc >>> 8);\n  }\n  return (crc ^ 0xffffffff) >>> 0;\n};\n\nconst createStoredZipBuffer = entries => {\n  const localFileHeaders = [];\n  const centralDirectoryHeaders = [];\n  let offset = 0;\n\n  for (const entry of entries) {\n    const fileName = Buffer.from(entry.fileName, \"utf8\");\n    const content = Buffer.from(entry.content, \"utf8\");\n    const checksum = crc32(content);\n    const localHeader = Buffer.alloc(30 + fileName.length);\n    localHeader.writeUInt32LE(0x04034b50, 0);\n    localHeader.writeUInt16LE(20, 4);\n    localHeader.writeUInt16LE(0x0800, 6);\n    localHeader.writeUInt16LE(0, 8);\n38:const serverEntry = resolve(\"apps/api/dist/apps/api/src/index.js\");\n258:    const filePath = resolve(process.env.FIRST_SLICE_FILE ?? \"./.data/ui-smoke.json\");\n266:    const filePath = resolve(\n533:              resolve(false);\n554:              resolve(true);\n2378:      resolve(\"test-fixtures/original-testcenter/system-checks/SysCheck.xml\"),\n2390:      resolve(\"test-fixtures/original-testcenter/units/Unit2.xml\"),\n2412:          resolve(\n2422:          resolve(\n2468:            resolve(\n2969:    const originalSystemCheckReportPath = resolve(\n3044:    const systemCheckReportJsonPath = resolve(\n5709:    resolve(\"test-fixtures/original-testcenter/booklets/Booklet2.xml\"),\n5710:    resolve(\"test-fixtures/original-testcenter/units/Unit2.xml\"),\n5711:    resolve(\n5714:    resolve(\n5811:          resolve(\"test-fixtures/original-testcenter/units/Unit2.xml\"),\n5854:          resolve(\"test-fixtures/original-testcenter/units/Unit2.xml\"),\n6082:        resolve(\n6215:  const uploadedZipSourcePath = resolve(\".data\", uploadedZipSourceFileName);\n6295:  const downloadedZipPath = resolve(\n6344:  const lifecycleReplacementPath = resolve(\n6413:  const uploadedSourcePath = resolve(\".data\", uploadedSourceFileName);\n7423:  const participantReviewDownloadPath = resolve(\n8366:        resolve(\n10187:      resolve(\"tes