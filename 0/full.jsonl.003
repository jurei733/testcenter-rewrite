o\">\n    <ng-container *ngTemplateOutlet=\"logo\"></ng-container>\n  </div>\n}\n\n<ng-template #logo>\n  <a [routerLink]=\"logoLink\" aria-label=\"Gehe zur Startseite\" (click)=\"isLoginRoute && logout()\">\n    <img [src]=\"logoURL\" data-cy=\"logo\" alt=\"Logo der Anwendung\"\n         matTooltip=\"Zur Startseite\"/>\n  </a>\n</ng-template>\n\n<ng-template #logoutDialogTemplate>\n  <div class=\"logout-dialog\">\n    <p>Du bist dabei, dich abzumelden.<br>\n       Willst du lieber weitermachen?<br>\n       Dann drücke einfach auf <b>Hier bleiben!</b>\n    </p>\n    <img [src]=\"confirmDialogImgSrc\">\n  </div>\n</ng-template><div class=\"login-page\">\n  <div class =\"welcome-section\">\n    @if (illustrationImageSrc) {\n      <img [src]=\"illustrationImageSrc\" alt=\"illustration image\">\n    }\n    <div>\n      <p class=\"heading\">{{ 'Willkommen im IQB‑Testcenter' | customtext : 'login_sidepanel_title' | async }}</p>\n      <p>{{ 'Das IQB-Testcenter ist eine Anwendung des Instituts zur Qualitätsentwicklung im ' +\n           'Bildungswesen (IQB) zur Durchführung digitaler Tests und Befragungen. Der Zugang ist mit den ' +\n           'Zugangsdaten möglich, die Sie vorab erhalten haben.' | customtext : 'login_sidepanel_subtitle' | async }}</p>\n    </div>\n  </div>\n  <div class=\"login-section\">\n    @if (!username) {\n      <form [formGroup]=\"loginForm\" (ngSubmit)=\"nameInput()\">\n        <h2>Anmeldenamen eingeben</h2>\n        <mat-form-field appearance=\"outline\">\n          <mat-label>Anmeldename</mat-label>\n          <input matInput formControlName=\"name\" autocapitalize=\"off\">\n        </mat-form-field>\n        @if (problemText) {\n          <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                    [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n        }\n        <button matButton=\"filled\" type=\"submit\" data-cy=\"login-user\"\n                [disabled]=\"!loginForm.get('name')?.valid\">\n          <mat-icon svgIcon=\"chevron_right\"></mat-icon>\n          Weiter\n        </button>\n      </form>\n    }\n    @else {\n      <form [formGroup]=\"loginForm\" (ngSubmit)=\"passwordInput()\">\n        <div class=\"password-headline\">\n          <button matIconButton type=\"reset\" (click)=\"username = null;\">\n            <mat-icon svgIcon=\"chevron_left\"></mat-icon>\n          </button>\n          <h2>Kennwort eingeben</h2>\n        </div>\n        <mat-form-field appearance=\"outline\">\n          <mat-label>Kennwort</mat-label>\n          <input matInput #pw formControlName=\"pw\"\n                 [type]=\"showPassword ? 'text' : 'password'\" autofocus\n                 (keyup)=\"clearWarning(); checkCapsLock($event)\">\n          <button mat-icon-button matSuffix type=\"button\"\n                  [attr.aria-label]=\"'Hide password'\" [attr.aria-pressed]=\"showPassword\"\n                  (click)=\"showPassword = !showPassword\">\n            <mat-icon svgIcon=\"visibility\"></mat-icon>\n          </button>\n        </mat-form-field>\n        @if (problemText) {\n          <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                    [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n        }\n        <button matButton=\"filled\" type=\"submit\" data-cy=\"login-user\"\n                [disabled]=\"!loginForm.get('name')?.valid || busyWithChallenge\">\n          Anmelden\n        </button>\n      </form>\n    }\n\n    @if (mainDataService.globalWarning) {\n      <mat-card class=\"help-box\">\n        <mat-icon svgIcon=\"warning\"></mat-icon>\n        <mat-card-content>{{mainDataService.globalWarning}}</mat-card-content>\n      </mat-card>\n    }\n\n    @if (unsupportedBrowser.length) {\n      <mat-card class=\"help-box\">\n        <mat-icon svgIcon=\"warning\"></mat-icon>\n        @let oldBrowserText = (\n          'Ihr Browser ist veraltet und könnte zu Fehlern führen. Bitte verwenden Sie eine aktuelle Version.'\n            | customtext : 'login_unsupportedBrowser'\n            : unsupportedBrowser[0]\n            : unsupportedBrowser[1]\n            | async\n        )?.trim();\n        <mat-card-content>{{ oldBrowserText }}</mat-card-content>\n      </mat-card>\n    }\n\n    <div class=\"button-section\">\n      <button matButton=\"tonal\" [routerLink]=\"['/r/admin-login']\" data-cy=\"login-admin-form\">\n        Adminbereich\n      </button>\n    </div>\n  </div>\n</div>\n"},"started_at_ms":1789189768452,"completed_at_ms":1789189768452}}
