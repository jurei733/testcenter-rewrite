\\n  </div>\\n}\\n\\n<router-outlet></router-outlet>\\n\\n@if (unsupportedBrowser.length && showBrowserBanner) {\\n  <div id=\\\"el\\\" class=\\\"browser-banner\\\"\\n       (click)=\\\"closeBanner()\\\">\\n    <div class=\\\"browser-banner-inner\\\">\\n      <ng-container *ngIf=\\\"('Ihr Browser ist veraltet und könnte zu Fehlern führen. Bitte verwenden Sie eine aktuelle Version.' | customtext: 'login_unsupportedBrowserBanner' : unsupportedBrowser[0] : unsupportedBrowser[1]  | async)?.trim() as oldBrowserText\\\">\\n        {{ oldBrowserText }}\\n        <button>X</button>\\n      </ng-container>\\n    </div>\\n  </div>\\n}\\n\\n@if (mainDataService.isTestingMode) {\\n  <div style=\\\"background: red; position: fixed; bottom: 4px; right: 4px; height: 4px; width: 4px; border-radius: 2px\\\">\\n  </div>\\n}\\n\\n@if (footerService.showFooter()) {\\n  <tc-footer></tc-footer>\\n}\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7e13de\",\"wall_time_seconds\":0.000004125,\"exit_code\":0,\"original_token_count\":1041,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\napps/web/src/assets/images/bird-character-cool.png\\napps/web/src/assets/images/bird-character-done.png\\napps/web/src/assets/images/code-input-illustration-teens.png\\napps/web/src/assets/images/bird-character.png\\napps/web/src/assets/images/IQB-Logo-2025.png\\napps/web/src/assets/images/code-input-illustration-kids.png\\napps/web/src/assets/images/login-illustration.png\\napps/web/src/app-icon.svg\\napps/web/src/manifest.webmanifest\\napps/web/src/service-worker.js\\napps/web/src/styles.css\\napps/web/src/main.ts\\nimport { CommonModule } from \\\"@angular/common\\\";\\nimport {\\n  ChangeDetectorRef,\\n  Component,\\n  effect,\\n  inject,\\n  signal\\n} from \\\"@angular/core\\\";\\nimport type { OnDestroy, OnInit } from \\\"@angular/core\\\";\\nimport {\\n  NavigationEnd,\\n  Router,\\n  RouterLink,\\n  RouterLinkActive,\\n  RouterOutlet\\n} from \\\"@a