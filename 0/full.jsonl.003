);\\n```\\n\\n        </div>\\n      </div>\\n    </section>\\n\\n    <section\\n      class=\\\"status-banner\\\"\\n      *ngIf=\\\"app.activeRequestLabel() || app.errorMessage()\\\"\\n      [class.is-error]=\\\"!!app.errorMessage()\\\"\\n    >\\n      <strong>{{ app.errorMessage() ? \\\"Last Error\\\" : \\\"Working\\\" }}</strong>\\n      <span *ngIf=\\\"app.activeRequestLabel() && !app.errorMessage()\\\">\\n        {{ app.activeRequestLabel() }} is in progress.\\n      </span>\\n      <span *ngIf=\\\"app.errorMessage()\\\">{{ app.errorMessage() }}</span>\\n      <button\\n        *ngIf=\\\"app.errorMessage()\\\"\\n        class=\\\"ghost\\\"\\n        type=\\\"button\\\"\\n        data-open-bug-report\\n        (click)=\\\"openErrorReport()\\\"\\n      >Fehlerbericht</button>\\n    </section>\\n\\n    <nav class=\\\"view-nav\\\" aria-label=\\\"Application Views\\\">\\n      <a\\n        *ngFor=\\\"let view of app.views\\\"\\n        [routerLink]=\\\"view.link\\\"\\n        routerLinkActive=\\\"is-active\\\"\\n        class=\\\"nav-link\\\"\\n        [attr.data-view-nav]=\\\"view.id\\\"\\n      >\\n        {{ view.label }}\\n      </a>\\n      <details\\n        id=\\\"operatorAccountMenu\\\"\\n        class=\\\"operator-account-menu\\\"\\n        *ngIf=\\\"app.hasAdminSession\\\"\\n      >\\n        <summary\\n          id=\\\"operatorAccountSummary\\\"\\n          class=\\\"nav-link\\\"\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a07fd0-fa32-7501-be65-48130bbe2957","create_time":1788851090.473085}}}
