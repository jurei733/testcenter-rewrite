": 5,\n        \"unit\": 1\n      }\n    }\n  ],\n  \"systemChecks\": [\n    {\n      \"fixture\": \"system-checks/SysCheck.xml\",\n      \"sourcePath\": \"sampledata/SysCheck.xml\",\n      \"checkId\": \"SYSCHECK.SAMPLE\",\n      \"displayLabel\": \"System-Check Beispiel\",\n      \"unitKey\": \"UNIT.SAMPLE\",\n      \"questionCount\": 6,\n      \"questionTypes\": [\"header\", \"string\", \"select\", \"text\", \"check\", \"radio\"],\n      \"requiredQuestionIds\": [\"2\"],\n      \"skipNetwork\": false,\n      \"canSave\": true\n    },\n    {\n      \"fixture\": \"system-checks/CY_SysCheck_2.xml\",\n      \"sourcePath\": \"sampledata/system-test/CY_SysCheck_2.xml\",\n      \"sha256\": \"ccc8fa83ec7680bb466ebd02a58fb3062b130673b956feb7d33f3cbdfaca9d7c\",\n      \"checkId\": \"syscheck-2\",\n      \"displayLabel\": \"System-Check-2\",\n      \"unitKey\": \"UNIT.SAMPLE\",\n      \"questionCount\": 6,\n      \"questionTypes\": [\"header\", \"string\", \"select\", \"text\", \"check\", \"radio\"],\n      \"requiredQuestionIds\": [\"2\"],\n      \"skipNetwork\": true,\n      \"canSave\": true\n    }\n  ]\n}\n\u003c?xml version=\"1.0\" encoding=\"utf-8\"?\u003e\n\u003cSysCheck xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n          xsi:noNamespaceSchemaLocation=\"https://raw.githubusercontent.com/iqb-berlin/testcenter/17.6.0/definitions/vo_SysCheck.xsd\"\u003e\n  \u003cMetadata\u003e\n    \u003cId\u003eSYSCHECK.SAMPLE\u003c/Id\u003e\n    \u003cLabel\u003eSystem-Check Beispiel\u003c/Label\u003e\n    \u003cDescription\u003eBeschreibungstext für den Systemcheck\u003c/Description\u003e\n  \u003c/Metadata\u003e\n  \u003cConfig unit=\"UNIT.SAMPLE\" savekey=\"saveme\" skipnetwork=\"false\"\u003e\n    \u003cUploadSpeed min=\"1024\" good=\"2048\" maxDevianceBytesPerSecond=\"10000\" maxErrorsPerSequence=\"0\" maxSequenceRepetitions=\"15\"\u003e\n      100000, 200000, 400000, 800000\n    \u003c/UploadSpeed\u003e\n    \u003cDownloadSpeed min=\"1024\" good=\"2048\" maxDevianceBytesPerSecond=\"200000\" maxErrorsPerSequence=\"0\" maxSequenceRepetitions=\"15\"\u003e\n      400000, 800000, 1600000, 3200000\n    \u003c/DownloadSpeed\u003e\n    \u003cQ id=\"1\" type=\"header\" prompt=\"Beispielüberschrift\"/\u003e\n    \u003cQ id=\"2\" type=\"string\" prompt=\"Eingabefeld\" required=\"true\"/\u003e\n    \u003cQ id=\"3\" type=\"select\" prompt=\"Auswahl\"\u003eOption A#Option B\u003c/Q\u003e\n    \u003cQ id=\"4\" type=\"text\" prompt=\"Eingabebereich\"/\u003e\n    \u003cQ id=\"5\" type=\"check\" prompt=\"Kontrollkästchen\"/\u003e\n    \u003cQ id=\"6\" type=\"radio\" prompt=\"Optionsfelder\"\u003eOption A#Option B\u003c/Q\u003e\n  \u003c/Config\u003e\n\u003c/SysCheck\u003e\n\u003c?xml version=\"1.0\" encoding=\"utf-8\"?\u003e\n\u003cSysCheck xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n          xsi:noNamespaceSchemaLocation=\"https://raw.githubusercontent.com/iqb-berlin/testcenter/17.6.0/definitions/vo_SysCheck.xsd\"\u003e\n  \u003cMetadata\u003e\n    \u003cId\u003esyscheck-2\u003c/Id\u003e\n    \u003cLabel\u003eSystem-Check-2\u003c/Label\u003e\n    \u003cDescription\u003e\u003c/Description\u003e\n  \u003c/Metadata\u003e\n\n  \u003cConfig unit=\"UNIT.SAMPLE\" savekey=\"saveme\" skipnetwork=\"true\"\u003e\n    \u003cUploadSpeed min=\"1024\" good=\"2048\" maxDevianceBytesPerSecond=\"10000\" maxErrorsPerSequence=\"0\" maxSequenceRepetitions=\"15\"\u003e\n      100000, 200000, 400000, 800000\n    \u003c/UploadSpeed\u003e\n    \u003cDownloadSpeed min=\"1024\" good=\"2048\" maxDevianceBytesPerSecond=\"200000\" maxErrorsPerSequence=\"0\" maxSequenceRepetitions=\"15\"\u003e\n      400000, 800000, 1600000, 3200000\n    \u003c/DownloadSpeed\u003e\n\n    \u003cQ id=\"1\" type=\"header\" prompt=\"Beispielüberschrift\"/\u003e\n    \u003cQ id=\"2\" type=\"string\" prompt=\"Eingabefeld\" required=\"true\"/\u003e\n    \u003cQ id=\"3\" type=\"select\" prompt=\"Auswahl\"\u003eOption A#Option B\u003c/Q\u003e\n    \u003cQ id=\"4\" type=\"text\" promp