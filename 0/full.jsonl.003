{"timestamp":"2026-09-08T01:29:05.219Z","ordinal":59913,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a07e9f-22be-75e0-a61a-d0d714b10df1","item":{"type":"FileChange","id":"exec-05388b61-ddbd-46d4-b44e-73953b1e299e","changes":{"/tmp/testcenter-import-real.mjs":{"type":"add","content":"import {readFile} from 'node:fs/promises';\nconst base='http://127.0.0.1:4311';\nlet token;\nasync function post(path,body){\n const r=await fetch(base+path,{method:'POST',headers:{'content-type':'application/json',...(token?{authorization:`Bearer ${token}`}:{})},body:JSON.stringify(body)});\n const p=await r.json(); if(!r.ok) throw new Error(`${path} ${r.status}: ${JSON.stringify(p).slice(0,2000)}`); return p;\n}\nconst auth=await post('/api/v1/admin/auth/sign-in',{username:'demo-admin',password:'REDACTED'});\ntoken=auth.sessionToken;\nif(!token) throw new Error('Missing sessionToken; fields: '+Object.keys(auth));\nconst w='/api/v1/tenants/demo-tenant/workspaces/map-real-20260908';\nawait post('/api/v1/tenants/demo-tenant/workspaces',{workspaceKey:'map-real-20260908',displayName:'MaP Originalpaket – lokale Testung 08.09.2026'});\nconst zip=await readFile('/Users/julian/Downloads/workspace-1-files (3).zip');\nconst source=await post(w+'/source-packages',{fileName:'workspace-1-files (3).zip',mediaType:'application/zip',sourceDocument:'data:application/zip;base64,'+zip.toString('base64')});\nconsole.log('Source uploaded',source.sourcePackage.sourcePackageId);\nconst imported=await post(w+'/import-jobs',{sourcePackageId:source.sourcePackage.sourcePackageId});\nconsole.log(JSON.stringify({status:imported.importJob.status,diagnostics:imported.importJob.diagnostics,releaseId:imported.stagedContentRelease?.contentReleaseId}).slice(0,18000));\nif(imported.importJob.status!=='completed') process.exit(2);\nawait post(w+'/content-releases/'+imported.stagedContentRelease.contentReleaseId+'/activate',{});\nawait post(w+'/participant-roster',{rosterText:[{loginKey:'local-map-test',groupKey:'local-acceptance',bookletKey:'MaP_BM_TH01',displayName:'Lokaler MaP Funktionstest',executionMode:'run-hot-return'}]});\nconsole.log('Activated and synthetic participant ready');\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /tmp/testcenter-import-real.mjs\n"},"completed_at_ms":1788830945219}}
