  const code = this.api.isApiError(error) ? error.error : \"\";\n      if (!wasPasswordStep && [\"participant_password_invalid\", \"participant_login_invalid\"].includes(code)) {\n        this.passwordStep.set(true);\n      } else {\n        this.problem.set(code === \"participant_login_rate_limited\"\n          ? \"Zu viele Fehlversuche! Probieren Sie es zu einem späteren Zeitpunkt noch einmal.\"\n          : [\"participant_password_invalid\", \"participant_login_invalid\"].includes(code)\n            ? \"Anmeldedaten sind nicht gültig. Bitte noch einmal versuchen!\"\n            : \"Problem bei der Anmeldung. Bitte versuchen Sie es erneut.\");\n      }\n    } finally {\n      this.busy.set(false);\n    }\n  }\n}\n"},"/Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-participant-login.component.html":{"type":"add","content":"<section class=\"login-page\" id=\"originalParticipantLogin\">\n  <aside class=\"welcome-section\">\n    @if (settings.assetUrl('loginIllustration'); as illustration) {\n      <img [src]=\"illustration\" alt=\"\" />\n    }\n    <div>\n      <p class=\"heading\">{{ view.customText('login_sidepanel_title', 'Willkommen im IQB-Testcenter') }}</p>\n      <p>{{ view.customText('login_sidepanel_subtitle', 'Das IQB-Testcenter ist eine Anwendung des Instituts zur Qualitätsentwicklung im Bildungswesen (IQB) zur Durchführung digitaler Tests und Befragungen. Der Zugang ist mit den Zugangsdaten möglich, die Sie vorab erhalten haben.') }}</p>\n    </div>\n  </aside>\n  <div class=\"login-section\">\n    <form (ngSubmit)=\"submit()\" [attr.aria-busy]=\"busy()\">\n      @if (!passwordStep()) {\n        <h2>Anmeldenamen eingeben</h2>\n        <label for=\"originalLoginName\">Anmeldename</label>\n        <input id=\"originalLoginName\" name=\"name\" autocomplete=\"username\" autocapitalize=\"off\"\n          required [disabled]=\"busy()\" [(ngModel)]=\"view.runtime.loginKey\" />\n      } @else {\n        <div class=\"password-headline\"