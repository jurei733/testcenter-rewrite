-direction: row;\n  justify-content: left;\n  align-items: center;\n  gap: 24px;\n}\n\n.password-headline > button {\n  color: var(--mat-sys-primary);\n  border: 1px solid var(--mat-sys-primary);\n  border-radius: 12px;\n}\n\n:host ::ng-deep .password-headline .mdc-icon-button .mat-mdc-button-persistent-ripple {\n  border-radius: inherit;\n}\n\nh2 {\n  font-weight: 400;\n  font-size: 30px;\n}\n\n.login-section mat-form-field {\n}\n\n.login-section > form > button {\n  width: 15%;\n  min-width: 120px;\n}\n\n.help-box {\n  display: flex;\n  flex-direction: row;\n  justify-content: start;\n  align-items: center;\n  padding: 10px 10px 10px 24px;\n  border: 1px solid var(--mat-sys-primary);\n  border-radius: 10px;\n  width: 80%;\n\n  mat-icon {\n    width: 5%;\n    height: 100%;\n    color: var(--mat-sys-primary);\n    flex-shrink: 0;\n  }\n}\n\n.button-section {\n  align-self: end;\n  display: flex;\n  gap: 9px;\n  margin-top: auto;\n  padding-bottom: 12px;\n  margin-right: 24px;\n}\nmat-toolbar {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  padding: 8px 24px;\n}\n\n.side {\n  height: 100%;\n  display: flex;\n  align-items: center;\n}\n\n.center {\n  position: absolute;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.logo a {\n  height: 100%;\n}\n\n.logo img {\n  height: 100%;\n}\n\nh1 {\n  color: var(--mat-sys-on-primary);\n}\n\n.account-button {\n  background-color: var(--mat-sys-on-primary);\n  color: var(--mat-sys-primary);\n  border-radius: 12px;\n}\n\n.standalone-logo {\n  height: 48px;\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  z-index: 2;\n}\n\n:host ::ng-deep span.mat-mdc-button-persistent-ripple {\n  border-radius: inherit;\n}\n\n.logout-dialog {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n\n  img {\n    width: 141px;\n    height: 141px;\n    object-fit: contain;\n  }\n}html, body {\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  margin: 0;\n  font-family: 'Nunito Sans',