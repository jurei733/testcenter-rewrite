atus,diagnostics:imported.importJob.diagnostics,releaseId:imported.stagedContentRelease?.contentReleaseId}).slice(0,18000));\\n+if(imported.importJob.status!=='completed') process.exit(2);\\n+await post(w+'/content-releases/'+imported.stagedContentRelease.contentReleaseId+'/activate',{});\\n+await post(w+'/participant-roster',{rosterText:[{loginKey:'local-map-test',groupKey:'local-acceptance',bookletKey:'MaP_BM_TH01',displayName:'Lokaler MaP Funktionstest',executionMode:'run-hot-return'}]});\\n+console.log('Activated and synthetic participant ready');\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"node /tmp/testcenter-import-real.mjs\",\"workdir\":\"/Users/julian/code/testcenter-rewrite/rewrite-app\",\"max_output_tokens\":4000,\"yield_time_ms\":1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a07e9f-22be-75e0-a61a-d0d714b10df1","create_time":1788830921.399738}}}
