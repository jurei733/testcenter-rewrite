 1px solid var(--mat-sys-outline-variant);\\n}\\n\\n/*Styling for account panel. It is an overlay and therefore out of the component's scope*/\\n.account-menu {\\n  width: 330px;\\n  padding: 12px;\\n}\\n\\n.account-menu .heading {\\n  display: flex;\\n  align-items: center;\\n  font-size: 22px;\\n}\\n\\n.account-menu .heading button {\\n  margin-left: auto;\\n  border-radius: 12px;\\n  border: 1px solid;\\n}\\n\\n.account-menu .heading button .mat-mdc-button-persistent-ripple {\\n  border-radius: inherit;\\n}\\n\\n.account-menu dt {\\n  margin-top: 12px;\\n  font-weight: 700;\\n}\\n\\n.account-menu dd {\\n  margin-top: 4px;\\n  margin-inline-start: 0;\\n}\\n\\n.account-menu .logout-button {\\n  margin-top: 12px;\\n  border: 1px solid var(--mat-sys-primary);\\n}\\nMIT License\\n\\nCopyright (c) 2019 Institute for Educational Quality Improvement (IQB)\\n\\nPermission is hereby granted, free of charge, to any person obtaining a copy\\nof this software and associated documentation files (the \\\"Software\\\"), to deal\\nin the Software without restriction, including without limitation the rights\\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7b1328\",\"wall_time_seconds\":5.001955792,\"session_id\":87596,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a09404-6cf2-7891-8f7e-76aa774b437b","create_time":1789189813.946409}}}
