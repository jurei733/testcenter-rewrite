ns-serif;\\n  background: white;\\n}\\n\\n:root[data-interface-mode=\\\"original\\\"] {\\n  --secondary-soft: #ccdfe5;\\n}\\n:root[data-interface-mode=\\\"original\\\"][data-application-theme=\\\"Sekundar\\\"] {\\n  --secondary-soft: #ced5e6;\\n}\\n:root[data-interface-mode=\\\"original\\\"][data-application-theme=\\\"Erwachsene\\\"] {\\n  --secondary-soft: #e1d7eb;\\n}\\n\\n:root[data-interface-mode=\\\"original\\\"] .page.is-participant-page {\\n  max-width: none;\\n  padding: 0;\\n}\\n\\n:root[data-interface-mode=\\\"original\\\"] .participant-stage > router-outlet {\\n  display: none;\\n}\\n\\n.page {\\n  max-width: 1440px;\\n  margin: 0 auto;\\n  padding: 32px 20px 56px;\\n}\\n\\n.page.is-busy .actions button,\\n.page.is-busy .view-nav a {\\n  pointer-events: none;\\n  opacity: 0.7;\\n  transform: none;\\n}\\n\\n.hero {\\n  display: grid;\\n  grid-template-columns: 1.2fr 0.8fr;\\n  gap: 18px;\\n  margin-bottom: 22px;\\n}\\n\\n.hero.is-home-hero {\\n  grid-template-columns: 1fr;\\n}\\n\\n.hero-panel,\\n.card {\\n  background: var(--panel);\\n  border: 1px solid var(--line);\\n  border-radius: var(--radius-xl);\\n  box-shadow: var(--shadow);\\n  backdrop-filter: blur(10px);\\n}\\n\\n.hero-panel {\\n  padding: 28px;\\n}\\n\\n.eyebrow {\\n  display: inline-flex;\\n  align-items: center;\\n  gap: 8px;\\n  padding: 7px 12px;\\n  border-radius: 999px;\\n  background: rgba(27, 36, 48, 0.06);\\n  color: var(--muted);\\n  font-size: 12px;\\n  letter-spacing: 0.08em;\\n  text-transform: uppercase;\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"aa8d1c\",\"wall_time_seconds\":0.00000875,\"exit_code\":0,\"original_token_count\":492,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\nstyles: [\\\"mat-icon,mat-icon.mat-primary,mat-icon.mat-accent,mat-icon.mat-warn{color:var(--mat-icon-color, inherit)}.mat-icon{-webkit-user-select:none;user-select:none;background-repeat:no-repeat;display:inline-block;fill:currentColor;height:24px;width:24px;overflow:hidden}.mat-icon.mat-icon-inline{font-size:inherit;height:inherit;line-height:inherit;width:inherit}.mat-icon.mat-ligature-font[fontIcon]::before{content:attr(fontIcon)}[dir=rtl] .mat-icon-rtl-mirror{transform:scale(-1, 1)}.mat-form-field:not(.mat-form-field-appearance-legacy) .mat-form-field-prefix .mat-icon,.mat-form-field:not(.mat-form-field-appearance-legacy) .mat-form-field-suffix .mat-icon{display:block}.mat-form-field:not(.mat-form-field-appearance-legacy) .mat-form-field-prefix .mat-icon-button .mat-icon,.mat-form-field:not(.mat-form-field-appearance-legacy) .mat-form-field-suffix .mat-icon-button .mat-icon{margin:auto}\\\\n\\\"], changeDetection: i0.ChangeDetectionStrategy.OnPush, encapsulation: i0.ViewEncapsulation.None });\\n}\\ni0.ɵɵngDeclareClassMetadata({ minVersion: \\\"12.0.0\\\", version: \\\"20.2.0-next.2\\\", ngImport: i0, type: MatIcon, decorators: [{\\n            type: Component,\\n            args: [{ template: '<ng-content></ng-content>', selector: 'mat-icon', exportAs: 'matIcon', host: {\\n                        'role': 'img',\\n                        'class': 'mat-icon notranslate',\\n                        '[class]': 'color ? \\\"mat-\\\" + color : \\\"\\\"',\\n                        '[attr.data-mat-icon-type]': '_usingFontIcon() ? \\\"font\\\" : \\\"svg\\\"',\\n                        '[attr.data-mat-icon-name]': '_svgName || fontIcon',\\n                        '[attr.data-mat-icon-namespace]': '_svgNamespace || fontSet',\\n                 \\ntemplate: '<ng-content></ng-content>', isInline: true, styles: [\\\"mat-icon,mat-icon.mat-primary,mat-icon.mat-accent,mat-icon.mat-warn{color:var(--mat-icon-color, inherit)}.mat-icon{\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10768-b685-70b3-b721-445140bdea12","create_time":1791128003.792088}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
