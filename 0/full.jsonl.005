 { algorithm, challenge, salt, signature, number });\\n  }\\n\\n  adminLogin(name: string, password: string | undefined = undefined): Observable\u003cAuthData\u003e {\\n    return this.http.put\u003cAuthData\u003e(`${this.serverUrl}session/admin`, { name, password });\\n  }\\n\\n  login(name: string, password?: string): Observable\u003cAuthData\u003e {\\n    return this.http.put\u003cAuthData\u003e(`${this.serverUrl}session/login`, { name, password });\\n  }\\n\\n  codeLogin(code: string): Observable\u003cAuthData\u003e {\\n    return this.http.put\u003cAuthData\u003e(`${this.serverUrl}session/person`, { code });\\n  }\\n\\n  getSessionData(): Observable\u003cAuthData\u003e {\\n    return this.http.get\u003cAuthData\u003e(`${this.serverUrl}session`);\\n  }\\n\\n  startTest(bookletName: string): Observable\u003cnumber\u003e {\\n    return this.http\\n      .put\u003cnumber\u003e(`${this.serverUrl}test`, { bookletName });\\n  }\\n\\n  getSysConfig(): Observable\u003cSysConfig\u003e {\\n    return this.http\\n      .get\u003cSysConfig\u003e(`${this.serverUrl}system/config`)\\n      .pipe(\\n        catchError((error: AppError) =\u003e {\\n          if (error.code !== 503) {\\n            error.type = 'fatal';\\n          }\\n          throw error;\\n        })\\n      );\\n  }\\n\\n  checkIfSysCheckModeExists(): Observable\u003cboolean\u003e {\\n    return this.http\\n      .get\u003cboolean\u003e(`${this.serverUrl}sys-check-mode`);\\n  }\\n\\n  getSysCheckInfosAcrossWorkspaces(): Observable\u003cSysCheckInfo[]\u003e {\\n    return this.http\\n      .get\u003cSysCheckInfo[]\u003e(`${this.serverUrl}sys-checks`);\\n  }\\n\\n  downloadReviews(): Observable\u003cHttpResponse\u003cBlob\u003e\u003e {\\n    return this.http.get(`${this.serverUrl}reviews/export`, {\\n      headers: {\\n        Accept: 'text/csv'\\n      },\\n      responseType: 'blob',\\n      observe: 'response'\\n    });\\n  }\\n}\\n      behavior: \\\"smooth\\\",\\n      block: \\\"center\\\"\\n    });\\n  }\\n\\n  ngOnInit(): void {\\n    this.view.init();\\n    const query = new URLSearchParams(window.location.search);\\n    this.view.startFromEntryParameters({\\n      tenantKey: query.get(\\\"tenantKey\\\"),\\n      workspaceKey: query.get(\\\"workspaceKey\\\"),\\n      loginKey: query.get(\\\"loginKey\\\"),\\n      groupKey: query.get(\\\"groupKey\\\"),\\n      bookletKey: query.get(\\\"bookletKey\\\"),\\n      participantSessionId: query.get(\\\"participantSessionId\\\"),\\n      currentUnitKey: query.get(\\\"currentUnitKey\\\"),\\n      unitResponse: query.get(\\\"unitResponse\\\"),\\n      legacyShortLink: query.get(\\\"legacyShortLink\\\") === \\\"true\\\"\\n    });\\n  }\\n\\n  ngOnDestroy(): void {\\n    this.starterScrollObserver?.disconnect();\\n    this.view.destroy();\\n  }\\n}\\n      });\\n      return;\\n    }\\n\\n    if (normalized.loginKey) {\\n      this.viewState.onActionAsync(async () =\u003e {\\n        if (normalized.legacyShortLink) {\\n          await this.signInInternal();\\n          return;\\n        }\\n        await this.starterLaunchInternal();\\n        await this.applyEntryDraftAfterResume(normalized);\\n      });\\n    }\\n  }\\n\\n  private applyEntryParameters(\\n    parameters: ParticipantEntryParameters\\n  ): NormalizedParticipantEntryParameters {\\n    const tenantKeyProvided = parameters.tenantKey != null;\\n    const workspaceKeyProvided = parameters.workspaceKey != null;\\n    const normalized = {\\n      tenantKey: parameters.tenantKey?.trim() ?? \\\"\\\",\\n      workspaceKey: parameters.workspaceKey?.trim() ?? \\\"\\\",\\n      loginKey: parameters.loginKey?.trim() ?? \\\"\\\",\\n      groupKey: parameters.groupKey?.trim() ?? \\\"\\\",\\n      bookletKey: parameters.bookletKey?.trim() ?? \\\"\\\",\\n      participantSessionId: parameters.participantSessionId?.trim() ?? \\\"\\\",\\n      currentUnitKey: parameters.currentUnitKey?.trim() ?? \\\"\\\",\\n      unitResponse: parameters.unitResponse ?? \\\"\\\",\\n      hasUni