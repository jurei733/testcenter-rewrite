/localhost').pathname;\n      if (path.startsWith('/api/')) {\n        let data;\n        if (path === '/api/system/config') data = { version: '19.0.0', customTexts: {}, appConfig: { appTitle: 'IQB-Testcenter', themeName: theme }, baseUrl: '/', veronaPlayerApiVersionMin: 2, veronaPlayerApiVersionMax: 6, iqbStandardResponseTypeMin: 1, iqbStandardResponseTypeMax: 2, xmlSchemaVersions: {}, bruteForceProtection: [], broadcastingServiceUri: '/bs/', fileServiceUri: '/fs/', passwordMinLength: 8, passwordPattern: '^.*$' };\n        else if (path === '/api/sys-check-mode') data = false;\n        else if (path === '/api/asset-assignments') data = {};\n        else if (path === '/api/assets') data = [];\n        else if (path === '/api/system/time') data = { timestamp: Date.now(), timezone: 'Europe/Berlin' };\n        else if (path === '/api/workspace/1/sys-check/ACK.SAMPLE') data = { workspaceId: 1, name: 'ACK.SAMPLE', label: 'Systemcheck acknowledgement', hasUnit: false, canSave: true, skipNetwork: true, customTexts: [], questions: [{ id: 'feedback', type: 'string', prompt: 'Feedback', value: '', options: [], required: true }], downloadSpeed: { min: 1, good: 1, maxDevianceBytesPerSecond: 1, maxErrorsPerSequence: 0, maxSequenceRepetitions: 1, sequenceSizes: [1024] }, uploadSpeed: { min: 1, good: 1, maxDevianceBytesPerSecond: 1, maxErrorsPerSequence: 0, maxSequenceRepetitions: 1, sequenceSizes: [1024] } };\n        else if (path === '/api/workspace/1/sys-check/ACK.SAMPLE/report' && request.method === 'PUT') { for await (const chunk of request) {} data = null; }\n        else { unknownApi.push(`${request.method} ${path}`); response.writeHead(404, { 'content-type': 'application/json' }); response.end('{}'); return; }\n        response.writeHead(200, { 'content-type': 'application/json', 'cache-control': 'no-store' }); response.end(JSON.stringify(data)); return;\n      }\n      const spa = path === '/' || path.startsWith('/check/') || path.startsWith('/r/');\n      const file = spa ? join(originalBrowser, 'index.html') : resolve(originalBrowser, `.${path}`);\n      assert.ok(file.startsWith(`${originalBrowser}/`));\n      const data = await readFile(file);\n      const mime = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.png': 'image/png', '.woff2': 'font/woff2', '.woff': 'font/woff', '.ttf': 'font/ttf', '.json': 'application/json' }[extname(file)] || 'application/octet-stream';\n      response.writeHead(200, { 'content-type': mime }); response.end(data);\n    } catch { response.writeHead(404); response.end('Not found'); }\n  });\n  await new Promise(done => referenceServer.listen(0, '127.0.0.1', done));\n  const sourceBase = `http://127.0.0.1:${referenceServer.address().port}`;\n  const rewritePort = await new Promise(done => {\n    const listener = createServer(); listener.listen(0, '127.0.0.1', () => { const p = listener.address().port; listener.close(() => done(p)); });\n  });\n  const rewriteBase = `http://127.0.0.1:${rewritePort}`;\n  const apiServer = spawn(process.execPath, ['/Users/julian/code/testcenter-rewrite/rewrite-app/apps/api/dist/apps/api/src/index.js'], { cwd: '/tmp/testcenter-original-ack-release.cwhWbD', env: { ...process.env, PORT: String(rewritePort), FIRST_SLICE_STORE: 'sqlite', FIRST_SLICE_SQLITE_FILE: '/var/folders/0g/0jg2ynjn33sftyg101714qvw0000gn/T/testcenter-original-system-check-saved-YFb5bO/store.sqlite', FIRST_SLICE_BOOTSTRAP_DEMO: 'true', FIRST_SLICE_OPERATOR_AUTH_REQUIRED: 'true' }, stdio: ['ignore', 'ignore', 'inherit'] });\n  let browser;\n  try {\n    const deadline = Date.now() + 20_000;\n    while (true) { try { if ((await fetch(`${rewriteBase}/readyz`)).ok) break; } catch {} if (Date.now() > deadline) throw Error('Owned Rewrite API not ready'); await delay(100); }\n    const auth = await fetch(`${rewriteBase}/api/v1/admin/auth/sign-in`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ username: 'demo-admin', password: 'REDACTED' }) });\n    assert.ok(auth.ok); const token = (await auth.json()).sessionToken;\n    browser = await chromium.launch({ headless: false });\n    const collected = {};\n    for (theme of ['Primar', 'Sekundar', 'Erwachsene']) {\n    const patched = await fetch(`${rewriteBase}/api/v1/admin/application-settings`, { method: 'PATCH', headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` }, body: JSON.stringify({ themeName: theme }) });\n    assert.ok(patched.ok);\n    for (const target of ['source', 'rewrite']) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, locale: 'de-DE', timezoneId: 'Europe/Berlin' });\n      const page = await context.newPage();\n      const errors = [];\n      page.on('pageerror', error => errors.push(String(error)));\n      page.on('console', message => { if (message.type() === 'error') console.log(`${target}_console_error=${message.text()}`); });\n      const url = target === 'source' ? `${sourceBase}/#/check/1/ACK.SAMPLE/w` : `${rewriteBase}/app/system-check?ui=original&tenantKey=ack-tenant&workspaceKey=ack-workspace&checkId=ACK.SAMPLE`;\n      await page.goto(url, { waitUntil: 'networkidle' });\n      try { await page.locator('#syscheck-next-step').waitFor(); }\n      catch (error) {\n        console.log(JSON.stringify({ target, url: page.url(), errors, unknownApi, body: (await page.locator('body').innerText()).slice(0, 5000) }));\n        await page.screenshot({ path: join(artifacts, `${target}-failure.png`), fullPage: true });\n        throw error;\n      }\n      await page.evaluate(() => document.fonts.ready);\n      await page.locator('#syscheck-next-step').click();\n      await page.getByRole('textbox', { name: 'Feedback', exact: true }).fill('Owned comparison response');\n      await page.locator('#syscheck-next-step').click();\n      await page.getByRole('button', { name: 'Bericht senden', exact: true }).click();\n      const surface = page.locator('.mat-mdc-dialog-surface');\n      await surface.waitFor();\n      await surface.evaluate(element => Promise.all(element.getAnimations({ subtree: true }).map(animation => animation.finished.catch(() => undefined))));\n      await page.evaluate(() => document.fonts.ready);\n      const metrics = async () => surface.evaluate(element => {\n        const root = element.getBoundingClientRect();\n        const read = node => {\n          const b = node.getBoundingClientRect(), style = getComputedStyle(node);\n          const props = ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'color', 'backgroundColor', 'borderRadius', 'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft', 'marginTop', 'marginBottom'];\n          return { text: node.innerText.trim().replace(/\\s+/gu, ' '), rect: { x: b.x - root.x, y: b.y - root.y, width: b.width, height: b.height }, style: Object.fromEntries([...props, 'opacity'].map(key => [key, style[key]])) };\n        };\n        return { root: { x: root.x, y: root.y, width: root.width, height: root.height }, surface: read(element), title: read(element.querySelector('.mat-mdc-dialog-title')), content: read(element.querySelector('.mat-mdc-dialog-content')), actions: read(element.querySelector('.mat-mdc-dialog-actions')), paragraphs: [...element.querySelectorAll('p')].map(read), buttons: [...element.querySelectorAll('button')].map(node => ({ ...read(node), children: [...node.children].filter(child => child.getBoundingClientRect().width).map(read), tokens: Object.fromEntries(['--mat-button-protected-disabled-container-color', '--mat-button-protected-disabled-label-text-color', '--mat-sys-on-surface', '--mat-button-protected-disabled-container-opacity', '--mat-button-protected-container-color'].map(key => [key, getComputedStyle(node).getPropertyValue(key)])) })) };\n      });\n      const capture = async stage => {\n        for (const [screen, width, height] of [['desktop', 1280, 720], ['mobile', 390, 844]]) {\n          await page.setViewportSize({ width, height });\n          const id = `${target}-${theme}-${stage}-${screen}`;\n          collected[id] = await metrics();\n          await surface.screenshot({ path: join(artifacts, `${id}.png`) });\n        }\n        await page.setViewportSize({ width: 1280, height: 720 });\n      };\n      await capture('save');\n      await page.getByPlaceholder('Systemcheck-Kennwort', { exact: true }).fill('ack-save');\n      await page.getByPlaceholder('Schul-ID', { exact: true }).fill('Owned comparison title');\n      await page.getByRole('button', { name: 'Speichern', exact: true }).click();\n      await page.getByRole('heading', { name: 'Bericht gespeichert', exact: true }).waitFor();\n      await surface.evaluate(element => Promise.all(element.getAnimations({ subtree: true }).map(animation => animation.finished.catch(() => undefined))));\n      await page.evaluate(() => document.fonts.ready);\n      await capture('saved');\n      assert.deepEqual(errors, []);\n      await context.close();\n    }\n    }\n    assert.deepEqual(unknownApi, [], 'Reference fixtures must cover every Original API call');\n    // Diagnostics are retained even when a comparison fails. No screenshot or\n    // DOM manipulation is used to make the actual interfaces match.\n    const fs = require('node:fs/promises');\n    await fs.writeFile(join(artifacts, 'metrics.json'), JSON.stringify(collected, null, 2));\n    for (const testedTheme of ['Primar', 'Sekundar', 'Erwachsene']) for (const stage of ['save', 'saved']) for (const screen of ['desktop', 'mobile']) {\n      const id = `${testedTheme}-${stage}-${screen}`;\n      assert.deepEqual(collected[`rewrite-${id}`], collected[`source-${id}`], `Rendered reference: ${id}`);\n      console.log(`rendered_reference=${id}:exact metrics`);\n    }\n    console.log(`reference=${original}; three themes; viewports=1280x720,390x844; real pinned frontend, fixture-only backend`);\n  } finally {\n    await browser?.close();\n    if (apiSe