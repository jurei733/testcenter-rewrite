ion supports select-all, individual CSV exports, a combined Original-compatible ZIP with response/log/review CSV and JSON reports plus manifest, and workspace-key-confirmed aggregate deletion with an audit record. Response, review, and log reads accept repeated `groupKey` parameters without breaking the existing single-group filters; exports are explicitly bounded while interactive lists remain capped at 500 rows\nui_smoke_step=action-admin-workspace-access-set-read-write-done\nui_smoke_step=admin-workspace-access-matrix-read-only\nui_smoke_step=action-admin-workspace-access-set-read-only-start\nui_smoke_step=action-admin-workspace-access-set-read-only-done\nui_smoke_step=admin-workspace-access-matrix-revoke\nui_smoke_step=action-admin-workspace-access-revoke-access-start\nui_smoke_step=action-admin-workspace-access-revoke-access-done\nui_smoke_step=admin-workspace-access-matrix-grant-read-only\nui_smoke_step=action-admin-workspace-access-grant-read-only-start\nui_smoke_step=action-admin-workspace-access-grant-read-only-done\n","exit_code":0,"duration":{"secs":0,"nanos":10833},"formatted_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n30:    quiet = false,\n33:    return this.request<T>(label, \"GET\", path, undefined, { quiet, headers });\n42:      quiet?: boolean;\n47:    if (!options.quiet) {\n65:      if (!options.quiet) {\n75:    } catch (error) {\n77:      if (!options.quiet) {\n88:      if (!options.quiet) {\n114:    } catch (error) {\n231:      *ngIf=\"app.activeRequestLabel() || app.errorMessage()\"\n232:      [class.is-error]=\"!!app.errorMessage()\"\n234:      <strong>{{ app.errorMessage() ? \"Last Error\" : \"Working\" }}</strong>\n235:      <span *ngIf=\"app.activeRequestLabel() && !app.errorMessage()\">\n238:      <span *ngIf=\"app.errorMessage()\">{{ app.errorMessage() }}</span>\n240:        *ngIf=\"app.errorMessage()\"\n244:        (click)=\"openErrorReport()\"\n362:      *ngIf=\"app.activeRequestLabel() |