 template: \"\",\n  styleUrl: \"./original-entry-surface.css\",\n  encapsulation: ViewEncapsulation.None\n})\nexport class OriginalEntrySurfaceStylesComponent {}\n.participant-stage {\n  display: grid;\n  gap: 18px;\n}\n\n.application-footer {\n  display: flex;\n    return `Chromium OS ${chromeOsVersion}`;\n  }\n  if (/Linux/i.test(userAgent)) {\n    return \"Linux --\";\n  }\n  return \"--\";\n};\n\nconst parseDeviceName = (userAgent: string): string => {\n  if (/iPhone/i.test(userAgent)) {\n    return \"Apple iPhone mobile\";\n  }\n  if (/iPad/i.test(userAgent)) {\n    return \"Apple iPad tablet\";\n  }\n  if (/Android/i.test(userAgent)) {\n    const model = userAgent\n      .match(/Android [^;)]*;\\s*([^;)]+?)(?:\\s+Build\\/[^;)]*)?[;)]/i)?.[1]\n      ?.trim();\n    return [model, /Mobile/i.test(userAgent) ? \"mobile\" : \"tablet\"]\n      .filter(Boolean)\n      .join(\" \");\n  }\n  return \"\";\n};\n\nexport const projectTestcenterLoadEnvironment = (input: {\n  userAgent: string;\n  screenSizeWidth: number;\n  screenSizeHeight: number;\n  loadTime: number;\n}): TestcenterLoadEnvironment => {\n  const browser = parseBrowserUserAgent(input.userAgent);\n  const mobileSafariVersion = /iPhone|iPad|iPod/i.test(input.userAgent)\n    ? readVersion(input.userAgent, /Version\\/([\\d.]+)/i)\n    : null;\n  return {\n    browserVersion:\n      mobileSafariVersion ??\n      (browser.version === \"unknown\" ? \"--\" : browser.version),\n    browserName:\n      mobileSafariVersion != null\n        ? \"Mobile Safari\"\n        : browser.family === \"Unknown\"\n          ? \"--\"\n          : browser.family,\n    osName: parseOperatingSystemName(input.userAgent),\n    device: parseDeviceName(input.userAgent),\n    screenSizeWidth: Math.max(0, Math.round(input.screenSizeWidth)),\n    screenSizeHeight: Math.max(0, Math.round(input.screenSizeHeight)),\n    loadTime: Math.max(0, Math.round(input.loadTime))\n  };\n};\n\nconst normalizeFamily = (family: string): string =>\n  family.trim().toLocaleLowerCase();\n\nconst parseVersion = (version: string): number[] | null => {\n  const parts = version.match(/\\d+/g)?.slice(0, 3).map(Number);\n  return parts?.length ? parts : null;\n};\n\nconst compareVersions = (left: string, right: string): number | null => {\n  const leftParts = parseVersion(left);\n  const rightParts = parseVersion(right);\n  if (!leftParts || !rightParts) {\n    return null;\n  }\n  for (let index = 0; index < 3; index += 1) {\n    const difference = (leftParts[index] ?? 0) - (rightParts[index] ?? 0);\n    if (difference !== 0) {\n      return Math.sign(difference);\n    }\n  }\n  return 0;\n};\n\nconst parseSupportedBrowser = (entry: string): BrowserIdentity | null => {\n  const separator = entry.lastIndexOf(\" \");\n  if (separator <= 0 || separator === entry.length - 1) {\n    return null;\n  }\n  const family = entry.slice(0, separator);\n  const version = entry.slice(separator + 1);\n  return parseVersion(version)\n    ? { family: browserFamilyLabels[family] ?? family, version }\nimport { Injectable } from '@angular/core';\nimport { coerce, gte, satisfies } from 'semver';\nimport { ResolvedUserAgent, resolveUserAgent } from 'browserslist-useragent';\nimport UAParser from 'ua-parser-js';\n// eslint-disable-next-line import/no-relative-packages\nimport browsersJson from '../../../../../../definitions/browsers.json';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class UserAgentService {\n  // see https://github.com/ai/browserslist#browsers\n  static browserNameMap: { [browserlistId: string]: string } = {\n    bb: 'BlackBerry',\n    and_chr: 'Chrome',\n    ChromeAndroid: 'Chrome',\n    FirefoxAndroid: 'Firefox',\n    ff: 'Firefox',\n    ie_mob: 'ExplorerMobile',\n    ie: 'Explorer',\n    and_ff: 'Firefox',\n    ios_saf: 'iOS',\n    op_mini: 'OperaMini',\n    op_mob: 'OperaMobile',\n    and_qq: 'QQAndroid',\n    and_uc: 'UCAndroid'\n  };\n\n  // we can't use matchesUA from browserslist-useragent because it expects a set of