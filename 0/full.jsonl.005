nds: cards.map(card => getComputedStyle(card).backgroundColor),\\n+          disabled: button.disabled, opacity: getComputedStyle(button).opacity,\\n+          iconSize: [icon.getBoundingClientRect().width, icon.getBoundingClientRect().height],\\n+          tableSizing: getComputedStyle(element.querySelector(\\\"td\\\")).boxSizing,\\n+          topbarHeight: document.querySelector(\\\"#participantApplicationHeader\\\").getBoundingClientRect().height };\\n+      });\\n+      assert.deepEqual(appearance, { width, color: \\\"rgb(25, 28, 29)\\\",\\n+        backgrounds: [\\\"rgb(255, 255, 255)\\\", \\\"rgb(255, 255, 255)\\\"], disabled: true,\\n+        opacity: \\\"1\\\", iconSize: [24, 24], tableSizing: \\\"content-box\\\",\\n+        topbarHeight: screen === \\\"desktop\\\" ? 64 : 56 });\\n+      assert.equal(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth), false);\\n+      await page.screenshot({ path: join(root, `${theme}-welcome-${screen}.png`), fullPage: true });\\n+    }\\n+    await page.setViewportSize({ width: 1280, height: 720 });\\n     await page.locator(\\\"#syscheck-next-step\\\").click();\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"UI_SMOKE_FRONTEND_ROOT=/tmp/testcenter-original-welcome-production UI_SMOKE_HEADFUL=true node scripts/smoke-original-system-check-saved.mjs > /tmp/testcenter-original-welcome-production-smoke.log 2>&1\",workdir:\"/Users/julian/code/testcenter-rewrite/rewrite-app\",yield_time_ms:1000,max_output_tokens:1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a106fc-b231-7422-957b-3f624ccb477f","create_time":1791124900.355684}}}
