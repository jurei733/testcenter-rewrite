                   [level]=\\\"problemLevel\\\" [text]=\\\"problemText\\\"></tc-alert>\\n        }\\n        <button matButton=\\\"filled\\\" type=\\\"submit\\\" data-cy=\\\"login-user\\\"\\n                [disabled]=\\\"!loginForm.get('name')?.valid\\\">\\n          <mat-icon svgIcon=\\\"chevron_right\\\"></mat-icon>\\n          Weiter\\n        </button>\\n      </form>\\n    }\\n    @else {\\n      <form [formGroup]=\\\"loginForm\\\" (ngSubmit)=\\\"passwordInput()\\\">\\n        <div class=\\\"password-headline\\\">\\n          <button matIconButton type=\\\"reset\\\" (click)=\\\"username = null;\\\">\\n            <mat-icon svgIcon=\\\"chevron_left\\\"></mat-icon>\\n          </button>\\n          <h2>Kennwort eingeben</h2>\\n        </div>\\n        <mat-form-field appearance=\\\"outline\\\">\\n          <mat-label>Kennwort</mat-label>\\n          <input matInput #pw formControlName=\\\"pw\\\"\\n                 [type]=\\\"showPassword ? 'text' : 'password'\\\" autofocus\\n                 (keyup)=\\\"clearWarning(); checkCapsLock($event)\\\">\\n          <button mat-icon-button matSuffix type=\\\"button\\\"\\n                  [attr.aria-label]=\\\"'Hide password'\\\" [attr.aria-pressed]=\\\"showPassword\\\"\\n                  (click)=\\\"showPassword = !showPassword\\\">\\n            <mat-icon svgIcon=\\\"visibility\\\"></mat-icon>\\n          </button>\\n        </mat-form-field>\\n        @if (problemText) {\\n          <tc-alert [attr.data-cy]=\\\"'login-problem:' + problemCode\\\"\\n                    [level]=\\\"problemLevel\\\" [text]=\\\"problemText\\\"></tc-alert>\\n        }\\n        <button matButton=\\\"filled\\\" type=\\\"submit\\\" data-cy=\\\"login-user\\\"\\n                [disabled]=\\\"!loginForm.get('name')?.valid || busyWithChallenge\\\">\\n          Anmelden\\n        </button>\\n      </form>\\n    }\\n\\n    @if (mainDataService.globalWarning) {\\n      <mat-card class=\\\"help-box\\\">\\n        <mat-icon svgIcon=\\\"warning\\\"></mat-icon>\\n        <mat-card-content>{{mainDataService.globalWarning}}</mat-card-content>\\n      </mat-card>\\n    }\\n\\n    @if (unsupportedBrowser.length) {\\n      <mat-card class=\\\"help-box\\\">\\n        <mat-icon svgIcon=\\\"warning\\\"></mat-icon>\\n        @let oldBrowserText = (\\n          'Ihr Browser ist veraltet und könnte zu Fehlern führen. Bitte verwenden Sie eine aktuelle Version.'\\n            | customtext : 'login_unsupportedBrowser'\\n            : unsupportedBrowser[0]\\n            : unsupportedBrowser[1]\\n            | async\\n        )?.trim();\\n        <mat-card-content>{{ oldBrowserText }}</mat-card-content>\\n      </mat-card>\\n    }\\n\\n    <div class=\\\"button-section\\\">\\n      <button matButton=\\\"tonal\\\" [routerLink]=\\\"['/r/admin-login']\\\" data-cy=\\\"login-admin-form\\\">\\n        Adminbereich\\n      </button>\\n    </div>\\n  </div>\\n</div>\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"c2cb69\",\"wall_time_seconds\":0.000013083,\"exit_code\":0,\"original_token_count\":465,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n.mat-mdc-form-field {\\n  display: block\\n}\\n\\n:host {\\n  flex: 1;\\n  max-height: 100%;\\n}\\n\\n.login-page {\\n  display: flex;\\n  flex-direction: row;\\n  height: 100%;\\n  gap: 64px;\\n}\\n\\n.welcome-section {\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  max-height: 100%;\\n  width: 25%;\\n  background-color: var(--mat-sys-secondary);\\n  gap: 48px;\\n  box-sizing: border-box;\\n  padding: 64px 24px 20px 24px;\\n  overflow: auto;\\n}\\n\\n.welcome-section img {\\n  width: 100%;\\n}\\n\\n.welcome-section .heading {\\n  font-size: 30px;\\n}\\n\\n.login-section {\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: start;\\n  align-items: start;\\n  gap: 60px;\\n  width: 75%;\\n}\\n\\n.login-section form {\\n  margin-top: 64px;\\n  display: flex;\\n  flex-direction: column;\\n  text-ali