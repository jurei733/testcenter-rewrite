acity: 1; }\\n+.login-submit svg.mat-icon { width: 18px; height: 18px; }\\n@@\\n-.button-section { align-self: end; margin-top: auto; padding: 12px 24px; }\\n+.button-section { align-self: end; display: flex; gap: 9px; margin-top: auto; padding-bottom: 12px; margin-right: 24px; }\\n .button-section a { border: 1px solid var(--secondary); }\\n .login-problem { color: #a12020; }\\n-@media (max-width: 700px) {\\n-  .login-page { flex-direction: column; gap: 24px; }\\n-  .welcome-section, .login-section { width: 100%; }\\n-  .welcome-section { padding: 24px; gap: 16px; }\\n-  .welcome-section img { max-width: 160px; }\\n-  form { margin: 0 auto; width: calc(100% - 48px); }\\n-}\\n+.help-box { display: flex; flex-direction: row; align-items: center; justify-content: start;\\n+  padding: 10px 10px 10px 24px; border: 1px solid var(--secondary); border-radius: 10px;\\n+  width: 80%; box-sizing: content-box; --mat-card-elevated-container-color: var(--mat-sys-surface); }\\n+.help-box svg.warning-icon { width: 5%; height: 100%; color: var(--secondary); flex-shrink: 0; }\\n*** Update File: /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-footer.component.ts\\n@@\\n-    footer { height: 24px; padding: 16px; background: var(--theme-gray-05, #F4F2F2);\\n+    footer { height: 24px; padding: 16px; box-sizing: content-box; color: var(--mat-sys-on-surface); background: var(--theme-gray-05, #F4F2F2);\\n@@\\n-    a { max-height: 100%; }\\n*** Update File: /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-entry-surface.css\\n@@\\n :root[data-interface-mode=\\\"original\\\"] app-original-participant-starter .starter {\\n@@\\n }\\n+\\n+/* The pinned login occupies the viewport between the toolbar and 56px footer.\\n+   Its own welcome/root containers scroll; the footer must not grow offscreen. */\\n+:root[data-interface-mode=\\\"original\\\"] .page.is-participant-page:has(#originalParticipantLogin) {\\n+  height: 100dvh;\\n+  min-height: