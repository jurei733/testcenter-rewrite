nd.service.ts-52-    return this.http.patch\u003cvoid\u003e(`${this.serverUrl}workspace/${workspaceId}`, { name: wsName });\\nfrontend/src/app/superadmin/backend.service.ts-53-  }\\nfrontend/src/app/superadmin/backend.service.ts-54-\\nfrontend/src/app/superadmin/backend.service.ts:55:  deleteWorkspaces(workspaces: number[], password: string): Observable\u003cvoid\u003e {\\nfrontend/src/app/superadmin/backend.service.ts:56:    return this.http.delete\u003cvoid\u003e(`${this.serverUrl}workspaces`, { body: { ws: workspaces, p: password } });\\nfrontend/src/app/superadmin/backend.service.ts-57-  }\\nfrontend/src/app/superadmin/backend.service.ts-58-\\nfrontend/src/app/superadmin/backend.service.ts-59-  getUsersByWorkspace(workspaceId: number): Observable\u003cIdRoleData[]\u003e {\\nfrontend/src/app/superadmin/backend.service.ts-60-    return this.http.get\u003cIdRoleData[]\u003e(`${this.serverUrl}workspace/${workspaceId}/users`);\\n--\\nfrontend/src/app/superadmin/users/users.component.ts-140-\\nfrontend/src/app/superadmin/users/users.component.ts-141-    passwdDialogRef.componentInstance.passwordSubmit.subscribe(password =\u003e {\\nfrontend/src/app/superadmin/users/users.component.ts-142-      const usersToDelete: string[] = [];\\nfrontend/src/app/superadmin/users/users.component.ts-143-      selectedRows.forEach((r: UserData) =\u003e usersToDelete.push(r.id.toString(10)));\\nfrontend/src/app/superadmin/users/users.component.ts:144:      this.bs.deleteUsers(usersToDelete, password).subscribe({\\nfrontend/src/app/superadmin/users/users.component.ts-145-        next: () =\u003e {\\nfrontend/src/app/superadmin/users/users.component.ts-146-          passwdDialogRef.close();\\nfrontend/src/app/superadmin/users/users.component.ts-147-          this.messageService.showSnackbar('Administrator:in gelöscht');\\nfrontend/src/app/superadmin/users/users.component.ts-148-          this.updateObjectList();\\n--\\nfrontend/src/app/superadmin/workspaces/workspaces.component.ts-136-\\n