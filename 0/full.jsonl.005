 GetAdminCurrentSessionResponse\\n  ): void {\\n    this.opsState.adminSessionView = prettyPrintJson(\\n      payload,\\n      this.opsState.adminSessionView\\n    );\\n    this.opsState.adminUsername = payload.adminUser.username;\\n    this.opsState.adminDisplayName = payload.adminUser.displayName;\\n  }\\n\\n  private createAdminHeaders(): Record<string, string> {\\n    const token = this.opsState.adminSessionToken.trim();\\n    return token ? { authorization: `Bearer ${token}` } : {};\\n  }\\n\\n  private hasAdminSession(): boolean {\\n    return this.opsState.adminSessionToken.trim() !== \\\"\\\";\\n  }\\n\\n  private createRoleAssignmentRequest(\\n    role: AssignAdminRoleRequest[\\\"role\\\"],\\n    accessMode: NonNullable<AssignAdminRoleRequest[\\\"accessMode\\\"]>,\\n    tenantKey: string,\\n    workspaceKey: string,\\n    groupKey: string,\\n    monitorProfilesJson?: string,\\n          <button id=\\\"applyAdminUserFiltersButton\\\" class=\\\"primary\\\" type=\\\"button\\\" [disabled]=\\\"!view.canUseAdminSession\\\" (click)=\\\"view.applyAdminUserFilters()\\\">Apply User Filters</button>\\n          <button id=\\\"useAdminManagementScopeAsUserFiltersButton\\\" class=\\\"secondary\\\" type=\\\"button\\\" [disabled]=\\\"!view.canUseAdminSession\\\" (click)=\\\"view.useAdminManagementScopeAsUserFilters()\\\">Use Role Scope</button>\\n          <button id=\\\"exportAdminUsersCsvButton\\\" class=\\\"secondary\\\" type=\\\"button\\\" [disabled]=\\\"!view.canUseAdminSession\\\" (click)=\\\"view.exportAdminUsersCsv()\\\">Export Users CSV</button>\\n          <button class=\\\"ghost\\\" type=\\\"button\\\" (click)=\\\"view.clearAdminUserFilters()\\\">Clear User Filters</button>\\n        </div>\\n      </article>\\n\\n      <app-record-collection\\n        title=\\\"Admin Users\\\"\\n        subtitle=\\\"Scoped admin directory with password-handoff state, public user fields, and delegable role scopes.\\\"\\n        [items]=\\\"view.adminUserItems\\\"\\n        (itemAction)=\\\"view.selectAdminUser($event)\\\"\\n        emptyState=\\\"Sign in with an administrative delegation role, then refresh admin users.\\\"\\n      ></app-record-collection>\\n\\nconst completeRequiredAdminPasswordChangeAt = async (\\n  rootUrl: string,\\n  sessionToken: string,\\n  username: string,\\n  password: string\\n): Promise<string> => {\\n  const changedPassword = await requestJsonAt<{\\n    adminUser: { passwordChangeRequired: boolean };\\n    revokedAdminSessionIds: string[];\\n  }>(rootUrl, \\\"/api/v1/admin/auth/password\\\", {\\n    method: \\\"POST\\\",\\n    headers: { authorization: `Bearer ${sessionToken}` },\\n    body: { password }\\n  });\\n  assert.equal(changedPassword.status, 200);\\n  assert.equal(changedPassword.body.adminUser.passwordChangeRequired, false);\\n  assert.equal(changedPassword.body.revokedAdminSessionIds.length > 0, true);\\n\\n  const signIn = await requestJsonAt<{\\n    adminUser: { passwordChangeRequired: boolean };\\n    sessionToken: string;\\n  }>(rootUrl, \\\"/api/v1/admin/auth/sign-in\\\", {\\n    method: \\\"POST\\\",\\n    body: { username, password }\\n  });\\n385:        [attr.data-view-nav]=\\\"view.id\\\"\\n36:            <input id=\\\"tenantKey\\\" name=\\\"tenantKey\\\" [(ngModel)]=\\\"view.workspace.tenantKey\\\" (change)=\\\"view.persistState()\\\" />\\n40:            <input id=\\\"workspaceKey\\\" name=\\\"workspaceKey\\\" [(ngModel)]=\\\"view.workspace.workspaceKey\\\" (change)=\\\"view.persistState()\\\" />\\n75:          <button id=\\\"refreshWorkspaceOverviewButton\\\" class=\\\"ghost\\\" type=\\\"button\\\" [disabled]=\\\"!view.canUseWorkspaceScope\\\" (click)=\\\"view.refreshWorkspaceOverview()\\\">Refresh Workspace Overview</button>\\n102:              [placeholder]=\\\"'Display name for ' + (view.workspace.workspaceKey || 'the selected workspace')\\\"\\n109:          <button id=\\\"deleteWorkspaceButton\\\" class=\\\"danger\\\" type=\\\"button\\\" [disabled]=\\\"!view.canDeleteWorkspace\\\" (click)=\\\"view.confirmDeleteWorkspace()\\\">Permanently Delete Workspace</button>\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"5ddb52\",\"wall_time_seconds\":1.00106325,\"session_id\":3631,\"original_token_count\":21,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"663ab3\",\"wall_time_seconds\":1.000808792,\"session_id\":57353,\"original_token_count\":21,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"ddf9bf\",\"wall_time_seconds\":1.002888,\"session_id\":90657,\"original_token_count\":21,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10768-b685-70b3-b721-445140bdea12","create_time":1791130997.075566}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
