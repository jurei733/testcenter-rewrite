l authenticated request');\\n+      const response = await fetch(`${baseUrl}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: participantAuthorization } });\\n+      assert.equal(response.status, 200);\\n+      const payload = await response.json(); assert.equal(payload.currentRunState.testRun.testRunId, runId);\\n+      return JSON.stringify(payload.currentRunState.testRun.unitResponses);\\n     };\\n-    const before = responseBytes(); assert.match(before, /Owned silent-channel answer/u);\\n+    const before = await responseBytes(); assert.match(before, /Owned silent-channel answer/u);\\n@@\\n-    assert.ok(responseBytes() === before, 'Reconnection must not rewrite saved response bytes');\\n+    assert.ok(await responseBytes() === before, 'Reconnection must not rewrite saved response bytes');\\n@@\\n     assert.deepEqual(errors, []);\\n-    await monitor.screenshot({ path: join(artifacts, 'monitor-reconnected.png'), fullPage: true });\\n-    await participant.screenshot({ path: join(artifacts, 'participant-reconnected.png'), fullPage: true });\\n+    assert.deepEqual(httpFailures, []);\\n+    await monitor.bringToFront();\\n+    await monitor.screenshot({ path: join(artifacts, 'monitor-reconnected.png'), animations: 'disabled' });\\n+    await participant.bringToFront();\\n+    await participant.screenshot({ path: join(artifacts, 'participant-reconnected.png'), animations: 'disabled' });\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"tail -20 /tmp/testcenter-event-stream-watchdog-browser-development.log\",\"workdir\":\"/Users/julian/code/testcenter-rewrite/rewrite-app\",\"max_output_tokens\":3000}));\ntext(await tools.write_stdin({session_id:16701,chars:\"\",\"yield_time_ms\":1000,\"max_output_tokens\":1500}));\ntext(await tools.exec_command({cmd:\"node run.js /tmp/playwright-test-stream-watchdog.js \u003e /tmp/testcenter-event-stream-watchdog-browser-production-api.log 2\u003e\u00261\",\"workdir\":\"/Users/julian/.a