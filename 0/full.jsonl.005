ssage => { if (message.event === 'released') releasedAt = message.at; });\n      try {\n        const [locked] = await once(worker, 'message'); assert.equal(locked.event, 'locked');\n        const answer = `Owned answer under ${lock} contention`;\n        const posted = page.waitForResponse(response => {\n          if (response.request().method() !== 'POST' || !new URL(response.url()).pathname.endsWith('/save-progress')) return false;\n          try { return String(response.request().postDataJSON()?.unitResponse || '').includes(answer); } catch { return false; }\n        });\n        const started = Date.now();\n        await frame.locator('#demoPlayerAnswer').fill(answer);\n        const response = await posted;\n        assert.equal(response.status(), 200);\n        await response.finished();\n        const elapsed = Date.now() - started;\n        const timing = response.request().timing();\n        console.log(JSON.stringify({ lock, elapsed, lockMs: releasedAt - locked.at,\n          requestRelativeToLock: timing.startTime + timing.requestStart - locked.at,\n          responseWaitMs: timing.responseStart - timing.requestStart, failures }));\n        assert.ok(elapsed >= 100 && elapsed < 15_000, `${lock} complete browser flow ${elapsed}ms`);\n        await page.locator('#participantVeronaSaveStatus').filter({ hasText: 'saved' }).waitFor();\n        assert.ok(credential);\n        const current = await fetch(`${baseUrl}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: credential } });\n        assert.equal(current.status, 200);\n        const state = (await current.json()).currentRunState;\n        assert.equal(state.testRun.testRunId, runId);\n        assert.ok(JSON.stringify(state.testRun.unitResponses).includes(answer));\n        console.log(`${lock}_save=200; waited_ms=${elapsed}; actual Player answer persisted in same run`);\n      } finally { await finished; }\n    }\n    assert.deepEqual(errors, []); assert.deepEqual(failures, []);\n    await page.bringToFront();\n    await page.screenshot({ path: join(root, 'answer-after-contention.png'), animations: 'disabled' });\n    console.log('sqlite_contention_browser=passed; both locks; no HTTP 5xx/page errors');\n  } finally {\n    await browser?.close();\n    if (apiServer.exitCode === null) {\n      const stopped = new Promise(done => apiServer.once('exit', done)); apiServer.kill('SIGTERM');\n      await Promise.race([stopped, delay(5_000)]); if (apiServer.exitCode === null) { apiServer.kill('SIGKILL'); await stopped; }\n    }\n    console.log('owned_api=shutdown');\n  }\n})().catch(error => { console.error(error); process.exitCode = 1; });\n","exit_code":0,"duration":{"secs":0,"nanos":11750},"formatted_output":"    { name: 'Mobile', width: 375, height: 667 },\n  ];\n\n  for (const viewport of viewports) {\n    console.log(\n      `Testing ${viewport.name} (${viewport.width}x${viewport.height})`,\n    );\n\n    await page.setViewportSize({\n      width: viewport.width,\n      height: viewport.height,\n    });\n\n    await page.goto(TARGET_URL);\n    await page.waitForTimeout(1000);\n\n    await page.screenshot({\n      path: `/tmp/${viewport.name.toLowerCase()}.png`,\n      fullPage: true,\n    });\n  }\n\n  console.log('All viewports tested');\n  await browser.close();\n})();\n```\n\n## Available Helpers\n\nOptional utility functions in `lib/helpers.js`:\n\n```javascript\nconst helpers = require('./lib/helpers');\n\n// Detect running dev servers (use this first)\nconst servers = await helpers.detectDevServers();\nconsole.log('Found servers:', servers);\n\n// Safe click with retry\nawait helpers.safeClick(page, 'button.submit', { retries: 3 });\n\n// Safe type with clear\nawait helpers.safeType(page, '#username', 'testuser');\n\n// Take timestamped screenshot\nawait helpers.takeScreenshot(page, 'test-result');\n\n// Handle cookie banners\nawait helpers.handleCookieBanner(page);\n\n// Extract table data\nconst data = await helpers.extractTableData(page, 'table.results');\n```\n\nSee `lib/helpers.js` for full list.\n\n## Custom HTTP Headers\n\nConfigure custom headers for all HTTP requests via environment variables. Useful for identifying automated traffic, getting LLM-optimized responses, or adding authentication tokens globally.\n\n**Single header (common case):**\n\n```bash\ncd $SKILL_DIR && \\\n  PW_HEADER_NAME=X-Automated-By REDACTED \\\n  node run.js /tmp/my-script.js\n```\n\n**Multiple headers (JSON format):**\n\n```bash\ncd $SKILL_DIR && \\\n  PW_EXTRA_HEADERS='{\"X-Automated-By\":\"playwright-skill\",\"X-Debug\":\"true\"}' \\\n  node run.js /tmp/my-script.js\n```\n\nHeaders are automatically applied when using `helpers.createContext()`:\n\n```javascript\nconst context = await helpers.createContext(browser);\nconst page = await context.newPage();\n// All requests from this page include your custom headers\n```\n\nFor scripts using raw Playwright API, use the injected `getContextOptionsWithHeaders()`:\n\n```javascript\nconst context = await browser.newContext(\n  getContextOptionsWithHeaders({ viewport: { width: 1920, height: 1080 } }),\n);\n```\n\n## Advanced Usage\n\nFor comprehensive Playwright API documentation, see [API_REFERENCE.md](API_REFERENCE.md):\n\n- Selectors & Locators best practices\n- Network interception & API mocking\n- Authentication & session management\n- Visual regression testing\n- Mobile device emulation\n- Performance testing\n- Debugging techniques\n- CI/CD integration\n\n## Notes\n\n- Each automation is custom-written for the specific request — not limited to pre-built scripts.\n- Auto-detects running dev servers to eliminate hardcoded URLs.\n- Test scripts written to `/tmp` for automatic cleanup (no project clutter).\n- Code executes with proper module resolution via `run.js`.\n- API_REFERENCE.md loaded only when advanced features are needed.\n- Use `waitForURL`, `waitForSelector`, `waitForLoadState` instead of fixed timeouts.\n- Always use try-catch for robust automation.\n- **Playwright not installed?** Run `cd $SKILL_DIR && npm run setup`.\n- **Module not found?** Ensure running from skill directory via `run.js` wrapper.\n- **Browser doesn't open?** Check `headless: false` and ensure display is available.\n- **Element not found?** Add wait: `await page.waitForSelector('.element', { timeout: 10000 })`.\nconst assert = require('node:assert/strict');\nconst { spawn } = require('node:child_process');\nconst { createServer } = require('node:net');\nconst { mkdtemp } = require('node:fs/promises');\nconst { join } = require('node:path');\nconst { once } = require('node:events');\nconst { Worker } = require('node:worker_threads');\nconst { setTimeout: delay } = require('node:timers/promises');\nconst { chromium } = require('playwright');\nconst TARGET_FRONTEND_ROOT = '/tmp/testcenter-stream-watchdog-production';\n(async () => {\n  const root = await mkdtemp('/tmp/testcenter-sqlite-save-contention-');\n  const sqliteFile = join(root, 'store.sqlite');\n  console.log(`owned_artifacts=${root}`);\n  const port = await new Promise(done => { const listener = createServer(); listener.listen(0, '127.0.0.1', () => { const p = listener.address().port; listener.close(() => done(p)); }); });\n  const baseUrl = `http://127.0.0.1:${port}`;\n  const apiServer = spawn(process.execPath, ['/Users/julian/code/testcenter-rewrite/rewrite-app/apps/api/dist/apps/api/src/index.js'], {\n    cwd: TARGET_FRONTEND_ROOT,\n    env: { ...process.env, PORT: String(port), FIRST_SLICE_STORE: 'sqlite', FIRST_SLICE_SQLITE_FILE: sqliteFile,\n      FIRST_SLICE_BOOTSTRAP_DEMO: 'true', FIRST_SLICE_OPERATOR_AUTH_REQUIRED: 'true', REQUIRE_LOGIN_PASSWORD: 'false' },\n    stdio: ['ignore', 'ignore', 'inherit'] });\n  let browser;\n  try {\n    const deadline = Date.now() + 20_000;\n    while (true) { try { if ((await fetch(`${baseUrl}/readyz`)).ok) break; } catch {} if (Date.now() > deadline) throw Error('Owned API not ready'); await delay(100); }\n    browser = await chromium.launch({ headless: false });\n    const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });\n    const page = await context.newPage();\n    const errors = [], failures = [];\n    let credential = '';\n    page.on('pageerror', error => errors.push(String(error)));\n    page.on('response', response => { if (response.status() >= 500) failures.push(response.status()); });\n    page.on('request', request => { if (/\\/participant\\/sessions\\/[^/]+\\/current-state$/u.test(new URL(request.url()).pathname)) credential = request.headers().authorization || ''; });\n    await page.goto(`${baseUrl}/app/participant?tenantKey=demo-tenant&workspaceKey=demo-workspace&loginKey=student-demo&groupKey=group%3Astudent-demo&bookletKey=booklet%3Ademo`, { waitUntil: 'domcontentloaded' });\n    const frame = page.frameLocator('#participantVeronaPlayerFrame');\n    await frame.locator('#demoPlayerAnswer').waitFor();\n    const sessionId = await page.locator('#participantRouteSessionId').inputValue();\n    const runId = (await page.locator('#participantRouteRunId').textContent()).trim();\n    for (const lock of ['reader', 'writer']) {\n      const worker = new Worker(`\n        const { DatabaseSync } = require('node:sqlite');\n        const { parentPort, workerData } = require('node:worker_threads');\n        const db = new DatabaseSync(workerData.file);\n        db.exec(workerData.lock === 'reader' ? 'BEGIN' : 'BEGIN IMMEDIATE');\n        db.prepare('SELECT COUNT(*) FROM test_runs').get();\n        parentPort.postMessage({ event: 'locked', at: Date.now() });\n        setTimeout(() => { db.exec('ROLLBACK'); db.close(); parentPort.postMessage({ event: 'released', at: Date.now() }); }, 750);\n      `, { eval: true, workerData: { file: sqliteFile, lock } });\n      const finished = once(worker, 'exit');\n      let releasedAt = 0;\n      worker.on('message', message => { if (message.event === 'released') releasedAt = message.at; });\n      try {\n        const [locked] = await once(worker, 'message'); assert.equal(locked.event, 'locked');\n        const answer = `Owned answer under ${lock} contention`;\n        const posted = page.waitForResponse(response => {\n          if (response.request().method() !== 'POST' || !new URL(response.url()).pathname.endsWith('/save-progress')) return false;\n          try { return String(response.request().postDataJSON()?.unitResponse || '').includes(answer); } catch { return false; }\n        });\n        const started = Date.now();\n        await frame.locator('#demoPlayerAnswer').fill(answer);\n        const response = await posted;\n        assert.equal(response.status(), 200);\n        await response.finished();\n        const elapsed = Date.now() - started;\n        const timing = response.request().timing();\n        console.log(JSON.stringify({ lock, elapsed, lockMs: releasedAt - locked.at,\n          requestRelativeToLock: timing.startTime + timing.requestStart - locked.at,\n          responseWaitMs: timing.responseStart - timing.requestStart, failures }));\n        assert.ok(elapsed >= 100 && elapsed < 15_000, `${lock} complete browser flow ${elapsed}ms`);\n        await page.locator('#participantVeronaSaveStatus').filter({ hasText: 'saved' }).waitFor();\n        assert.ok(credential);\n        const current = await fetch(`${baseUrl}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: credential } });\n        assert.equal(current.status, 200);\n        const state = (await current.json()).currentRunState;\n        assert.equal(state.testRun.testRunId, runId);\n        assert.ok(JSON.stringify(state.testRun.unitResponses).includes(answer));\n        console.log(`${lock}_save=200; waited_ms=${elapsed}; actual Player answer persisted in same run`);\n      } finally { await finished; }\n    }\n    assert.deepEqual(errors, []); assert.deepEqual(failures, []);\n    await page.bringToFront();\n    await page.screenshot({ path: join(root, 'answer-after-contention.png'), animations: 'disabled' });\n    console.log('sqlite_contention_browser=passed; both locks; no HTTP 5xx/page errors');\n  } finally {\n    await browser?.close();\n    if (apiServer.exitCode === null) {\n      const stopped = new Promise(done => apiServer.once('exit', done)); apiServer.kill('SIGTERM');\n      await Promise.race([stopped, delay(5_000)]); if (apiServer.exitCode === null) { apiServer.kill('SIGKILL'); await stopped; }\n    }\n    console.log('owned_api=shutdown');\n  }\n})().catch(error => { console.error(error); process.exitCode = 1; });\n"},"started_at_ms":1791124228772,"completed_at_ms":1791124228772}}
{"timestamp":"2026-10-04T14:30:28.848Z","ordinal":74535,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a106fc-b231-7422-957b-3f624ccb477f","item":{"type":"CommandExecution","id":"exec-87f02541-c7ef-4038-854a-8a3eaac3b1ce","process_id":"25362","command":["/bin/zsh","-lc","git diff -- rewrite-app/packages/sqlite-store/src/index.ts rewrite-app/packages/sqlite-store/src/index.test.ts; rg -n 'SQLite|contention|Sperr|watchdog|Original.*UI|matrix|Matrix' rewrite-app/docs/PARITY.md rewrite-app/README.md"],"cwd":"file:///Users/julian/code/testcenter-rewrite","parsed_cmd":[{"type":"unknown","cmd":"git diff -- rewrite-app/packages/sqlite-store/src/index.ts rewrite-app/packages/sqlite-store/src/index.test.ts; rg -n 'SQLite|contention|Sperr|watchdog|Original.*UI|matrix|Matrix' rewrite-app/docs/PARITY.md rewrite-app/README.md"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\ndiff --git a/rewrite-app/packages/sqlite-store/src/index.test.ts b/rewrite-app/packages/sqlite-store/src/index.test.ts\nindex db95b867..52b78685 100644\n--- a/rewrite-app/packages/sqlite-store/src/index.test.ts\n+++ b/rewrite-app/packages/sqlite-store/src/index.test.ts\n@@ -3,6 +3,8 @@ import { mkdtemp, rm } from \"node:fs/promises\";\n import { tmpdir } from \"node:os\";\n import { join } from \"node:path\";\n import { DatabaseSync } from \"node:sqlite\";\n+import { once } from \"node:events\";\n+import { Worker } from \"node:worker_threads\";\n import test from \"node:test\";\n \n import { createWorkspaceSourcePackageReferenceRevision } from \"@testcenter-rewrite-app/application\";\n@@ -19,7 +21,70 @@ import type {\n   Workspace\n } from \"@testcenter-rewrite-app/domain\";\n \n-import { createSqliteFirstSliceRepository } from \"./index.js\";\n+import { createSqliteFirstSliceRepository, SQLITE_BUSY_TIMEOUT_MS } from \"./index.js\";\n+\n+const startExternalSqliteLock = (databasePath: string, lock: \"reader\" | \"writer\", durationMs: number) => {\n+  const worker = new Worker(`\n+    const { DatabaseSync } = require('node:sqlite');\n+    const { parentPort, workerData } = require('node:worker_threads');\n+    const database = new DatabaseSync(workerData.path);\n+    database.exec(workerData.lock === 'writer' ? 'BEGIN IMMEDIATE' : 'BEGIN');\n+    database.prepare('SELECT COUNT(*) FROM tenants').get();\n+    parentPort.postMessage('locked');\n+    setTimeout(() => { database.exec('ROLLBACK'); database.close(); }, workerData.durationMs);\n+  `, { eval: true, workerData: { path: databasePath, lock, durationMs } });\n+  return { ready: once(worker, \"message\"), finished: once(worker, \"exit\") };\n+};\n+\n+for (const lock of [\"reader\", \"writer\"] as const) {\n+  test(`SQLite waits for a short external ${lock} lock instead of rejecting a durable write`, async () => {\n+    const directory = await mkdtemp(join(tmpdir(), \"sqlite-contention-\"));\n+    const databasePath = join(directory, \"store.sqlite\");\n+    const repository = createSqliteFirstSliceRepository(databasePath);\n+    const tenant = { tenantId: \"contention-tenant\", tenantKey: \"contention-tenant\", displayName: \"Before lock\",\n+      status: \"active\" as const, createdAt: \"2026-10-04T00:00:00.000Z\" };\n+    await repository.saveTenant(tenant);\n+    const worker = startExternalSqliteLock(databasePath, lock, 250);\n+    try {\n+      assert.deepEqual(await worker.ready, [\"locked\"]);\n+      const startedAt = performance.now();\n+      await assert.doesNotReject(repository.saveTenant({ ...tenant, displayName: \"After lock\" }));\n+      const elapsed = performance.now() - startedAt;\n+      assert.ok(elapsed >= 100 && elapsed < 5_000, `Expected bounded contention wait, received ${elapsed}ms.`);\n+      assert.equal((await repository.getTenantByKey(tenant.tenantKey))?.displayName, \"After lock\");\n+    } finally {\n+      await worker.finished;\n+      await rm(directory, { recursive: true, force: true });\n+    }\n+  });\n+\n+  test(`SQLite bounds a persistent external ${lock} lock and preserves data for a later retry`, { timeout: 15_000 }, async () => {\n+    assert.equal(SQLITE_BUSY_TIMEOUT_MS, 5_000);\n+    const directory = await mkdtemp(join(tmpdir(), \"sqlite-bounded-contention-\"));\n+    const databasePath = join(directory, \"store.sqlite\");\n+    const repository = createSqliteFirstSliceRepository(databasePath);\n+    const tenant = { tenantId: \"bounded-contention\", tenantKey: \"bounded-contention\", displayName: \"Before lock\",\n+      status: \"active\" as const, createdAt: \"2026-10-04T00:00:00.000Z\" };\n+    await repository.saveTenant(tenant);\n+    const worker = startExternalSqliteLock(databasePath, lock, SQLITE_BUSY_TIMEOUT_MS + 1_000);\n+    try {\n+      assert.deepEqual(await worker.ready, [\"locked\"]);\n+      const startedAt = performance.now();\n+      await assert.rejects(repository.saveTenant({ ...tenant, displayName: \"Rejected write\" }), /database is locked/);\n+      const elapsed = performance.now() - startedAt;\n+      assert.ok(elapsed >= SQLITE_BUSY_TIMEOUT_MS - 250 && elapsed < SQLITE_BUSY_TIMEOUT_MS + 1_000,\n+        `Expected bounded failed write, received ${elapsed}ms.`);\n+      assert.deepEqual(await repository.getTenantByKey(tenant.tenantKey), tenant, \"A failed write cannot leave partial data.\");\n+      await worker.finished;\n+      const retried = { ...tenant, displayName: \"After successful retry\" };\n+      await repository.saveTenant(retried);\n+      assert.deepEqual(await repository.getTenantByKey(tenant.tenantKey), retried);\n+    } finally {\n+      await worker.finished;\n+      await rm(directory, { recursive: true, force: true });\n+    }\n+  });\n+}\n \n test(\"SQLite atomically reserves only one workspace dependency snapshot per revision\", async () => {\n   const tempDirectory = await mkdtemp(join(tmpdir(), \"sqlite-snapshot-race-\"));\ndiff --git a/rewrite-app/packages/sqlite-store/src/index.ts b/rewrite-app/packages/sqlite-store/src/index.ts\nindex b44a900a..8108ede0 100644\n--- a/rewrite-app/packages/sqlite-store/src/index.ts\n+++ b/rewrite-app/packages/sqlite-store/src/index.ts\n@@ -1566,11 +1566,27 @@ export type SqliteFirstSliceStorageDiagnostics = {\n   targetSchemaVersion: number;\n };\n \n+export const SQLITE_BUSY_TIMEOUT_MS = 5_000;\n+\n+const openSqliteDatabase = (filePath: string): DatabaseSync => {\n+  const database = new DatabaseSync(filePath);\n+  try {\n+    // Short-lived readers (e.g. diagnostics/backups) and other writers must\n+    // not make a durable save fail immediately. SQLite performs the bounded\n+    // wait inside each statement; longer contention still fails for retry.\n+    database.exec(`PRAGMA busy_timeout = ${SQLITE_BUSY_TIMEOUT_MS}`);\n+    return database;\n+  } catch (error) {\n+    database.close();\n+    throw error;\n+  }\n+};\n+\n export const inspectSqliteFirstSliceStorage = async (\n   filePath: string\n ): Promise<SqliteFirstSliceStorageDiagnostics> => {\n   mkdirSync(dirname(filePath), { recursive: true });\n-  const database = new DatabaseSync(filePath);\n+  const database = openSqliteDatabase(filePath);\n \n   try {\n     return {\n@@ -1586,7 +1602,7 @@ export const migrateSqliteFirstSliceStorage = async (\n   filePath: string\n ): Promise<SqliteFirstSliceStorageDiagnostics> => {\n   mkdirSync(dirname(filePath), { recursive: true });\n-  const database = new DatabaseSync(filePath);\n+  const database = openSqliteDatabase(filePath);\n \n   try {\n     applyMigrations(database);\n@@ -1603,7 +1619,7 @@ export const checkSqliteFirstSliceReadiness = async (\n   filePath: string\n ): Promise<void> => {\n   mkdirSync(dirname(filePath), { recursive: true });\n-  const database = new DatabaseSync(filePath);\n+  const database = openSqliteDatabase(filePath);\n \n   try {\n     database.prepare(\"SELECT 1\").get();\n@@ -1616,7 +1632,7 @@ export const createSqliteFirstSliceRepository = (\n   filePath: string\n ): FirstSliceRepository => {\n   mkdirSync(dirname(filePath), { recursive: true });\n-  const database = new DatabaseSync(filePath);\n+  const database = openSqliteDatabase(filePath);\n   applyMigrations(database);\n \n   return {\nrewrite-app/README.md:60:watchdog covers a request that never receives headers, aborts the blocked read,\nrewrite-app/README.md:87:versioned domain matrix across every storage adapter. Matching the current\nrewrite-app/README.md:192:by the memory, JSON-file, SQLite, and Postgres adapters.\nrewrite-app/README.md:205:read model in memory, file, SQLite, and PostgreSQL stores; Angular reloads them\nrewrite-app/README.md:216:profile JSON is persisted by file, SQLite, and PostgreSQL\nrewrite-app/README.md:287:That builds the API and Angular shell, migrates `./.data/local.sqlite`, starts the API with SQLite persistence and protected operator routes, then serves the app at `http://127.0.0.1:4310/app`. The root opens a compact start surface for Participant, System Check, and operator sign-in; protected Workspace, Content, Runtime, and Diagnostics surfaces are no longer presented as the signed-out landing page. In protected mode, a direct administration or monitoring link is routed through the focused operator sign-in without issuing an unauthorized API request, then resumes the requested route after successful authentication. Open-auth development deployments retain direct route access.\nrewrite-app/README.md:307:To reset that local demo state and let `start:local` seed it again from a clean SQLite database, run:\nrewrite-app/README.md:313:The reset only removes `./.data/local.sqlite` and SQLite's matching WAL/SHM sidecar files used by `npm run start:local`. For scripted checks, `LOCAL_STATE_SQLITE_FILE` can point the reset helper at a disposable SQLite file instead.\nrewrite-app/README.md:321:For a quicker pre-push signal that builds once, reuses built artifacts, includes the SQLite runtime preflight, and stops the browser flow after the content import/activation read model, run:\nrewrite-app/README.md:341:Use `npm run ci:deployability` for a non-Docker release gate that builds once, runs file-store migrate/doctor/preflight, migrates SQLite, requires build metadata in both runtime preflights, and verifies the built SQLite startup smoke with the same metadata. Use `npm run ci:postgres` when `FIRST_SLICE_POSTGRES_URL` points at a reachable Postgres database. Docker-only release checks remain covered by `npm run smoke:docker:runtime` and `npm run smoke:compose:postgres`.\nrewrite-app/README.md:349:- built-server startup smoke tests against file and SQLite storage\nrewrite-app/README.md:350:- built runtime preflights against file and SQLite storage\nrewrite-app/README.md:351:- built-server graceful shutdown/drain smoke tests against file and SQLite storage\nrewrite-app/README.md:352:- browser-driven Angular UI smokes against SQLite in focused content, participant-entry, activation-roster-warning, review-readiness, open-run, monitor-detail, destructive-action, full, and protected operator modes, plus a Postgres-backed protected UI smoke in the Postgres CI matrix\nrewrite-app/README.md:353:- a standalone production Docker image runtime smoke that builds the image, migrates SQLite inside the container, starts the API as the non-root runtime user, and verifies `/readyz`, `/manifest`, and `/app`\nrewrite-app/README.md:390:The public challenge is signed, short-lived, bound to the exact credential input through a keyed digest, and contains no plaintext password or second code. Angular solves it in Web Workers with the same `altcha-lib` mechanism used by Testcenter 18.2. A valid solution is atomically consumed by memory, file, SQLite, or Postgres storage before authentication, so it cannot be replayed across requests, processes, or restarts; rejected or missing proof does not advance the existing login-failure sink. `/diagnostics/config` and runtime preflight expose only the non-secret algorithm, limits, enabled scopes, current key ID, and whether a previous key is configured.\nrewrite-app/README.md:775:- the Original central error-report flow is available for participant and operator surfaces: application request failures offer a report action and unhandled Angular/browser errors open the same accessible dialog automatically. The sanitized report contains an error ID, timestamp, build, browser/device, parameter-free URL, stack, and a bounded previous-error buffer and can be inspected, copied, or downloaded as `bug-report.txt`. Optional direct GitHub issue delivery is enabled only when both `BUG_REPORT_GITHUB_REPOSITORY` and the server-only `BUG_REPORT_GITHUB_TOKEN` are configured; delivery is rate-limited and timeout-bounded, while shared browser/server redaction removes common credentials and tokens before submission. The dedicated `smoke:ui:bug-report` production SQLite/Chromium gate triggers the global handler, verifies redaction, and downloads the report\nrewrite-app/README.md:785:- study monitor participant matrix read model exposes participant-by-unit session/run/answer/review status directly for the operator shell\nrewrite-app/README.md:787:- study monitor participant matrix CSV export flattens participant-by-unit progress with session/run status, expected/answered flags, response lengths, review counts, and roster display context, and can be narrowed by the same login/group/booklet/unit/status/answer/limit filters used by the operator matrix\nrewrite-app/README.md:791:- source-package deletion readiness exposes active imports/releases and every participant-session/test-run reference; exact-file-name confirmation deletes only a rechecked safe aggregate and its unused import/release derivatives, while dependency changes fail closed and every successful deletion is audited. The final store mutation is bound to a SHA-256 revision of every dependency-relevant workspace file and assembly/replacement event, so an upload, retry, replacement, assembly, or deletion that races the readiness calculation returns a conflict instead of deleting from a stale graph. PostgreSQL serializes those mutations on the workspace row; memory, file, and SQLite apply the same comparison inside their atomic mutation boundary. A bounded batch route and Angular multi-selection now reproduce the original partial deletion report: safe files are removed while still-used, missing, disallowed, and unexpected failures remain separated for operator follow-up; read-only workspace admins cannot invoke either delete path\nrewrite-app/README.md:827:- Verona 6 `playerState.sharedParameters` now follows the Original's test-wide Player-to-Player path: valid key/value pairs merge by key, persist independently from per-Unit responses in every store, emit an auditable `SHARED_PARAMETERS` test-state snapshot, and return in every start or live config-change `playerConfig`. A production SQLite/Chromium gate publishes values in one sandboxed Player, observes the live config update, consumes them in a second Unit, overwrites and extends the map, and restores the exact merged state after reload\nrewrite-app/README.md:829:- original XML/JSON `BookletConfig` values now compile into a versioned runtime policy exposed by participant current-state; presentation/response completeness is enforced server-side for forward, backward, and completion requests, nested `DenyNavigationOnIncomplete` rules independently inherit or override each dimension, and the Angular/Verona player applies unit-menu/control, player-end, paging, logging, page-restore, header/title, fullscreen-prompt, and fullscreen-button settings with visible denial or browser-fallback guidance. Matching the current Original controller, an adjacent host Unit button remains clickable when completeness or an active forbidden timer prevents the transition, then presents the exact effective denial without issuing a navigation request; the server and embedded Player targets remain locked. Code-gated blocks retain their dedicated entry control. The historical four-Booklet package remains gated with its three Units, legacy Player, and byte-exact four-account roster. Separately, the complete current 51-Booklet matrix activates with the current five-Unit source pool, Verona 6.0.5 Player, and byte-exact 51-account roster; all one-to-one assignments plus representative starter isolation and current fullscreen/browser-navigation policies run across memory, file, and SQLite\nrewrite-app/README.md:833:- a pinned original Testcenter 14.3/15.1/15.2/17.4/17.6/18.0 compatibility corpus now imports both historical and current production-shaped packages, including both historical and current three-Booklet root Sample packages with the current two-SysCheck/expanded-roster graph, the historical 17-case and current 27-case `CY_Bklt_TC-*` Test-Controller packages, the complete legacy/current BookletConfig matrix, and the current Session-Management and Group-Monitoring packages. The current two-Booklet Session-Management graph activates with all five Units, Verona 6.0.5, and its byte-exact 12-login roster; password-free/protected entry, ordered multi-Booklet assignment, second codes, access windows, and Hot-Return versus Hot-Restart re-entry with response restoration run across memory, file, and SQLite. The current Controller corpus at `65d28718eb6474cf5158206494096d32cd3393f9` likewise activates all 27 current 18.0 booklets, their five current Units, Verona 6.0.5 Player, and the byte-exact current 36-login `CY_Logins_TestController.xml` roster in one workspace, while retaining the independently pinned historical package; its nine refactored navigation cases use only `toolbar_show_unit_list`. Official Demo variants, Review variants, Hot-Return, and Hot-Restart accounts gate mode policy, code/time enforcement, durable response return versus clean restart, and monitor inclusion across memory, file, and SQLite. The current Group-Monitoring package independently gates its empty legacy monitor password as a passwordless migration candidate, explicit creation with a replacement operator password, exact profile retention, group isolation, and participant-visible pause/resume/go-to/lock/unlock transitions across memory, file, and SQLite. The importer accepts the original `id-6.0` Verona-player reference as a version-checked legacy alias while retaining identity and version mismatch failures. Its real `Booklet2.xml` + `Unit2.xml` + coding scheme + Verona 6 dependency set gates both prebuilt-ZIP and loose multi-upload intake, immutable dependency retention, and raw-response adaptive routing end-to-end. The byte-exact current `CY_Bklt_Adap-1.xml` package, Verona 6.0.5 Player, and two-account `CY_Logins_Adap.xml` roster additionally gate the five official default/value/coder/Review-preset/Review-override scenarios across memory, file, and SQLite. The current two-Booklet/four-Unit Aspect graph and changed 18.0 roster likewise gate the new Unit, full dependency retention, symbol-keypad settings, second-code enforcement, and the real multi-booklet `testuser1` flow across all three stores. The complete official `@iqb/responses` 3.6.0 `test/coding/derive` tree is additionally pinned through 11 scheme variants and all 23 byte-exact inputs/outcomes. A combined compatibility package gates `CONCAT_CODE`, `COPY_VALUE`, `MANUAL`, all four `SOLVER` variants, `SUM_CODE`, `SUM_SCORE`, and `UNIQUE_VALUES`, including aliases, same-ID/no-alias solvers, dependency failures, arrays, copied unset values, partial inputs, explicit zeroes, and every official status/value/code/score route through import, server coding, adaptive routing, and raw-response retention across memory, file, and SQLite. The historical DAN `G231mm.xml` + `G231mm.voud` + metadata-free `IQBVisualUnitPlayerV2.99.2.html` graph now has prebuilt and loose intake gates plus a production SQLite/Chromium execution gate for its API-2.1 handshake, JSON-string `all` response, and reload restoration; dotted version suffixes resolve only as a conservative metadata-free filename fallback, and competing versions remain an explicit ambiguity. Its complete original three-unit Aspect booklet, IQB Aspect 2.12.3 player, and all Unit/Voud pairs add a production-sized import and browser handshake/save/navigation/restore gate, including a 16.17 MB media definition; operational monitor/system-check logins are excluded from participant import\nrewrite-app/README.md:835:- the official `array-length-check` and deliberately versionless `arrays` schemes from `@iqb/responses` 3.6.0 pin all six historical cases and gate AND-connected rulesets, `ANY_OPEN`, `LENGTH`, `SORT_ARRAY`, numeric array positions, `SUM`, `ANY_OTHER`, `ANY`, sorted array comparison, automatic zero coding, derived `SUM_SCORE`, and `CODING_INCOMPLETE` routing across memory, file, and SQLite\nrewrite-app/README.md:836:- the official versionless `fragmenting` scheme pins regex capture-group coding byte-for-byte and gates numeric/unit fragments, `IGNORE_CASE`, exact code/score results, raw text retention, and adaptive routing across memory, file, and SQLite\nrewrite-app/README.md:837:- the complete official `@iqb/responses` 3.6.0 `test/coding/rules` tree is pinned through 18 schemes and all 38 byte-exact inputs/outcomes. One 18-booklet compatibility package gates `MATCH`, `MATCH_REGEX`, `NUMERIC_MATCH`, open and full numeric ranges, min/max comparisons, `IS_TRUE`, `IS_FALSE`, `IS_NULL`, `IS_EMPTY`, `ELSE`, AND-connected rules and rulesets with fixed array positions, legacy preprocessing, `BASE_NO_VALUE` omission, residual zeroes, `INVALID`, `CODING_INCOMPLETE`, `INTENDED_INCOMPLETE` code types, derived `SUM_CODE`/`SUM_SCORE`, recoding of a Player-supplied derived variable, and pre-coded status with zero or signed code/score values. The 11-case intended-incomplete matrix covers every official source-status propagation outcome. All 38 raw envelopes select an exclusive Participant route across memory, file, and SQLite\nrewrite-app/README.md:838:- together with the root `alias` and `subforms` cases, the compatibility corpus now pins the complete official `@iqb/responses` 3.6.0 `test/coding` tree: 34 scheme variants and all 70 byte-exact inputs/outcomes. Base aliases route by their external identifiers; ordered repeated-ID subform responses reach the IQB coder with their `subform` markers intact, while `BASE_NO_VALUE` remains omitted and the adaptive Testcenter read model deliberately applies its original ID-only last-write selection after coding. The unchanged multi-subform Player envelope, final coded status/value/code/score route, and persistence are gated across memory, file, and SQLite\nrewrite-app/README.md:839:- the complete original Aspect source graph now includes both byte-exact `.vomd` files named by Unit `Metadata/Reference`, in addition to its booklet, three Units, three Voud definitions, and Player. Loose-file import resolves all ten files into one audited immutable package and preserves the metadata documents byte-for-byte in the downloadable snapshot; a partial chain with a missing metadata reference fails with a stable diagnostic instead of silently dropping editor provenance. The complete graph and failure path are gated across memory, file, and SQLite\nrewrite-app/README.md:840:- the pinned original `SysCheck.xml` and byte-exact official `CY_SysCheck_2.xml` import as first-class system-check definitions without producing empty content releases. Multiple checks remain independently selectable in one workspace; the browser gate proves the measured-network and configured-`skipnetwork` paths, required-field feedback, every original questionnaire control, two resolved Verona runs, save-key reports, statistics, and check-isolated cleanup. Separately uploaded SysCheck, Unit, IQB coding-scheme, and Verona files resolve transitively into audited immutable packages; their Unit definition and Player stay attached to each check, and a packaged missing Unit is rejected with a stable diagnostic. `/system-check` is a lazy direct-entry Angular flow for browser/device capture, configured repeated upload/download throughput against original-compatible `/speed-test/random-package` endpoints, application latency and connection hints, original threshold ratings, per-check `syscheck_*` custom texts, Original report cancellation, and report persistence. Matching the Original welcome check, a cache-disabled public server-time contract compares the browser clock and IANA timezone with the configured participant timezone; deviations of at least 60 seconds and timezone mismatches are highlighted and retained in the saved environment report, while an unavailable check remains visible as a warning. The Original 800 × 600 minimum screen resolution is evaluated and highlighted in the same report. The Original's UAParser-based CPU architecture, device model/type/vendor, browser and major version, operating system and version, cookie/language/core values, and available browser-plugin names are captured with the upstream report labels and stable IDs, sorted by label, persisted, and included in both report detail and semicolon CSV export. Scoped operators can list/filter reports, export original-style semicolon CSV columns, inspect per-check operating-system/browser/overall-rating distributions and individual report values, and delete selected report sets only after typing the workspace key; deletion is store-scoped and audited across memory, file, and SQLite. Creating the first dedicated system-check account removes anonymous key-based entry instance-wide; after its mandatory password rotation, the protected browser flow auto-selects a single assigned check, validates required questions, hides the report-title and save-key inputs, and proves that the saved report title is forced to the login name\nrewrite-app/README.md:841:- destructive Angular actions no longer depend on browser-native `confirm` or `prompt` UI. Workspace/content/result/system-check exact-value gates and ordinary monitor/admin confirmations share a labelled in-app alert dialog with safe initial focus, focus trapping/restoration, Escape cancellation, preserved multiline/custom monitor copy, and a disabled destructive action until the exact workspace/group/file value is entered. Participant review deletion reuses the Player confirmation surface. Production SQLite/Chromium gates prove wrong-text rejection, cancellation without a request, focus restoration, exact acceptance, and the representative content, monitor, system-check, review, and admin paths\nrewrite-app/README.md:845:- byte-preserving XML intake recognizes UTF-8, UTF-16, UTF-32, ISO-8859, Windows, CJK, and other legacy declarations across direct uploads, Data URLs, loose dependency assembly, and ZIP entries. XML-standard `ISO-10646-UCS-2` and `ISO-10646-UCS-4` aliases map onto the signature-aware UTF-16/32 decoders instead of being rejected as unknown; generic aliases accept either byte order only when the BOM or leading XML signature agrees. A production `iconv-lite` fallback extends Node's narrower WHATWG decoder set with allowlisted `ISO-8859-16`/Latin-10 and DOS `CP437`/`CP775`/`CP850`/`CP852`/`CP858` IANA aliases without admitting transport codecs such as base64, hex, or UTF-7 as XML encodings. Supported multibyte encodings are decoded strictly: incomplete UTF-8, UTF-16, UTF-32, Shift_JIS, and other WHATWG sequences fail with `source_document_xml_encoding_invalid_bytes` instead of entering normalization as replacement characters. Data-URL charset metadata remains authoritative when an XML declaration is absent. Original-corpus API gates preserve representative Romanian, German, Baltic, Czech, Cyrillic, Japanese, simplified/traditional Chinese, Korean, and Euro labels through the complete release projection across memory, file, and SQLite alongside a big-endian UCS-2 Booklet, a little-endian UCS-4 Booklet, a UCS-4 IMS manifest inside ZIP, and malformed multibyte rejection\nrewrite-app/README.md:852:- Testtakers validation now follows the declared roster generation: monitor profile containers and references require schema 15.3, Booklet state presets plus extended monitor profile/filter fields require 15.4, and per-login `ViewSettings` require 17.6. Current 18.0 nested `ViewSettings` validate and preserve the original `theme`, `codeInput` type/length, and `monitorBookletVisibility` structure. Participant theme overrides and text, numeric, symbol, or alternative-symbol code entry now reach both the second-login-code and protected-block gates; keypad input uses the configured length and restores the application theme when the participant session ends. The byte-exact original 15.2 E2E roster imports and updates idempotently, while cross-generation feature mixing fails with stable diagnostics across memory, file, and SQLite\nrewrite-app/README.md:859:- loose source-package intake resolves unique original `Booklet` or `SysCheck` → `Unit` → Verona player, `DefinitionRef`, `VariablesRef`, coding-scheme, and separately uploaded `.itcr.zip` player-resource references across already uploaded workspace files. Starting the root import captures that transitive closure in a new immutable dependency-snapshot ZIP, records exact member lineage, selects the snapshot in Angular, and runs the normal importer; the original resource-package gate proves the resulting participant download in memory, file, and SQLite stores. Ambiguous references produce structured diagnostics with one Angular action per exact candidate. The chosen source-package ID is validated server-side, retained across later ambiguity decisions, and captured with the remaining unique dependency closure in the same audited immutable snapshot; incomplete matches still fail explicitly. Snapshot package and assembly evidence are committed together only if the complete source-package/activity revision still matches; otherwise the import or manual assembly returns a retryable conflict without leaving a partial aggregate. The sequential loose-file queue exposes its processed count, exact current file, accessible determinate progress, and workspace-refresh phase while disabling duplicate submission; successful files enter reviewed assembly immediately and the final best-effort report remains itemized. Manual assembly remains as the controlled fallback for deliberate 2–100-file composition, rejecting missing documents, unsafe relative paths, duplicate selection ids, case-insensitive duplicate archive paths, and per-file/aggregate size overflow while preserving an existing manifest or generating compatible IMS aliases from paths, original XML metadata, and Verona JSON-LD module identity/version metadata\nrewrite-app/README.md:870:- adaptive Testcenter booklets now import XML `States`, nested variable/aggregation conditions, and testlet `Show` restrictions; schema-aware import requires the original conditionless fallback option for every State and enforces the State/Option/If/source/aggregation/Is attribute and child surface instead of silently accepting routing syntax outside the XSD. In particular, `or` is accepted only on `Score`, as in the original schema; `Score` alone requires `of` plus `from`, while schema-valid missing references on `Value`, `Code`, and `Status` are preserved with the Original parser's empty-string/default-`0` representation instead of being dropped into an accidental fallback. Original unit resource IDs and ZIP-relative `CodingSchemeRef` files resolve into immutable releases, missing/malformed/newer-major schemes fail with stable import diagnostics, and the current Original's pinned `@iqb/responses@5.2.2` plus `@iqbspecs/coding-scheme@3.4.1` stack derives tracked codes, scores, indirect variables, and the exact IQB status rank server-side from raw IQB-standard Verona responses before selecting the first matching state option; only tracked base responses enter the coder, matching the Original's filtering boundary. Executable gates cover both textual `CODING_COMPLETE` and its numeric status comparison, plus the Original's comparable-value handling for null, booleans, sorted arrays, aggregate `NaN`/`Infinity`, and shallowly accepted malformed values without empty-string coercion across memory, file, and SQLite. The server persists the original-equivalent `BOOKLET_STATES` snapshot at launch and after response saves, restores or backfills it from durable storage, and uses it to remove inactive units from participant menus, sequential navigation, code-gate scans, timed-block expiry routing, and completion while rejecting direct hidden-unit jumps; Demo/Review/Trial now expose the original-style adaptive selector, persist its override separately from the automatic recommendation across saves and reloads in every storage backend, and immediately rebuild the participant route; run detail, open-run monitor cards, and CSV exports expose the effective state options to operators\nrewrite-app/README.md:872:- participant controller and Verona Player events now persist as first-class test-wide or unit-wide logs across memory, file, SQLite, and Postgres stores; Verona window-focus notifications and host focus/visibility changes are debounced into original-compatible test-wide `FOCUS=HAS|HAS_NOT` entries. Scoped operators can filter the JSON read model and export the original semicolon/BOM log-report columns, while the prior workspace activity timeline remains available through its own audit CSV route. Group-result deletion removes associated logs and reports the count\nrewrite-app/README.md:878:file, and SQLite, while the production browser gate exercises all three timed\nrewrite-app/README.md:885:- the shell persists non-secret form context locally, exposes guided flows for admin bootstrap/sign-in, admin-session reads, admin user management with selectable role-assignment cards and filtered admin-user/audit reads plus admin-user/audit CSV export, tenant/workspace directory selection and CSV export, workspace bootstrap, workspace overview CSV export, file-backed source-document loading with draft preview for XML/JSON/manifest files, import, filtered source-package/import-job/content-release CSV export, runtime with a non-persisted participant-password field, persisted participant roster import/listing/export with validation warnings and local parse preview, a participant launchpad for roster/link/session handoff, participant route session re-entry and local leave/reset, participant-entry API-error guidance for ambiguous workspace and launch issues, CSV/XML/JSON entry-link preview/download, filtered content reads, filtered participant-session/response/review reads and CSV exports, participant test-log inspection plus original-style CSV export, selected-group Original-compatible result archives containing response/log/review CSV and JSON reports, filtered workspace activity reads plus a separate audit CSV export, study-monitor booklet/unit/run progress, monitor status/group/booklet/unit cards that seed participant-matrix filters, a monitor review queue with focused response/review handoff, direct Runtime handoff from monitor run, run-detail review, and unit-detail run cards plus Runtime preparation from monitor detail roster cards, and study-monitor summary/matrix/run-detail CSV export, surfaces operational summaries plus an activity feed, switches authenticated study/group monitors into a reduced role-aware console that performs only monitor-authorized reads, and now has repo-native browser smoke coverage for the runtime lifecycle, blocked activation guard, failed-import retry flow, protected admin directory, tenant/workspace directory export, workspace overview export, file-backed manifest loading, source-package/import-job/content-release CSV export, CSV/XML/JSON participant roster entry-link generation/export, participant launchpad state, typed group-result archive and deletion flows, study-monitor booklet/unit/run progress/export, admin-session reads, admin-user/audit CSV export, response/review/test-log/activity CSV export, operator timeline/session/content/runtime filters, open-run selection filter sync, group-monitor UI isolation, activation-blocking runtime handoff, run-detail review handoff, and unit-detail review handoff\nrewrite-app/README.md:886:- participant-matrix retrieval now keeps a 200-row server window independent from the operator's visible-card limit, so totals and hidden-row counts remain correct beyond 25 rows; detailed response cards always expose both session and test-run identity, including when a roster display name is present\nrewrite-app/README.md:918:- the SQLite adapter now also persists raw source-package content used for import-time structure derivation\nrewrite-app/README.md:919:- memory, file, SQLite, and Postgres stores persist participant roster entries for operator-managed entry-link/run setup\nrewrite-app/README.md:923:## Integration Test Matrix\nrewrite-app/README.md:927:into a fresh temporary directory and uses its own protected SQLite database;\nrewrite-app/README.md:933:The production slice now has a small store matrix:\nrewrite-app/README.md:951:If `FIRST_SLICE_POSTGRES_URL` is not set, the optional Postgres test runner skips cleanly outside CI and fails in CI so a misconfigured Postgres matrix cannot pass silently. When it does run, it validates the Postgres URL scheme and parseability, then logs only a credential-redacted target. CI builds once, then uses the `:built` migration, doctor, integration, and startup scripts against the same compiled artifacts.\nrewrite-app/README.md:1004:The `smoke:ui:participant-review` variant verifies the participant starter's compact-height scroll helper plus its review download before and after comment creation, including the original empty-`204` feedback, stable `testcenter-reviews.csv` filename, Original-compatible CSV shape, and participant-owned content. The `smoke:ui:admin-password-policy` variant boots the protected SQLite application with a non-default minimum and regular-expression rule, creates the first platform administrator under that rule, and verifies the effective public runtime projection plus Angular policy copy and native new-password constraints. The `smoke:ui:application-settings` variant verifies the independently configurable and routed `Impressum`, `Datenschutz`, and `Barrierefreiheit` pages, sanitizer enforcement, public settings projection, and full reset against the built application on SQLite.\nrewrite-app/README.md:1010:The `smoke:ui:content` variant is a fast browser slice that stops after admin/workspace bootstrap, original loose multi-file upload, automatic transitive workspace-dependency capture, explicit fallback assembly, source-package import, release activation, and the content prompt read model; it also verifies direct unit `Definition` prompt extraction. The `smoke:ui:system-check` variant executes both original system-check definitions, gates the anonymous report-save dialog plus success redirect, migrates several original-format JSON reports through Angular, verifies resumable duplicate detection across a multi-check batch, and downloads legacy-compatible CSV plus JSON. The `smoke:ui:system-check-access` variant continues through operational-login migration and proves that creating the first dedicated system-check account atomically replaces the public anonymous Start action with protected account entry, including password rotation, single-check auto-selection, required-field validation, a real report save with the forced login title, success redirect, and route isolation. The `smoke:ui:json-roster` variant continues through CSV/XML/original Testcenter `Login`/JSON roster import, saved roster export, and generated participant entry links. The `smoke:ui:participant-entry` variant continues through participant-route action gating, automatic single-Booklet sign-in, start/resume, session re-entry, direct `Definition` prompt display, completion, and local leave/reset. The `smoke:ui:participant-code` variant stops after verifying the original password-first `<Booklet codes>` challenge, invalid-code guidance, code-scoped session creation, and non-persistence of the code in browser storage. The `smoke:ui:activation-roster-warnings` variant continues to the staged-release roster compatibility warning drill-down before stopping. The `smoke:ui:review-readiness` variant continues through participant start, detailed response filtering, review creation/filtering, and the runtime review-readiness checklist. The `smoke:ui:monitor-review` variant continues through the study-monitor review queue and verifies the focused response/review handoff into Runtime. The `smoke:ui:monitor-detail-review` variant verifies booklet-detail and group-detail response/review handoffs into Runtime. The `smoke:ui:participant-detail-review` variant verifies the participant-matrix drill-down and participant-detail response/review handoff into Runtime. The `smoke:ui:monitor-bulk` variant verifies exact-id selection, confirmation, bulk pause/resume responses, and live run-state reconciliation. The `smoke:ui:delete-group-results` variant verifies result-group selection, the three selected-group CSV downloads, workspace-key-confirmed aggregate deletion, and its post-delete read-model/activity effects. The `smoke:ui:admin-session-bulk` variant verifies exact active-session selection, signed-in-session exclusion, labelled in-app confirmation, server-side delegation/audit enforcement, revocation of two live delegated bearer sessions, and automatic token/session cleanup plus reload in a second browser whose exact session was revoked. The `smoke:ui:admin-password-reset-confirmation` variant verifies the shared confirmation's safe initial focus and Escape cancellation before explicitly approving the reset, then proves old-password invalidation and the mandatory next-login change. The `smoke:ui:admin-password-change` variant covers the global account identity/role/scope panel and operator-shell sign-out plus the mandatory post-reset change and voluntary self-service path, including current-password rejection, double entry, complete session revocation, old-password invalidation, and renewed sign-in. The `smoke:ui:admin-password-bulk` variant generates a distinct 24-character password for each selected account, applies every reset through the existing delegation boundary, verifies old/new sign-in behavior, and validates the one-time CSV handoff plus in-memory cleanup. The `smoke:ui:admin-role-bulk` variant reuses the bounded exact account selection to assign one scoped role to two accounts through independent delegation checks and audit events, retaining only failures for retry. The `smoke:ui:admin-status-bulk` variant disables two delegated accounts through Angular, proves their live bearer tokens are rejected, and confirms that both session IDs are formally visible as revoked. The `smoke:ui:admin-delete` variant drives the shared confirmation across the preceding account mutations, permanently deletes two delegated accounts through Angular, verifies their directory and session removal, and requires retained deletion audits with exact role/session counts. The full SQLite variants build the Angular frontend, boot the built API process on SQLite, and drive a real browser through:\nrewrite-app/README.md:1020:- study-monitor summary, prioritized attention cards, status/group/booklet/unit-card participant-matrix filtering, review queue with focused response/review handoff, group drill-down, booklet drill-down, unit-progress cards, run drill-down, direct monitor-run Runtime handoff, monitor-detail Runtime preparation, study-monitor CSV export, filtered participant-matrix CSV export, selected run-detail CSV export, and open-run CSV export\nrewrite-app/README.md:1031:are gated across memory, file, and SQLite; production Chromium completes the\nrewrite-app/README.md:1040:The STARS corpus retains the byte-exact metadata-2.0/API-6 Player from a fixed official Testbed commit and a radio-button definition from the matching 0.6.19 source tag as historical independent-family coverage. It also pins the current official 0.7.2 release and its byte-exact BUTTONS option-text definition from the same source tag; production SQLite/Chromium gates `stars-unit-definition@5.3`, persists its `iqb-standard@2.0` choice in JSON-string `responses`, and restores the selection after reload. Separately, the current Original Testcenter package pins the complete 0.6.40 Player/Unit/Voud/Vomd/28-alias Booklet/Testtakers graph. Its production SQLite/Chromium gate imports the unmodified assets, signs in through the original hot-return account, persists `iqb-standard@2.0` responses on aliases `1` and `2`, follows the Player's continue navigation, and restores the second selected option after reload. The dedicated `smoke:ui:stars-recovery` slice additionally proves that the bounded 200-entry browser outbox retains 56 alias-scoped responses from two valid participant runs across one actual hard reload with the active save route unavailable. It restores the visible response semantically after Player JSON reserialization, drains only that run with its visible Unit first, retains the other run exactly until its own session opens and drains visible-Unit-first, then mirrors a separate 28-Unit queue into IndexedDB on page close, replays it idempotently, and leaves both queues empty. A separate mid-drain reload settles seven of 28 responses, retains exactly the remaining 21 across the Player restart, tolerates the idempotent visible-Unit reserialization, and finishes with all server responses committed and the browser queue empty. A complete Chromium browser-process crash after the origin store has settled, followed by relaunch from the same persistent profile, proves that another complete 28-Unit queue drains without any `pagehide` handoff. At the storage boundary, a full 200-entry outbox rejects a 201st independent Unit instead of silently evicting an older response; the Participant sees the failed save, every secured entry remains byte-for-byte present, and an explicit retry persists the current answer after capacity is released.\nrewrite-app/README.md:1042:The DAN corpus additionally imports and executes the official Testbed's historical, metadata-free `IQBVisualUnitPlayerV2.99.2.html`, original `G231mm.xml`, and byte-exact `G231mm.voud` as a real relative `DefinitionRef` graph. Its production SQLite/Chromium gate proves the API-2.1 handshake, response save, and reload restoration while retaining the stable legacy metadata warning and runtime-handshake authority instead of treating the historical definition-format key as an alias for the modern `iqb-player-dan` module id. The same definition now runs independently with both official DAN 3.0.0 and current 3.1.0 release assets; the latter gates metadata 2.0/spec 5.0, runtime API 4, the embedded `3.1.0-beta` module version, and unchanged historical JSON-string `all` restoration.\nrewrite-app/README.md:1046:`testcenter-sample1` Unit/Voud/Vomd graph. Its production SQLite/Chromium gate\nrewrite-app/README.md:1104:  - built runtime preflight against file, SQLite, and Postgres stores\nrewrite-app/README.md:1105:  - metadata-required file/SQLite deployability preflight plus built startup smoke\nrewrite-app/README.md:1106:  - memory + file + sqlite integration matrix\nrewrite-app/README.md:1109:  - file and SQLite startup/shutdown, grouped quick/review/monitor/ops browser suites, full browser, and local-demo smokes as isolated matrix jobs\nrewrite-app/README.md:1110:  - standalone production Docker image runtime smoke with image-time artifact preflight, in-container SQLite migration, non-root API start, and `/readyz`/`/manifest`/`/app` verification\nrewrite-app/README.md:1112:- [package.json](/Users/julian/code/testcenter-rewrite/rewrite-app/package.json) exposes local CI-shaped gates: `ci:static` for typecheck/unit/build/preflight, `ci:storage` for memory/file/SQLite integration plus file/SQLite startup/shutdown, `ci:browser:quick` (including the offline App-Shell gate), `ci:browser:review`, `ci:browser:monitor`, and `ci:browser:ops` for grouped built Angular browser smokes, `ci:deployability` for file/SQLite metadata-required built-runtime preflight and startup smoke, and `ci:postgres` for the Postgres-backed migration/doctor/preflight/startup/integration/UI sequence\nrewrite-app/README.md:1123:- persistence can be in-memory, JSON-file-backed, SQLite-backed, or Postgres-backed\nrewrite-app/README.md:1126:- monitor reads now include workspace summary, prioritized attention items, group drill-down, participant drill-down, booklet drill-down, unit drill-down, unit-progress coverage, participant-by-unit matrix export, selected run-detail export, saved-roster expected/not-started participants, CSV exports, open-run blockers, and confirmation-gated single/bulk pause/resume/complete/go-to/whole-test-lock/unlock/navigation-unlock/re-lock/time-adjustment controls, but still do not cover every original Testcenter monitor view\nrewrite-app/docs/PARITY.md:14:Fresh production and development builds passed. A protected SQLite/headful\nrewrite-app/docs/PARITY.md:17:Unit answers. A separate owned-API/SQLite/headful regression passed all three\nrewrite-app/docs/PARITY.md:38:the real API and isolated SQLite. This is not Original-backend compatibility\nrewrite-app/docs/PARITY.md:43:All eight Original UI matrix rows, operator layout and the remaining 19.0\nrewrite-app/docs/PARITY.md:46:### Latest verified live-channel watchdog\nrewrite-app/docs/PARITY.md:60:watchdog and both consumers/parsers with only Angular injection/signal storage\nrewrite-app/docs/PARITY.md:62:Headful Chromium checks with owned API/SQLite and a silent-socket proxy passed\nrewrite-app/docs/PARITY.md:68:`.data/stream-watchdog-reference-20261004.783OA9`. These checks do not establish the\nrewrite-app/docs/PARITY.md:71:A separate concurrent raw-SQLite inspection exposed one `database is locked`\