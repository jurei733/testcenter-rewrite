adPayload = await lazyBookletPreloadResponse.json();\n  assert.equal(\n    lazyBookletPreloadPayload.currentRunState.booklet.policy.player.loadingMode,\n    \"lazy\"\n  );\n  assert.deepEqual(\n    lazyBookletPreloadPayload.currentRunState.bookletAssets.units.map(\n      unit => unit.unitKey\n    ),\n    [veronaUnitKey]\n  );\n  await page\n    .locator(\"#participantRouteBookletLoadingStatus\")\n    .filter({ hasText: \"1 unit asset loaded\" })\n    .waitFor();\n  await page.unroute(lazyBookletPreloadPattern, holdLazyBookletPreload);\n2668:    await page.unroute(\n3191:    await page.unroute(systemTimeRoute);\n5990:  await page.unroute(looseSourcePackageUploadRoute, holdFinalLooseUpload);\n8820:  await page.unroute(lazyBookletPreloadPattern, holdLazyBookletPreload);\n8951:  page.off(\"pageerror\", recordMalformedVeronaMessageError);\n9339:  await page.unroute(veronaSaveProgressUrl, rejectVeronaSave);\n13129:  await page.unroute(starsSaveProgressUrl, abortStarsSaveProgress);\n13507:  await page.unroute(starsSaveProgressUrl, starsMidDrainRoute);\n13580:  await page.unroute(starsSaveProgressUrl, rejectStarsCapacitySave);\n20925:  await page.unroute(finishAllCommandRoute);\n21680:  await page.unroute(monitorBatchCommandsRoute);\n21687:  await page.unroute(monitorSpeciesRoute);\n21768:  await page.unroute(monitorOpenRunsRoute);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0318e-acf5-7da3-9339-e2e3369d0732","create_time":1787538109.799499}}}
