n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    defaults:\n      run:\n        working-directory: REDACTED-app\n    services:\n      postgres:\n        image: postgres:16-alpine\n        env:\n          POSTGRES_DB: REDACTED_app\n          POSTGRES_USER: REDACTED\n          POSTGRES_PASSWORD: REDACTED\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd \"pg_isready -U REDACTED -d REDACTED_app\"\n          --health-interval 5s\n          --health-timeout 5s\n          --health-retries 10\n    env:\n      FIRST_SLICE_POSTGRES_URL: REDACTED\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - run: npm run typecheck\n      - run: npm run build\n      - run: npm run db:migrate:postgres:built\n      - run: npm run db:doctor:postgres:built\n      - name: Run Postgres runtime preflight\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n          APP_BUILD_TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n          FIRST_SLICE_STORE=postgres \\\n          RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=true \\\n          npm run preflight:runtime:built\n      - run: npm run test:integration:postgres:built\n      - name: Run protected Postgres startup smoke\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04e66-c772-7170-b7f2-4f6daa7e2bfb","create_time":1788026753.96218}}}
