iscover available integrations and their connection status. Use when the user asks what integrations are available, wants to check connection status across providers, or needs to connect a provider but no provider-specific skill is loaded. (file: r0/zen-discovery/SKILL.md)\n- zen-office-docx: Create professional Word documents (.docx) from JSON descriptors via the zenskill CLI. Triggers when the user asks to create, generate, or write a Word document, .docx file, report, proposal, letter, memo, invoice, contract, resume, or any formatted document. (file: r0/zen-office-docx/SKILL.md)\n- zen-office-pdf: Create PDF documents (.pdf) from JSON descriptors via the zenskill CLI. Triggers when the user asks to create, generate, or write a PDF document, or mentions .pdf, PDF, portable document, or needs a fixed-layout document. (file: r0/zen-office-pdf/SKILL.md)\n- zen-office-pptx: Create professional PowerPoint presentations (.pptx) from JSON descriptors via the zenskill CLI. Triggers when the user asks to create, generate, or write a presentation, slide deck, pitch deck, or mentions .pptx, PowerPoint, slides, or keynote. (file: r0/zen-office-pptx/SKILL.md)\n- zen-office-xlsx: Create professional Excel spreadsheets (.xlsx) from JSON descriptors via the zenskill CLI. Triggers when the user asks to create, generate, or write a spreadsheet, workbook, data table, or mentions .xlsx, Excel, or tabular data export. (file: r0/zen-office-xlsx/SKILL.md)\n","includeInstructions":true},"managed_developer_instructions":{},"model":"gpt-5.6-sol","multi_agent_mode":{"mode":"explicitRequestOnly","usage_hint_hash":"0e2a3174d5f40de49ed383507497d69bbff42c5d"},"multi_agent_usage_hint":"0e2a3174d5f40de49ed383507497d69bbff42c5d","orchestrator_skills":{"includeInstructions":true,"enabled":false},"permissions":{"instructions":"32ca25d6d85edaeb6f1e19b2a5cc4e08d2a631cd","approved_command_prefixes":[["/bin/zsh","-lc","AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq '.' | sed -n '1,260p'"],["/bin/zsh","-lc","AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/api/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq '.' | sed -n '1,260p'"],["/bin/zsh","-lc","AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/api/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq -r '.responses[] | \"ID=\" + .id + \"\\n\" + .content + \"\\n\"' | sed -n '1,80p'"],["/bin/zsh","-lc","AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/api/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq -r '.responses[] | select(.id==\"elementCodes\") | .content' | jq '.[] | select(.id==\"01a\")'"],["/bin/zsh","-lc","docker compose --env-file .env.dev exec -T db psql -U root -d coding-box -P pager=off -c \"SELECT p.workspace_id, COUNT(*) AS quoted_json_like FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.value IS NOT NULL AND btrim(r.value) ~ '^\\\"[\\[{].*[\\]}]\\\"$';\""],["/bin/zsh","-lc","docker compose --env-file .env.dev exec -T db psql -U root -d coding-box -P pager=off -c \"SELECT r.id AS response_id, u.alias AS unit_alias, r.variableid, r.status, r.subform, left(r.value,120) AS value_prefix FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.value IS NOT NULL AND btrim(r.value) ~ '^\\\"[\\[{].*[\\]}]\\\"$' ORDER BY r.id DESC LIMIT 80;\""],["/bin/zsh","-lc","sleep 20; AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/api/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq -r '.responses[] | select(.id==\"elementCodes\") | .content' | jq '.[] | select(.id==\"01a\")'"],["/bin/zsh","-lc","sleep 2; AUTH='REDACTED'; curl -sS -H \"Authorization: Bearer $AUTH\" \"http://localhost:3333/api/admin/workspace/11/responses/4egfhspe@fts5@4egfhspe@THD325_1_2/DSB002\" | jq -r '.responses[] | select(.id==\"elementCodes\") | .content' | jq '.[] | select(.id==\"01a\")'"],["curl","-LsS"],["docker","compose","--env-file",".env.dev","exec","-T","backend","sh","-lc","grep -Rns 'parseStoredResponseValue\\|value: WorkspaceTestResultsService.parseStoredResponseValue' /usr/src/coding-box-base 2>/dev/null | head -n 20"],["docker","compose","--env-file",".env.dev","exec","-T","backend","sh","-lc","pwd; rg -n 'parseStoredResponseValue|value: WorkspaceTestResultsService.parseStoredResponseValue' /app -S | head -n 20"],["docker","compose","--env-file",".env.dev","exec","-T","backend","sh","-lc","sed -n '670,740p' /usr/src/coding-box-base/dist/apps/backend/main.js"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT c.key AS chunk_key, c.type AS chunk_type, COUNT(*) AS rows_count, COUNT(DISTINCT c.unitid) AS unit_count FROM chunk c JOIN unit u ON u.id = c.unitid JOIN booklet b ON b.id = u.bookletid JOIN persons p ON p.id = b.personid WHERE p.workspace_id = 11 GROUP BY c.key, c.type ORDER BY c.key, c.type;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT conname, pg_get_constraintdef(c.oid) AS def FROM pg_constraint c JOIN pg_class t ON t.oid=c.conrelid WHERE t.relname='chunk';"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT p.workspace_id, COUNT(*) AS trailing_space_variableids FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE r.variableid <> btrim(r.variableid) GROUP BY p.workspace_id ORDER BY trailing_space_variableids DESC;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT r.id, u.id AS unitid, u.alias, r.variableid, r.status, r.subform, r.value FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.variableid='marking-panel_1' ORDER BY r.id;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT r.variableid, COUNT(*) AS cnt, min(left(r.value,80)) AS sample FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.variableid ILIKE '%mark%' GROUP BY r.variableid ORDER BY cnt DESC;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","WITH chunk_variable_map AS ( SELECT c.unitid, c.key AS chunk_key, trim(v.var) AS variableid FROM chunk c CROSS JOIN LATERAL regexp_split_to_table(coalesce(c.variables,''), ',') AS v(var) WHERE trim(v.var) <> '' ), mapped AS ( SELECT p.workspace_id, u.id AS unitid, u.alias AS unit_alias, u.name AS unit_name, r.id AS response_id, r.variableid, r.subform, cvm.chunk_key, COALESCE(cvm.chunk_key, r.subform, '') AS replay_group_id, CASE WHEN cvm.chunk_key IS NOT NULL THEN 'chunk.key' WHEN r.subform IS NOT NULL AND r.subform <> '' THEN 'subform-fallback' ELSE 'empty-fallback' END AS mapping_source FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid LEFT JOIN chunk_variable_map cvm ON cvm.unitid=r.unitid AND cvm.variableid=r.variableid ) SELECT workspace_id, unitid, unit_alias, unit_name, response_id, variableid, subform, chunk_key, replay_group_id FROM mapped WHERE mapping_source='empty-fallback' ORDER BY workspace_id, unitid, response_id LIMIT 120;"],["docker","compose