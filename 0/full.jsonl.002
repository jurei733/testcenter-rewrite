const protectedSystemCheckSignOutResponsePromise = page.waitForResponse(\n19874:  await fillAndCommitUntilValue(\"#contentReleaseId\", incompatibleReleaseId);\n19875:  await clickAction(\"Release Readiness\");\n20208:  await fillAndCommitUntilValue(\"#currentUnitKey\", \"unit-paused\");\n20409:    const responseCsvResponsePromise = page.waitForResponse(\n20434:    const reviewCsvResponsePromise = page.waitForResponse(\n20691:  const bulkPauseResponsePromise = page.waitForResponse(\n20715:  const bulkLockResponsePromise = page.waitForResponse(\n20738:  const bulkUnlockResponsePromise = page.waitForResponse(\n20765:  const bulkResumeResponsePromise = page.waitForResponse(\n20823:  const groupMonitorSignInResponsePromise = page.waitForResponse(\n20987:        .waitForResponse(\n21479:  const firstBlockGotoResponsePromise = page.waitForResponse(\n21508:  const nextBlockGotoResponsePromise = page.waitForResponse(\n21967:  await fillAndCommitUntilValue(\"#adminUsername\", adminUsername);\n21968:  await fillAndCommitUntilValue(\"#adminPassword\", adminPassword);\n21995:  await fillAndCommitUntilValue(\"#openRunLoginFilter\", participantLoginKey);\n22001:  const openRunsCsvResponsePromise = page.waitForResponse(\n23131:  const studentGroupDetailResponse = page.waitForResponse(\n23326:  await clickAction(\"Release Readiness\");\n23562:  await fillAndCommitUntilValue(\"#sourceFileName\", \"broken.json\");\n23563:  await fillAndCommitUntilValue(\"#sourceMediaType\", \"application/json\");\n23564:  await fillAndCommitUntilValue(\"#sourceDocument\", failedImportSourceDocument);\n23613:  const failedSourcePackageDetailResponsePromise = page.waitForResponse(\n23626:  await fillAndCommitUntilValue(\"#sourceFileName\", \"fixed.xml\");\n23627:  await fillAndCommitUntilValue(\"#sourceMediaType\", \"application/xml\");\n23629:  await fillAndCommitUntilValue(\"#sourceDocument\", repairedImportSourceDocument);\n23684:  const sortedSourcePackageResponse = page.waitForResponse(response => 