\",\\\"requestId\\\":\\\"8d687d16-8002-4dfe-9cfb-f6b1ad9f7285\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /api/v1/system/bug-report\\\",\\\"path\\\":\\\"/api/v1/system/bug-report\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":5.295,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.403Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"fa6eb44b-7d2b-48c0-963d-13c4ba7dcea0\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /api/v1/system/application-settings\\\",\\\"path\\\":\\\"/api/v1/system/application-settings\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":4.991,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.430Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"9e8301a0-804f-492f-b66e-f92ef3677c5c\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /api/v1/participant/sessions/:participantSessionId/current-state\\\",\\\"path\\\":\\\"/api/v1/participant/sessions/205acc6c-c890-4370-ad4c-06231aa0c865/current-state\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":14.62,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.440Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"0725462f-4a97-4c60-a5a6-b8f01ca1a02c\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /healthz\\\",\\\"path\\\":\\\"/healthz\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":9.852,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.443Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"5dade3d2-b6c3-4362-82cf-40a2cc6be34c\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /readyz\\\",\\\"path\\\":\\\"/readyz\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":2.807,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.458Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"4e5ce3af-42ef-42cb-805f-a418260f6816\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /manifest\\\",\\\"path\\\":\\\"/manifest\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":0.6,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.462Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"76473240-de4e-4b4f-b350-8a5c1ae2c866\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /metrics\\\",\\\"path\\\":\\\"/metrics\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":4.596,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.465Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"659403dd-664c-4eb8-8269-7a5012f24282\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /diagnostics/runtime\\\",\\\"path\\\":\\\"/diagnostics/runtime\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":1.687,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.465Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"20f88ab4-85ee-4d12-ac7f-156ede50eb88\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /diagnostics/config\\\",\\\"path\\\":\\\"/diagnostics/config\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":0.11,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.476Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"b4f914fc-6fcf-4796-b428-ac8eafe2ba25\\\",\\\"method\\\":\\\"GET\\\",\\\"route\\\":\\\"GET /api/v1/participant/sessions/:participantSessionId/current-state\\\",\\\"path\\\":\\\"/api/v1/participant/sessions/205acc6c-c890-4370-ad4c-06231aa0c865/current-state\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":9.119,\\\"storageKind\\\":\\\"sqlite\\\"}\\n{\\\"timestamp\\\":\\\"2026-08-29T19:13:13.516Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"f0a9a497-ddb9-4879-8b98-19caf3c2d90a\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/participant/test-runs/:testRunId/test-logs\\\",\\\"path\\\":\\\"/api/v1/participant/test-runs/e94e1fb6-a8d9-4dce-ba44-3822ea1c0f88/test-logs\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":18.732,\\\"storageKind\\\":\\\"sqlite\\\"}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04e66-c772-7170-b7f2-4f6daa7e2bfb","create_time":1788030793.688734}}}
