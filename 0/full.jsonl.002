ponse) => {\\n 12955\\t    const expected = starsReloadResponses[unitKey];\\n 12956\\t    if (response === expected) {\\n 12957\\t      return true;\\n 12958\\t    }\\n 12959\\t    if (unitKey !== \\\"2\\\" || typeof response !== \\\"string\\\") {\\n 12960\\t      return false;\\n 12961\\t    }\\n 12962\\t    try {\\n 12963\\t      return JSON.stringify(JSON.parse(response)) ===\\n 12964\\t        JSON.stringify(JSON.parse(expected));\\n 12965\\t    } catch {\\n 12966\\t      return false;\\n 12967\\t    }\\n 12968\\t  };\\n 12969\\t  const parallelStarsReloadResponses = Object.fromEntries(\\n 12970\\t    starsUnitKeys.map((unitKey, index) => [\\n 12971\\t      unitKey,\\n 12972\\t      `${starsBaseResponse}\\\\n${\\\" \\\".repeat(index + 151)}`\\n 12973\\t    ])\\n 12974\\t  );\\n 12975\\t  const matchesParallelStarsReloadResponse = (unitKey, response) => {\\n 12976\\t    const expected = parallelStarsReloadResponses[unitKey];\\n 12977\\t    if (response === expected) {\\n 12978\\t      return true;\\n 12979\\t    }\\n 12980\\t    if (unitKey !== \\\"1\\\" || typeof response !== \\\"string\\\") {\\n 12981\\t      return false;\\n 12982\\t    }\\n 12983\\t    try {\\n 12984\\t      return JSON.stringify(JSON.parse(response)) ===\\n 12985\\t        JSON.stringify(JSON.parse(expected));\\n 12986\\t    } catch {\\n 12987\\t      return false;\\n 12988\\t    }\\n 12989\\t  };\\n 12990\\t  const starsSaveProgressUrl =\\n 12991\\t    `${baseUrl}/api/v1/participant/test-runs/${starsTestRunId}/save-progress`;\\n 12992\\t  const parallelStarsSaveProgressUrl =\\n 12993\\t    `${baseUrl}/api/v1/participant/test-runs/${parallelStarsTestRunId}/save-progress`;\\n 12994\\t  await page.evaluate(async () => {\\n 12995\\t    const registrations = await navigator.serviceWorker.getRegistrations();\\n 12996\\t    await Promise.all(registrations.map(registration => registration.unregister()));\\n 12997\\t  });\\n 12998\\t  const abortStarsSaveProgress = route => route.abort(\\\"failed\\\");\\n 12999\\t  await page.route(starsSaveProgressUrl, abortStarsSaveProgress);\\n 13000\\t  await page.evaluate(\\n 13001\\t    ({ storageKey, runs }) => {\\n 13002\\t      const queuedAt = Date.now();\\n 13003\\t      localStorage.setItem(\\n 13004\\t        storageKey,\\n 13005\\t        JSON.stringify({\\n 13006\\t          version: 1,\\n 13007\\t          entries: runs.flatMap((run, runIndex) =>\\n 13008\\t            Object.entries(run.responses).map(\\n 13009\\t              ([unitKey, response], index) => ({\\n 13010\\t                version: 1,\\n 13011\\t                deliveryId:\\n 13012\\t                  `stars-reload-${runIndex + 1}-${unitKey}-${queuedAt}`,\\n 13013\\t                testRunId: run.testRunId,\\n 13014\\t                unitKey,\\n 13015\\t                response,\\n 13016\\t                status: \\\"running\\\",\\n 13017\\t                logs: [],\\n 13018\\t                queuedAt: new Date(\\n 13019\\t                  queuedAt +\\n 13020\\t                    runIndex * 1_000 +\\n 13021\\t                    (unitKey === run.currentUnitKey ? 100 : index)\\n 13022\\t                ).toISOString()\\n 13023\\t              })\\n 13024\\t            )\\n 13025\\t          )\\n 13026\\t        })\\n 13027\\t      );\\n 13028\\t    },\\n 13029\\t    {\\n 13030\\t      storageKey: \\\"testcenter-rewrite:participant-save-outbox:v1\\\",\\n 13031\\t      runs: [\\n 13032\\t        {\\n 13033\\t          testRunId: starsTestRunId,\\n 13034\\t          currentUnitKey: \\\"2\\\",\\n 13035\\t          responses: starsReloadResponses\\n 13036\\t        },\\n 13037\\t        {\\n 13038\\t          testRunId: parallelStarsTestRunId,\\n 13039\\t          currentUnitKey: \\\"1\\\",\\n 13040\\t          responses: parallelStarsReloadResponses\\n 13041\\t        }\\n 13042\\t      ]\\n 13043\\t    }\\n 13044\\t  );\\n 13045\\t  const blockedStarsReloadSavePromise = page.waitForRequest(\\n 13046\\t    request =>\\n 13047\\t      request.method() === \\\"POST\\\" && request.url() === starsSaveProgressUrl\\n 13048\\t  );\\n 13049\\t  await page.reload({ waitUntil: \\\"domcontentloaded\\\" });\\n 13050\\t  await blockedStarsReloadSavePromise;\\n 13051\\t  await page\\n 13052\\t    .locator(\\\"#participantVeronaPlayerVersion\\\")\\n 13053\\t    .filter({ hasText: `API ${starsPlayerPackage.player.playerApiVersion}` })\\n 13054\\t    .waitFor({ timeout: 30_000 });\\n 13055\\t  const restoredStarsReloadOutbox = await page.evaluate(storageKey => {\\n 13056\\t    const stored = JSON.parse(localStorage.getItem(storageKey) ?? \\\"null\\\");\\n 13057\\t    return stored?.entries ?? [];\\n 13058\\t  }, \\\"testcenter-rewrite:participant-save-outbox:v1\\\");\\n 13059\\t  assert.equal(\\n 13060\\t    restoredStarsReloadOutbox.length,\\n 13061\\t    starsUnitKeys.length * 2,\\n 13062\\t    \\\"A hard reload must retain every pending Unit from both STARS runs.\\\"\\n 13063\\t  );\\n 13064\\t  for (const [testRunId, responseMatches] of [\\n 13065\\t    [starsTestRunId, matchesStarsReloadResponse],\\n 13066\\t    [parallelStarsTestRunId, matchesParallelStarsReloadResponse]\\n 13067\\t  ]) {\\n 13068\\t    const restoredRunEntries = restoredStarsReloadOutbox.filter(\\n 13069\\t      entry => entry.testRunId === testRunId\\n 13070\\t    );\\n 13071\\t    assert.deepEqual(\\n 13072\\t      restoredRunEntries\\n 13073\\t        .map(entry => entry.unitKey)\\n 13074\\t        .sort((left, right) => Number(left) - Number(right)),\\n 13075\\t      starsUnitKeys,\\n 13076\\t      `Hard reload must retain the complete isolated run ${testRunId}.`\\n 13077\\t    );\\n 13078\\t    assert.ok(\\n 13079\\t      restoredRunEntries.every(entry =>\\n 13080\\t        responseMatches(entry.unitKey, entry.response)\\n 13081\\t      ),\\n 13082\\t      `Hard reload must preserve the responses for run ${testRunId}.`\\n 13083\\t    );\\n 13084\\t  }\\n 13085\\t  const mismatchedStarsReloadEntries = restoredStarsReloadOutbox\\n 13086\\t    .filter(entry =>\\n 13087\\t      entry.testRunId === starsTestRunId &&\\n 13088\\t      !matchesStarsReloadResponse(entry.unitKey, entry.response)\\n 13089\\t    )\\n 13090\\t    .map(entry => ({\\n 13091\\t      unitKey: entry.unitKey,\\n 13092\\t      expectedLength: starsReloadResponses[entry.unitKey]?.length ?? null,\\n 13093\\t      actualLength: entry.response.length,\\n 13094\\t      semanticallyEqual: (() => {\\n 13095\\t        try {\\n 13096\\t          return JSON.stringify(JSON.parse(entry.response)) ===\\n 13097\\t            JSON.stringify(JSON.parse(starsReloadResponses[entry.unitKey]));\\n 13098\\t        } catch {\\n 13099\\t          return false;\\n 13100\\t        }\\n 13101\\t      })()\\n 13102\\t    }));\\n 13103\\t  assert.deepEqual(\\n 13104\\t    mismatchedStarsReloadEntries,\\n 13105\\t    [],\\n 13106\\t    \\\"A hard reload must preserve all inactive responses exactly and the active Player state semantically.\\\"\\n 13107\\t  );\\n 13108\\t  const starsReloadSaveOrder = [];\\n 13109\\t  const observedStarsReloadResponses = new Set();\\n 13110\\t  const recordStarsReloadSaveOrder = response => {\\n 13111\\t    const request = response.request();\\n 13112\\t    if (\\n 13113\\t      response.status() !== 200 ||\\n 13114\\t      request.method() !== \\\"POST\\\" ||\\n 13115\\t      request.url() !== starsSaveProgressUrl\\n 13116\\t    ) {\\n 13117\\t      return;\\n 13118\\t    }\\n 13119\\t    const requestBody = request.postDataJSON();\\n 13120\\t    const responseUnitKey = requestBody?.responseUnitKey;\\n 13121\\t    if (\\n 13122\\t      typeof responseUnitKey !== \\\"string\\\" ||\\n 13123\\t      !matchesStarsReloadResponse(responseUnitKey, requestBody?.unitResponse) ||\\n 13124\\t      observedStarsReloadResponses.has(responseUnitKey)\\n 13125\\t    ) {\\n 13126\\t      return;\\n 13127\\t    }\\n 13128\\t    observedStarsReloadResponses.add(responseUnitKey);\\n 13129\\t    starsReloadSaveOrder.push(responseUnitKey);\\n 13130\\t  };\\n 13131\\t  page.on(\\\"response\\\", recordStarsReloadSaveOrder);\\n 13132\\t  await page.unroute(starsSaveProgressUrl, abortStarsSaveProgress);\\n 13133\\t  await page.evaluate(() => window.dispatchEvent(new Event(\\\"online\\\")));\\n 13134\\t  await pollJsonWithPredicate(\\n 13135\\t    `${baseUrl}/api/v1/participant/sessions/${starsParticipantSessionId}/current-state`,\\n 13136\\t    payload =>\\n 13137\\t      starsUnitKeys.every(\\n 13138\\t        unitKey =>\\n 13139\\t          matchesStarsReloadResponse(\\n 13140\\t            unitKey,\\n 13141\\t            payload?.currentRunState?.testRun?.unitResponses?.[unitKey]\\n 13142\\t          )\\n 13143\\t      ),\\n 13144\\t    45_000\\n 13145\\t  );\\n 13146\\t  await page.waitForFunction(\\n 13147\\t    ({ storageKey, retainedTestRunId, expectedCount }) => {\\n 13148\\t      const stored = JSON.parse(localStorage.getItem(storageKey) ?? \\\"null\\\");\\n 13149\\t      return stored?.entries?.length === expectedCount &&\\n 13150\\t        stored.entries.every(entry => entry.testRunId === retainedTestRunId);\\n 13151\\t    },\\n 13152\\t    {\\n 13153\\t      storageKey: \\\"testcenter-rewrite:participant-save-outbox:v1\\\",\\n 13154\\t      retainedTestRunId: parallelStarsTestRunId,\\n 13155\\t      expectedCount: starsUnitKeys.length\\n 13156\\t    },\\n 13157\\t    { timeout: 30_000 }\\n 13158\\t  );\\n 13159\\t  page.off(\\\"response\\\", recordStarsReloadSaveOrder);\\n 13160\\t  assert.equal(\\n 13161\\t    starsReloadSaveOrder[0],\\n 13162\\t    \\\"2\\\",\\n 13163\\t    \\\"Hard-reload recovery must deliver the visible STARS Unit first.\\\"\\n 13164\\t  );\\n 13165\\t  assert.deepEqual(\\n 13166\\t    [...new Set(starsReloadSaveOrder)].sort(\\n 13167\\t      (left, right) => Number(left) - Number(right)\\n 13168\\t    ),\\n 13169\\t    starsUnitKeys,\\n 13170\\t    \\\"Hard-reload recovery must deliver every Unit in the STARS booklet.\\\"\\n 13171\\t  );\\n 13172\\t  const parallelStarsReloadSaveOrder = [];\