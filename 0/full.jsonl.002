(var(--accent-rgb) / 0.22), transparent 24%),\n    radial-gradient(circle at top right, rgb(var(--secondary-rgb) / 0.18), transparent 28%),\n    linear-gradient(180deg, var(--bg-start) 0%, var(--bg) 100%);\n}\n\napp-root {\n  display: block;\n}\n\n.page {\n  max-width: 1440px;\nrewrite-app/apps/web/src/styles.css:57:  box-sizing: border-box;\nrewrite-app/apps/web/src/app/confirmation-dialog.component.ts:118:      box-sizing: border-box;\nrewrite-app/apps/web/src/app/system-check-save-report-dialog.component.ts:113:      box-sizing: border-box;\nrewrite-app/apps/web/src/app/runtime-view.component.ts:13:  selector: \"app-runtime-view\",\nrewrite-app/apps/web/src/app/runtime-view.component.ts:246:      <app-attachment-manager\nrewrite-app/apps/web/src/app/runtime-view.component.ts:252:      ></app-attachment-manager>\nrewrite-app/apps/web/src/app/attachment-manager.component.ts:12:  selector: \"app-attachment-manager\",\nrewrite-app/apps/web/src/app/attachment-manager.component.ts:31:    <article id=\"attachmentManagerCard\" class=\"card\">\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04e66-c772-7170-b7f2-4f6daa7e2bfb","create_time":1788034723.800047}}}
