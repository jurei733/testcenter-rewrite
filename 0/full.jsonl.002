 ORDER BY trailing_space_variableids DESC;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT r.id, u.id AS unitid, u.alias, r.variableid, r.status, r.subform, r.value FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.variableid='marking-panel_1' ORDER BY r.id;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","SELECT r.variableid, COUNT(*) AS cnt, min(left(r.value,80)) AS sample FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid WHERE p.workspace_id=11 AND r.variableid ILIKE '%mark%' GROUP BY r.variableid ORDER BY cnt DESC;"],["docker","compose","--env-file",".env.dev","exec","-T","db","psql","-U","root","-d","coding-box","-P","pager=off","-c","WITH chunk_variable_map AS ( SELECT c.unitid, c.key AS chunk_key, trim(v.var) AS variableid FROM chunk c CROSS JOIN LATERAL regexp_split_to_table(coalesce(c.variables,''), ',') AS v(var) WHERE trim(v.var) <> '' ), mapped AS ( SELECT p.workspace_id, u.id AS unitid, u.alias AS unit_alias, u.name AS unit_name, r.id AS response_id, r.variableid, r.subform, cvm.chunk_key, COALESCE(cvm.chunk_key, r.subform, '') AS replay_group_id, CASE WHEN cvm.chunk_key IS NOT NULL THEN 'chunk.key' WHEN r.subform IS NOT NULL AND r.subform <> '' THEN 'subform-fallback' ELSE 'empty-fallback' END AS mapping_source FROM response r JOIN unit u ON u.id=r.unitid JOIN booklet b ON b.id=u.bookletid JOIN persons p ON p.id=b.personid LEFT JOIN chunk_variable_map cvm ON cvm.unitid=r.unitid AND cvm.variableid=r.variableid ) SELECT workspace_id, unitid, unit_alias, unit_name, response_id, variableid, subform, chunk_key, replay_group_id FROM mapped WHERE mapping_source='empty-fallback' ORDER BY workspace_id, unitid, response_id LIMIT 120;"],["docker","compose