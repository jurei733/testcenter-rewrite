t      return stored?.entries?.length === expectedCount &&\n 13658\t        stored.entries.every(\n 13659\t          entry => !deliveredUnitKeys.includes(entry.unitKey)\n 13660\t        );\n 13661\t    },\n 13662\t    {\n 13663\t      storageKey: \"testcenter-rewrite:participant-save-outbox:v1\",\n 13664\t      deliveredUnitKeys: [...permittedStarsMidDrainUnits],\n 13665\t      expectedCount: starsUnitKeys.length - permittedStarsMidDrainUnits.size\n 13666\t    },\n 13667\t    { timeout: 30_000 }\n 13668\t  );\n 13669\t  const restoredStarsMidDrainEntries = await page.evaluate(storageKey => {\n 13670\t    const stored = JSON.parse(localStorage.getItem(storageKey) ?? \"null\");\n 13671\t    return stored?.entries ?? [];\n 13672\t  }, \"testcenter-rewrite:participant-save-outbox:v1\");\n 13673\t  const expectedStarsMidDrainUnitKeys = starsUnitKeys.filter(\n 13674\t    unitKey => !permittedStarsMidDrainUnits.has(unitKey)\n 13675\t  );\n 13676\t  assert.deepEqual(\n 13677\t    restoredStarsMidDrainEntries\n 13678\t      .map(entry => entry.unitKey)\n 13679\t      .sort((left, right) => Number(left) - Number(right)),\n 13680\t    expectedStarsMidDrainUnitKeys,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04e66-c772-7170-b7f2-4f6daa7e2bfb","create_time":1788032827.091663}}}
