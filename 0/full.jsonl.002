t 0; fi; exec entire hooks codex stop'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SubagentStart\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex subagent-start'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"SubagentStop\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex subagent-stop'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"matcher\": null,\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks codex user-prompt-submit'\",\n            \"timeout\": 30\n          }\n        ]\n      }\n    ]\n  }\n}\nImporting Codex session 1/2 (0 turns)...\nImporting Codex session 2/2 (0 turns)...\nWould import 0 turn(s) from 2 session(s) (0 already imported).\nEntire's CLI is the source of truth for its own usage. Do not guess flags or\nsubcommands — read them from this command. You are already inside the repo:\nentire auto-detects it from the git origin remote, so never ask the user for the\nrepo name. Pass --repo only to target a DIFFERENT repo.\n\nCurrent repo: gh/jurei733/testcenter-rewrite  (auto-detected from origin; pass --repo only for a DIFFERENT repo)\n\nWhen to use entire — the commands that bear on the work:\n  checkpoint  Inspect and search checkpoints\n                task-driven\n  search      Search checkpoints, commits, and sessions using semantic and keyword matching\n                read-only\n  session     Manage agent sessions tracked by Entire\n                read-only except: adopt, attach, resume, stop\n  status      Show Entire status\n                read-only\n  why         Show why a line exists\n                read-only\n\nAlso available (entire agent-help <command> for any of these):\n  read-only, safe to run:\n    activity · labs · recap · version\n  when the task needs them:\n    api · dispatch · doctor\n  the user's — suggest, don't run:\n    agent · auth · clean · configure · disable · enable · grant\n    login · logout · org · plugin · project · repo\n\nDrill in for exact, currently-installed flags:  entire agent-help <command>  (e.g. entire agent-help checkpoint)\nAdd --json for structured output.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a04e66-c772-7170-b7f2-4f6daa7e2bfb","create_time":1788036329.335299}}}
