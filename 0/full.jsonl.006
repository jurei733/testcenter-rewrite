`);\\n  response.write(`event: ${event.eventType}\\\\n`);\\n  response.write(`data: ${JSON.stringify(event)}\\\\n\\\\n`);\\n};\\n\\nconst streamParticipantEvents = async (input: {\\n  request: IncomingMessage;\\n  response: ServerResponse;\\n  participantRuntime: FirstSliceServices[\\\"participantRuntime\\\"];\\n  participantSessionId: string;\\n  testRunId?: string;\\n  validateAccess: () =\u003e Promise\u003cunknown\u003e;\\n}): Promise\u003cvoid\u003e =\u003e {\\n  await input.validateAccess();\\n  const initialState = await input.participantRuntime.getCurrentRunState({\\n    participantSessionId: input.participantSessionId,\\n    testRunId: input.testRunId\\n  });\\n  let testRunId = initialState.testRun.testRunId;\\n  const connectionId = randomUUID();\\n  const register = () =\u003e input.participantRuntime.updateConnection({\\n4207:const PARTICIPANT_EVENT_STREAM_POLL_INTERVAL_MS = 1_000;\\n4353:  }, PARTICIPANT_EVENT_STREAM_POLL_INTERVAL_MS);\\n  duration_ms: 653.648041\\n  type: 'test'\\n  ...\\n1..163\\n# tests 163\\n# suites 0\\n# pass 163\\n# fail 0\\n# cancelled 0\\n# skipped 0\\n# todo 0\\n# duration_ms 75860.871375\\n  duration_ms: 207.348125\\n  type: 'test'\\n  ...\\n# {\\\"timestamp\\\":\\\"2026-10-05T07:16:14.767Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"135f61a3-8248-42e0-8355-fe64cbcec22f\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/platform/tenants\\\",\\\"path\\\":\\\"/api/v1/platform/tenants\\\",\\\"statusCode\\\":201,\\\"durationMs\\\":17.861,\\\"storageKind\\\":\\\"file\\\"}\\n# {\\\"timestamp\\\":\\\"2026-10-05T07:16:14.807Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"79c79a04-01d5-4bd8-8834-1b2de3c2355a\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/tenants/:tenantKey/workspaces\\\",\\\"path\\\":\\\"/api/v1/tenants/integration-tenant-zip-booklet-file/workspaces\\\",\\\"statusCode\\\":201,\\\"durat