','Gamma Booklet'];\n  let auth={token:'owned-source-rendering-fixture',displayName:'starter-reference',loginName:'starter-reference',groupLabel:'Reference',customTexts:{},flags:[],groupToken:null,viewSettings:{},claims:{test:booklets.map((label,index)=>({label,id:'reference-'+index,type:'test',flags:{},workspaceId:'reference',description:''}))}};\n  const fixture=createServer(async(req,res)=>{try{\n    const path=new URL(req.url,'http://localhost').pathname;\n    if(path.startsWith('/api/')){\n      let value;\n      if(path==='/api/system/config')value={version:'Rewrite',customTexts:{},appConfig:{appTitle:'IQB-Testcenter',themeName:theme},baseUrl:'/',bruteForceProtection:[],broadcastingServiceUri:'/bs/',fileServiceUri:'/fs/'};\n      else if(path==='/api/sys-check-mode')value=false;\n      else if(path==='/api/asset-assignments')value={};\n      else if(path==='/api/assets')value=[];\n      else if(path==='/api/system/time')value={timestamp:Date.now(),timezone:'Europe/Berlin'};\n      else if(path==='/api/session/login'&&req.method==='PUT'){for await(const c of req){}value=auth;}\n      else if(path==='/api/session'&&req.method==='GET')value=auth;\n      else{unknown.push(req.method+' '+path);res.writeHead(404);res.end('{}');return;}\n      res.writeHead(200,{'content-type':'application/json','cache-control':'no-store'});res.end(JSON.stringify(value));return;\n    }\n    const file=path==='/'?join(sourceDist,'index.html'):resolve(sourceDist,'.'+path);assert.ok(file.startsWith(sourceDist+'/'));\n    const value=await readFile(file);res.writeHead(200,{'content-type':{'.html':'text/html','.js':'text/javascript','.css':'text/css','.woff2':'font/woff2','.woff':'font/woff','.ttf':'font/ttf','.svg':'image/svg+xml','.png':'image/png','.json':'application/json'}[extname(file)]||'application/octet-stream'});res.end(value);\n  }catch{res.writeHead(404);res.end('Missing');}});\n  await new Promise(done=>fixture.listen(0,'127.0.0.1',done));const SOURCE_URL='http://127.0.0.1:'+