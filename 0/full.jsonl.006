\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"1a6196\",\"wall_time_seconds\":0.000008417,\"exit_code\":0,\"original_token_count\":359,\"output\":\"/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1381:ui_smoke_step=action-rename-workspace-start\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1386:ui_smoke_step=action-rename-workspace-done\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1398:ui_smoke_step=action-refresh-workspace-directory-start\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1400:ui_smoke_step=action-refresh-workspace-directory-done\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1401:ui_smoke_step=workspace-delete\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1404:ui_smoke_step=action-refresh-workspace-directory-start\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1406:ui_smoke_step=action-refresh-workspace-directory-done\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1407:ui_smoke_step=action-workspace-directory-disposable-workspace-start\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1409:ui_smoke_step=action-workspace-directory-disposable-workspace-done\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1417:ui_smoke_step=action-workspace-directory-renamed-workspace-1791354785585-start\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1419:ui_smoke_step=action-workspace-directory-renamed-workspace-1791354785585-done\\n/tmp/testcenter-entry-link-full-memory-chrome-20261007.log:1420:ui_smoke_step=nav-ops-admin-management\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"034970\",\"wall_time_seconds\":30.002752,\"session_id\":40785,\"original_token_count\":0,\"output\":\"\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11505-6069-7411-b5ab-e7c10a97a630","create_time":1791354818.603304}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
