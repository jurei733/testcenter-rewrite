aces/ui-workspace-1791355353706/activity-events\",\"statusCode\":200,\"durationMs\":1.157,\"storageKind\":\"sqlite\"}\n{\"timestamp\":\"2026-10-07T06:51:19.303Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"9390e0c9-e569-44d7-a397-aabe05c9bd2c\",\"method\":\"GET\",\"route\":\"GET /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/participant-roster\",\"path\":\"/api/v1/tenants/ui-tenant-1791355353706/workspaces/ui-workspace-1791355353706/participant-roster\",\"statusCode\":200,\"durationMs\":133.167,\"storageKind\":\"sqlite\"}\nui_smoke_step=action-study-monitor-group:student-ui-start\n{\"timestamp\":\"2026-10-07T06:51:19.552Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"f7bfccc2-e8c4-4d49-a108-86054b00f4f5\",\"method\":\"GET\",\"route\":\"GET /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/study-monitor/participants/:loginKey\",\"path\":\"/api/v1/tenants/ui-tenant-1791355353706/workspaces/ui-workspace-1791355353706/study-monitor/participants/entry-student-a\",\"statusCode\":200,\"durationMs\":248.032,\"storageKind\":\"sqlite\"}\n{\"timestamp\":\"2026-10-07T06:51:19.714Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"d65752df-973f-431b-913c-1ce03a34651f\",\"method\":\"GET\",\"route\":\"GET /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/study-monitor/groups/:groupKey\",\"path\":\"/api/v1/tenants/ui-tenant-1791355353706/workspaces/ui-workspace-1791355353706/study-monitor/groups/group%3Astudent-ui\",\"statusCode\":200,\"durationMs\":161.668,\"storageKind\":\"sqlite\"}\nui_smoke_step=action-study-monitor-group:student-ui-done\n{\"timestamp\":\"2026-10-07T06:51:22.270Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"4719f0da-f44c-4553-ab43-339574a39437\",\"method\":\"GET\",\"route\":\"GET /api/v1/tenants/:tenantKey/workspaces/:workspaceKey\",\"path\":\"/api/v1/tenants/ui-tenant-1791355353706/workspaces/ui-workspace-1791355353706\",\"statusCode\":200,\"d