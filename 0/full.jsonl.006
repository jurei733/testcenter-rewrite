ulian/code/testcenter-rewrite/rewrite-app';\\nconst FRONTEND_ROOT=process.env.UI_SMOKE_FRONTEND_ROOT||'/tmp/testcenter-presence-production-final';\\n(async()=>{\\n  assert.equal(execFileSync('git',['rev-parse','HEAD'],{cwd:SOURCE_ROOT,encoding:'utf8'}).trim(),'c35cff81383949b4664e0fdffa3ba1154d144d9d');\\n  assert.equal(execFileSync('git',['status','--porcelain','--untracked-files=no'],{cwd:SOURCE_ROOT,encoding:'utf8'}).trim(),'');\\n  const artifacts=await mkdtemp('/tmp/testcenter-original-starter-reference-');console.log('owned_artifacts='+artifacts);\\n  const sourceDist=join(SOURCE_ROOT,'frontend/dist/testcenter-frontend/browser');\\n  let theme='Primar';const unknown=[],errors=[];\\n  const booklets=['Alpha Booklet','Beta Booklet','Gamma Booklet'];\\n  let auth={token:'owned-source-rendering-fixture',displayName:'starter-reference',loginName:'starter-reference',groupLabel:'Reference',customTexts:{},flags:[],groupToken:null,viewSettings:{},claims:{test:booklets.map((label,index)=>({label,id:'reference-'+index,type:'test',flags:{},workspaceId:'reference',description:''}))}};\\n  const fixture=createServer(async(req,res)=>{try{\\n    const path=new URL(req.url,'http://localhost').pathname;\\n    if(path.startsWith('/api/')){\\n      let value;\\n      if(path==='/api/system/config')value={version:'Rewrite',customTexts:{},appConfig:{appTitle:'IQB-Testcenter',themeName:theme},baseUrl:'/',bruteForceProtection:[],broadcastingServiceUri:'/bs/',fileServiceUri:'/fs/'};\\n      else if(path==='/api/sys-check-mode')value=false;\\n      else if(path==='/api/asset-assignments')value={};\\n      else if(path==='/api/assets')value=[];\\n      else if(path==='/api/system/time')value={timestamp:Date.now(),timezone:'Europe/Berlin'};\\n      else if(path==='/api/session/login'&&req.method==='PUT'){for await(const c of req){}value=auth;}\\n      else if(path==='/api/session'&&req.method==='GET')value=auth;\\n      else{unknown.push(req.method+' '+path);res.writeHead(404);res.end('{}');return;}\\n      res.writeHead(200,{'content-type':'application/json','cache-control':'no-store'});res.end(JSON.stringify(value));return;\\n    }\\n    const file=path==='/'?join(sourceDist,'index.html'):resolve(sourceDist,'.'+path);assert.ok(file.startsWith(sourceDist+'/'));\\n    const value=await readFile(file);res.writeHead(200,{'content-type':{'.html':'text/html','.js':'text/javascript','.css':'text/css','.woff2':'font/woff2','.woff':'font/woff','.ttf':'font/ttf','.svg':'image/svg+xml','.png':'image/png','.json':'application/json'}[extname(file)]||'application/octet-stream'});res.end(value);\\n  }catch{res.writeHead(404);res.end('Missing');}});\\n  await new Promise(done=>fixture.listen(0,'127.0.0.1',done));const SOURCE_URL='http://127.0.0.1:'+fixture.address().port;\\n  const moduleUrl=pathToFileURL(join(REWRITE_ROOT,'apps/api/dist/apps/api/src/index.js')).href;\\n  const server=spawn(process.execPath,['--input-type=module','-e',`import{createProductionApiServer}from${JSON.stringify(moduleUrl)};const s=await createProductionApiServer();s.listen(0,'127.0.0.1',()=>process.send({port:s.address().port}));process.once('SIGTERM',()=>s.close(()=>process.exit(0)));`],{cwd:FRONTEND_ROOT,stdio:['ignore','ignore','inherit','ipc'],env:{...process.env,PORT:'4310',FIRST_SLICE_STORE:'sqlite',FIRST_SLICE_SQLITE_FILE:join(artifacts,'store.sqlite'),FIRST_SLICE_BOOTSTRAP_DEMO:'true',FIRST_SLICE_OPERATOR_AUTH_REQUIRED:'true',FIRST_SLICE_PROOF_OF_WORK_SCOPES:'',FIRST_SLICE_XML_SCHEMA_PROFILE:'legacy-compatibility'}});\\n  let browser,TARGET_URL,token;const metrics={};\\n  const api=async(path,body,method=body===undefined?'GET':'POST')=>{const r=await fetch(TARGET_URL+path,{method,headers:{'content-type':'application/json',...(token?{authorization:'Bearer '+token}:{})},...(body===undefined?{}:{body:JSON.stringify(body)})});if(!r.ok){const error=await r.json();throw Error(`${method} ${path}:${r.status} ${JSON.stringify(error.error||error)}`)}return r.json();};\\n  try{\\n    const port=await new Promise((done,reject)=>{const t=setTimeout(()=>reject(Error('Owned API startup timeout')),20000);server.once('message',m=>{clearTimeout(t);done(m.port)});server.once('error',e=>{clearTimeout(t);reject(e)});server.once('exit',()=>{clearTimeout(t);reject(Error('Owned API exited'))})});TARGET_URL='http://127.0.0.1:'+port;\\n    token=(await api('/api/v1/admin/auth/sign-in',{username:'demo-admin',password:'REDACTED'})).sessionToken;\\n    const configurations=process.env.REFERENCE_FULL?['fresh','mixed','long','review']:['fresh'];\\n    const fixtures={};\\n    const customTexts={booklet_starterStartTestButtonLabel:'Los geht’s',booklet_starterContinueTestButtonLabel:'Jetzt fortsetzen',booklet_starterLockedTestButtonLabel:'Teil abgeschlossen'};\\n    for(const state of configurations){\\n      const labels=state==='long'?['Eine längere Bezeichnung mit mehreren Worten, die die verfügbare Breite der Original-Karte überschreitet und vollständig umbricht.', 'UntrennbaresTestheft'+ 'a'.repeat(140),'Gamma Booklet']:booklets;\\n      const workspaceKey='starter-reference-'+state;\\n      await api('/api/v1/tenants/demo-tenant/workspaces',{workspaceKey,displayName:'Starter '+state});\\n      const workspace='/api/v1/tenants/demo-tenant/workspaces/'+workspaceKey;\\n      const source=await api(workspace+'/source-packages',{fileName:'starter-reference.json',mediaType:'application/json',contentStructure:{bookletEntries:labels.map((displayLabel,index)=>({bookletKey:'reference-'+index,displayLabel,unitEntries:[{unitKey:'reference-unit-'+index,displayLabel:'Unit '+index}]}))}});\\n      const imported=await api(workspace+'/import-jobs',{sourcePackageId:source.sourcePackage.sourcePackageId});\\n      await api(workspace+'/content-releases/'+imported.stagedContentRelease.contentReleaseId+'/activate',{activatedByActorId:'owned-starter-reference'});\\n      const texts=state==='mixed'?customTexts:{};\\n      await api(workspace+'/participant-roster',{rosterText:'<Testtakers><CustomTexts>'+Object.entries(texts).map(([key,value])=>`<CustomText key=\\\"${key}\\\">${value}</CustomText>`).join('')+'</CustomTexts><Group id=\\\"reference\\\" label=\\\"Reference\\\"><Login mode=\\\"'+(state==='review'?'run-review':'run-hot-return')+'\\\" name=\\\"starter-reference\\\">'+labels.map((_,index)=>`<Booklet>reference-${index}</Booklet>`).join('')+'</Login></Group></Testtakers>'});\\n      if(state==='mixed'){\\n        const operatorToken=token;\\n        const session=await api('/api/v1/participant/auth/sign-in',{tenantKey:'demo-tenant',workspaceKey,loginKey:'starter-reference'});\\n        token=session.sessionToken;\\n        const second=await api('/api/v1/participant/sessions/'+session.participantSession.participantSessionId+'/resume',{bookletKey:'reference-1'});\\n        await api('/api/v1/participant/test-runs/'+second.testRun.testRunId+'/save-progress',{currentUnitKey:'reference-unit-1',unitResponse:'Owned exact starter reference answer',status:'running'});\\n        await api('/api/v1/participant/test-runs/'+second.testRun.testRunId+'/complete',{});\\n        const first=await api('/api/v1/participant/sessions/'+session.participantSession.participantSessionId+'/resume',{bookletKey:'reference-0'});\\n        await api('/api/v1/participant/test-runs/'+first.testRun.testRunId+'/return-to-starter',{});\\n        token=operatorToken;\\n      }\\n      fixtures[state]={workspaceKey,labels,texts};\\n    }\\n    browser=await chromium.launch({headless:false});\\n    for(theme of(process.env.REFERENCE_QUICK?['Primar']:['Primar','Sekundar','Erwachsene'])){\\n      await api('/api/v1/admin/application-settings',{themeName:theme},'PATCH');\\n      for(const state of configurations){\\n        const {workspaceKey,labels,texts}=fixtures[state];\\n        auth={...auth,customTexts:texts,claims:{test:labels.map((label,index)=>({label,id:'reference-'+index,type:'test',flags:state==='mixed'?index===0?{running:true}:index===1?{locked:true}:{}:{},workspaceId:'reference',description:''})),...(state==='review'?{review:[]}: {})}};\\n      for(const[screen,width,height]of(process.env.REFERENCE_FULL?[['desktop',1280,720],['mobile',390,844],['toolbar-small',599,844],['toolbar-large',600,844]]:[['desktop',1280,720],['mobile',390,844]]))for(const target of['source','rewrite']){\\n        const context=await browser.newContext({viewport:{width,height},locale:'de-DE',timezoneId:'Europe/Berlin'});const page=await context.newPage();\\n        page.on('pageerror',e=>errors.push(target+':'+e));\\n        await page.goto(target==='source'?SOURCE_URL+'/#/r/login':TARGET_URL+'/app/participant?ui=original&tenantKey=demo-tenant&workspaceKey='+workspaceKey,{waitUntil:'networkidle'});\\n        await page.getByLabel('Anmeldename',{exact:true}).fill('starter-reference');await page.getByRole('button',{name:'Weiter',exact:true}).click();\\n        const root=page.locator(target==='source'?'tc-starter':'#originalParticipantStarter');await root.waitFor();await root.locator('mat-card').first().waitFor();\\n        await page.locator('[data-cy=\\\"account-button\\\"]').waitFor();\\n        await page.evaluate(()=>document.fonts.ready);\\n        const id=target+'-'+theme+'-'+state+'-'+screen;\\n        metrics[id]=await root.evaluate(root=>{\\n M apps/api/src/index.ts\\n M apps/api/src/integration.test.ts\\n M apps/web/src/app/participant-event-stream.service.ts\\n M apps/web/src/app/participant-session-links.ts\\n M apps/web/src/app/participant-view.component.ts\\n M apps/web/src/app/participant-view.facade.ts\\n M apps/web/src/app/runtime-view.facade.ts\\n M package.json\\n M packages/application/src/index.ts\\n M scripts/event-stream-watchdog.test.mjs\\n M scripts/smoke-participant-booklet-variant.mjs\\n M scripts/smoke-ui.mjs\\n?? docs/testcenter-thread-migration-process.pptx\\n?? scripts/participant-session-links.test.mjs\\n rewrite-app/apps/api/src/index.ts                  |  9 ++-\\n rewrite-app/apps/api/src/integration.test.ts       | 