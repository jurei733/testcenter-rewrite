{"timestamp":"2026-10-07T05:54:31.111Z","ordinal":82527,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_06ef5e23f2db4ce4016ac5de92693481918b33f8bb5ad55844","status":"completed","call_id":"call_94edbc8877ae4f4a85223f090e864882","name":"exec","input":"text(await tools.exec_command({cmd:\"sed -n '1,240p' /tmp/testcenter-source-delta-20261007.log && sed -n '420,454p' docs/PARITY.md && sed -n '1,90p' docs/ORIGINAL-UI-PARITY.md && rg '^# tests|^# pass|^# fail' /tmp/testcenter-selected-request-unit-20261007.log && tail -5 /tmp/testcenter-selected-request-loading-chrome-20261007.log\",workdir:\"/Users/julian/code/testcenter-rewrite/rewrite-app\",max_output_tokens:6900}));\ntext(await tools.exec_command({cmd:\"UI_SMOKE_BROWSER_CHANNEL=chrome UI_SMOKE_HEADFUL=true node scripts/smoke-participant-booklet-variant.mjs > /tmp/testcenter-selected-request-variant-20261007.log 2>&1\",workdir:\"/Users/julian/code/testcenter-rewrite/rewrite-app\",max_output_tokens:1000,yield_time_ms:1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","create_time":1791352466.4132748}}}
{"timestamp":"2026-10-07T05:54:31.183Z","ordinal":82528,"type":"token_usage_record","payload":{"thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","session_id":"01a07cfb-af30-7a62-8a81-f821103d611a","root_turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","response_id":"resp_06ef5e23f2db4ce4016ac5de8ec62481918557df57cd2d9cfa","usage":{"input_tokens":156473,"cached_input_tokens":154624,"cache_write_input_tokens":0,"output_tokens":283,"reasoning_output_tokens":54,"total_tokens":156756},"turn_token_usage":{"input_tokens":2561612,"cached_input_tokens":2403328,"cache_write_input_tokens":0,"output_tokens":11182,"reasoning_output_tokens":3344,"total_tokens":2572794},"thread_token_usage":{"input_tokens":621933191,"cached_input_tokens":605542784,"cache_write_input_tokens":0,"output_tokens":2302047,"reasoning_output_tokens":899415,"total_tokens":624235238}}}
{"timestamp":"2026-10-07T05:54:31.192Z","ordinal":82529,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","item":{"type":"CommandExecution","id":"exec-744880ca-5ee3-4cef-a5ae-019f11f63545","process_id":"2456","command":["/bin/zsh","-lc","sed -n '1,240p' /tmp/testcenter-source-delta-20261007.log && sed -n '420,454p' docs/PARITY.md && sed -n '1,90p' docs/ORIGINAL-UI-PARITY.md && rg '^# tests|^# pass|^# fail' /tmp/testcenter-selected-request-unit-20261007.log && tail -5 /tmp/testcenter-selected-request-loading-chrome-20261007.log"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"unknown","cmd":"sed -n '1,240p' /tmp/testcenter-source-delta-20261007.log && sed -n '420,454p' docs/PARITY.md && sed -n '1,90p' docs/ORIGINAL-UI-PARITY.md && rg '^# tests|^# pass|^# fail' /tmp/testcenter-selected-request-unit-20261007.log && tail -5 /tmp/testcenter-selected-request-loading-chrome-20261007.log"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n.env.prod-template\n@@ -29,7 +29,11 @@ RESTART_POLICY=always\n ## Backend\n BROADCASTER_ENABLED=true\n FILE_SERVER_ENABLED=true\n-BRUTE_FORCE_PROTECTION='admin login person'\n+### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by\n+### spaces. Empty disables the protection.\n+### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a\n+### TLS-terminating proxy), otherwise the protected logins are impossible.\n+BRUTE_FORCE_PROTECTION=\n ### Validate uploaded XML files against their XSD schema. Default is true.\n XML_SCHEMA_VALIDATION=true\n PASSWORD_SALT=t\nfrontend/src/app/app-root/login/admin-login/admin-login.component.html\n@@ -25,11 +25,14 @@\n             <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                       [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n           }\n+          @if (insecureContext()) {\n+            <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+          }\n         </mat-card-content>\n       }\n       <mat-card-actions [style.justify-content]=\"'space-between'\">\n         <button matButton=\"filled\" type=\"submit\" color=\"primary\" id=\"admin\" data-cy=\"login-admin\"\n-                [disabled]=\"loginForm.invalid || busyWithChallenge\">\n+                [disabled]=\"loginForm.invalid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </mat-card-actions>\nfrontend/src/app/app-root/login/login.component.html\n@@ -52,8 +52,11 @@ <h2>Kennwort eingeben</h2>\n           <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                     [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n         }\n+        @if (insecureContext()) {\n+          <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+        }\n         <button matButton=\"filled\" type=\"submit\" data-cy=\"login-user\"\n-                [disabled]=\"!loginForm.get('name')?.valid || busyWithChallenge\">\n+                [disabled]=\"!loginForm.get('name')?.valid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </form>\nfrontend/src/app/brute-force-protection.service.ts\n@@ -0,0 +1,75 @@\n+import { Injectable } from '@angular/core';\n+import {\n+  from, map, Observable, switchMap\n+} from 'rxjs';\n+import { MainDataService } from '@shared/services/maindata/maindata.service';\n+import { AppError, AuthData } from './app.interfaces';\n+import { BackendService, Challenge, ChallengeRequest } from './backend.service';\n+\n+type LoginType = 'admin' | 'login' | 'person';\n+\n+@Injectable({\n+  providedIn: 'root'\n+})\n+export class BruteForceProtectionService {\n+  constructor(private backendService: BackendService, private mainDataService: MainDataService) { }\n+\n+  static readonly insecureContextMessage =\n+    'Die Anmeldung ist nur über eine verschlüsselte Verbindung (HTTPS) möglich. ' +\n+    'Bitte wenden Sie sich an den Betreiber dieses Servers.';\n+\n+  /** Whether the backend requires a solved challenge for this login type (env var BRUTE_FORCE_PROTECTION). */\n+  isActive$(loginType: LoginType): Observable<boolean> {\n+    return this.mainDataService.appConfig$\n+      .pipe(map(appConfig => appConfig.bruteForceProtection.includes(loginType)));\n+  }\n+\n+  /**\n+   * Whether this login type is protected but the challenge cannot be solved, because browsers provide the\n+   * Web Crypto API only in secure contexts (HTTPS or localhost).\n+   */\n+  isUnavailable$(loginType: LoginType): Observable<boolean> {\n+    return this.isActive$(loginType)\n+      .pipe(map(isActive => isActive && !window.isSecureContext));\n+  }\n+\n+  /**\n+   * Logs in via proof of work: the backend issues a challenge for the given credentials, the browser solves it,\n+   * and the solution is exchanged for a session. The credentials are only checked in the last step.\n+   */\n+  createSession(request: ChallengeRequest): Observable<AuthData> {\n+    return this.backendService.createChallenge(request)\n+      .pipe(\n+        switchMap(challenge => from(this.solve(challenge))\n+          .pipe(\n+            switchMap(number => this.backendService.createSession(\n+              challenge.algorithm,\n+              challenge.challenge,\n+              challenge.salt,\n+              challenge.signature,\n+              number\n+            ))\n+          ))\n+      );\n+  }\n+\n+  /** Finds the number the challenge hash was built from by brute force, spread over several web workers. */\n+  private async solve(challenge: Challenge): Promise<number> {\n+    const { solveChallengeWorkers } = await import('altcha-lib');\n+    const solution = await solveChallengeWorkers(\n+      `${window.document.baseURI}/altcha-lib/dist/worker.js`,\n+      8,\n+      challenge.challenge,\n+      challenge.salt,\n+      challenge.algorithm,\n+      challenge.maxNumber\n+    );\n+    if (!solution) {\n+      throw new AppError({\n+        label: 'Problem bei der Anmeldung.',\n+        description: 'Die Anmelde-Challenge konnte nicht gelöst werden.'\n+      });\n+    }\n+    return solution.number;\n+  }\n+}\nfrontend/src/app/shared/components/code-input/code-input.component.html\n@@ -3,7 +3,8 @@\n </ng-template>\n \n @if (inputType === 'text-field') {\n-  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" (submitCode)=\"onSubmit($event)\">\n+  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" [disabled]=\"disabled\"\n+                           (submitCode)=\"onSubmit($event)\">\n     <ng-container *ngTemplateOutlet=\"projectedContent\"></ng-container>\n   </tc-code-text-field-form>\n } @else {\nscripts/update.sh\n@@ -1,5 +1,4 @@\n #!/usr/bin/env bash\n-set -e\n \n # This is a small, version-independent bootstrap script, analogous to scripts/install.sh. Its only\n # job is to figure out which release the user wants to update to and then download + run the\n@@ -24,6 +23,10 @@ declare UPDATE_OPTION\n declare SOURCE_VERSION\n declare TARGET_VERSION\n \n+# Exit code of the backup phase when the user chose to stop the update there. Must match\n+# ABORTED_BY_USER in scripts/updater.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -123,6 +126,10 @@ run_backup_phase() {\n   declare exit_code=$?\n   rm -f \"${source_updater}\"\n \n+  if [ ${exit_code} -eq ${ABORTED_BY_USER} ]; then\n+    exit 0\n+  fi\n+\n   if [ ${exit_code} -ne 0 ]; then\n     exit ${exit_code}\n   fi\nscripts/updater.sh\n@@ -44,6 +44,10 @@ declare HAS_MIGRATION_FILES=false\n # separate process, downloaded from TARGET_VERSION).\n declare MIGRATION_PENDING_MARKER=\"${APP_DIR}/backup/temp/.migration-pending\"\n \n+# Exit code of the backup phase when the user chooses to stop the update there. scripts/update.sh\n+# then ends without running the apply phase. Must match ABORTED_BY_USER in scripts/update.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -117,7 +121,7 @@ create_backup_set() {\n   if [[ ! ${continue} =~ ^[yY]$ ]]; then\n     printf \"'%s' update script finished.\\n\" \"${APP_NAME}\"\n \n-    exit 0\n+    exit ${ABORTED_BY_USER}\n   fi\n }\n \n@@ -266,7 +270,7 @@ run_complementary_migration_scripts() {\n         fi\n \n         printf \"'%s' update script finished.\\n\\n\" \"${APP_NAME}\"\n-        exit 0\n+        exit ${ABORTED_BY_USER}\n       fi\n       printf \"\\n\"\n \nThe complete unit gates passed 144 core and 45 frontend tests; all 161 SQLite\nAPI integration tests and the schema-57 startup smoke passed. A headful\nChromium check held each external lock until after the actual Player save was\nreleased to the API: both real POSTs waited approximately 790ms and returned\n200, preserving the answer in the same run without HTTP 5xx or page errors.\nRequest interception only synchronizes the lock; it does not mock the backend,\nalter the payload or change the normal five-second response buffer.\n\nEvidence is retained locally in ignored\n`.data/sqlite-contention-reference-20261004`. This closes the reproduced\nshort-contention finding, not general multi-process scalability: synchronous\nSQLite waiting blocks the API event loop, and long locks remain errors.\nPostgreSQL deployment and server-side connection-loss parity remain distinct\nacceptance requirements.\n\n## Current 19.0 delta to verify\n\nOn 2026-10-03, the Original fetch advanced to\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (version 19.0).\nGitHub `HEAD`, `master` and tag `19.0.0` were independently reverified on\n2026-10-04 at the same revision (not the stale default HEAD of the local clone).\nThe broad historical\naudit below remains useful, but its 94% estimate is **not a verified estimate\nagainst 19.0** and does not include the newly requested identical optional UI.\nThe following additional acceptance requirements come from the 19.0 changelog\nand implementation. Each needs current rewrite evidence before it is closed:\n\n- Required current-password confirmation for self-service password changes\n  and for superadmin deletion of administrators/workspaces; resetting another\n  administrator's password retains its distinct authorization boundary.\n  Administrator and workspace DELETE now require the acting administrator's\n  current password in `confirmationPassword`, after active-session and role /\n  delegation checks and before any deletion. Workspace deletion always requires\n  a platform administrator, even in diagnostic auth-off mode; its exact-key\n  confirmation remains required and the audit actor comes from that session.\n# Optional Original UI\n\n## Acceptance baseline\n\nRequested on 2026-09-12: keep the existing rewrite interface available and add\nan optional interface identical to the Original Testcenter. This is a separate\nacceptance axis from functional parity; the historical 94% estimate in\nPARITY.md does not measure it.\n\nReference: `iqb-berlin/testcenter` commit\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (19.0), fetched on 2026-10-03.\nCompare source files from that revision, not the older local checkout.\n\n## Required behavior\n\n- Explicit, reversible interface selection. The existing rewrite interface\n  remains the default until the Original interface passes acceptance.\n- Both interfaces use the same authorized application services and persisted\n  data. Switching must not reset answers, create a test run, change permissions,\n  or bypass a participant navigation restriction.\n- Preserve the independent Primar, Sekundar and Erwachsene presentation themes,\n  authored texts, branding and participant-specific configuration.\n- Do not equate a color/font override with an identical interface. Reproduce\n  page structure, spacing, typography, controls, dialogs and interaction states.\n- Keep rewrite-only tenant and diagnostic tools accessible without inserting\n  them into the Original participant workflow.\n\n## Acceptance matrix\n\nBoth interfaces now bind the selected Run ID through state, asset preload,\nlive updates and actual generated re-entry links. Exact preset assignment,\nUnicode answers and Run ID survive hard reload; another run's later background\nsaves cannot steal selection or bypass the selected run's monitor pause.\nProduction/development protected SQLite browsers and headless production pass.\nThe second open run in this focused fixture is repository-seeded, not started\nthrough the still-blocked P0 workflow. These shared functional safeguards do not\nclose any full rendered-UI acceptance row or pixel-identity claim.\n\nThe shared backend now permits exact preset-assignment resumption after returning\nto the starter, rather than rejecting its variant key against the source Booklet\nkey. Both interfaces passed real participant login, Unicode draft preservation,\nconfirmed starter return, same-run resumption and session-link/hard-reload\nrestoration with owned protected SQLite in production/development; production\nalso passed headlessly. The mandatory quick-CI variant smoke retains exact\nrun/answer assertions. This does not close the other-unfinished-Booklet P0 gap,\nthe full starter row or any pixel-identity claim.\n\nLatest participant-starter comparison (2026-10-05): the optional renderer now\nmatches the pinned 19.0 intrinsic 684px card/intro width, 24px gaps, 94px companion,\nnormal paragraph typography, flex-column margins, Material icon baselines,\ncompleted-button opacity and bordered Review action. The scrolling content is\nviewport-bounded below the Source toolbar, including the authenticated account\ncontrol at both sides of the 600px breakpoint. The native scroll button sends\nthe actual Source's smooth 300px increment rather than jumping to the bottom.\nThe Source's narrow-screen clipping is retained in this optional interface;\nthe responsive Rewrite interface remains independently available.\n\nAll 48 equal-fixture states passed in each final production/development build:\nthree themes × four viewports × fresh, mixed/completed with custom action labels,\nlong/wrapped/unbreakable labels and Review-enabled starters. The reference uses\nthe unmodified `c35cff81` frontend with a bounded API fixture; Rewrite uses real\nprotected API/SQLite. Text, geometry and measured visible styles match,\nincluding the account control and disabled opacity. Raw RGBA is identical in\n33/48 production and 29/48 development pairs. Remaining pairs retain differences\nup to 7,733 pixels and 67/255 channel units; complete pixel identity is not\nestablished. Scripts, metrics, screenshots and logs are retained in ignored\n`.data/original-starter-reference-20261005.*`.\n\nThe new mandatory quick-CI browser regression passes all 48 states in both builds\nand exercises real login, keyboard scrolling, non-lifting account hover, a\nblocked duplicate pending start, exact saved-answer resumption and participant\nbearer authorization for the actual HTTP 204 Review export. The separate login\nregression and all 165 core, 12 presence and 83 frontend/preflight tests passed.\nInitial production output for that layout step was 469.61kB below the unchanged 470kB hard limit.\nFresh publication CI remains separate proof. This narrow comparison does not\nclose the complete starter/shell row: empty/error/custom-branding states,\nSource snackbar feedback and other claims remain open. A functional P0 gap was\nalso reproduced: another unfinished Booklet blocks an otherwise available\nselection. Explicit run-bound reads now avoid answer-update chronology, while\nhistorical session-only links retain that fallback. The\nmixed rendering fixture completes one Booklet before starting the other; it\ndoes not prove that blocked workflow. See PARITY.md's explicit acceptance.\n\nLatest administrator-login comparison (2026-10-04): the optional signed-out\noperator entry now uses the pinned 19.0 400px Material card, bordered centered\nform, German labels/actions, shared Source header/footer and Testtaker link.\nIt calls the same authorized operator login, proof-of-work, persistence and\nreturn-route logic as Rewrite; there is no second credential store. Native\nsetup remains accessible through the interface selection or `?ui=rewrite`.\nStructured error identifiers preserve Source copy despite different HTTP\n# tests 165\n# pass 165\n# fail 0\n# tests 12\n# pass 12\n# fail 0\n# tests 95\n# pass 95\n# fail 0\nui_smoke_step=teardown-browser\nui_smoke_step=teardown-server\n{\"timestamp\":\"2026-10-07T05:54:01.015Z\",\"level\":\"info\",\"event\":\"process_shutdown_requested\",\"signal\":\"SIGTERM\",\"storageKind\":\"memory\",\"shutdownDrainDelayMs\":1000}\nshutdown_signal=SIGTERM\nui_smoke_step=teardown-complete\n","stderr":"","aggregated_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n.env.prod-template\n@@ -29,7 +29,11 @@ RESTART_POLICY=always\n ## Backend\n BROADCASTER_ENABLED=true\n FILE_SERVER_ENABLED=true\n-BRUTE_FORCE_PROTECTION='admin login person'\n+### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by\n+### spaces. Empty disables the protection.\n+### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a\n+### TLS-terminating proxy), otherwise the protected logins are impossible.\n+BRUTE_FORCE_PROTECTION=\n ### Validate uploaded XML files against their XSD schema. Default is true.\n XML_SCHEMA_VALIDATION=true\n PASSWORD_SALT=t\nfrontend/src/app/app-root/login/admin-login/admin-login.component.html\n@@ -25,11 +25,14 @@\n             <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                       [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n           }\n+          @if (insecureContext()) {\n+            <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+          }\n         </mat-card-content>\n       }\n       <mat-card-actions [style.justify-content]=\"'space-between'\">\n         <button matButton=\"filled\" type=\"submit\" color=\"primary\" id=\"admin\" data-cy=\"login-admin\"\n-                [disabled]=\"loginForm.invalid || busyWithChallenge\">\n+                [disabled]=\"loginForm.invalid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </mat-card-actions>\nfrontend/src/app/app-root/login/login.component.html\n@@ -52,8 +52,11 @@ <h2>Kennwort eingeben</h2>\n           <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                     [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n         }\n+        @if (insecureContext()) {\n+          <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+        }\n         <button matButton=\"filled\" type=\"submit\" data-cy=\"login-user\"\n-                [disabled]=\"!loginForm.get('name')?.valid || busyWithChallenge\">\n+                [disabled]=\"!loginForm.get('name')?.valid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </form>\nfrontend/src/app/brute-force-protection.service.ts\n@@ -0,0 +1,75 @@\n+import { Injectable } from '@angular/core';\n+import {\n+  from, map, Observable, switchMap\n+} from 'rxjs';\n+import { MainDataService } from '@shared/services/maindata/maindata.service';\n+import { AppError, AuthData } from './app.interfaces';\n+import { BackendService, Challenge, ChallengeRequest } from './backend.service';\n+\n+type LoginType = 'admin' | 'login' | 'person';\n+\n+@Injectable({\n+  providedIn: 'root'\n+})\n+export class BruteForceProtectionService {\n+  constructor(private backendService: BackendService, private mainDataService: MainDataService) { }\n+\n+  static readonly insecureContextMessage =\n+    'Die Anmeldung ist nur über eine verschlüsselte Verbindung (HTTPS) möglich. ' +\n+    'Bitte wenden Sie sich an den Betreiber dieses Servers.';\n+\n+  /** Whether the backend requires a solved challenge for this login type (env var BRUTE_FORCE_PROTECTION). */\n+  isActive$(loginType: LoginType): Observable<boolean> {\n+    return this.mainDataService.appConfig$\n+      .pipe(map(appConfig => appConfig.bruteForceProtection.includes(loginType)));\n+  }\n+\n+  /**\n+   * Whether this login type is protected but the challenge cannot be solved, because browsers provide the\n+   * Web Crypto API only in secure contexts (HTTPS or localhost).\n+   */\n+  isUnavailable$(loginType: LoginType): Observable<boolean> {\n+    return this.isActive$(loginType)\n+      .pipe(map(isActive => isActive && !window.isSecureContext));\n+  }\n+\n+  /**\n+   * Logs in via proof of work: the backend issues a challenge for the given credentials, the browser solves it,\n+   * and the solution is exchanged for a session. The credentials are only checked in the last step.\n+   */\n+  createSession(request: ChallengeRequest): Observable<AuthData> {\n+    return this.backendService.createChallenge(request)\n+      .pipe(\n+        switchMap(challenge => from(this.solve(challenge))\n+          .pipe(\n+            switchMap(number => this.backendService.createSession(\n+              challenge.algorithm,\n+              challenge.challenge,\n+              challenge.salt,\n+              challenge.signature,\n+              number\n+            ))\n+          ))\n+      );\n+  }\n+\n+  /** Finds the number the challenge hash was built from by brute force, spread over several web workers. */\n+  private async solve(challenge: Challenge): Promise<number> {\n+    const { solveChallengeWorkers } = await import('altcha-lib');\n+    const solution = await solveChallengeWorkers(\n+      `${window.document.baseURI}/altcha-lib/dist/worker.js`,\n+      8,\n+      challenge.challenge,\n+      challenge.salt,\n+      challenge.algorithm,\n+      challenge.maxNumber\n+    );\n+    if (!solution) {\n+      throw new AppError({\n+        label: 'Problem bei der Anmeldung.',\n+        description: 'Die Anmelde-Challenge konnte nicht gelöst werden.'\n+      });\n+    }\n+    return solution.number;\n+  }\n+}\nfrontend/src/app/shared/components/code-input/code-input.component.html\n@@ -3,7 +3,8 @@\n </ng-template>\n \n @if (inputType === 'text-field') {\n-  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" (submitCode)=\"onSubmit($event)\">\n+  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" [disabled]=\"disabled\"\n+                           (submitCode)=\"onSubmit($event)\">\n     <ng-container *ngTemplateOutlet=\"projectedContent\"></ng-container>\n   </tc-code-text-field-form>\n } @else {\nscripts/update.sh\n@@ -1,5 +1,4 @@\n #!/usr/bin/env bash\n-set -e\n \n # This is a small, version-independent bootstrap script, analogous to scripts/install.sh. Its only\n # job is to figure out which release the user wants to update to and then download + run the\n@@ -24,6 +23,10 @@ declare UPDATE_OPTION\n declare SOURCE_VERSION\n declare TARGET_VERSION\n \n+# Exit code of the backup phase when the user chose to stop the update there. Must match\n+# ABORTED_BY_USER in scripts/updater.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -123,6 +126,10 @@ run_backup_phase() {\n   declare exit_code=$?\n   rm -f \"${source_updater}\"\n \n+  if [ ${exit_code} -eq ${ABORTED_BY_USER} ]; then\n+    exit 0\n+  fi\n+\n   if [ ${exit_code} -ne 0 ]; then\n     exit ${exit_code}\n   fi\nscripts/updater.sh\n@@ -44,6 +44,10 @@ declare HAS_MIGRATION_FILES=false\n # separate process, downloaded from TARGET_VERSION).\n declare MIGRATION_PENDING_MARKER=\"${APP_DIR}/backup/temp/.migration-pending\"\n \n+# Exit code of the backup phase when the user chooses to stop the update there. scripts/update.sh\n+# then ends without running the apply phase. Must match ABORTED_BY_USER in scripts/update.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -117,7 +121,7 @@ create_backup_set() {\n   if [[ ! ${continue} =~ ^[yY]$ ]]; then\n     printf \"'%s' update script finished.\\n\" \"${APP_NAME}\"\n \n-    exit 0\n+    exit ${ABORTED_BY_USER}\n   fi\n }\n \n@@ -266,7 +270,7 @@ run_complementary_migration_scripts() {\n         fi\n \n         printf \"'%s' update script finished.\\n\\n\" \"${APP_NAME}\"\n-        exit 0\n+        exit ${ABORTED_BY_USER}\n       fi\n       printf \"\\n\"\n \nThe complete unit gates passed 144 core and 45 frontend tests; all 161 SQLite\nAPI integration tests and the schema-57 startup smoke passed. A headful\nChromium check held each external lock until after the actual Player save was\nreleased to the API: both real POSTs waited approximately 790ms and returned\n200, preserving the answer in the same run without HTTP 5xx or page errors.\nRequest interception only synchronizes the lock; it does not mock the backend,\nalter the payload or change the normal five-second response buffer.\n\nEvidence is retained locally in ignored\n`.data/sqlite-contention-reference-20261004`. This closes the reproduced\nshort-contention finding, not general multi-process scalability: synchronous\nSQLite waiting blocks the API event loop, and long locks remain errors.\nPostgreSQL deployment and server-side connection-loss parity remain distinct\nacceptance requirements.\n\n## Current 19.0 delta to verify\n\nOn 2026-10-03, the Original fetch advanced to\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (version 19.0).\nGitHub `HEAD`, `master` and tag `19.0.0` were independently reverified on\n2026-10-04 at the same revision (not the stale default HEAD of the local clone).\nThe broad historical\naudit below remains useful, but its 94% estimate is **not a verified estimate\nagainst 19.0** and does not include the newly requested identical optional UI.\nThe following additional acceptance requirements come from the 19.0 changelog\nand implementation. Each needs current rewrite evidence before it is closed:\n\n- Required current-password confirmation for self-service password changes\n  and for superadmin deletion of administrators/workspaces; resetting another\n  administrator's password retains its distinct authorization boundary.\n  Administrator and workspace DELETE now require the acting administrator's\n  current password in `confirmationPassword`, after active-session and role /\n  delegation checks and before any deletion. Workspace deletion always requires\n  a platform administrator, even in diagnostic auth-off mode; its exact-key\n  confirmation remains required and the audit actor comes from that session.\n# Optional Original UI\n\n## Acceptance baseline\n\nRequested on 2026-09-12: keep the existing rewrite interface available and add\nan optional interface identical to the Original Testcenter. This is a separate\nacceptance axis from functional parity; the historical 94% estimate in\nPARITY.md does not measure it.\n\nReference: `iqb-berlin/testcenter` commit\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (19.0), fetched on 2026-10-03.\nCompare source files from that revision, not the older local checkout.\n\n## Required behavior\n\n- Explicit, reversible interface selection. The existing rewrite interface\n  remains the default until the Original interface passes acceptance.\n- Both interfaces use the same authorized application services and persisted\n  data. Switching must not reset answers, create a test run, change permissions,\n  or bypass a participant navigation restriction.\n- Preserve the independent Primar, Sekundar and Erwachsene presentation themes,\n  authored texts, branding and participant-specific configuration.\n- Do not equate a color/font override with an identical interface. Reproduce\n  page structure, spacing, typography, controls, dialogs and interaction states.\n- Keep rewrite-only tenant and diagnostic tools accessible without inserting\n  them into the Original participant workflow.\n\n## Acceptance matrix\n\nBoth interfaces now bind the selected Run ID through state, asset preload,\nlive updates and actual generated re-entry links. Exact preset assignment,\nUnicode answers and Run ID survive hard reload; another run's later background\nsaves cannot steal selection or bypass the selected run's monitor pause.\nProduction/development protected SQLite browsers and headless production pass.\nThe second open run in this focused fixture is repository-seeded, not started\nthrough the still-blocked P0 workflow. These shared functional safeguards do not\nclose any full rendered-UI acceptance row or pixel-identity claim.\n\nThe shared backend now permits exact preset-assignment resumption after returning\nto the starter, rather than rejecting its variant key against the source Booklet\nkey. Both interfaces passed real participant login, Unicode draft preservation,\nconfirmed starter return, same-run resumption and session-link/hard-reload\nrestoration with owned protected SQLite in production/development; production\nalso passed headlessly. The mandatory quick-CI variant smoke retains exact\nrun/answer assertions. This does not close the other-unfinished-Booklet P0 gap,\nthe full starter row or any pixel-identity claim.\n\nLatest participant-starter comparison (2026-10-05): the optional renderer now\nmatches the pinned 19.0 intrinsic 684px card/intro width, 24px gaps, 94px companion,\nnormal paragraph typography, flex-column margins, Material icon baselines,\ncompleted-button opacity and bordered Review action. The scrolling content is\nviewport-bounded below the Source toolbar, including the authenticated account\ncontrol at both sides of the 600px breakpoint. The native scroll button sends\nthe actual Source's smooth 300px increment rather than jumping to the bottom.\nThe Source's narrow-screen clipping is retained in this optional interface;\nthe responsive Rewrite interface remains independently available.\n\nAll 48 equal-fixture states passed in each final production/development build:\nthree themes × four viewports × fresh, mixed/completed with custom action labels,\nlong/wrapped/unbreakable labels and Review-enabled starters. The reference uses\nthe unmodified `c35cff81` frontend with a bounded API fixture; Rewrite uses real\nprotected API/SQLite. Text, geometry and measured visible styles match,\nincluding the account control and disabled opacity. Raw RGBA is identical in\n33/48 production and 29/48 development pairs. Remaining pairs retain differences\nup to 7,733 pixels and 67/255 channel units; complete pixel identity is not\nestablished. Scripts, metrics, screenshots and logs are retained in ignored\n`.data/original-starter-reference-20261005.*`.\n\nThe new mandatory quick-CI browser regression passes all 48 states in both builds\nand exercises real login, keyboard scrolling, non-lifting account hover, a\nblocked duplicate pending start, exact saved-answer resumption and participant\nbearer authorization for the actual HTTP 204 Review export. The separate login\nregression and all 165 core, 12 presence and 83 frontend/preflight tests passed.\nInitial production output for that layout step was 469.61kB below the unchanged 470kB hard limit.\nFresh publication CI remains separate proof. This narrow comparison does not\nclose the complete starter/shell row: empty/error/custom-branding states,\nSource snackbar feedback and other claims remain open. A functional P0 gap was\nalso reproduced: another unfinished Booklet blocks an otherwise available\nselection. Explicit run-bound reads now avoid answer-update chronology, while\nhistorical session-only links retain that fallback. The\nmixed rendering fixture completes one Booklet before starting the other; it\ndoes not prove that blocked workflow. See PARITY.md's explicit acceptance.\n\nLatest administrator-login comparison (2026-10-04): the optional signed-out\noperator entry now uses the pinned 19.0 400px Material card, bordered centered\nform, German labels/actions, shared Source header/footer and Testtaker link.\nIt calls the same authorized operator login, proof-of-work, persistence and\nreturn-route logic as Rewrite; there is no second credential store. Native\nsetup remains accessible through the interface selection or `?ui=rewrite`.\nStructured error identifiers preserve Source copy despite different HTTP\n# tests 165\n# pass 165\n# fail 0\n# tests 12\n# pass 12\n# fail 0\n# tests 95\n# pass 95\n# fail 0\nui_smoke_step=teardown-browser\nui_smoke_step=teardown-server\n{\"timestamp\":\"2026-10-07T05:54:01.015Z\",\"level\":\"info\",\"event\":\"process_shutdown_requested\",\"signal\":\"SIGTERM\",\"storageKind\":\"memory\",\"shutdownDrainDelayMs\":1000}\nshutdown_signal=SIGTERM\nui_smoke_step=teardown-complete\n","exit_code":0,"duration":{"secs":0,"nanos":7167},"formatted_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n.env.prod-template\n@@ -29,7 +29,11 @@ RESTART_POLICY=always\n ## Backend\n BROADCASTER_ENABLED=true\n FILE_SERVER_ENABLED=true\n-BRUTE_FORCE_PROTECTION='admin login person'\n+### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by\n+### spaces. Empty disables the protection.\n+### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a\n+### TLS-terminating proxy), otherwise the protected logins are impossible.\n+BRUTE_FORCE_PROTECTION=\n ### Validate uploaded XML files against their XSD schema. Default is true.\n XML_SCHEMA_VALIDATION=true\n PASSWORD_SALT=t\nfrontend/src/app/app-root/login/admin-login/admin-login.component.html\n@@ -25,11 +25,14 @@\n             <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                       [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n           }\n+          @if (insecureContext()) {\n+            <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+          }\n         </mat-card-content>\n       }\n       <mat-card-actions [style.justify-content]=\"'space-between'\">\n         <button matButton=\"filled\" type=\"submit\" color=\"primary\" id=\"admin\" data-cy=\"login-admin\"\n-                [disabled]=\"loginForm.invalid || busyWithChallenge\">\n+                [disabled]=\"loginForm.invalid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </mat-card-actions>\nfrontend/src/app/app-root/login/login.component.html\n@@ -52,8 +52,11 @@ <h2>Kennwort eingeben</h2>\n           <tc-alert [attr.data-cy]=\"'login-problem:' + problemCode\"\n                     [level]=\"problemLevel\" [text]=\"problemText\"></tc-alert>\n         }\n+        @if (insecureContext()) {\n+          <tc-alert data-cy=\"login-insecure-context\" level=\"error\" [text]=\"insecureContextMessage\"></tc-alert>\n+        }\n         <button matButton=\"filled\" type=\"submit\" data-cy=\"login-user\"\n-                [disabled]=\"!loginForm.get('name')?.valid || busyWithChallenge\">\n+                [disabled]=\"!loginForm.get('name')?.valid || busy || insecureContext()\">\n           Anmelden\n         </button>\n       </form>\nfrontend/src/app/brute-force-protection.service.ts\n@@ -0,0 +1,75 @@\n+import { Injectable } from '@angular/core';\n+import {\n+  from, map, Observable, switchMap\n+} from 'rxjs';\n+import { MainDataService } from '@shared/services/maindata/maindata.service';\n+import { AppError, AuthData } from './app.interfaces';\n+import { BackendService, Challenge, ChallengeRequest } from './backend.service';\n+\n+type LoginType = 'admin' | 'login' | 'person';\n+\n+@Injectable({\n+  providedIn: 'root'\n+})\n+export class BruteForceProtectionService {\n+  constructor(private backendService: BackendService, private mainDataService: MainDataService) { }\n+\n+  static readonly insecureContextMessage =\n+    'Die Anmeldung ist nur über eine verschlüsselte Verbindung (HTTPS) möglich. ' +\n+    'Bitte wenden Sie sich an den Betreiber dieses Servers.';\n+\n+  /** Whether the backend requires a solved challenge for this login type (env var BRUTE_FORCE_PROTECTION). */\n+  isActive$(loginType: LoginType): Observable<boolean> {\n+    return this.mainDataService.appConfig$\n+      .pipe(map(appConfig => appConfig.bruteForceProtection.includes(loginType)));\n+  }\n+\n+  /**\n+   * Whether this login type is protected but the challenge cannot be solved, because browsers provide the\n+   * Web Crypto API only in secure contexts (HTTPS or localhost).\n+   */\n+  isUnavailable$(loginType: LoginType): Observable<boolean> {\n+    return this.isActive$(loginType)\n+      .pipe(map(isActive => isActive && !window.isSecureContext));\n+  }\n+\n+  /**\n+   * Logs in via proof of work: the backend issues a challenge for the given credentials, the browser solves it,\n+   * and the solution is exchanged for a session. The credentials are only checked in the last step.\n+   */\n+  createSession(request: ChallengeRequest): Observable<AuthData> {\n+    return this.backendService.createChallenge(request)\n+      .pipe(\n+        switchMap(challenge => from(this.solve(challenge))\n+          .pipe(\n+            switchMap(number => this.backendService.createSession(\n+              challenge.algorithm,\n+              challenge.challenge,\n+              challenge.salt,\n+              challenge.signature,\n+              number\n+            ))\n+          ))\n+      );\n+  }\n+\n+  /** Finds the number the challenge hash was built from by brute force, spread over several web workers. */\n+  private async solve(challenge: Challenge): Promise<number> {\n+    const { solveChallengeWorkers } = await import('altcha-lib');\n+    const solution = await solveChallengeWorkers(\n+      `${window.document.baseURI}/altcha-lib/dist/worker.js`,\n+      8,\n+      challenge.challenge,\n+      challenge.salt,\n+      challenge.algorithm,\n+      challenge.maxNumber\n+    );\n+    if (!solution) {\n+      throw new AppError({\n+        label: 'Problem bei der Anmeldung.',\n+        description: 'Die Anmelde-Challenge konnte nicht gelöst werden.'\n+      });\n+    }\n+    return solution.number;\n+  }\n+}\nfrontend/src/app/shared/components/code-input/code-input.component.html\n@@ -3,7 +3,8 @@\n </ng-template>\n \n @if (inputType === 'text-field') {\n-  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" (submitCode)=\"onSubmit($event)\">\n+  <tc-code-text-field-form [buttonLabel]=\"buttonLabel\" [disabled]=\"disabled\"\n+                           (submitCode)=\"onSubmit($event)\">\n     <ng-container *ngTemplateOutlet=\"projectedContent\"></ng-container>\n   </tc-code-text-field-form>\n } @else {\nscripts/update.sh\n@@ -1,5 +1,4 @@\n #!/usr/bin/env bash\n-set -e\n \n # This is a small, version-independent bootstrap script, analogous to scripts/install.sh. Its only\n # job is to figure out which release the user wants to update to and then download + run the\n@@ -24,6 +23,10 @@ declare UPDATE_OPTION\n declare SOURCE_VERSION\n declare TARGET_VERSION\n \n+# Exit code of the backup phase when the user chose to stop the update there. Must match\n+# ABORTED_BY_USER in scripts/updater.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -123,6 +126,10 @@ run_backup_phase() {\n   declare exit_code=$?\n   rm -f \"${source_updater}\"\n \n+  if [ ${exit_code} -eq ${ABORTED_BY_USER} ]; then\n+    exit 0\n+  fi\n+\n   if [ ${exit_code} -ne 0 ]; then\n     exit ${exit_code}\n   fi\nscripts/updater.sh\n@@ -44,6 +44,10 @@ declare HAS_MIGRATION_FILES=false\n # separate process, downloaded from TARGET_VERSION).\n declare MIGRATION_PENDING_MARKER=\"${APP_DIR}/backup/temp/.migration-pending\"\n \n+# Exit code of the backup phase when the user chooses to stop the update there. scripts/update.sh\n+# then ends without running the apply phase. Must match ABORTED_BY_USER in scripts/update.sh.\n+declare ABORTED_BY_USER=2\n+\n check_version_tag_exists() {\n   declare tag=\"${1}\"\n   declare status_code\n@@ -117,7 +121,7 @@ create_backup_set() {\n   if [[ ! ${continue} =~ ^[yY]$ ]]; then\n     printf \"'%s' update script finished.\\n\" \"${APP_NAME}\"\n \n-    exit 0\n+    exit ${ABORTED_BY_USER}\n   fi\n }\n \n@@ -266,7 +270,7 @@ run_complementary_migration_scripts() {\n         fi\n \n         printf \"'%s' update script finished.\\n\\n\" \"${APP_NAME}\"\n-        exit 0\n+        exit ${ABORTED_BY_USER}\n       fi\n       printf \"\\n\"\n \nThe complete unit gates passed 144 core and 45 frontend tests; all 161 SQLite\nAPI integration tests and the schema-57 startup smoke passed. A headful\nChromium check held each external lock until after the actual Player save was\nreleased to the API: both real POSTs waited approximately 790ms and returned\n200, preserving the answer in the same run without HTTP 5xx or page errors.\nRequest interception only synchronizes the lock; it does not mock the backend,\nalter the payload or change the normal five-second response buffer.\n\nEvidence is retained locally in ignored\n`.data/sqlite-contention-reference-20261004`. This closes the reproduced\nshort-contention finding, not general multi-process scalability: synchronous\nSQLite waiting blocks the API event loop, and long locks remain errors.\nPostgreSQL deployment and server-side connection-loss parity remain distinct\nacceptance requirements.\n\n## Current 19.0 delta to verify\n\nOn 2026-10-03, the Original fetch advanced to\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (version 19.0).\nGitHub `HEAD`, `master` and tag `19.0.0` were independently reverified on\n2026-10-04 at the same revision (not the stale default HEAD of the local clone).\nThe broad historical\naudit below remains useful, but its 94% estimate is **not a verified estimate\nagainst 19.0** and does not include the newly requested identical optional UI.\nThe following additional acceptance requirements come from the 19.0 changelog\nand implementation. Each needs current rewrite evidence before it is closed:\n\n- Required current-password confirmation for self-service password changes\n  and for superadmin deletion of administrators/workspaces; resetting another\n  administrator's password retains its distinct authorization boundary.\n  Administrator and workspace DELETE now require the acting administrator's\n  current password in `confirmationPassword`, after active-session and role /\n  delegation checks and before any deletion. Workspace deletion always requires\n  a platform administrator, even in diagnostic auth-off mode; its exact-key\n  confirmation remains required and the audit actor comes from that session.\n# Optional Original UI\n\n## Acceptance baseline\n\nRequested on 2026-09-12: keep the existing rewrite interface available and add\nan optional interface identical to the Original Testcenter. This is a separate\nacceptance axis from functional parity; the historical 94% estimate in\nPARITY.md does not measure it.\n\nReference: `iqb-berlin/testcenter` commit\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (19.0), fetched on 2026-10-03.\nCompare source files from that revision, not the older local checkout.\n\n## Required behavior\n\n- Explicit, reversible interface selection. The existing rewrite interface\n  remains the default until the Original interface passes acceptance.\n- Both interfaces use the same authorized application services and persisted\n  data. Switching must not reset answers, create a test run, change permissions,\n  or bypass a participant navigation restriction.\n- Preserve the independent Primar, Sekundar and Erwachsene presentation themes,\n  authored texts, branding and participant-specific configuration.\n- Do not equate a color/font override with an identical interface. Reproduce\n  page structure, spacing, typography, controls, dialogs and interaction states.\n- Keep rewrite-only tenant and diagnostic tools accessible without inserting\n  them into the Original participant workflow.\n\n## Acceptance matrix\n\nBoth interfaces now bind the selected Run ID through state, asset preload,\nlive updates and actual generated re-entry links. Exact preset assignment,\nUnicode answers and Run ID survive hard reload; another run's later background\nsaves cannot steal selection or bypass the selected run's monitor pause.\nProduction/development protected SQLite browsers and headless production pass.\nThe second open run in this focused fixture is repository-seeded, not started\nthrough the still-blocked P0 workflow. These shared functional safeguards do not\nclose any full rendered-UI acceptance row or pixel-identity claim.\n\nThe shared backend now permits exact preset-assignment resumption after returning\nto the starter, rather than rejecting its variant key against the source Booklet\nkey. Both interfaces passed real participant login, Unicode draft preservation,\nconfirmed starter return, same-run resumption and session-link/hard-reload\nrestoration with owned protected SQLite in production/development; production\nalso passed headlessly. The mandatory quick-CI variant smoke retains exact\nrun/answer assertions. This does not close the other-unfinished-Booklet P0 gap,\nthe full starter row or any pixel-identity claim.\n\nLatest participant-starter comparison (2026-10-05): the optional renderer now\nmatches the pinned 19.0 intrinsic 684px card/intro width, 24px gaps, 94px companion,\nnormal paragraph typography, flex-column margins, Material icon baselines,\ncompleted-button opacity and bordered Review action. The scrolling content is\nviewport-bounded below the Source toolbar, including the authenticated account\ncontrol at both sides of the 600px breakpoint. The native scroll button sends\nthe actual Source's smooth 300px increment rather than jumping to the bottom.\nThe Source's narrow-screen clipping is retained in this optional interface;\nthe responsive Rewrite interface remains independently available.\n\nAll 48 equal-fixture states passed in each final production/development build:\nthree themes × four viewports × fresh, mixed/completed with custom action labels,\nlong/wrapped/unbreakable labels and Review-enabled starters. The reference uses\nthe unmodified `c35cff81` frontend with a bounded API fixture; Rewrite uses real\nprotected API/SQLite. Text, geometry and measured visible styles match,\nincluding the account control and disabled opacity. Raw RGBA is identical in\n33/48 production and 29/48 development pairs. Remaining pairs retain differences\nup to 7,733 pixels and 67/255 channel units; complete pixel identity is not\nestablished. Scripts, metrics, screenshots and logs are retained in ignored\n`.data/original-starter-reference-20261005.*`.\n\nThe new mandatory quick-CI browser regression passes all 48 states in both builds\nand exercises real login, keyboard scrolling, non-lifting account hover, a\nblocked duplicate pending start, exact saved-answer resumption and participant\nbearer authorization for the actual HTTP 204 Review export. The separate login\nregression and all 165 core, 12 presence and 83 frontend/preflight tests passed.\nInitial production output for that layout step was 469.61kB below the unchanged 470kB hard limit.\nFresh publication CI remains separate proof. This narrow comparison does not\nclose the complete starter/shell row: empty/error/custom-branding states,\nSource snackbar feedback and other claims remain open. A functional P0 gap was\nalso reproduced: another unfinished Booklet blocks an otherwise available\nselection. Explicit run-bound reads now avoid answer-update chronology, while\nhistorical session-only links retain that fallback. The\nmixed rendering fixture completes one Booklet before starting the other; it\ndoes not prove that blocked workflow. See PARITY.md's explicit acceptance.\n\nLatest administrator-login comparison (2026-10-04): the optional signed-out\noperator entry now uses the pinned 19.0 400px Material card, bordered centered\nform, German labels/actions, shared Source header/footer and Testtaker link.\nIt calls the same authorized operator login, proof-of-work, persistence and\nreturn-route logic as Rewrite; there is no second credential store. Native\nsetup remains accessible through the interface selection or `?ui=rewrite`.\nStructured error identifiers preserve Source copy despite different HTTP\n# tests 165\n# pass 165\n# fail 0\n# tests 12\n# pass 12\n# fail 0\n# tests 95\n# pass 95\n# fail 0\nui_smoke_step=teardown-browser\nui_smoke_step=teardown-server\n{\"timestamp\":\"2026-10-07T05:54:01.015Z\",\"level\":\"info\",\"event\":\"process_shutdown_requested\",\"signal\":\"SIGTERM\",\"storageKind\":\"memory\",\"shutdownDrainDelayMs\":1000}\nshutdown_signal=SIGTERM\nui_smoke_step=teardown-complete\n"},"started_at_ms":1791352471192,"completed_at_ms":1791352471192}}
{"timestamp":"2026-10-07T05:54:32.065Z","ordinal":82530,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","item":{"type":"CommandExecution","id":"exec-4f54bbc1-5a93-4c10-8dc0-6aebf90ac0d1","process_id":"5838","command":["/bin/zsh","-lc","UI_SMOKE_BROWSER_CHANNEL=chrome UI_SMOKE_HEADFUL=true node scripts/smoke-participant-booklet-variant.mjs > /tmp/testcenter-selected-request-variant-20261007.log 2>&1"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"unknown","cmd":"UI_SMOKE_BROWSER_CHANNEL=chrome UI_SMOKE_HEADFUL=true node scripts/smoke-participant-booklet-variant.mjs > /tmp/testcenter-selected-request-variant-20261007.log 2>&1"}],"source":"unified_exec_startup","status":"failed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n","stderr":"","aggregated_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n","exit_code":1,"duration":{"secs":0,"nanos":713132292},"formatted_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n"},"started_at_ms":1791352471352,"completed_at_ms":1791352472065}}
{"timestamp":"2026-10-07T05:54:32.069Z","ordinal":82531,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a114ed-8205-7130-a20d-e5a0eb0dcacf","call_id":"call_94edbc8877ae4f4a85223f090e864882","output":[{"type":"input_text","text":"Script completed\nWall time 1.0 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"5c8ac3\",\"wall_time_seconds\":0.000007167,\"exit_code\":0,\"original_token_count\":3880,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n.env.prod-template\\n@@ -29,7 +29,11 @@ RESTART_POLICY=always\\n ## Backend\\n BROADCASTER_ENABLED=true\\n FILE_SERVER_ENABLED=true\\n-BRUTE_FORCE_PROTECTION='admin login person'\\n+### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by\\n+### spaces. Empty disables the protection.\\n+### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a\\n+### TLS-terminating proxy), otherwise the protected logins are impossible.\\n+BRUTE_FORCE_PROTECTION=\\n ### Validate uploaded XML files against their XSD schema. Default is true.\\n XML_SCHEMA_VALIDATION=true\\n PASSWORD_SALT=t\\nfrontend/src/app/app-root/login/admin-login/admin-login.component.html\\n@@ -25,11 +25,14 @@\\n             <tc-alert [attr.data-cy]=\\\"'login-problem:' + problemCode\\\"\\n                       [level]=\\\"problemLevel\\\" [text]=\\\"problemText\\\"></tc-alert>\\n           }\\n+          @if (insecureContext()) {\\n+            <tc-alert data-cy=\\\"login-insecure-context\\\" level=\\\"error\\\" [text]=\\\"insecureContextMessage\\\"></tc-alert>\\n+          }\\n         </mat-card-content>\\n       }\\n       <mat-card-actions [style.justify-content]=\\\"'space-between'\\\">\\n         <button matButton=\\\"filled\\\" type=\\\"submit\\\" color=\\\"primary\\\" id=\\\"admin\\\" data-cy=\\\"login-admin\\\"\\n-                [disabled]=\\\"loginForm.invalid || busyWithChallenge\\\">\\n+                [disabled]=\\\"loginForm.invalid || busy || insecureContext()\\\">\\n           Anmelden\\n         </button>\\n       </mat-card-actions>\\nfrontend/src/app/app-root/login/login.component.html\\n@@ -52,8 +52,11 @@ <h2>Kennwort eingeben</h2>\\n           <tc-alert [attr.data-cy]=\\\"'login-problem:' + problemCode\\\"\\n                     [level]=\\\"problemLevel\\\" [text]=\\\"problemText\\\"></tc-alert>\\n         }\\n+        @if (insecureContext()) {\\n+          <tc-alert data-cy=\\\"login-insecure-context\\\" level=\\\"error\\\" [text]=\\\"insecureContextMessage\\\"></tc-alert>\\n+        }\\n         <button matButton=\\\"filled\\\" type=\\\"submit\\\" data-cy=\\\"login-user\\\"\\n-                [disabled]=\\\"!loginForm.get('name')?.valid || busyWithChallenge\\\">\\n+                [disabled]=\\\"!loginForm.get('name')?.valid || busy || insecureContext()\\\">\\n           Anmelden\\n         </button>\\n       </form>\\nfrontend/src/app/brute-force-protection.service.ts\\n@@ -0,0 +1,75 @@\\n+import { Injectable } from '@angular/core';\\n+import {\\n+  from, map, Observable, switchMap\\n+} from 'rxjs';\\n+import { MainDataService } from '@shared/services/maindata/maindata.service';\\n+import { AppError, AuthData } from './app.interfaces';\\n+import { BackendService, Challenge, ChallengeRequest } from './backend.service';\\n+\\n+type LoginType = 'admin' | 'login' | 'person';\\n+\\n+@Injectable({\\n+  providedIn: 'root'\\n+})\\n+export class BruteForceProtectionService {\\n+  constructor(private backendService: BackendService, private mainDataService: MainDataService) { }\\n+\\n+  static readonly insecureContextMessage =\\n+    'Die Anmeldung ist nur über eine verschlüsselte Verbindung (HTTPS) möglich. ' +\\n+    'Bitte wenden Sie sich an den Betreiber dieses Servers.';\\n+\\n+  /** Whether the backend requires a solved challenge for this login type (env var BRUTE_FORCE_PROTECTION). */\\n+  isActive$(loginType: LoginType): Observable<boolean> {\\n+    return this.mainDataService.appConfig$\\n+      .pipe(map(appConfig => appConfig.bruteForceProtection.includes(loginType)));\\n+  }\\n+\\n+  /**\\n+   * Whether this login type is protected but the challenge cannot be solved, because browsers provide the\\n+   * Web Crypto API only in secure contexts (HTTPS or localhost).\\n+   */\\n+  isUnavailable$(loginType: LoginType): Observable<boolean> {\\n+    return this.isActive$(loginType)\\n+      .pipe(map(isActive => isActive && !window.isSecureContext));\\n+  }\\n+\\n+  /**\\n+   * Logs in via proof of work: the backend issues a challenge for the given credentials, the browser solves it,\\n+   * and the solution is exchanged for a session. The credentials are only checked in the last step.\\n+   */\\n+  createSession(request: ChallengeRequest): Observable<AuthData> {\\n+    return this.backendService.createChallenge(request)\\n+      .pipe(\\n+        switchMap(challenge => from(this.solve(challenge))\\n+          .pipe(\\n+            switchMap(number => this.backendService.createSession(\\n+              challenge.algorithm,\\n+              challenge.challenge,\\n+              challenge.salt,\\n+              challenge.signature,\\n+              number\\n+            ))\\n+          ))\\n+      );\\n+  }\\n+\\n+  /** Finds the number the challenge hash was built from by brute force, spread over several web workers. */\\n+  private async solve(challenge: Challenge): Promise<number> {\\n+    const { solveChallengeWorkers } = await import('altcha-lib');\\n+    const solution = await solveChallengeWorkers(\\n+      `${window.document.baseURI}/altcha-lib/dist/worker.js`,\\n+      8,\\n+      challenge.challenge,\\n+      challenge.salt,\\n+      challenge.algorithm,\\n+      challenge.maxNumber\\n+    );\\n+    if (!solution) {\\n+      throw new AppError({\\n+        label: 'Problem bei der Anmeldung.',\\n+        description: 'Die Anmelde-Challenge konnte nicht gelöst werden.'\\n+      });\\n+    }\\n+    return solution.number;\\n+  }\\n+}\\nfrontend/src/app/shared/components/code-input/code-input.component.html\\n@@ -3,7 +3,8 @@\\n </ng-template>\\n \\n @if (inputType === 'text-field') {\\n-  <tc-code-text-field-form [buttonLabel]=\\\"buttonLabel\\\" (submitCode)=\\\"onSubmit($event)\\\">\\n+  <tc-code-text-field-form [buttonLabel]=\\\"buttonLabel\\\" [disabled]=\\\"disabled\\\"\\n+                           (submitCode)=\\\"onSubmit($event)\\\">\\n     <ng-container *ngTemplateOutlet=\\\"projectedContent\\\"></ng-container>\\n   </tc-code-text-field-form>\\n } @else {\\nscripts/update.sh\\n@@ -1,5 +1,4 @@\\n #!/usr/bin/env bash\\n-set -e\\n \\n # This is a small, version-independent bootstrap script, analogous to scripts/install.sh. Its only\\n # job is to figure out which release the user wants to update to and then download + run the\\n@@ -24,6 +23,10 @@ declare UPDATE_OPTION\\n declare SOURCE_VERSION\\n declare TARGET_VERSION\\n \\n+# Exit code of the backup phase when the user chose to stop the update there. Must match\\n+# ABORTED_BY_USER in scripts/updater.sh.\\n+declare ABORTED_BY_USER=2\\n+\\n check_version_tag_exists() {\\n   declare tag=\\\"${1}\\\"\\n   declare status_code\\n@@ -123,6 +126,10 @@ run_backup_phase() {\\n   declare exit_code=$?\\n   rm -f \\\"${source_updater}\\\"\\n \\n+  if [ ${exit_code} -eq ${ABORTED_BY_USER} ]; then\\n+    exit 0\\n+  fi\\n+\\n   if [ ${exit_code} -ne 0 ]; then\\n     exit ${exit_code}\\n   fi\\nscripts/updater.sh\\n@@ -44,6 +44,10 @@ declare HAS_MIGRATION_FILES=false\\n # separate process, downloaded from TARGET_VERSION).\\n declare MIGRATION_PENDING_MARKER=\\\"${APP_DIR}/backup/temp/.migration-pending\\\"\\n \\n+# Exit code of the backup phase when the user chooses to stop the update there. scripts/update.sh\\n+# then ends without running the apply phase. Must match ABORTED_BY_USER in scripts/update.sh.\\n+declare ABORTED_BY_USER=2\\n+\\n check_version_tag_exists() {\\n   declare tag=\\\"${1}\\\"\\n   declare status_code\\n@@ -117,7 +121,7 @@ create_backup_set() {\\n   if [[ ! ${continue} =~ ^[yY]$ ]]; then\\n     printf \\\"'%s' update script finished.\\\\n\\\" \\\"${APP_NAME}\\\"\\n \\n-    exit 0\\n+    exit ${ABORTED_BY_USER}\\n   fi\\n }\\n \\n@@ -266,7 +270,7 @@ run_complementary_migration_scripts() {\\n         fi\\n \\n         printf \\\"'%s' update script finished.\\\\n\\\\n\\\" \\\"${APP_NAME}\\\"\\n-        exit 0\\n+        exit ${ABORTED_BY_USER}\\n       fi\\n       printf \\\"\\\\n\\\"\\n \\nThe complete unit gates passed 144 core and 45 frontend tests; all 161 SQLite\\nAPI integration tests and the schema-57 startup smoke passed. A headful\\nChromium check held each external lock until after the actual Player save was\\nreleased to the API: both real POSTs waited approximately 790ms and returned\\n200, preserving the answer in the same run without HTTP 5xx or page errors.\\nRequest interception only synchronizes the lock; it does not mock the backend,\\nalter the payload or change the normal five-second response buffer.\\n\\nEvidence is retained locally in ignored\\n`.data/sqlite-contention-reference-20261004`. This closes the reproduced\\nshort-contention finding, not general multi-process scalability: synchronous\\nSQLite waiting blocks the API event loop, and long locks remain errors.\\nPostgreSQL deployment and server-side connection-loss parity remain distinct\\nacceptance requirements.\\n\\n## Current 19.0 delta to verify\\n\\nOn 2026-10-03, the Original fetch advanced to\\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (version 19.0).\\nGitHub `HEAD`, `master` and tag `19.0.0` were independently reverified on\\n2026-10-04 at the same revision (not the stale default HEAD of the local clone).\\nThe broad historical\\naudit below remains useful, but its 94% estimate is **not a verified estimate\\nagainst 19.0** and does not include the newly requested identical optional UI.\\nThe following additional acceptance requirements come from the 19.0 changelog\\nand implementation. Each needs current rewrite evidence before it is closed:\\n\\n- Required current-password confirmation for self-service password changes\\n  and for superadmin deletion of administrators/workspaces; resetting another\\n  administrator's password retains its distinct authorization boundary.\\n  Administrator and workspace DELETE now require the acting administrator's\\n  current password in `confirmationPassword`, after active-session and role /\\n  delegation checks and before any deletion. Workspace deletion always requires\\n  a platform administrator, even in diagnostic auth-off mode; its exact-key\\n  confirmation remains required and the audit actor comes from that session.\\n# Optional Original UI\\n\\n## Acceptance baseline\\n\\nRequested on 2026-09-12: keep the existing rewrite interface available and add\\nan optional interface identical to the Original Testcenter. This is a separate\\nacceptance axis from functional parity; the historical 94% estimate in\\nPARITY.md does not measure it.\\n\\nReference: `iqb-berlin/testcenter` commit\\n`c35cff81383949b4664e0fdffa3ba1154d144d9d` (19.0), fetched on 2026-10-03.\\nCompare source files from that revision, not the older local checkout.\\n\\n## Required behavior\\n\\n- Explicit, reversible interface selection. The existing rewrite interface\\n  remains the default until the Original interface passes acceptance.\\n- Both interfaces use the same authorized application services and persisted\\n  data. Switching must not reset answers, create a test run, change permissions,\\n  or bypass a participant navigation restriction.\\n- Preserve the independent Primar, Sekundar and Erwachsene presentation themes,\\n  authored texts, branding and participant-specific configuration.\\n- Do not equate a color/font override with an identical interface. Reproduce\\n  page structure, spacing, typography, controls, dialogs and interaction states.\\n- Keep rewrite-only tenant and diagnostic tools accessible without inserting\\n  them into the Original participant workflow.\\n\\n## Acceptance matrix\\n\\nBoth interfaces now bind the selected Run ID through state, asset preload,\\nlive updates and actual generated re-entry links. Exact preset assignment,\\nUnicode answers and Run ID survive hard reload; another run's later background\\nsaves cannot steal selection or bypass the selected run's monitor pause.\\nProduction/development protected SQLite browsers and headless production pass.\\nThe second open run in this focused fixture is repository-seeded, not started\\nthrough the still-blocked P0 workflow. These shared functional safeguards do not\\nclose any full rendered-UI acceptance row or pixel-identity claim.\\n\\nThe shared backend now permits exact preset-assignment resumption after returning\\nto the starter, rather than rejecting its variant key against the source Booklet\\nkey. Both interfaces passed real participant login, Unicode draft preservation,\\nconfirmed starter return, same-run resumption and session-link/hard-reload\\nrestoration with owned protected SQLite in production/development; production\\nalso passed headlessly. The mandatory quick-CI variant smoke retains exact\\nrun/answer assertions. This does not close the other-unfinished-Booklet P0 gap,\\nthe full starter row or any pixel-identity claim.\\n\\nLatest participant-starter comparison (2026-10-05): the optional renderer now\\nmatches the pinned 19.0 intrinsic 684px card/intro width, 24px gaps, 94px companion,\\nnormal paragraph typography, flex-column margins, Material icon baselines,\\ncompleted-button opacity and bordered Review action. The scrolling content is\\nviewport-bounded below the Source toolbar, including the authenticated account\\ncontrol at both sides of the 600px breakpoint. The native scroll button sends\\nthe actual Source's smooth 300px increment rather than jumping to the bottom.\\nThe Source's narrow-screen clipping is retained in this optional interface;\\nthe responsive Rewrite interface remains independently available.\\n\\nAll 48 equal-fixture states passed in each final production/development build:\\nthree themes × four viewports × fresh, mixed/completed with custom action labels,\\nlong/wrapped/unbreakable labels and Review-enabled starters. The reference uses\\nthe unmodified `c35cff81` frontend with a bounded API fixture; Rewrite uses real\\nprotected API/SQLite. Text, geometry and measured visible styles match,\\nincluding the account control and disabled opacity. Raw RGBA is identical in\\n33/48 production and 29/48 development pairs. Remaining pairs retain differences\\nup to 7,733 pixels and 67/255 channel units; complete pixel identity is not\\nestablished. Scripts, metrics, screenshots and logs are retained in ignored\\n`.data/original-starter-reference-20261005.*`.\\n\\nThe new mandatory quick-CI browser regression passes all 48 states in both builds\\nand exercises real login, keyboard scrolling, non-lifting account hover, a\\nblocked duplicate pending start, exact saved-answer resumption and participant\\nbearer authorization for the actual HTTP 204 Review export. The separate login\\nregression and all 165 core, 12 presence and 83 frontend/preflight tests passed.\\nInitial production output for that layout step was 469.61kB below the unchanged 470kB hard limit.\\nFresh publication CI remains separate proof. This narrow comparison does not\\nclose the complete starter/shell row: empty/error/custom-branding states,\\nSource snackbar feedback and other claims remain open. A functional P0 gap was\\nalso reproduced: another unfinished Booklet blocks an otherwise available\\nselection. Explicit run-bound reads now avoid answer-update chronology, while\\nhistorical session-only links retain that fallback. The\\nmixed rendering fixture completes one Booklet before starting the other; it\\ndoes not prove that blocked workflow. See PARITY.md's explicit acceptance.\\n\\nLatest administrator-login comparison (2026-10-04): the optional signed-out\\noperator entry now uses the pinned 19.0 400px Material card, bordered centered\\nform, German labels/actions, shared Source header/footer and Testtaker link.\\nIt calls the same authorized operator login, proof-of-work, persistence and\\nreturn-route logic as Rewrite; there is no second credential store. Native\\nsetup remains accessible through the interface selection or `?ui=rewrite`.\\nStructured error identifiers preserve Source copy despite different HTTP\\n# tests 165\\n# pass 165\\n# fail 0\\n# tests 12\\n# pass 12\\n# fail 0\\n# tests 95\\n# pass 95\\n# fail 0\\nui_smoke_step=teardown-browser\\nui_smoke_step=teardown-server\\n{\\\"timestamp\\\":\\\"2026-10-07T05:54:01.015Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"process_shutdown_requested\\\",\\\"signal\\\":\\\"SIGTERM\\\",\\\"storageKind\\\":\\\"memory\\\",\\\"shutdownDrainDelayMs\\\":1000}\\nshutdown_signal=SIGTERM\\nui_smoke_step=teardown-complete\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"1c485d\",\"wall_time_seconds\":0.713158875,\"exit_code\":1,\"original_token_count\":21,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a114e8-3dc1-7553-b4e3-fbed0e137776","create_time":1791352472.069757}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
