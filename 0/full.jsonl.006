{"timestamp":"2026-10-07T06:17:07.946Z","ordinal":82843,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":369998342,"cached_input_tokens":360181120,"cache_write_input_tokens":0,"output_tokens":1771142,"reasoning_output_tokens":851662,"total_tokens":371769484},"last_token_usage":{"input_tokens":239405,"cached_input_tokens":237056,"cache_write_input_tokens":0,"output_tokens":3024,"reasoning_output_tokens":1034,"total_tokens":242429},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":1.0,"window_minutes":10080,"resets_at":1791956734},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":null},"individual_limit":null,"spend_control_reached":null,"plan_type":"self_serve_business_prolite","rate_limit_reached_type":null}}}
