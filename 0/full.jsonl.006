{"timestamp":"2026-10-07T07:00:36.081Z","ordinal":83744,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_06ef5e23f2db4ce4016ac5eddbf6b08191a586786a80422afc","status":"completed","call_id":"call_errkllgJICfBT6ePiH7F3jhO","name":"exec","input":"text(await tools.apply_patch(\"*** Begin Patch\\n*** Add File: /Users/julian/code/testcenter-rewrite/rewrite-app/scripts/operator-run-links.test.mjs\\n+import assert from \\\"node:assert/strict\\\";\\n+import { readFileSync } from \\\"node:fs\\\";\\n+import test from \\\"node:test\\\";\\n+import ts from \\\"typescript\\\";\\n+\\n+const moduleUrl = code => `data:text/javascript;base64,${Buffer.from(code).toString(\\\"base64\\\")}`;\\n+const compile = code => ts.transpileModule(code, {\\n+  compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext }\\n+}).outputText;\\n+const source = file => readFileSync(new URL(`../apps/web/src/app/${file}.ts`, import.meta.url), \\\"utf8\\\");\\n+const readers = moduleUrl(compile(source(\\\"rewrite-app-shell.readers\\\")));\\n+const links = moduleUrl(compile(source(\\\"participant-session-links\\\")));\\n+\\n+// Execute the real getters and their real helpers. Only unrelated Angular\\n+// injection/field initialization is excluded; no card/link algorithm is copied.\\n+async function loadFacade(file, name) {\\n+  const ast = ts.createSourceFile(file, source(file), ts.ScriptTarget.ES2022, true);\\n+  const declaration = ast.statements.find(node => ts.isClassDeclaration(node) && node.name?.text === name);\\n+  assert.ok(declaration, `${name} must exist`);\\n+  const members = declaration.members.filter(node =>\\n+    ts.isMethodDeclaration(node) || ts.isGetAccessorDeclaration(node) || ts.isSetAccessorDeclaration(node) ||\\n+    (ts.isPropertyDeclaration(node) && node.initializer && ts.isArrowFunction(node.initializer))\\n+  ).map(node => node.getText(ast)).join(\\\"\\\\n\\\");\\n+  return (await import(moduleUrl(compile(`\\n+    import { parseJsonDocument, readStringValue, readNumberValue, readUnknownValue } from ${JSON.stringify(readers)};\\n+    import { participantSessionLinkRows as buildParticipantSessionLinkRows,\\n+      buildParticipantEntryUrl as buildParticipantEntryLinkUrl } from ${JSON.stringify(links)};\\n+    export class ${name} { ${members} }\\n+  `))))[name];\\n+}\\n+const WorkspaceViewFacade = await loadFacade(\\\"workspace-view.facade\\\", \\\"WorkspaceViewFacade\\\");\\n+const ContentViewFacade = await loadFacade(\\\"content-view.facade\\\", \\\"ContentViewFacade\\\");\\n+const date = \\\"2026-10-07T06:00:00.000Z\\\";\\n+const participantSession = {\\n+  participantSessionId: \\\"owned/session:ä\\\", loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\",\\n+  status: \\\"running\\\", createdAt: date\\n+};\\n+const run = (id, assignment) => ({\\n+  testRunId: id, participantSessionId: participantSession.participantSessionId,\\n+  bookletKey: \\\"BOOKLET\\\", ...(assignment ? { bookletAssignmentKey: assignment } : {}),\\n+  status: \\\"running\\\", currentUnitKey: \\\"unit-a\\\", unitResponses: {}, createdAt: date, updatedAt: date\\n+});\\n+const runA = run(\\\"run/A:ä\\\", \\\"BOOKLET#level:advanced\\\");\\n+const runB = run(\\\"run/B\\\", \\\"BOOKLET#level:beginner\\\");\\n+const runItem = testRun => ({\\n+  testRun, participantSession, participantRosterEntry: null,\\n+  responseCount: 1, reviewCount: 0, responseLength: 5, answered: true, expected: true\\n+});\\n+const detail = overrides => ({\\n+  tenantKey: \\\"owned-tenant\\\", workspaceKey: \\\"owned-workspace\\\", loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\",\\n+  generatedAt: date, unitProgress: [], bookletProgress: [], rosterEntries: [], sessions: [], unitRows: [],\\n+  testRuns: [runItem(runA), runItem(runB)], ...overrides\\n+});\\n+const createFacade = (Type, workspace = {}, content = {}) => {\\n+  const facade = new Type();\\n+  facade.uiState = {\\n+    workspace: { tenantKey: \\\"owned-tenant\\\", workspaceKey: \\\"owned-workspace\\\", ...workspace },\\n+    content: { sourcePackageId: \\\"\\\", importJobId: \\\"\\\", contentReleaseId: \\\"\\\", ...content },\\n+    runtime: { participantSessionId: \\\"\\\", testRunId: \\\"\\\", loginKey: \\\"\\\" }\\n+  };\\n+  facade.workspace = facade.uiState.workspace;\\n+  facade.content = facade.uiState.content;\\n+  return facade;\\n+};\\n+const linkRows = items => items.flatMap(item => item.rows ?? []).filter(row => row.label === \\\"Participant Link\\\");\\n+const assertLink = (row, testRun, bookletKey = testRun?.bookletAssignmentKey ?? testRun?.bookletKey) => {\\n+  assert.equal(row.value, row.href);\\n+  const url = new URL(row.href, \\\"https://owned.example\\\");\\n+  assert.equal(url.pathname, \\\"/participant\\\");\\n+  assert.deepEqual(Object.fromEntries(url.searchParams), {\\n+    participantSessionId: participantSession.participantSessionId,\\n+    ...(testRun ? { testRunId: testRun.testRunId } : {}),\\n+    tenantKey: \\\"owned-tenant\\\", workspaceKey: \\\"owned-workspace\\\", loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\",\\n+    ...(bookletKey ? { bookletKey } : {})\\n+  });\\n+};\\n+\\n+for (const [getter, field, payloadKey] of [\\n+  [\\\"studyMonitorParticipantItems\\\", \\\"studyMonitorParticipantView\\\", \\\"studyMonitorParticipant\\\"],\\n+  [\\\"studyMonitorBookletItems\\\", \\\"studyMonitorBookletView\\\", \\\"studyMonitorBooklet\\\"],\\n+  [\\\"studyMonitorGroupItems\\\", \\\"studyMonitorGroupView\\\", \\\"studyMonitorGroup\\\"],\\n+  [\\\"studyMonitorUnitItems\\\", \\\"studyMonitorUnitView\\\", \\\"studyMonitorUnit\\\"]\\n+]) {\\n+  test(`${getter} keeps each represented run and exact preset assignment`, () => {\\n+    const facade = createFacade(WorkspaceViewFacade, { [field]: JSON.stringify({ [payloadKey]: detail() }) });\\n+    const rows = linkRows(facade[getter]);\\n+    assert.equal(rows.length, 2);\\n+    assertLink(rows[0], runA);\\n+    assertLink(rows[1], runB);\\n+  });\\n+}\\n+\\n+test(\\\"participant unit cards bind their row's run, assignment and group\\\", () => {\\n+  const unitRows = [runA, runB].map(testRun => ({\\n+    participantSessionId: participantSession.participantSessionId, testRunId: testRun.testRunId,\\n+    loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\", bookletKey: \\\"BOOKLET\\\", unitKey: \\\"unit-a\\\"\\n+  }));\\n+  const facade = createFacade(WorkspaceViewFacade, {\\n+    studyMonitorParticipantView: JSON.stringify({ studyMonitorParticipant: detail({ unitRows, testRuns: [runItem(runA), runItem(runB)] }) })\\n+  });\\n+  const rows = linkRows(facade.studyMonitorParticipantItems);\\n+  assert.equal(rows.length, 4);\\n+  assertLink(rows[0], runA);\\n+  assertLink(rows[1], runB);\\n+});\\n+\\n+test(\\\"group session cards use the represented latest run before an unrelated first roster assignment\\\", () => {\\n+  const facade = createFacade(WorkspaceViewFacade, {\\n+    studyMonitorGroupView: JSON.stringify({ studyMonitorGroup: detail({\\n+      testRuns: [], sessions: [{ participantSession, latestTestRun: runB,\\n+        participantRosterEntry: { bookletKey: \\\"UNRELATED-FIRST\\\", displayName: \\\"Owned\\\" } }]\\n+    }) })\\n+  });\\n+  assertLink(linkRows(facade.studyMonitorGroupItems)[0], runB);\\n+});\\n+\\n+test(\\\"a group session without a run remains a legitimate session-only entry\\\", () => {\\n+  const facade = createFacade(WorkspaceViewFacade, {\\n+    studyMonitorGroupView: JSON.stringify({ studyMonitorGroup: detail({\\n+      testRuns: [], sessions: [{ participantSession, latestTestRun: null,\\n+        participantRosterEntry: { bookletKey: \\\"ROSTER-BOOKLET\\\" } }]\\n+    }) })\\n+  });\\n+  assertLink(linkRows(facade.studyMonitorGroupItems)[0], null, \\\"ROSTER-BOOKLET\\\");\\n+});\\n+\\n+for (const getter of [\\\"workspaceActivityItems\\\", \\\"workspaceActivityDetailItems\\\"]) {\\n+  test(`${getter} binds historical run subjects and explicit run details, never an unrelated subject`, () => {\\n+    const events = [\\n+      { subjectType: \\\"test_run\\\", subjectId: runA.testRunId, details: { testRunId: \\\"stale-detail\\\" } },\\n+      { subjectType: \\\"participant_session\\\", subjectId: participantSession.participantSessionId, details: { testRunId: runA.testRunId } },\\n+      { subjectType: \\\"participant_session\\\", subjectId: participantSession.participantSessionId, details: {} }\\n+    ].map((event, index) => ({ activityEvent: {\\n+      activityEventId: `event-${index}`, summary: \\\"Owned historical event\\\", occurredAt: date,\\n+      eventType: \\\"test_run_created\\\", ...event,\\n+      details: { participantSessionId: participantSession.participantSessionId, loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\",\\n+        bookletKey: \\\"BOOKLET\\\", bookletAssignmentKey: runA.bookletAssignmentKey, sessionToken: \\\"never-export-this\\\", ...event.details }\\n+    } }));\\n+    const facade = createFacade(WorkspaceViewFacade, { workspaceActivityView: JSON.stringify({ items: events }) });\\n+    const rows = linkRows(facade[getter]);\\n+    assert.equal(rows.length, 3);\\n+    assertLink(rows[0], runA);\\n+    assertLink(rows[1], runA);\\n+    assertLink(rows[2], null, runA.bookletAssignmentKey);\\n+    assert.equal(JSON.stringify(rows).includes(\\\"never-export-this\\\"), false);\\n+  });\\n+}\\n+\\n+test(\\\"activation blockers bind the actual blocking run rather than the session fallback\\\", () => {\\n+  const facade = createFacade(ContentViewFacade, {}, { contentReleaseActivationReadinessView: JSON.stringify({ activationReadiness: {\\n+    blockingOpenRuns: [{ ...runA, loginKey: \\\"owned-login\\\", groupKey: \\\"owned-group\\\", participantRosterEntry: null }]\\n+  } }) });\\n+  // OpenMonitorRun exposes the source Booklet, not the preset-assignment field.\\n+  assertLink(linkRows(facade.activationBlockingRunItems)[0], runA, \\\"BOOKLET\\\");\\n+});\\n+\\n+test(\\\"content release run cards keep separate runs and preset assignments in one session\\\", () => {\\n+  const facade = createFacade(ContentViewFacade, {}, { contentReleaseDetailView: JSON.stringify({ contentReleaseDetail: {\\n+    contentRelease: { releaseLabel: \\\"Owned\\\" }, participantRosterEntries: [], participantSessions: [participantSession], testRuns: [runA, runB]\\n+  } }) });\\n+  const rows = linkRows(facade.contentReleaseTestRunItems);\\n+  assert.equal(rows.length, 2);\\n+  assertLink(rows[0], runA);\\n+  assertLink(rows[1], runB);\\n+});\\n+\\n+test(\\\"content session cards do not invent a run selection when they represent only a session\\\", () => {\\n+  const facade = createFacade(ContentViewFacade, {}, { contentReleaseDetailView: JSON.stringify({ contentReleaseDetail: {\\n+    contentRelease: { releaseLabel: \\\"Owned\\\" }, participantRosterEntries: [], participantSessions: [participantSession], testRuns: [runA, runB]\\n+  } }) });\\n+  assertLink(linkRows(facade.contentReleaseParticipantSessionItems)[0], null);\\n+});\\n+\\n+test(\\\"a run card without a known owning session never emits a participant re-entry link\\\", () => {\\n+  const facade = createFacade(WorkspaceViewFacade, { studyMonitorParticipantView: JSON.stringify({ studyMonitorParticipant: detail({\\n+    testRuns: [{ ...runItem(runA), participantSession: null }]\\n+  }) }) });\\n+  assert.deepEqual(linkRows(facade.studyMonitorParticipantItems), []);\\n+});\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"node --test scripts/operator-run-links.test.mjs\",workdir:\"/Users/julian/code/testcenter-rewrite/rewrite-app\",max_output_tokens:2000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a11526-9c9a-7463-b440-efbb190b92c4","create_time":1791356354.97783}}}
{"timestamp":"2026-10-07T07:00:36.094Z","ordinal":83745,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a11526-9c9a-7463-b440-efbb190b92c4","item":{"type":"FileChange","id":"exec-dab8c766-5726-41cf-aa7b-6c2d40d4ce05","changes":{"/Users/julian/code/testcenter-rewrite/rewrite-app/scripts/operator-run-links.test.mjs":{"type":"add","content":"import assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\nimport test from \"node:test\";\nimport ts from \"typescript\";\n\nconst moduleUrl = code => `data:text/javascript;base64,${Buffer.from(code).toString(\"base64\")}`;\nconst compile = code => ts.transpileModule(code, {\n  compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext }\n}).outputText;\nconst source = file => readFileSync(new URL(`../apps/web/src/app/${file}.ts`, import.meta.url), \"utf8\");\nconst readers = moduleUrl(compile(source(\"rewrite-app-shell.readers\")));\nconst links = moduleUrl(compile(source(\"participant-session-links\")));\n\n// Execute the real getters and their real helpers. Only unrelated Angular\n// injection/field initialization is excluded; no card/link algorithm is copied.\nasync function loadFacade(file, name) {\n  const ast = ts.createSourceFile(file, source(file), ts.ScriptTarget.ES2022, true);\n  const declaration = ast.statements.find(node => ts.isClassDeclaration(node) && node.name?.text === name);\n  assert.ok(declaration, `${name} must exist`);\n  const members = declaration.members.filter(node =>\n    ts.isMethodDeclaration(node) || ts.isGetAccessorDeclaration(node) || ts.isSetAccessorDeclaration(node) ||\n    (ts.isPropertyDeclaration(node) && node.initializer && ts.isArrowFunction(node.initializer))\n  ).map(node => node.getText(ast)).join(\"\\n\");\n  return (await import(moduleUrl(compile(`\n    import { parseJsonDocument, readStringValue, readNumberValue, readUnknownValue } from ${JSON.stringify(readers)};\n    import { participantSessionLinkRows as buildParticipantSessionLinkRows,\n      buildParticipantEntryUrl as buildParticipantEntryLinkUrl } from ${JSON.stringify(links)};\n    export class ${name} { ${members} }\n  `))))[name];\n}\nconst WorkspaceViewFacade = await loadFacade(\"workspace-view.facade\", \"WorkspaceViewFacade\");\nconst ContentViewFacade = await loadFacade(\"content-view.facade\", \"ContentViewFacade\");\nconst date = \"2026-10-07T06:00:00.000Z\";\nconst participantSession = {\n  participantSessionId: \"owned/session:ä\", loginKey: \"owned-login\", groupKey: \"owned-group\",\n  status: \"running\", createdAt: date\n};\nconst run = (id, assignment) => ({\n  testRunId: id, participantSessionId: participantSession.participantSessionId,\n  bookletKey: \"BOOKLET\", ...(assignment ? { bookletAssignmentKey: assignment } : {}),\n  status: \"running\", currentUnitKey: \"unit-a\", unitResponses: {}, createdAt: date, updatedAt: date\n});\nconst runA = run(\"run/A:ä\", \"BOOKLET#level:advanced\");\nconst runB = run(\"run/B\", \"BOOKLET#level:beginner\");\nconst runItem = testRun => ({\n  testRun, participantSession, participantRosterEntry: null,\n  responseCount: 1, reviewCount: 0, responseLength: 5, answered: true, expected: true\n});\nconst detail = overrides => ({\n  tenantKey: \"owned-tenant\", workspaceKey: \"owned-workspace\", loginKey: \"owned-login\", groupKey: \"owned-group\",\n  generatedAt: date, unitProgress: [], bookletProgress: [], rosterEntries: [], sessions: [], unitRows: [],\n  testRuns: [runItem(runA), runItem(runB)], ...overrides\n});\nconst createFacade = (Type, workspace = {}, content = {}) => {\n  const facade = new Type();\n  facade.uiState = {\n    workspace: { tenantKey: \"owned-tenant\", workspaceKey: \"owned-workspace\", ...workspace },\n    content: { sourcePackageId: \"\", importJobId: \"\", contentReleaseId: \"\", ...content },\n    runtime: { participantSessionId: \"\", testRunId: \"\", loginKey: \"\" }\n  };\n  facade.workspace = facade.uiState.workspace;\n  facade.content = facade.uiState.content;\n  return facade;\n};\nconst linkRows = items => items.flatMap(item => item.rows ?? []).filter(row => row.label === \"Participant Link\");\nconst assertLink = (row, testRun, bookletKey = testRun?.bookletAssignmentKey ?? testRun?.bookletKey) => {\n  assert.equal(row.value, row.href);\n  const url = new URL(row.href, \"https://owned.example\");\n  assert.equal(url.pathname, \"/participant\");\n  assert.deepEqual(Object.fromEntries(url.searchParams), {\n    participantSessionId: participantSession.participantSessionId,\n    ...(testRun ? { testRunId: testRun.testRunId } : {}),\n    tenantKey: \"owned-tenant\", workspaceKey: \"owned-workspace\", loginKey: \"owned-login\", groupKey: \"owned-group\",\n    ...(bookletKey ? { bookletKey } : {})\n  });\n};\n\nfor (const [getter, field, payloadKey] of [\n  [\"studyMonitorParticipantItems\", \"studyMonitorParticipantView\", \"studyMonitorParticipant\"],\n  [\"studyMonitorBookletItems\", \"studyMonitorBookletView\", \"studyMonitorBooklet\"],\n  [\"studyMonitorGroupItems\", \"studyMonitorGroupView\", \"studyMonitorGroup\"],\n  [\"studyMonitorUnitItems\", \"studyMonitorUnitView\", \"studyMonitorUnit\"]\n]) {\n  test(`${getter} keeps each represented run and exact preset assignment`, () => {\n    const facade = createFacade(WorkspaceViewFacade, { [field]: JSON.stringify({ [payloadKey]: detail() }) });\n    const rows = linkRows(facade[getter]);\n    assert.equal(rows.length, 2);\n    assertLink(rows[0], runA);\n    assertLink(rows[1], runB);\n  });\n}\n\ntest(\"participant unit cards bind their row's run, assignment and group\", () => {\n  const unitRows = [runA, runB].map(testRun => ({\n    participantSessionId: participantSession.participantSessionId, testRunId: testRun.testRunId,\n    loginKey: \"owned-login\", groupKey: \"owned-group\", bookletKey: \"BOOKLET\", unitKey: \"unit-a\"\n  }));\n  const facade = createFacade(WorkspaceViewFacade, {\n    studyMonitorParticipantView: JSON.stringify({ studyMonitorParticipant: detail({ unitRows, testRuns: [runItem(runA), runItem(runB)] }) })\n  });\n  const rows = linkRows(facade.studyMonitorParticipantItems);\n  assert.equal(rows.length, 4);\n  assertLink(rows[0], runA);\n  assertLink(rows[1], runB);\n});\n\ntest(\"group session cards use the represented latest run before an unrelated first roster assignment\", () => {\n  const facade = createFacade(WorkspaceViewFacade, {\n    studyMonitorGroupView: JSON.stringify({ studyMonitorGroup: detail({\n      testRuns: [], sessions: [{ participantSession, latestTestRun: runB,\n        participantRosterEntry: { bookletKey: \"UNRELATED-FIRST\", displayName: \"Owned\" } }]\n    }) })\n  });\n  assertLink(linkRows(facade.studyMonitorGroupItems)[0], runB);\n});\n\ntest(\"a group session without a run remains a legitimate session-only entry\", () => {\n  const facade = createFacade(WorkspaceViewFacade, {\n    studyMonitorGroupView: JSON.stringify({ studyMonitorGroup: detail({\n      testRuns: [], sessions: [{ participantSession, latestTestRun: null,\n        participantRosterEntry: { bookletKey: \"ROSTER-BOOKLET\" } }]\n    }) })\n  });\n  assertLink(linkRows(facade.studyMonitorGroupItems)[0], null, \"ROSTER-BOOKLET\");\n});\n\nfor (const getter of [\"workspaceActivityItems\", \"workspaceActivityDetailItems\"]) {\n  test(`${getter} binds historical run subjects and explicit run details, never an unrelated subject`, () => {\n    const events = [\n      { subjectType: \"test_run\", subjectId: runA.testRunId, details: { testRunId: \"stale-detail\" } },\n      { subjectType: \"participant_session\", subjectId: participantSession.participantSessionId, details: { testRunId: runA.testRunId } },\n      { subjectType: \"participant_session\", subjectId: participantSession.participantSessionId, details: {} }\n    ].map((event, index) => ({ activityEvent: {\n      activityEventId: `event-${index}`, summary: \"Owned historical event\", occurredAt: date,\n      eventType: \"test_run_created\", ...event,\n      details: { participantSessionId: participantSession.participantSessionId, loginKey: \"owned-login\", groupKey: \"owned-group\",\n        bookletKey: \"BOOKLET\", bookletAssignmentKey: runA.bookletAssignmentKey, sessionToken: \"never-export-this\", ...event.details }\n    } }));\n    const facade = createFacade(WorkspaceViewFacade, { workspaceActivityView: JSON.stringify({ items: events }) });\n    const rows = linkRows(facade[getter]);\n    assert.equal(rows.length, 3);\n    assertLink(rows[0], runA);\n    assertLink(rows[1], runA);\n    assertLink(rows[2], null, runA.bookletAssignmentKey);\n    assert.equal(JSON.stringify(rows).includes(\"never-export-this\"), false);\n  });\n}\n\ntest(\"activation blockers bind the actual blocking run rather than the session fallback\", () => {\n  const facade = createFacade(ContentViewFacade, {}, { contentReleaseActivationReadinessView: JSON.stringify({ activationReadiness: {\n    blockingOpenRuns: [{ ...runA, loginKey: \"owned-login\", groupKey: \"owned-group\", participantRosterEntry: null }]\n  } }) });\n  // OpenMonitorRun exposes the source Booklet, not the preset-assignment field.\n  assertLink(linkRows(facade.activationBlockingRunItems)[0], runA, \"BOOKLET\");\n});\n\ntest(\"content release run cards keep separate runs and preset assignments in one session\", () => {\n  const facade = createFacade(ContentViewFacade, {}, { contentReleaseDetailView: JSON.stringify({ contentReleaseDetail: {\n    contentRelease: { releaseLabel: \"Owned\" }, participantRosterEntries: [], participantSessions: [participantSession], testRuns: [runA, runB]\n  } }) });\n  const rows = linkRows(facade.contentReleaseTestRunItems);\n  assert.equal(rows.length, 2);\n  assertLink(rows[0], runA);\n  assertLink(rows[1], runB);\n});\n\ntest(\"content session cards do not invent a run selection when they represent only a session\", () => {\n  const facade = createFacade(ContentViewFacade, {}, { contentReleaseDetailView: JSON.stringify({ contentReleaseDetail: {\n    contentRelease: { releaseLabel: \"Owned\" }, participantRosterEntries: [], participantSessions: [participantSession], testRuns: [runA, runB]\n  } }) });\n  assertLink(linkRows(facade.contentReleaseParticipantSessionItems)[0], null);\n});\n\ntest(\"a run card without a known owning session never emits a participant re-entry link\", () => {\n  const facade = createFacade(WorkspaceViewFacade, { studyMonitorParticipantView: JSON.stringify({ studyMonitorParticipant: detail({\n    testRuns: [{ ...runItem(runA), participantSession: null }]\n  }) }) });\n  assert.deepEqual(linkRows(facade.studyMonitorParticipantItems), []);\n});\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/julian/code/testcenter-rewrite/rewrite-app/scripts/operator-run-links.test.mjs\n","stderr":""},"started_at_ms":1791356436093,"completed_at_ms":1791356436094}}
