>${ibUnitKey}</Id>\\n            <Label>IB Simple sample</Label>\\n          </Metadata>\\n          <Definition player=\\\"${ibPlayerPackage.playerKey}\\\"><![CDATA[${ibDefinitionDocument}]]></Definition>\\n          <Dependencies>\\n            <File for=\\\"player\\\">${ibPlayerPackage.requiredResourceId}</File>\\n          </Dependencies>\\n        </Unit>\\n      `\\n    },\\n    {\\n      fileName: \\\"export/players/verona-player-ib-0.2.html\\\",\\n      content: ibPlayerDocument\\n    },\\n    {\\n      fileName: \\\"export/resources/IB_SAMPLE_2025.itcr.zip\\\",\\n      content: ibResourcePackage\\n    }\\n  ]);\\n  await sendSmokeJson(`${baseUrl}/api/v1/platform/tenants`, {\\n    body: {\\n      tenantKey: ibTenantKey,\\n      displayName: \\\"Official IB ItemBuilder Player\\\"\\n    }\\n  });\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"2b1cef\",\"wall_time_seconds\":0.000006875,\"exit_code\":0,\"original_token_count\":36,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\n/tmp/testcenter-selected-request-production-20261007.Xr9BLp\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"00c7a3\",\"wall_time_seconds\":0.000007708,\"exit_code\":0,\"original_token_count\":279,\"output\":\"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\\nscripts/smoke-ib-player.mjs:17:const ibRuntimeReadyTimeoutMs = 60_000;\\nscripts/smoke-ib-player.mjs:208:      content: `<manifest xmlns=\\\"http://www.imsglobal.org/xsd/imscp_v1p1\\\"><resources><resource identifier=\\\"${bookletKey}\\\" href=\\\"booklets/Booklet.xml\\\" /><resource identifier=\\\"${unitKey}\\\" href=\\\"units/Simple.xml\\\" /><resource identifier=\\\"${playerPackage.playerKey}\\\" href=\\\"players/player.html\\\" /><resource identifier=\\\"${playerPackage.requiredResourceId}\\\" href=\\\"resources/IB_SAMPLE_2025.itcr.zip\\\" /></resources></manifest>`\\nscripts/smoke-ib-player.mjs:220:      fileName: \\\"export/resources/I