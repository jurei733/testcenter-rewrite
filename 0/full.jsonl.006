"}\\n3752-2026-10-07T06:12:30.1152566Z {\\\"timestamp\\\":\\\"2026-10-07T06:12:30.114Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"ee048bd6-1920-45c8-bdf1-2ce1175ce3ee\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/participant/test-runs/:testRunId/save-progress\\\",\\\"path\\\":\\\"/api/v1/participant/test-runs/97e7b3ed-8855-4711-b483-d062364e557f/save-progress\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":8.138,\\\"storageKind\\\":\\\"sqlite\\\"}\\n3753-2026-10-07T06:12:30.1255814Z {\\\"timestamp\\\":\\\"2026-10-07T06:12:30.125Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"8009040e-8a35-4b1f-8514-909f52aaec94\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/participant/test-runs/:testRunId/save-progress\\\",\\\"path\\\":\\\"/api/v1/participant/test-runs/97e7b3ed-8855-4711-b483-d062364e557f/save-progress\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":10.227,\\\"storageKind\\\":\\\"sqlite\\\"}\\n3754-2026-10-07T06:12:30.1345062Z {\\\"timestamp\\\":\\\"2026-10-07T06:12:30.134Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"ab83de3f-20e2-4f15-b94c-1e5f45d5dc50\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/participant/test-runs/:testRunId/save-progress\\\",\\\"path\\\":\\\"/api/v1/participant/test-runs/97e7b3ed-8855-4711-b483-d062364e557f/save-progress\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":8.616,\\\"storageKind\\\":\\\"sqlite\\\"}\\n3755-2026-10-07T06:12:30.1432885Z {\\\"timestamp\\\":\\\"2026-10-07T06:12:30.142Z\\\",\\\"level\\\":\\\"info\\\",\\\"event\\\":\\\"http_request_completed\\\",\\\"requestId\\\":\\\"7da1ba27-883a-4b87-84a3-91cffd42ee3b\\\",\\\"method\\\":\\\"POST\\\",\\\"route\\\":\\\"POST /api/v1/participant/test-runs/:testRunId/save-progress\\\",\\\"path\\\":\\\"/api/v1/participant/test-runs/97e7b3ed-8855-4711-b483-d062364e557f/save-progress\\\",\\\"statusCode\\\":200,\\\"durationMs\\\":8.619,\\\"storageKind\\\":\\\"sqlite\\\"}\\n--\\n8335-2026-10-07T06:18:49.7584838Z Call log:\\n8336-2026-10-07T06:18:49.7587641Z   - waiting for locator('article.card').filter({ has: getByRole('heading', { name: 'Participant Sessions' }) }).locator('.record-card').filter({ hasText: 'student-ui' }).first().getByRole('link', { name: 'http://127.0.0.1:33033/participant?participantSessionId=a367fca7-ae30-4e96-bfbb-5baf52e4d0fa&tenantKey=ui-tenant-1791353300564&workspaceKey=ui-workspace-1791353300564&loginKey=student-ui&groupKey=group%3Astudent-ui&bookletKey=booklet%3Astarter' }) to be visible\\n8337-2026-10-07T06:18:49.7589643Z \\n8338-2026-10-07T06:18:49.7590141Z     at /home/runner/work/testcenter-rewrite/testcenter-rewrite/rewrite-app/scripts/smoke-ui.mjs:21293:6 {\\n8339:2026-10-07T06:18:49.7590626Z   name: 'TimeoutError'\\n8340-2026-10-07T06:18:49.7590866Z }\\n8341-2026-10-07T06:18:49.7590965Z \\n8342-2026-10-07T06:18:49.7591061Z Node.js v22.23.3\\n8343:2026-10-07T06:18:49.8144247Z ##[error]Process completed with exit code 1.\\n8344-2026-10-07T06:18:49.8286583Z Post job cleanup.\\n8345-2026-10-07T06:18:49.9159059Z [command]/usr/bin/git version\\n8346-2026-10-07T06:18:49.9207842Z git version 2.55.0\\n8347-2026-10-07T06:18:49.9255411Z Temporarily overriding HOME='/home/runner/work/_temp/283bdc8e-3378-40b6-b910-90f690d072bd' before making global git config changes\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a11505-6069-7411-b5ab-e7c10a97a630","create_time":1791354190.20327}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
