el: \"review\" | \"units\"): void {\n    if (panel === \"review\" && !this.view.player.canReview ||\n        panel === \"units\" && !this.view.player.showUnitMenu) {\n      return;\n    }\n    this.originalPanel.update(current => current === panel ? null : panel);\n  }\n  readonly browserCompatibility = inject(BrowserCompatibilityService);\n  readonly showStarterScrollButton = signal(false);\n  private readonly retainedVisibleCodeNotice =\n    signal<ParticipantVisibleCodeNotice | null>(null);\n  private readonly dismissedVisibleCodeNoticeKey = signal<string | null>(null);\n  private starterBottomElement: HTMLElement | null = null;\n  private readonly starterScrollObserver =\n    typeof IntersectionObserver === \"undefined\"\n      ? null\n      : new IntersectionObserver(([entry]) => {\n          this.showStarterScrollButton.set(Boolean(entry && !entry.isIntersecting));\n        });\n\n  @ViewChild(\"participantStarterBottomSentinel\")\n  set participantStarterBottomSentinel(\n    element: ElementRef<HTMLElement> | undefined\n  ) {\n    if (this.starterBottomElement) {\n      this.starterScrollObserver?.unobserve(this.starterBottomElement);\n    }\n    this.starterBottomElement = element?.nativeElement ?? null;\nsed: apps/web/src/app/participant-side-panel.component.ts: No such file or directory\n{\"timestamp\":\"2026-10-03T18:43:55.042Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"31a9ec5a-295f-4fda-9fff-9c3984bf99ec\",\"method\":\"GET\",\"route\":\"GET /api/v1/system-check/access\",\"path\":\"/api/v1/system-check/access\",\"statusCode\":200,\"durationMs\":1.585,\"storageKind\":\"sqlite\"}\n{\"timestamp\":\"2026-10-03T18:43:55.169Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"464e2bc5-ada1-4b64-8ed3-3411cf64a273\",\"method\":\"GET\",\"route\":\"GET /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/system-checks\",\"path\":\"/api/v1/tenants/ui-tenant-1791052599463/workspaces/ui-workspace-1791052599463/syst