17:57Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:18:10Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Run npm ci\\\",\\\"number\\\":4,\\\"startedAt\\\":\\\"2026-10-03T18:17:59Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:18:10Z\\\",\\\"conclusion\\\":\\\"skipped\\\",\\\"name\\\":\\\"Run npx playwright install --with-deps chromium\\\",\\\"number\\\":5,\\\"startedAt\\\":\\\"2026-10-03T18:18:10Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Run integration-memory\\\",\\\"number\\\":6,\\\"startedAt\\\":\\\"2026-10-03T18:18:10Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Post Run actions/setup-node@v4\\\",\\\"number\\\":11,\\\"startedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Post Run actions/checkout@v4\\\",\\\"number\\\":12,\\\"startedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"status\\\":\\\"completed\\\"},{\\\"completedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Complete job\\\",\\\"number\\\":13,\\\"startedAt\\\":\\\"2026-10-03T18:19:40Z\\\",\\\"status\\\":\\\"completed\\\"}],\\\"url\\\":\\\"https://github.com/jurei733/testcenter-rewrite/actions/runs/37143420887/job/111262390396\\\"},{\\\"completedAt\\\":\\\"0001-01-01T00:00:00Z\\\",\\\"conclusion\\\":\\\"\\\",\\\"databaseId\\\":111262390411,\\\"name\\\":\\\"verify-memory-sqlite (ui-monitor-bulk)\\\",\\\"startedAt\\\":\\\"2026-10-03T18:16:14Z\\\",\\\"status\\\":\\\"in_progress\\\",\\\"steps\\\":[{\\\"completedAt\\\":\\\"2026-10-03T18:16:16Z\\\",\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"Set up job\\\",\\\"number\\\":1,\\\"startedAt\\\":\\\"2026-10-03T18:16:15Z\\\",\\\"status\\\"