antLogin').waitFor();\n    await page.locator('#originalApplicationFooter').waitFor();\n    assert.deepEqual(await page.locator('#originalApplicationFooter nav a').allTextContents(),\n      ['Barrierefreiheit', 'Datenschutz', 'Impressum']);\n    assert.match(await page.locator('#originalApplicationFooter .version-label').textContent(), /Version Rewrite/);\n    const footer = await page.locator('#originalApplicationFooter').boundingBox();\n    assert.ok(Math.abs(footer.y + footer.height - 900) <= 2, 'Original login footer must reach the viewport bottom');\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    await page.screenshot({ path: '/tmp/testcenter-original-login-footer-desktop.png', fullPage: true });\n    console.log('PASS Original login footer labels, order and truthful build identity; no signed-in menu');\n    const response = await page.request.post(`${TARGET_URL}/api/v1/participant/auth/sign-in`,\n      { data: { ...scope, loginKey: 'Test_Ctrl-2a', password: '123' } });\n    assert.equal(response.ok(), true);\n    const signedIn = await response.json();\n    const sessionId = signedIn.participantSession.participantSessionId;\n    await page.request.post(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/resume`,\n      { data: { bookletKey: 'Cy-Bklt_TC-2a' } });\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ participantSessionId: sessionId, ui: 'original' })}`);\n    await page.locator('#originalPlayerToolbar').waitFor();\n    const before = await page.request.get(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/current-state`);\n    const runId = (await before.json()).currentRunState.testRun.testRunId;\n    assert.equal(await page.locator('#originalApplicationFooter').count(), 0);\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    assert.equal(await page.locator('.application-footer').count(), 0);\n    await page.locator('#participantApplicationLogoButton').click();\n    if (await page.locator('#participantConfirmationContinueButton').count()) {\n      await page.locator('#participantConfirmationContinueButton').click();\n    }\n    await page.locator('#originalParticipantStarter').waitFor();\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.locator('#originalParticipantAccountLogin').waitFor();\n    assert.equal((await page.locator('#originalParticipantAccountLogin').textContent()).trim(), 'Test_Ctrl-2a');\n    assert.equal((await page.locator('#originalParticipantAccountGroup').textContent()).trim(),\n      signedIn.participantRosterEntry.groupLabel?.trim() || signedIn.participantSession.groupKey);\n    assert.equal(await page.locator('#originalParticipantLogoutButton').isDisabled(), true,\n      'Preview must not pretend local clearing revokes the access token.');\n    await page.keyboard.press('Escape');\n    await page.locator('#originalParticipantAccountLogin').waitFor({ state: 'detached' });\n    assert.equal(await page.locator('#originalParticipantAccountButton').evaluate(el => el === document.activeElement), true);\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.getByRole('button', { name: 'Nutzerinformationen schließen' }).click();\n    await page.locator('#originalParticipantAccountLogin').waitFor({ state: 'detached' });\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.locator('#originalParticipantAccountButton').click();\n    const menu = page.locator('.original-participant-account-menu');\n    await menu.waitFor();\n    await menu.evaluate(async element => {\n      await Promise.all(element.getAnimations({ subtree: true }).map(animation => animation.finished));\n    });\n    assert.equal(await menu.evaluate(el => getComputedStyle(el).opacity), '1');\n    assert.equal(await menu.evaluate(el => getComputedStyle(el).backgroundColor), 'rgb(255, 255, 255)',\n      'The CDK menu must be opaque even though it is outside the themed host.');\n    assert.ok((await menu.boundingBox()).width <= 366);\n    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth), false);\n    await page.screenshot({ path: '/tmp/testcenter-original-account-mobile.png', fullPage: true });\n    await page.keyboard.press('Escape');\n    await page.locator('#originalParticipantStarter mat-card[data-booklet-status=\"in_progress\"] button').click();\n    await page.locator('#originalPlayerToolbar').waitFor();\n    assert.equal((await page.locator('#participantRouteRunId').textContent()).trim(), runId);\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ participantSessionId: sessionId, ui: 'rewrite' })}`);\n    await page.locator('#participantRoutePlayer').waitFor();\n    assert.equal(await page.locator('app-original-participant-account').count(), 0);\n    assert.equal(await page.locator('app-original-footer').count(), 0);\n    await page.locator('.application-footer').waitFor();\n    assert.equal((await page.locator('#participantRouteRunId').textContent()).trim(), runId);\n    assert.deepEqual(errors, []);\n    console.log('PASS Starter-only Original account metadata, mobile menu, Escape/close focus and same-run return to Rewrite');\n  } finally { await browser.close(); }\n})().catch(error => { console.error(error); process.exitCode = 1; });\nimport { CommonModule } from \"@angular/common\";\nimport { Component, inject } from \"@angular/core\";\nimport type { OnInit } from \"@angular/core\";\nimport { FormsModule } from \"@angular/forms\";\n\nimport { AdministrationNavComponent } from \"./administration-nav.component\";\nimport { JsonPanelComponent } from \"./json-panel.component\";\nimport { RecordCollectionComponent } from \"./record-collection.component\";\nimport { SummaryCardsComponent } from \"./summary-cards.component\";\nimport { WorkspaceViewFacade } from \"./workspace-view.facade\";\n\n@Component({\n  selector: \"app-workspace-view\",\n  standalone: true,\n  imports: [\n    CommonModule,\n    FormsModule,\n    AdministrationNavComponent,\n    JsonPanelComponent,\n    SummaryCardsComponent,\n    RecordCollectionComponent\n  ],\n  template: `\n    <div class=\"stack\">\n      <app-administration-nav\n        *ngIf=\"view.canCreateTenant\"\n        activeSection=\"workspaces\"\n      ></app-administration-nav>\n\n      <article class=\"card\">\n        <h2>Scope</h2>\n        <p>Keep tenant and workspace context pinned while you manage workspaces, content, and runtime operations.</p>\n        <div class=\"form-grid\">\n          <label>\n            Tenant Key\n            <input id=\"tenantKey\" name=\"tenantKey\" [(ngModel)]=\"view.workspace.tenantKey\" (change)=\"view.persistState()\" />\n          </label>\n          <label>\n            Workspace Key\n            <input id=\"workspaceKey\" name=\"workspaceKey\" [(ngModel)]=\"view.workspace.workspaceKey\" (change)=\"view.persistState()\" />\n          </label>\n          <label>\n            Auto Refresh Active View\n            <span class=\"inline-toggle\">\n              <input\n                id=\"autoRefreshEnabled\"\n                name=\"autoRefreshEnabled\"\n                type=\"checkbox\"\n                [checked]=\"view.workspace.autoRefreshEnabled\"\n                (change)=\"onAutoRefreshChange($event)\"\n              />\n              Refresh workspace, content, runtime, and diagnostics views automatically\n            </span>\n          </label>\n          <label>\n            Refresh Every (Seconds)\n            <input\n              id=\"autoRefreshSeconds\"\n                name=\"autoRefreshSeconds\"\n                type=\"number\"\n                min=\"3\"\n                step=\"1\"\n                [(ngModel)]=\"view.workspace.autoRefreshSeconds\"\n                (change)=\"view.onAutoRefreshSettingsChanged()\"\n              />\n          </label>\n        </div>\n      </article>\n\n      <article class=\"card\">\n        <h2>Workspace Setup</h2>\n        <div class=\"actions\">\n          <button id=\"createTenantButton\" class=\"primary\" type=\"button\" [disabled]=\"!view.canCreateTenant\" (click)=\"view.createTenant()\">Create Tenant</button>\n          <button id=\"createWorkspaceButton\" class=\"secondary\" type=\"button\" [disabled]=\"!view.canCreateWorkspace\" (click)=\"view.createWorkspace()\">Create Workspace</button>\n          <button id=\"refreshWorkspaceOverviewButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseWorkspaceScope\" (click)=\"view.refreshWorkspaceOverview()\">Refresh Workspace Overview</button>\n          <button id=\"exportWorkspaceOverviewCsvButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseWorkspaceScope\" (click)=\"view.exportWorkspaceOverviewCsv()\">Export Workspace Overview CSV</button>\n          <button id=\"refreshStudyMonitorButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseWorkspaceScope\" (click)=\"view.refreshStudyMonitor()\">Refresh Study Monitor</button>\n          <button id=\"refreshTenantDirectoryButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseDirectoryScope\" (click)=\"view.refreshTenantDirectory()\">Refresh Tenant Directory</button>\n          <button id=\"exportTenantDirectoryCsvButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseDirectoryScope\" (click)=\"view.exportTenantDirectoryCsv()\">Export Tenant Directory CSV</button>\n          <button id=\"refreshWorkspaceDirectoryButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseWorkspaceDirectoryScope\" (click)=\"view.refreshWorkspaceDirectory()\">Refresh Workspace Directory</button>\n          <button id=\"exportWorkspaceDirectoryCsvButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.canUseWorkspaceDirectoryScope\" (click)=\"view.exportWorkspaceDirectoryCsv()\">Export Workspace Directory CSV</button>\n          <button id=\"exportStudyMonitorCsvButton\" class