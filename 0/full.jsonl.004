wait readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      Promise.all(\n        testControllerUnitFixtures.map(async fixture => ({\n          ...fixture,\n          content: Buffer.from(\n            (\n              await readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      readBrotliBase64Text(\n        resolve(\n          originalCorpusRoot,\n          currentTestControllerPackage.player.fixture\n        )\n      )\n    ]);\n  const testControllerManifestResources = [\n    ...testControllerFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.bookletKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    ...testControllerUnitFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.unitKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    `<resource identifier=\"${currentTestControllerPackage.player.playerKey}\" href=\"players/verona-player-simple-6.0.html\" />`\n  ].join(\"\\n\");\n  const testControllerZip = createStoredZipBuffer([\n    {\n      fileName: \"export/imsmanifest.xml\",\n      content: `\n        <manifest xmlns=\"http://www.imsglobal.org/xsd/imscp_v1p1\">\n          <resources>${testControllerManifestResources}</resources>\n        </manifest>\n      `\n    },\n    ...testControllerDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    ...testControllerUnitDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    {\n      fileName: \"export/players/verona-player-simple-6.0.html\",\n      content: testControllerPlayerDocument\n    }\n  ]);\n  const testControllerSourcePackageResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/source-packages`,\n    {\n      body: {\n        fileName: \"original-test-controller-browser-smoke.zip\",\n        mediaType: \"application/zip\",\n        sourceDocument: `data:application/zip;base64,${testControllerZip.toString(\"base64\")}`\n      }\n    }\n  );\n  const testControllerSourcePackagePayload =\n    await testControllerSourcePackageResponse.json();\n  const testControllerImportResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/import-jobs`,\n    {\n      body: {\n        sourcePackageId:\n          testControllerSourcePackagePayload.sourcePackage.sourcePackageId\n      }\n    }\n  );\n  const testControllerImportPayload = await testControllerImportResponse.json();\n  const testControllerReleaseId =\n    testControllerImportPayload.stagedContentRelease?.contentReleaseId;\n  assert.ok(\n    testControllerReleaseId,\n    `Original Test Controller browser import should stage a release: ${JSON.stringify(\n      testControllerImportPayload.importJob?.diagnostics ?? []\n    )}`\n  );\n  await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/content-releases/${testControllerReleaseId}/activate`,\n    { body: {} }\n  );\n  const testControllerRosterResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/participant-roster`,\n    {\n      body: {\n        rosterText: Buffer.from(\n          (\n            await readFile(\n              resolve(\n                originalCorpusRoot,\n                currentTestControllerPackage.roster.fixture\n              ),\n              \"utf8\"\n            )\n          ).trim(),\n          \"base64\"\n        ).toString(\"utf8\")\n      }\n    }\n  );\n  const testControllerRosterPayload = await testControllerRosterResponse.json();\n  assert.equal(\n    testControllerRosterPayload.items.length,\n    currentTestControllerPackage.roster.participantCount\n  );\n  assert.deepEqual(\n    testControllerRosterPayload.items\n      .filter(item => [\"Test_Ctrl-3\", \"Test_Ctrl-23\"].includes(item.loginKey))\n      .map(item => [item.loginKey, item.bookletKey, item.passwordRequired])\n      .sort((left, right) => left[0].localeCompare(right[0])),\n    [\n      [\"Test_Ctrl-23\", \"Cy-Bklt_TC-14\", true],\n      [\"Test_Ctrl-3\", \"Cy-Bklt_TC-3\", true]\n    ]\n  );\n  const openOriginalTestController = async (loginKey, bookletKey, existingSessionId, interfaceMode = \"rewrite\") => {\n    let participantSessionId = existingSessionId;\n    if (!participantSessionId) {\n      const signInResponse = await sendSmokeJson(\n        `${baseUrl}/api/v1/participant/auth/sign-in`,\n        {\n          body: {\n            tenantKey: testControllerTenantKey,\n            workspaceKey: testControllerWorkspaceKey,\n            loginKey,\n            password: \"123\"\n          }\n        }\n      );\n      const signInPayload = await signInResponse.json();\n      participantSessionId = signInPayload.participantSession?.participantSessionId;\n    }\n    assert.ok(participantSessionId, `${loginKey} should create a session.`);\n    const resumeResponse = await sendSmokeJson(\n      `${baseUrl}/api/v1/participant/sessions/${participantSessionId}/resume`,\n      { body: { bookletKey } }\n    );\n    const resumePayload = await resumeResponse.json();\n    await participantHttpActor.goto(page,\n      `${baseUrl}/participant?participantSessionId=${encodeURIComponent(\n        participantSessionId\n      )}&ui=${interfaceMode}`,\n      { waitUntil: \"domcontentloaded\" }\n    );\n    await page\n      .locator(\"#participantVeronaPlayerVersion\")\n      .filter({ hasText: \"API 6.0\" })\n      .waitFor({ timeout: 30_000, state: interfaceMode === \"original\" ? \"attached\" : \"visible\" });\n    return {\n      frame: page.frameLocator(\"#participantVeronaPlayerFrame\"),\n      participantSessionId,\n      testRunId: resumePayload.testRun?.testRunId\n    };\n  };\n  const completeOriginalControllerUnit = async frame => {\n    await frame\n      .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n      .check();\n    await frame.locator(\"#next-page\").click();\n    await frame\n      .getByText(\"Presentation complete\", { exact: true })\n      .waitFor({ timeout: 15_000 });\n  };\n  const waitForOriginalControllerCompletenessDenial = async (\n    controller,\n    direction,\n    deniedReasons\n  ) =>\n    pollJsonWithPredicate(\n      `${baseUrl}/api/v1/participant/sessions/${controller.participantSessionId}/current-state`,\n      payload => {\n        const reasons =\n          direction === \"forward\"\n            ? payload?.currentRunState?.navigation?.forwardDeniedReasons\n            : payload?.currentRunState?.navigation?.backwardDeniedReasons;\n        return (\n          Array.isArray(reasons) &&\n          reasons.length === deniedReasons.length &&\n          deniedReasons.every(reason => reasons.includes(reason))\n        );\n      }\n    );\n  const waitForOriginalControllerCompletenessAllowed = async (\n    controller,\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { dirname, resolve } from \"node:path\";\nimport { setTimeout as delay } from \"node:timers/promises\";\nimport { brotliDecompressSync } from \"node:zlib\";\n\nimport { chromium } from \"playwright\";\nimport QRCode from \"qrcode\";\nimport { createParticipantHttpTestActor } from \"./participant-http-test-actor.mjs\";\n\nconst participantHttpActor = createParticipantHttpTestActor();\nconst fetch = participantHttpActor.fetch;\n\nconst store = process.env.FIRST_SLICE_STORE ?? \"sqlite\";\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\nconst operatorAuthRequired =\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \"true\";\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \"\";\nconst configuredProofOfWorkScopes = new Set(\n  String(process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES ?? \"\")\n    .split(/[\\s,]+/u)\n    .filter(Boolean)\n);\nconst skipRuntimeCsvExports = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_RUNTIME_CSV_EXPORTS ?? \"\").toLowerCase()\n);\nconst skipOfflineAppShell = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_OFFLINE_APP_SHELL ?? \"\").toLowerCase()\n);\nconst skipWorkspaceRename = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_WORKSPACE_RENAME ?? \"\").toLowerCase()\n);\nconst busyStartTimeoutMs = Number.parseInt(\n  process.env.UI_SMOKE_BUSY_START_TIMEOUT_MS ?? \"750\",\n  10\n);\nconst logBusyStartTimeouts = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_LOG_BUSY_START_TIMEOUTS ?? \"\").toLowerCase()\n);\nconst serverEntry = resolve(\"apps/api/dist/apps/api/src/index.js\");\nconst failedImportSourceDocument = '{\"booklets\":[]}';\nconst repairedImportSourceDocument =\n  '<assessment><booklet key=\"booklet:recovered\" label=\"Recovered\"><unit key=\"unit-recovered\" label=\"Recovered Unit\" /></booklet></assessment>';\nconst uploadedSourceDocument =\n  '<Booklet><Metadata><Id>booklet:starter</Id><Label>Starter</Label></Metadata><BookletConfig><Config key=\"toolbar_show_unit_list\">TRUE</Config><Config key=\"ask_for_fullscreen\">ON</Config><Config key=\"show_fullscreen_button\">ON</Config><Config key=\"toolbar_show_reload_button\">TRUE</Config><Config key=\"unit_screenheader\">WITH_UNIT_TITLE</Config><Config key=\"unit_title\">OFF</Config></BookletConfig><Units><Unit id=\"unit-1\" label=\"Entry\" /><Testlet id=\"testlet:participant-route\" label=\"Participant Route Block\"><Unit id=\"unit-participant-route\" label=\"Participant Route\"><description>Read the participant prompt.</description><prompt>Explain how the starter example works.</prompt></Unit></Testlet><Testlet id=\"testlet:timed-paused\" label=\"Timed Paused Work\"><Restrictions><TimeMax minutes=\"5\" leave=\"allowed\" /></Restrictions><Unit id=\"unit-paused\" label=\"Paused Work\"><Definition><![CDATA[<section>Answer the direct Testcenter definition prompt.</section>]]></Definition></Unit></Testlet></Units></Booklet>';\nlet smokeAdminSessionToken = \"\";\n\nconst readBrotliBase64Text = async fixturePath =>\n  brotliDecompressSync(\n    Buffer.from(await readFile(fixturePath, \"utf8\"), \"base64\")\n  ).toString(\"utf8\");\n\nconst crc32Table = Array.from({ length: 256 }, (_, value) => {\n  let crc = value;\n  for (let bit = 0; bit < 8; bit += 1) {\n    crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\n  }\n  return crc >>> 0;\n});\n\nconst crc32 = content => {\n  let crc = 0xffffffff;\n  for (const byte of content) {\n    crc = crc32Table[(crc ^ byte) & 0xff] ^ (crc >>> 8);\n  }\n  return (crc ^ 0xffffffff) >>> 0;\n};\n\nconst createStoredZipBuffer = entries => {\n  const localFileHeaders = [];\n  const centralDirectoryHeaders = [];\n  let offset = 0;\n\n  for (const entry of entries) {\n    const fileName = Buffer.from(entry.fileName, \"utf8\");\n    const content = Buffer.from(entry.content, \"utf8\");\n    const checksum = crc32(content);\n    const localHeader = Buffer.alloc(30 + fileName.length);\n    localHeader.writeUInt32LE(0x04034b50, 0);\n    localHeader.writeUInt16LE(20, 4);\n    localHeader.writeUInt16LE(0x0800, 6);\n    localHeader.writeUInt16LE(0, 8);\n    localHeader.writeUInt32LE(0, 10);\n    localHeader.writeUInt32LE(checksum, 14);\n    localHeader.writeUInt32LE(content.length, 18);\n    localHeader.writeUInt32LE(content.length, 22);\n    localHeader.writeUInt16LE(fileName.length, 26);\n    fileName.copy(localHeader, 30);\n    localFileHeaders.push(localHeader, content);\n\n    const centralDirectoryHeader = Buffer.alloc(46 + fileName.length);\n    centralDirectoryHeader.writeUInt32LE(0x02014b50, 0);\n    centralDirectoryHeader.writeUInt16LE(20, 4);\n    centralDirectoryHeader.writeUInt16LE(20, 6);\n    centralDirectoryHeader.writeUInt16LE(0x0800, 8);\n    centralDirectoryHeader.writeUInt16LE(0, 10);\n    centralDirectoryHeader.writeUInt32LE(0, 12);\n    centralDirectoryHeader.writeUInt32LE(checksum, 16);\n    centralDirectoryHeader.writeUInt32LE(content.length, 20);\n    centralDirectoryHeader.writeUInt32LE(content.length, 24);\n    centralDirectoryHeader.writeUInt16LE(fileName.length, 28);\n    centralDirectoryHeader.writeUInt32LE(offset, 42);\n    fileName.copy(centralDirectoryHeader, 46);\n    centralDirectoryHeaders.push(centralDirectoryHeader);\n\n    offset += localHeader.length + content.length;\n  }\n\n  const centralDirectoryOffset = offset;\n  const centralDirectory = Buffer.concat(centralDirectoryHeaders);\n  const endOfCentralDirectory = Buffer.alloc(22);\n  endOfCentralDirectory.writeUInt32LE(0x06054b50, 0);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 8);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 10);\n  endOfCentralDirectory.writeUInt32LE(centralDirectory.length, 12);\n  endOfCentralDirectory.writeUInt32LE(centralDirectoryOffset, 16);\n\n  );\n  const participantEntryStartedRunId =\n    participantEntryStartedPayload.currentRunState.testRun.testRunId;\n  await page.waitForFunction(\n    ([expectedSessionId, expectedDisplayName, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteDisplayName\")?.textContent?.trim() ===\n        expectedDisplayName &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [\n      participantEntrySignInSessionId,\n      participantEntrySignInDisplayName,\n      participantEntryStartedRunId\n    ],\n    { timeout: 15_000 }\n  );\n  assert.equal(\n    await page.locator(\"#participantEntryIssueCode\").count(),\n    0,\n    \"Participant entry issue guidance should clear after a successful sign-in.\"\n  );\n  const originalSignInContext = await browser.newContext();\n  participantHttpActor.observeContext(originalSignInContext);\n  try {\n    const originalSignInPage = await originalSignInContext.newPage();\n    await originalSignInPage.goto(`${baseUrl}/app/participant?${new URLSearchParams({\n      ui: \"original\", tenantKey, workspaceKey\n    })}`, { waitUntil: \"networkidle\" });\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    await originalSignInPage.locator(\"#originalApplicationFooter\").waitFor();\n    assert.deepEqual(await originalSignInPage.locator(\"#originalApplicationFooter nav a\").allTextContents(),\n      [\"Barrierefreiheit\", \"Datenschutz\", \"Impressum\"]);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").count(), 0);\n    await originalSignInPage.locator(\".login-submit svg[matButtonIcon]\").waitFor();\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantLogin\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId,\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    // The optional layout must preserve the same durable run when returning\n    // to its numbered Starter card and resuming from that card.\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").waitFor();\n    await originalSignInPage.locator(\"#participantConfirmationStayButton\").click();\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantStarter\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    assert.equal(await originalSignInPage.locator(\"#participantRouteEntry\").count(), 0);\n    assert.equal(await originalSignInPage.locator(\"#participantRoutePlayer\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationHeader h1\").filter({ hasText: \"Übersicht\" }).waitFor();\n    assert.equal(await originalSignInPage.locator(\"#originalApplicationFooter\").count(), 0);\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor();\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountLogin\").textContent())?.trim(),\n      participantEntrySignInLoginKey);\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountGroup\").textContent())?.trim(),\n      participantEntrySignInGroupKey);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantLogoutButton\").isDisabled(), false);\n    await originalSignInPage.keyboard.press(\"Escape\");\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor({ state: \"detached\" });\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").evaluate(el => el === document.activeElement), true);\n    const originalResumeCard = originalSignInPage.locator(\"#originalParticipantStarter mat-card[data-booklet-status='in_progress']\");\n    assert.equal(await originalResumeCard.count(), 1);\n    await originalResumeCard.getByRole(\"button\").click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantStarter\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n        document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() === \"running\",\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    const originalCredentialBeforeLogout = await originalSignInPage.evaluate(sessionId => {\n      const state = JSON.parse(localStorage.getItem(\"testcenter-rewrite:participant-access:v1\") ?? \"{}\");\n      return state.sessions?.find(([id]) => id === sessionId)?.[1];\n    }, participantEntrySignInSessionId);\n    assert.match(originalCredentialBeforeLogout, /^[A-Za-z0-9_-]{43}$/u);\n    const originalStateBeforeLogout = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } }\n    )).json();\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    const logoutCompleted = originalSignInPage.waitForResponse(response => response.request().method() === \"DELETE\" &&\n      response.url().endsWith(`/sessions/${participantEntrySignInSessionId}/access`) && response.status() === 205);\n    await originalSignInPage.locator(\"#originalParticipantLogoutButton\").click();\n    await logoutCompleted;\n    await originalSignInPage.locator(\"#originalParticipantLogin\").waitFor();\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    assert.equal(new URL(originalSignInPage.url()).searchParams.has(\"participantSessionId\"), false);\n    assert.equal((await fetch(`${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } })).status, 401);\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(expectedRunId =>\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === expectedRunId,\n      participantEntryStartedRunId);\n    const restoredOriginalState = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`\n    )).json();\n    assert.equal(restoredOriginalState.currentRunState.testRun.testRunId, participantEntryStartedRunId);\n    assert.deepEqual(restoredOriginalState.currentRunState.testRun.unitResponses,\n      originalStateBeforeLogout.currentRunState.testRun.unitResponses);\n  } finally {\n    await originalSignInContext.close();\n  }\n  // A second real login rotates access for this participant. Re-authenticate\n  // the first browser through its UI; never inject the other browser's token.\n  await page.locator(\"#participantRouteClearSessionButton\").click();\n  await page.locator(\"#participantRouteEntry\").waitFor();\n  await page.locator(\"#participantRouteSignInButton\").click();\n  await page.waitForFunction(\n    ([sessionId, runId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId]\n  );\n  stopAfter(\"participant-entry-sign-in\");\n  logStep(\"participant-entry-start-after-sign-in\");\n  await page.waitForFunction(\n    ([expectedSessionId, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId],\n    { timeout: 15_000 }\n  );\n  await page.locator(\"#participantRouteFullscreenPrompt\").waitFor();\n  await page\n    .locator(\"#participantRouteScreenHeader\")\n    .filter({ hasText: \"Entry\" })\n    .waitFor();\n  assert.equal(await page.locator(\"#participantRouteUnit\").count(), 0);\n  await page.locator(\"#participantRouteFullscreenButton\").waitFor();\n  await page.locator(\"#participantRouteEnterFullscreenButton\").click();\n  await page.waitForFunction(() => Boolean(document.fullscreenElement));\n  await page\n    .locator(\"#participantRouteFullscreenStatus\")\n    .filter({ hasText: \"active\" })\nscripts/run-postgres-ui-smoke.mjs\nscripts/smoke-ui.mjs\nscripts/with-build-metadata.mjs\n","stderr":"","aggregated_output":"    officialProtocolCorpus.currentOriginalTestControllerPackage;\n  const testControllerFixtures = currentTestControllerPackage.booklets.map(\n    ([fixture, bookletKey]) => ({\n      fixture,\n      bookletKey,\n      packagePath: `booklets/${bookletKey.replace(\"Cy-Bklt_\", \"CY_Bklt_\")}.xml`\n    })\n  );\n  const testControllerUnitFixtures = currentTestControllerPackage.units.map(\n    ([fixture, unitKey], index) => ({\n      fixture,\n      unitKey,\n      packagePath: `units/CY_Unit${index + 100}.xml`\n    })\n  );\n  const [\n    testControllerDocuments,\n    testControllerUnitDocuments,\n    testControllerPlayerDocument\n  ] =\n    await Promise.all([\n      Promise.all(\n        testControllerFixtures.map(async fixture => ({\n          ...fixture,\n          content: Buffer.from(\n            (\n              await readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      Promise.all(\n        testControllerUnitFixtures.map(async fixture => ({\n          ...fixture,\n          content: Buffer.from(\n            (\n              await readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      readBrotliBase64Text(\n        resolve(\n          originalCorpusRoot,\n          currentTestControllerPackage.player.fixture\n        )\n      )\n    ]);\n  const testControllerManifestResources = [\n    ...testControllerFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.bookletKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    ...testControllerUnitFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.unitKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    `<resource identifier=\"${currentTestControllerPackage.player.playerKey}\" href=\"players/verona-player-simple-6.0.html\" />`\n  ].join(\"\\n\");\n  const testControllerZip = createStoredZipBuffer([\n    {\n      fileName: \"export/imsmanifest.xml\",\n      content: `\n        <manifest xmlns=\"http://www.imsglobal.org/xsd/imscp_v1p1\">\n          <resources>${testControllerManifestResources}</resources>\n        </manifest>\n      `\n    },\n    ...testControllerDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    ...testControllerUnitDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    {\n      fileName: \"export/players/verona-player-simple-6.0.html\",\n      content: testControllerPlayerDocument\n    }\n  ]);\n  const testControllerSourcePackageResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/source-packages`,\n    {\n      body: {\n        fileName: \"original-test-controller-browser-smoke.zip\",\n        mediaType: \"application/zip\",\n        sourceDocument: `data:application/zip;base64,${testControllerZip.toString(\"base64\")}`\n      }\n    }\n  );\n  const testControllerSourcePackagePayload =\n    await testControllerSourcePackageResponse.json();\n  const testControllerImportResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/import-jobs`,\n    {\n      body: {\n        sourcePackageId:\n          testControllerSourcePackagePayload.sourcePackage.sourcePackageId\n      }\n    }\n  );\n  const testControllerImportPayload = await testControllerImportResponse.json();\n  const testControllerReleaseId =\n    testControllerImportPayload.stagedContentRelease?.contentReleaseId;\n  assert.ok(\n    testControllerReleaseId,\n    `Original Test Controller browser import should stage a release: ${JSON.stringify(\n      testControllerImportPayload.importJob?.diagnostics ?? []\n    )}`\n  );\n  await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/content-releases/${testControllerReleaseId}/activate`,\n    { body: {} }\n  );\n  const testControllerRosterResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/participant-roster`,\n    {\n      body: {\n        rosterText: Buffer.from(\n          (\n            await readFile(\n              resolve(\n                originalCorpusRoot,\n                currentTestControllerPackage.roster.fixture\n              ),\n              \"utf8\"\n            )\n          ).trim(),\n          \"base64\"\n        ).toString(\"utf8\")\n      }\n    }\n  );\n  const testControllerRosterPayload = await testControllerRosterResponse.json();\n  assert.equal(\n    testControllerRosterPayload.items.length,\n    currentTestControllerPackage.roster.participantCount\n  );\n  assert.deepEqual(\n    testControllerRosterPayload.items\n      .filter(item => [\"Test_Ctrl-3\", \"Test_Ctrl-23\"].includes(item.loginKey))\n      .map(item => [item.loginKey, item.bookletKey, item.passwordRequired])\n      .sort((left, right) => left[0].localeCompare(right[0])),\n    [\n      [\"Test_Ctrl-23\", \"Cy-Bklt_TC-14\", true],\n      [\"Test_Ctrl-3\", \"Cy-Bklt_TC-3\", true]\n    ]\n  );\n  const openOriginalTestController = async (loginKey, bookletKey, existingSessionId, interfaceMode = \"rewrite\") => {\n    let participantSessionId = existingSessionId;\n    if (!participantSessionId) {\n      const signInResponse = await sendSmokeJson(\n        `${baseUrl}/api/v1/participant/auth/sign-in`,\n        {\n          body: {\n            tenantKey: testControllerTenantKey,\n            workspaceKey: testControllerWorkspaceKey,\n            loginKey,\n            password: \"123\"\n          }\n        }\n      );\n      const signInPayload = await signInResponse.json();\n      participantSessionId = signInPayload.participantSession?.participantSessionId;\n    }\n    assert.ok(participantSessionId, `${loginKey} should create a session.`);\n    const resumeResponse = await sendSmokeJson(\n      `${baseUrl}/api/v1/participant/sessions/${participantSessionId}/resume`,\n      { body: { bookletKey } }\n    );\n    const resumePayload = await resumeResponse.json();\n    await participantHttpActor.goto(page,\n      `${baseUrl}/participant?participantSessionId=${encodeURIComponent(\n        participantSessionId\n      )}&ui=${interfaceMode}`,\n      { waitUntil: \"domcontentloaded\" }\n    );\n    await page\n      .locator(\"#participantVeronaPlayerVersion\")\n      .filter({ hasText: \"API 6.0\" })\n      .waitFor({ timeout: 30_000, state: interfaceMode === \"original\" ? \"attached\" : \"visible\" });\n    return {\n      frame: page.frameLocator(\"#participantVeronaPlayerFrame\"),\n      participantSessionId,\n      testRunId: resumePayload.testRun?.testRunId\n    };\n  };\n  const completeOriginalControllerUnit = async frame => {\n    await frame\n      .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n      .check();\n    await frame.locator(\"#next-page\").click();\n    await frame\n      .getByText(\"Presentation complete\", { exact: true })\n      .waitFor({ timeout: 15_000 });\n  };\n  const waitForOriginalControllerCompletenessDenial = async (\n    controller,\n    direction,\n    deniedReasons\n  ) =>\n    pollJsonWithPredicate(\n      `${baseUrl}/api/v1/participant/sessions/${controller.participantSessionId}/current-state`,\n      payload => {\n        const reasons =\n          direction === \"forward\"\n            ? payload?.currentRunState?.navigation?.forwardDeniedReasons\n            : payload?.currentRunState?.navigation?.backwardDeniedReasons;\n        return (\n          Array.isArray(reasons) &&\n          reasons.length === deniedReasons.length &&\n          deniedReasons.every(reason => reasons.includes(reason))\n        );\n      }\n    );\n  const waitForOriginalControllerCompletenessAllowed = async (\n    controller,\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { dirname, resolve } from \"node:path\";\nimport { setTimeout as delay } from \"node:timers/promises\";\nimport { brotliDecompressSync } from \"node:zlib\";\n\nimport { chromium } from \"playwright\";\nimport QRCode from \"qrcode\";\nimport { createParticipantHttpTestActor } from \"./participant-http-test-actor.mjs\";\n\nconst participantHttpActor = createParticipantHttpTestActor();\nconst fetch = participantHttpActor.fetch;\n\nconst store = process.env.FIRST_SLICE_STORE ?? \"sqlite\";\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\nconst operatorAuthRequired =\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \"true\";\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \"\";\nconst configuredProofOfWorkScopes = new Set(\n  String(process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES ?? \"\")\n    .split(/[\\s,]+/u)\n    .filter(Boolean)\n);\nconst skipRuntimeCsvExports = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_RUNTIME_CSV_EXPORTS ?? \"\").toLowerCase()\n);\nconst skipOfflineAppShell = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_OFFLINE_APP_SHELL ?? \"\").toLowerCase()\n);\nconst skipWorkspaceRename = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_WORKSPACE_RENAME ?? \"\").toLowerCase()\n);\nconst busyStartTimeoutMs = Number.parseInt(\n  process.env.UI_SMOKE_BUSY_START_TIMEOUT_MS ?? \"750\",\n  10\n);\nconst logBusyStartTimeouts = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_LOG_BUSY_START_TIMEOUTS ?? \"\").toLowerCase()\n);\nconst serverEntry = resolve(\"apps/api/dist/apps/api/src/index.js\");\nconst failedImportSourceDocument = '{\"booklets\":[]}';\nconst repairedImportSourceDocument =\n  '<assessment><booklet key=\"booklet:recovered\" label=\"Recovered\"><unit key=\"unit-recovered\" label=\"Recovered Unit\" /></booklet></assessment>';\nconst uploadedSourceDocument =\n  '<Booklet><Metadata><Id>booklet:starter</Id><Label>Starter</Label></Metadata><BookletConfig><Config key=\"toolbar_show_unit_list\">TRUE</Config><Config key=\"ask_for_fullscreen\">ON</Config><Config key=\"show_fullscreen_button\">ON</Config><Config key=\"toolbar_show_reload_button\">TRUE</Config><Config key=\"unit_screenheader\">WITH_UNIT_TITLE</Config><Config key=\"unit_title\">OFF</Config></BookletConfig><Units><Unit id=\"unit-1\" label=\"Entry\" /><Testlet id=\"testlet:participant-route\" label=\"Participant Route Block\"><Unit id=\"unit-participant-route\" label=\"Participant Route\"><description>Read the participant prompt.</description><prompt>Explain how the starter example works.</prompt></Unit></Testlet><Testlet id=\"testlet:timed-paused\" label=\"Timed Paused Work\"><Restrictions><TimeMax minutes=\"5\" leave=\"allowed\" /></Restrictions><Unit id=\"unit-paused\" label=\"Paused Work\"><Definition><![CDATA[<section>Answer the direct Testcenter definition prompt.</section>]]></Definition></Unit></Testlet></Units></Booklet>';\nlet smokeAdminSessionToken = \"\";\n\nconst readBrotliBase64Text = async fixturePath =>\n  brotliDecompressSync(\n    Buffer.from(await readFile(fixturePath, \"utf8\"), \"base64\")\n  ).toString(\"utf8\");\n\nconst crc32Table = Array.from({ length: 256 }, (_, value) => {\n  let crc = value;\n  for (let bit = 0; bit < 8; bit += 1) {\n    crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\n  }\n  return crc >>> 0;\n});\n\nconst crc32 = content => {\n  let crc = 0xffffffff;\n  for (const byte of content) {\n    crc = crc32Table[(crc ^ byte) & 0xff] ^ (crc >>> 8);\n  }\n  return (crc ^ 0xffffffff) >>> 0;\n};\n\nconst createStoredZipBuffer = entries => {\n  const localFileHeaders = [];\n  const centralDirectoryHeaders = [];\n  let offset = 0;\n\n  for (const entry of entries) {\n    const fileName = Buffer.from(entry.fileName, \"utf8\");\n    const content = Buffer.from(entry.content, \"utf8\");\n    const checksum = crc32(content);\n    const localHeader = Buffer.alloc(30 + fileName.length);\n    localHeader.writeUInt32LE(0x04034b50, 0);\n    localHeader.writeUInt16LE(20, 4);\n    localHeader.writeUInt16LE(0x0800, 6);\n    localHeader.writeUInt16LE(0, 8);\n    localHeader.writeUInt32LE(0, 10);\n    localHeader.writeUInt32LE(checksum, 14);\n    localHeader.writeUInt32LE(content.length, 18);\n    localHeader.writeUInt32LE(content.length, 22);\n    localHeader.writeUInt16LE(fileName.length, 26);\n    fileName.copy(localHeader, 30);\n    localFileHeaders.push(localHeader, content);\n\n    const centralDirectoryHeader = Buffer.alloc(46 + fileName.length);\n    centralDirectoryHeader.writeUInt32LE(0x02014b50, 0);\n    centralDirectoryHeader.writeUInt16LE(20, 4);\n    centralDirectoryHeader.writeUInt16LE(20, 6);\n    centralDirectoryHeader.writeUInt16LE(0x0800, 8);\n    centralDirectoryHeader.writeUInt16LE(0, 10);\n    centralDirectoryHeader.writeUInt32LE(0, 12);\n    centralDirectoryHeader.writeUInt32LE(checksum, 16);\n    centralDirectoryHeader.writeUInt32LE(content.length, 20);\n    centralDirectoryHeader.writeUInt32LE(content.length, 24);\n    centralDirectoryHeader.writeUInt16LE(fileName.length, 28);\n    centralDirectoryHeader.writeUInt32LE(offset, 42);\n    fileName.copy(centralDirectoryHeader, 46);\n    centralDirectoryHeaders.push(centralDirectoryHeader);\n\n    offset += localHeader.length + content.length;\n  }\n\n  const centralDirectoryOffset = offset;\n  const centralDirectory = Buffer.concat(centralDirectoryHeaders);\n  const endOfCentralDirectory = Buffer.alloc(22);\n  endOfCentralDirectory.writeUInt32LE(0x06054b50, 0);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 8);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 10);\n  endOfCentralDirectory.writeUInt32LE(centralDirectory.length, 12);\n  endOfCentralDirectory.writeUInt32LE(centralDirectoryOffset, 16);\n\n  );\n  const participantEntryStartedRunId =\n    participantEntryStartedPayload.currentRunState.testRun.testRunId;\n  await page.waitForFunction(\n    ([expectedSessionId, expectedDisplayName, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteDisplayName\")?.textContent?.trim() ===\n        expectedDisplayName &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [\n      participantEntrySignInSessionId,\n      participantEntrySignInDisplayName,\n      participantEntryStartedRunId\n    ],\n    { timeout: 15_000 }\n  );\n  assert.equal(\n    await page.locator(\"#participantEntryIssueCode\").count(),\n    0,\n    \"Participant entry issue guidance should clear after a successful sign-in.\"\n  );\n  const originalSignInContext = await browser.newContext();\n  participantHttpActor.observeContext(originalSignInContext);\n  try {\n    const originalSignInPage = await originalSignInContext.newPage();\n    await originalSignInPage.goto(`${baseUrl}/app/participant?${new URLSearchParams({\n      ui: \"original\", tenantKey, workspaceKey\n    })}`, { waitUntil: \"networkidle\" });\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    await originalSignInPage.locator(\"#originalApplicationFooter\").waitFor();\n    assert.deepEqual(await originalSignInPage.locator(\"#originalApplicationFooter nav a\").allTextContents(),\n      [\"Barrierefreiheit\", \"Datenschutz\", \"Impressum\"]);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").count(), 0);\n    await originalSignInPage.locator(\".login-submit svg[matButtonIcon]\").waitFor();\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantLogin\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId,\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    // The optional layout must preserve the same durable run when returning\n    // to its numbered Starter card and resuming from that card.\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").waitFor();\n    await originalSignInPage.locator(\"#participantConfirmationStayButton\").click();\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantStarter\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    assert.equal(await originalSignInPage.locator(\"#participantRouteEntry\").count(), 0);\n    assert.equal(await originalSignInPage.locator(\"#participantRoutePlayer\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationHeader h1\").filter({ hasText: \"Übersicht\" }).waitFor();\n    assert.equal(await originalSignInPage.locator(\"#originalApplicationFooter\").count(), 0);\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor();\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountLogin\").textContent())?.trim(),\n      participantEntrySignInLoginKey);\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountGroup\").textContent())?.trim(),\n      participantEntrySignInGroupKey);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantLogoutButton\").isDisabled(), false);\n    await originalSignInPage.keyboard.press(\"Escape\");\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor({ state: \"detached\" });\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").evaluate(el => el === document.activeElement), true);\n    const originalResumeCard = originalSignInPage.locator(\"#originalParticipantStarter mat-card[data-booklet-status='in_progress']\");\n    assert.equal(await originalResumeCard.count(), 1);\n    await originalResumeCard.getByRole(\"button\").click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantStarter\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n        document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() === \"running\",\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    const originalCredentialBeforeLogout = await originalSignInPage.evaluate(sessionId => {\n      const state = JSON.parse(localStorage.getItem(\"testcenter-rewrite:participant-access:v1\") ?? \"{}\");\n      return state.sessions?.find(([id]) => id === sessionId)?.[1];\n    }, participantEntrySignInSessionId);\n    assert.match(originalCredentialBeforeLogout, /^[A-Za-z0-9_-]{43}$/u);\n    const originalStateBeforeLogout = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } }\n    )).json();\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    const logoutCompleted = originalSignInPage.waitForResponse(response => response.request().method() === \"DELETE\" &&\n      response.url().endsWith(`/sessions/${participantEntrySignInSessionId}/access`) && response.status() === 205);\n    await originalSignInPage.locator(\"#originalParticipantLogoutButton\").click();\n    await logoutCompleted;\n    await originalSignInPage.locator(\"#originalParticipantLogin\").waitFor();\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    assert.equal(new URL(originalSignInPage.url()).searchParams.has(\"participantSessionId\"), false);\n    assert.equal((await fetch(`${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } })).status, 401);\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(expectedRunId =>\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === expectedRunId,\n      participantEntryStartedRunId);\n    const restoredOriginalState = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`\n    )).json();\n    assert.equal(restoredOriginalState.currentRunState.testRun.testRunId, participantEntryStartedRunId);\n    assert.deepEqual(restoredOriginalState.currentRunState.testRun.unitResponses,\n      originalStateBeforeLogout.currentRunState.testRun.unitResponses);\n  } finally {\n    await originalSignInContext.close();\n  }\n  // A second real login rotates access for this participant. Re-authenticate\n  // the first browser through its UI; never inject the other browser's token.\n  await page.locator(\"#participantRouteClearSessionButton\").click();\n  await page.locator(\"#participantRouteEntry\").waitFor();\n  await page.locator(\"#participantRouteSignInButton\").click();\n  await page.waitForFunction(\n    ([sessionId, runId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId]\n  );\n  stopAfter(\"participant-entry-sign-in\");\n  logStep(\"participant-entry-start-after-sign-in\");\n  await page.waitForFunction(\n    ([expectedSessionId, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId],\n    { timeout: 15_000 }\n  );\n  await page.locator(\"#participantRouteFullscreenPrompt\").waitFor();\n  await page\n    .locator(\"#participantRouteScreenHeader\")\n    .filter({ hasText: \"Entry\" })\n    .waitFor();\n  assert.equal(await page.locator(\"#participantRouteUnit\").count(), 0);\n  await page.locator(\"#participantRouteFullscreenButton\").waitFor();\n  await page.locator(\"#participantRouteEnterFullscreenButton\").click();\n  await page.waitForFunction(() => Boolean(document.fullscreenElement));\n  await page\n    .locator(\"#participantRouteFullscreenStatus\")\n    .filter({ hasText: \"active\" })\nscripts/run-postgres-ui-smoke.mjs\nscripts/smoke-ui.mjs\nscripts/with-build-metadata.mjs\n","exit_code":0,"duration":{"secs":0,"nanos":9542},"formatted_output":"    officialProtocolCorpus.currentOriginalTestControllerPackage;\n  const testControllerFixtures = currentTestControllerPackage.booklets.map(\n    ([fixture, bookletKey]) => ({\n      fixture,\n      bookletKey,\n      packagePath: `booklets/${bookletKey.replace(\"Cy-Bklt_\", \"CY_Bklt_\")}.xml`\n    })\n  );\n  const testControllerUnitFixtures = currentTestControllerPackage.units.map(\n    ([fixture, unitKey], index) => ({\n      fixture,\n      unitKey,\n      packagePath: `units/CY_Unit${index + 100}.xml`\n    })\n  );\n  const [\n    testControllerDocuments,\n    testControllerUnitDocuments,\n    testControllerPlayerDocument\n  ] =\n    await Promise.all([\n      Promise.all(\n        testControllerFixtures.map(async fixture => ({\n          ...fixture,\n          content: Buffer.from(\n            (\n              await readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      Promise.all(\n        testControllerUnitFixtures.map(async fixture => ({\n          ...fixture,\n          content: Buffer.from(\n            (\n              await readFile(\n                resolve(originalCorpusRoot, fixture.fixture),\n                \"utf8\"\n              )\n            ).trim(),\n            \"base64\"\n          ).toString(\"utf8\")\n        }))\n      ),\n      readBrotliBase64Text(\n        resolve(\n          originalCorpusRoot,\n          currentTestControllerPackage.player.fixture\n        )\n      )\n    ]);\n  const testControllerManifestResources = [\n    ...testControllerFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.bookletKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    ...testControllerUnitFixtures.map(\n      fixture =>\n        `<resource identifier=\"${fixture.unitKey}\" href=\"${fixture.packagePath}\" />`\n    ),\n    `<resource identifier=\"${currentTestControllerPackage.player.playerKey}\" href=\"players/verona-player-simple-6.0.html\" />`\n  ].join(\"\\n\");\n  const testControllerZip = createStoredZipBuffer([\n    {\n      fileName: \"export/imsmanifest.xml\",\n      content: `\n        <manifest xmlns=\"http://www.imsglobal.org/xsd/imscp_v1p1\">\n          <resources>${testControllerManifestResources}</resources>\n        </manifest>\n      `\n    },\n    ...testControllerDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    ...testControllerUnitDocuments.map(document => ({\n      fileName: `export/${document.packagePath}`,\n      content: document.content\n    })),\n    {\n      fileName: \"export/players/verona-player-simple-6.0.html\",\n      content: testControllerPlayerDocument\n    }\n  ]);\n  const testControllerSourcePackageResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/source-packages`,\n    {\n      body: {\n        fileName: \"original-test-controller-browser-smoke.zip\",\n        mediaType: \"application/zip\",\n        sourceDocument: `data:application/zip;base64,${testControllerZip.toString(\"base64\")}`\n      }\n    }\n  );\n  const testControllerSourcePackagePayload =\n    await testControllerSourcePackageResponse.json();\n  const testControllerImportResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/import-jobs`,\n    {\n      body: {\n        sourcePackageId:\n          testControllerSourcePackagePayload.sourcePackage.sourcePackageId\n      }\n    }\n  );\n  const testControllerImportPayload = await testControllerImportResponse.json();\n  const testControllerReleaseId =\n    testControllerImportPayload.stagedContentRelease?.contentReleaseId;\n  assert.ok(\n    testControllerReleaseId,\n    `Original Test Controller browser import should stage a release: ${JSON.stringify(\n      testControllerImportPayload.importJob?.diagnostics ?? []\n    )}`\n  );\n  await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/content-releases/${testControllerReleaseId}/activate`,\n    { body: {} }\n  );\n  const testControllerRosterResponse = await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/participant-roster`,\n    {\n      body: {\n        rosterText: Buffer.from(\n          (\n            await readFile(\n              resolve(\n                originalCorpusRoot,\n                currentTestControllerPackage.roster.fixture\n              ),\n              \"utf8\"\n            )\n          ).trim(),\n          \"base64\"\n        ).toString(\"utf8\")\n      }\n    }\n  );\n  const testControllerRosterPayload = await testControllerRosterResponse.json();\n  assert.equal(\n    testControllerRosterPayload.items.length,\n    currentTestControllerPackage.roster.participantCount\n  );\n  assert.deepEqual(\n    testControllerRosterPayload.items\n      .filter(item => [\"Test_Ctrl-3\", \"Test_Ctrl-23\"].includes(item.loginKey))\n      .map(item => [item.loginKey, item.bookletKey, item.passwordRequired])\n      .sort((left, right) => left[0].localeCompare(right[0])),\n    [\n      [\"Test_Ctrl-23\", \"Cy-Bklt_TC-14\", true],\n      [\"Test_Ctrl-3\", \"Cy-Bklt_TC-3\", true]\n    ]\n  );\n  const openOriginalTestController = async (loginKey, bookletKey, existingSessionId, interfaceMode = \"rewrite\") => {\n    let participantSessionId = existingSessionId;\n    if (!participantSessionId) {\n      const signInResponse = await sendSmokeJson(\n        `${baseUrl}/api/v1/participant/auth/sign-in`,\n        {\n          body: {\n            tenantKey: testControllerTenantKey,\n            workspaceKey: testControllerWorkspaceKey,\n            loginKey,\n            password: \"123\"\n          }\n        }\n      );\n      const signInPayload = await signInResponse.json();\n      participantSessionId = signInPayload.participantSession?.participantSessionId;\n    }\n    assert.ok(participantSessionId, `${loginKey} should create a session.`);\n    const resumeResponse = await sendSmokeJson(\n      `${baseUrl}/api/v1/participant/sessions/${participantSessionId}/resume`,\n      { body: { bookletKey } }\n    );\n    const resumePayload = await resumeResponse.json();\n    await participantHttpActor.goto(page,\n      `${baseUrl}/participant?participantSessionId=${encodeURIComponent(\n        participantSessionId\n      )}&ui=${interfaceMode}`,\n      { waitUntil: \"domcontentloaded\" }\n    );\n    await page\n      .locator(\"#participantVeronaPlayerVersion\")\n      .filter({ hasText: \"API 6.0\" })\n      .waitFor({ timeout: 30_000, state: interfaceMode === \"original\" ? \"attached\" : \"visible\" });\n    return {\n      frame: page.frameLocator(\"#participantVeronaPlayerFrame\"),\n      participantSessionId,\n      testRunId: resumePayload.testRun?.testRunId\n    };\n  };\n  const completeOriginalControllerUnit = async frame => {\n    await frame\n      .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n      .check();\n    await frame.locator(\"#next-page\").click();\n    await frame\n      .getByText(\"Presentation complete\", { exact: true })\n      .waitFor({ timeout: 15_000 });\n  };\n  const waitForOriginalControllerCompletenessDenial = async (\n    controller,\n    direction,\n    deniedReasons\n  ) =>\n    pollJsonWithPredicate(\n      `${baseUrl}/api/v1/participant/sessions/${controller.participantSessionId}/current-state`,\n      payload => {\n        const reasons =\n          direction === \"forward\"\n            ? payload?.currentRunState?.navigation?.forwardDeniedReasons\n            : payload?.currentRunState?.navigation?.backwardDeniedReasons;\n        return (\n          Array.isArray(reasons) &&\n          reasons.length === deniedReasons.length &&\n          deniedReasons.every(reason => reasons.includes(reason))\n        );\n      }\n    );\n  const waitForOriginalControllerCompletenessAllowed = async (\n    controller,\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { dirname, resolve } from \"node:path\";\nimport { setTimeout as delay } from \"node:timers/promises\";\nimport { brotliDecompressSync } from \"node:zlib\";\n\nimport { chromium } from \"playwright\";\nimport QRCode from \"qrcode\";\nimport { createParticipantHttpTestActor } from \"./participant-http-test-actor.mjs\";\n\nconst participantHttpActor = createParticipantHttpTestActor();\nconst fetch = participantHttpActor.fetch;\n\nconst store = process.env.FIRST_SLICE_STORE ?? \"sqlite\";\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\nconst operatorAuthRequired =\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \"true\";\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \"\";\nconst configuredProofOfWorkScopes = new Set(\n  String(process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES ?? \"\")\n    .split(/[\\s,]+/u)\n    .filter(Boolean)\n);\nconst skipRuntimeCsvExports = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_RUNTIME_CSV_EXPORTS ?? \"\").toLowerCase()\n);\nconst skipOfflineAppShell = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_OFFLINE_APP_SHELL ?? \"\").toLowerCase()\n);\nconst skipWorkspaceRename = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_WORKSPACE_RENAME ?? \"\").toLowerCase()\n);\nconst busyStartTimeoutMs = Number.parseInt(\n  process.env.UI_SMOKE_BUSY_START_TIMEOUT_MS ?? \"750\",\n  10\n);\nconst logBusyStartTimeouts = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_LOG_BUSY_START_TIMEOUTS ?? \"\").toLowerCase()\n);\nconst serverEntry = resolve(\"apps/api/dist/apps/api/src/index.js\");\nconst failedImportSourceDocument = '{\"booklets\":[]}';\nconst repairedImportSourceDocument =\n  '<assessment><booklet key=\"booklet:recovered\" label=\"Recovered\"><unit key=\"unit-recovered\" label=\"Recovered Unit\" /></booklet></assessment>';\nconst uploadedSourceDocument =\n  '<Booklet><Metadata><Id>booklet:starter</Id><Label>Starter</Label></Metadata><BookletConfig><Config key=\"toolbar_show_unit_list\">TRUE</Config><Config key=\"ask_for_fullscreen\">ON</Config><Config key=\"show_fullscreen_button\">ON</Config><Config key=\"toolbar_show_reload_button\">TRUE</Config><Config key=\"unit_screenheader\">WITH_UNIT_TITLE</Config><Config key=\"unit_title\">OFF</Config></BookletConfig><Units><Unit id=\"unit-1\" label=\"Entry\" /><Testlet id=\"testlet:participant-route\" label=\"Participant Route Block\"><Unit id=\"unit-participant-route\" label=\"Participant Route\"><description>Read the participant prompt.</description><prompt>Explain how the starter example works.</prompt></Unit></Testlet><Testlet id=\"testlet:timed-paused\" label=\"Timed Paused Work\"><Restrictions><TimeMax minutes=\"5\" leave=\"allowed\" /></Restrictions><Unit id=\"unit-paused\" label=\"Paused Work\"><Definition><![CDATA[<section>Answer the direct Testcenter definition prompt.</section>]]></Definition></Unit></Testlet></Units></Booklet>';\nlet smokeAdminSessionToken = \"\";\n\nconst readBrotliBase64Text = async fixturePath =>\n  brotliDecompressSync(\n    Buffer.from(await readFile(fixturePath, \"utf8\"), \"base64\")\n  ).toString(\"utf8\");\n\nconst crc32Table = Array.from({ length: 256 }, (_, value) => {\n  let crc = value;\n  for (let bit = 0; bit < 8; bit += 1) {\n    crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\n  }\n  return crc >>> 0;\n});\n\nconst crc32 = content => {\n  let crc = 0xffffffff;\n  for (const byte of content) {\n    crc = crc32Table[(crc ^ byte) & 0xff] ^ (crc >>> 8);\n  }\n  return (crc ^ 0xffffffff) >>> 0;\n};\n\nconst createStoredZipBuffer = entries => {\n  const localFileHeaders = [];\n  const centralDirectoryHeaders = [];\n  let offset = 0;\n\n  for (const entry of entries) {\n    const fileName = Buffer.from(entry.fileName, \"utf8\");\n    const content = Buffer.from(entry.content, \"utf8\");\n    const checksum = crc32(content);\n    const localHeader = Buffer.alloc(30 + fileName.length);\n    localHeader.writeUInt32LE(0x04034b50, 0);\n    localHeader.writeUInt16LE(20, 4);\n    localHeader.writeUInt16LE(0x0800, 6);\n    localHeader.writeUInt16LE(0, 8);\n    localHeader.writeUInt32LE(0, 10);\n    localHeader.writeUInt32LE(checksum, 14);\n    localHeader.writeUInt32LE(content.length, 18);\n    localHeader.writeUInt32LE(content.length, 22);\n    localHeader.writeUInt16LE(fileName.length, 26);\n    fileName.copy(localHeader, 30);\n    localFileHeaders.push(localHeader, content);\n\n    const centralDirectoryHeader = Buffer.alloc(46 + fileName.length);\n    centralDirectoryHeader.writeUInt32LE(0x02014b50, 0);\n    centralDirectoryHeader.writeUInt16LE(20, 4);\n    centralDirectoryHeader.writeUInt16LE(20, 6);\n    centralDirectoryHeader.writeUInt16LE(0x0800, 8);\n    centralDirectoryHeader.writeUInt16LE(0, 10);\n    centralDirectoryHeader.writeUInt32LE(0, 12);\n    centralDirectoryHeader.writeUInt32LE(checksum, 16);\n    centralDirectoryHeader.writeUInt32LE(content.length, 20);\n    centralDirectoryHeader.writeUInt32LE(content.length, 24);\n    centralDirectoryHeader.writeUInt16LE(fileName.length, 28);\n    centralDirectoryHeader.writeUInt32LE(offset, 42);\n    fileName.copy(centralDirectoryHeader, 46);\n    centralDirectoryHeaders.push(centralDirectoryHeader);\n\n    offset += localHeader.length + content.length;\n  }\n\n  const centralDirectoryOffset = offset;\n  const centralDirectory = Buffer.concat(centralDirectoryHeaders);\n  const endOfCentralDirectory = Buffer.alloc(22);\n  endOfCentralDirectory.writeUInt32LE(0x06054b50, 0);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 8);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 10);\n  endOfCentralDirectory.writeUInt32LE(centralDirectory.length, 12);\n  endOfCentralDirectory.writeUInt32LE(centralDirectoryOffset, 16);\n\n  );\n  const participantEntryStartedRunId =\n    participantEntryStartedPayload.currentRunState.testRun.testRunId;\n  await page.waitForFunction(\n    ([expectedSessionId, expectedDisplayName, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteDisplayName\")?.textContent?.trim() ===\n        expectedDisplayName &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [\n      participantEntrySignInSessionId,\n      participantEntrySignInDisplayName,\n      participantEntryStartedRunId\n    ],\n    { timeout: 15_000 }\n  );\n  assert.equal(\n    await page.locator(\"#participantEntryIssueCode\").count(),\n    0,\n    \"Participant entry issue guidance should clear after a successful sign-in.\"\n  );\n  const originalSignInContext = await browser.newContext();\n  participantHttpActor.observeContext(originalSignInContext);\n  try {\n    const originalSignInPage = await originalSignInContext.newPage();\n    await originalSignInPage.goto(`${baseUrl}/app/participant?${new URLSearchParams({\n      ui: \"original\", tenantKey, workspaceKey\n    })}`, { waitUntil: \"networkidle\" });\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    await originalSignInPage.locator(\"#originalApplicationFooter\").waitFor();\n    assert.deepEqual(await originalSignInPage.locator(\"#originalApplicationFooter nav a\").allTextContents(),\n      [\"Barrierefreiheit\", \"Datenschutz\", \"Impressum\"]);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").count(), 0);\n    await originalSignInPage.locator(\".login-submit svg[matButtonIcon]\").waitFor();\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantLogin\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId,\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    // The optional layout must preserve the same durable run when returning\n    // to its numbered Starter card and resuming from that card.\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").waitFor();\n    await originalSignInPage.locator(\"#participantConfirmationStayButton\").click();\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantStarter\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    assert.equal(await originalSignInPage.locator(\"#participantRouteEntry\").count(), 0);\n    assert.equal(await originalSignInPage.locator(\"#participantRoutePlayer\").count(), 0);\n    await originalSignInPage.locator(\"#participantApplicationHeader h1\").filter({ hasText: \"Übersicht\" }).waitFor();\n    assert.equal(await originalSignInPage.locator(\"#originalApplicationFooter\").count(), 0);\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor();\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountLogin\").textContent())?.trim(),\n      participantEntrySignInLoginKey);\n    assert.equal((await originalSignInPage.locator(\"#originalParticipantAccountGroup\").textContent())?.trim(),\n      participantEntrySignInGroupKey);\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantLogoutButton\").isDisabled(), false);\n    await originalSignInPage.keyboard.press(\"Escape\");\n    await originalSignInPage.locator(\"#originalParticipantAccountLogin\").waitFor({ state: \"detached\" });\n    assert.equal(await originalSignInPage.locator(\"#originalParticipantAccountButton\").evaluate(el => el === document.activeElement), true);\n    const originalResumeCard = originalSignInPage.locator(\"#originalParticipantStarter mat-card[data-booklet-status='in_progress']\");\n    assert.equal(await originalResumeCard.count(), 1);\n    await originalResumeCard.getByRole(\"button\").click();\n    await originalSignInPage.waitForFunction(\n      ([sessionId, runId]) =>\n        !document.querySelector(\"#originalParticipantStarter\") &&\n        document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n        document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n        document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() === \"running\",\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\n    );\n    await originalSignInPage.locator(\"#participantApplicationLogoButton\").click();\n    await originalSignInPage.locator(\"#participantConfirmationContinueButton\").click();\n    await originalSignInPage.locator(\"#originalParticipantStarter\").waitFor();\n    const originalCredentialBeforeLogout = await originalSignInPage.evaluate(sessionId => {\n      const state = JSON.parse(localStorage.getItem(\"testcenter-rewrite:participant-access:v1\") ?? \"{}\");\n      return state.sessions?.find(([id]) => id === sessionId)?.[1];\n    }, participantEntrySignInSessionId);\n    assert.match(originalCredentialBeforeLogout, /^[A-Za-z0-9_-]{43}$/u);\n    const originalStateBeforeLogout = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } }\n    )).json();\n    await originalSignInPage.locator(\"#originalParticipantAccountButton\").click();\n    const logoutCompleted = originalSignInPage.waitForResponse(response => response.request().method() === \"DELETE\" &&\n      response.url().endsWith(`/sessions/${participantEntrySignInSessionId}/access`) && response.status() === 205);\n    await originalSignInPage.locator(\"#originalParticipantLogoutButton\").click();\n    await logoutCompleted;\n    await originalSignInPage.locator(\"#originalParticipantLogin\").waitFor();\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \"originalLoginName\");\n    assert.equal(new URL(originalSignInPage.url()).searchParams.has(\"participantSessionId\"), false);\n    assert.equal((await fetch(`${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } })).status, 401);\n    await originalSignInPage.locator(\"#originalLoginName\").fill(participantEntrySignInLoginKey);\n    await originalSignInPage.getByRole(\"button\", { name: \"Weiter\", exact: true }).click();\n    await originalSignInPage.waitForFunction(expectedRunId =>\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === expectedRunId,\n      participantEntryStartedRunId);\n    const restoredOriginalState = await (await fetch(\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`\n    )).json();\n    assert.equal(restoredOriginalState.currentRunState.testRun.testRunId, participantEntryStartedRunId);\n    assert.deepEqual(restoredOriginalState.currentRunState.testRun.unitResponses,\n      originalStateBeforeLogout.currentRunState.testRun.unitResponses);\n  } finally {\n    await originalSignInContext.close();\n  }\n  // A second real login rotates access for this participant. Re-authenticate\n  // the first browser through its UI; never inject the other browser's token.\n  await page.locator(\"#participantRouteClearSessionButton\").click();\n  await page.locator(\"#participantRouteEntry\").waitFor();\n  await page.locator(\"#participantRouteSignInButton\").click();\n  await page.waitForFunction(\n    ([sessionId, runId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() === sessionId &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() === runId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId]\n  );\n  stopAfter(\"participant-entry-sign-in\");\n  logStep(\"participant-entry-start-after-sign-in\");\n  await page.waitForFunction(\n    ([expectedSessionId, expectedRunId]) =>\n      document.querySelector(\"#participantRouteSessionLabel\")?.textContent?.trim() ===\n        expectedSessionId &&\n      document.querySelector(\"#participantRouteStatus\")?.textContent?.trim() ===\n        \"running\" &&\n      document.querySelector(\"#participantRouteRunId\")?.textContent?.trim() ===\n        expectedRunId &&\n      document.querySelector(\"#participantRouteEntry\") == null,\n    [participantEntrySignInSessionId, participantEntryStartedRunId],\n    { timeout: 15_000 }\n  );\n  await page.locator(\"#participantRouteFullscreenPrompt\").waitFor();\n  await page\n    .locator(\"#participantRouteScreenHeader\")\n    .filter({ hasText: \"Entry\" })\n    .waitFor();\n  assert.equal(await page.locator(\"#participantRouteUnit\").count(), 0);\n  await page.locator(\"#participantRouteFullscreenButton\").waitFor();\n  await page.locator(\"#participantRouteEnterFullscreenButton\").click();\n  await page.waitForFunction(() => Boolean(document.fullscreenElement));\n  await page\n    .locator(\"#participantRouteFullscreenStatus\")\n    .filter({ hasText: \"active\" })\nscripts/run-postgres-ui-smoke.mjs\nscripts/smoke-ui.mjs\nscripts/with-build-metadata.mjs\n"},"started_at_ms":1791051945960,"completed_at_ms":1791051945960}}
{"timestamp":"2026-10-03T18:25:45.994Z","ordinal":68251,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a10303-d80a-71a0-a6bb-f0c635cf32d9","call_id":"call_cyWxZzZPEfmrA565I2HNE4Ox","output":[{"type":"input_text","text":"Script completed\nWall time 1.3 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"dca89a\",\"wall_time_seconds\":1.003093,\"session_id\":82549,\"original_token_count\":0,\"output\":\"\"}"},{"type":"input_text","text":"{\"chunk_id\":\"233c73\",\"wall_time_seconds\":0.000009542,\"exit_code\":0,\"original_token_count\":5946,\"output\":\"    officialProtocolCorpus.currentOriginalTestControllerPackage;\\n  const testControllerFixtures = currentTestControllerPackage.booklets.map(\\n    ([fixture, bookletKey]) => ({\\n      fixture,\\n      bookletKey,\\n      packagePath: `booklets/${bookletKey.replace(\\\"Cy-Bklt_\\\", \\\"CY_Bklt_\\\")}.xml`\\n    })\\n  );\\n  const testControllerUnitFixtures = currentTestControllerPackage.units.map(\\n    ([fixture, unitKey], index) => ({\\n      fixture,\\n      unitKey,\\n      packagePath: `units/CY_Unit${index + 100}.xml`\\n    })\\n  );\\n  const [\\n    testControllerDocuments,\\n    testControllerUnitDocuments,\\n    testControllerPlayerDocument\\n  ] =\\n    await Promise.all([\\n      Promise.all(\\n        testControllerFixtures.map(async fixture => ({\\n          ...fixture,\\n          content: Buffer.from(\\n            (\\n              await readFile(\\n                resolve(originalCorpusRoot, fixture.fixture),\\n                \\\"utf8\\\"\\n              )\\n            ).trim(),\\n            \\\"base64\\\"\\n          ).toString(\\\"utf8\\\")\\n        }))\\n      ),\\n      Promise.all(\\n        testControllerUnitFixtures.map(async fixture => ({\\n          ...fixture,\\n          content: Buffer.from(\\n            (\\n              await readFile(\\n                resolve(originalCorpusRoot, fixture.fixture),\\n                \\\"utf8\\\"\\n              )\\n            ).trim(),\\n            \\\"base64\\\"\\n          ).toString(\\\"utf8\\\")\\n        }))\\n      ),\\n      readBrotliBase64Text(\\n        resolve(\\n          originalCorpusRoot,\\n          currentTestControllerPackage.player.fixture\\n        )\\n      )\\n    ]);\\n  const testControllerManifestResources = [\\n    ...testControllerFixtures.map(\\n      fixture =>\\n        `<resource identifier=\\\"${fixture.bookletKey}\\\" href=\\\"${fixture.packagePath}\\\" />`\\n    ),\\n    ...testControllerUnitFixtures.map(\\n      fixture =>\\n        `<resource identifier=\\\"${fixture.unitKey}\\\" href=\\\"${fixture.packagePath}\\\" />`\\n    ),\\n    `<resource identifier=\\\"${currentTestControllerPackage.player.playerKey}\\\" href=\\\"players/verona-player-simple-6.0.html\\\" />`\\n  ].join(\\\"\\\\n\\\");\\n  const testControllerZip = createStoredZipBuffer([\\n    {\\n      fileName: \\\"export/imsmanifest.xml\\\",\\n      content: `\\n        <manifest xmlns=\\\"http://www.imsglobal.org/xsd/imscp_v1p1\\\">\\n          <resources>${testControllerManifestResources}</resources>\\n        </manifest>\\n      `\\n    },\\n    ...testControllerDocuments.map(document => ({\\n      fileName: `export/${document.packagePath}`,\\n      content: document.content\\n    })),\\n    ...testControllerUnitDocuments.map(document => ({\\n      fileName: `export/${document.packagePath}`,\\n      content: document.content\\n    })),\\n    {\\n      fileName: \\\"export/players/verona-player-simple-6.0.html\\\",\\n      content: testControllerPlayerDocument\\n    }\\n  ]);\\n  const testControllerSourcePackageResponse = await sendSmokeJson(\\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/source-packages`,\\n    {\\n      body: {\\n        fileName: \\\"original-test-controller-browser-smoke.zip\\\",\\n        mediaType: \\\"application/zip\\\",\\n        sourceDocument: `data:application/zip;base64,${testControllerZip.toString(\\\"base64\\\")}`\\n      }\\n    }\\n  );\\n  const testControllerSourcePackagePayload =\\n    await testControllerSourcePackageResponse.json();\\n  const testControllerImportResponse = await sendSmokeJson(\\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/import-jobs`,\\n    {\\n      body: {\\n        sourcePackageId:\\n          testControllerSourcePackagePayload.sourcePackage.sourcePackageId\\n      }\\n    }\\n  );\\n  const testControllerImportPayload = await testControllerImportResponse.json();\\n  const testControllerReleaseId =\\n    testControllerImportPayload.stagedContentRelease?.contentReleaseId;\\n  assert.ok(\\n    testControllerReleaseId,\\n    `Original Test Controller browser import should stage a release: ${JSON.stringify(\\n      testControllerImportPayload.importJob?.diagnostics ?? []\\n    )}`\\n  );\\n  await sendSmokeJson(\\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/content-releases/${testControllerReleaseId}/activate`,\\n    { body: {} }\\n  );\\n  const testControllerRosterResponse = await sendSmokeJson(\\n    `${baseUrl}/api/v1/tenants/${testControllerTenantKey}/workspaces/${testControllerWorkspaceKey}/participant-roster`,\\n    {\\n      body: {\\n        rosterText: Buffer.from(\\n          (\\n            await readFile(\\n              resolve(\\n                originalCorpusRoot,\\n                currentTestControllerPackage.roster.fixture\\n              ),\\n              \\\"utf8\\\"\\n            )\\n          ).trim(),\\n          \\\"base64\\\"\\n        ).toString(\\\"utf8\\\")\\n      }\\n    }\\n  );\\n  const testControllerRosterPayload = await testControllerRosterResponse.json();\\n  assert.equal(\\n    testControllerRosterPayload.items.length,\\n    currentTestControllerPackage.roster.participantCount\\n  );\\n  assert.deepEqual(\\n    testControllerRosterPayload.items\\n      .filter(item => [\\\"Test_Ctrl-3\\\", \\\"Test_Ctrl-23\\\"].includes(item.loginKey))\\n      .map(item => [item.loginKey, item.bookletKey, item.passwordRequired])\\n      .sort((left, right) => left[0].localeCompare(right[0])),\\n    [\\n      [\\\"Test_Ctrl-23\\\", \\\"Cy-Bklt_TC-14\\\", true],\\n      [\\\"Test_Ctrl-3\\\", \\\"Cy-Bklt_TC-3\\\", true]\\n    ]\\n  );\\n  const openOriginalTestController = async (loginKey, bookletKey, existingSessionId, interfaceMode = \\\"rewrite\\\") => {\\n    let participantSessionId = existingSessionId;\\n    if (!participantSessionId) {\\n      const signInResponse = await sendSmokeJson(\\n        `${baseUrl}/api/v1/participant/auth/sign-in`,\\n        {\\n          body: {\\n            tenantKey: testControllerTenantKey,\\n            workspaceKey: testControllerWorkspaceKey,\\n            loginKey,\\n            password: \\\"123\\\"\\n          }\\n        }\\n      );\\n      const signInPayload = await signInResponse.json();\\n      participantSessionId = signInPayload.participantSession?.participantSessionId;\\n    }\\n    assert.ok(participantSessionId, `${loginKey} should create a session.`);\\n    const resumeResponse = await sendSmokeJson(\\n      `${baseUrl}/api/v1/participant/sessions/${participantSessionId}/resume`,\\n      { body: { bookletKey } }\\n    );\\n    const resumePayload = await resumeResponse.json();\\n    await participantHttpActor.goto(page,\\n      `${baseUrl}/participant?participantSessionId=${encodeURIComponent(\\n        participantSessionId\\n      )}&ui=${interfaceMode}`,\\n      { waitUntil: \\\"domcontentloaded\\\" }\\n    );\\n    await page\\n      .locator(\\\"#participantVeronaPlayerVersion\\\")\\n      .filter({ hasText: \\\"API 6.0\\\" })\\n      .waitFor({ timeout: 30_000, state: interfaceMode === \\\"original\\\" ? \\\"attached\\\" : \\\"visible\\\" });\\n    return {\\n      frame: page.frameLocator(\\\"#participantVeronaPlayerFrame\\\"),\\n      participantSessionId,\\n      testRunId: resumePayload.testRun?.testRunId\\n    };\\n  };\\n  const completeOriginalControllerUnit = async frame => {\\n    await frame\\n      .locator('[data-cy=\\\"TestController-radio1-Aufg1\\\"]')\\n      .check();\\n    await frame.locator(\\\"#next-page\\\").click();\\n    await frame\\n      .getByText(\\\"Presentation complete\\\", { exact: true })\\n      .waitFor({ timeout: 15_000 });\\n  };\\n  const waitForOriginalControllerCompletenessDenial = async (\\n    controller,\\n    direction,\\n    deniedReasons\\n  ) =>\\n    pollJsonWithPredicate(\\n      `${baseUrl}/api/v1/participant/sessions/${controller.participantSessionId}/current-state`,\\n      payload => {\\n        const reasons =\\n          direction === \\\"forward\\\"\\n            ? payload?.currentRunState?.navigation?.forwardDeniedReasons\\n            : payload?.currentRunState?.navigation?.backwardDeniedReasons;\\n        return (\\n          Array.isArray(reasons) &&\\n          reasons.length === deniedReasons.length &&\\n          deniedReasons.every(reason => reasons.includes(reason))\\n        );\\n      }\\n    );\\n  const waitForOriginalControllerCompletenessAllowed = async (\\n    controller,\\nimport assert from \\\"node:assert/strict\\\";\\nimport { spawn } from \\\"node:child_process\\\";\\nimport { createHash } from \\\"node:crypto\\\";\\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \\\"node:fs/promises\\\";\\nimport { createServer as createNetServer } from \\\"node:net\\\";\\nimport { dirname, resolve } from \\\"node:path\\\";\\nimport { setTimeout as delay } from \\\"node:timers/promises\\\";\\nimport { brotliDecompressSync } from \\\"node:zlib\\\";\\n\\nimport { chromium } from \\\"playwright\\\";\\nimport QRCode from \\\"qrcode\\\";\\nimport { createParticipantHttpTestActor } from \\\"./participant-http-test-actor.mjs\\\";\\n\\nconst participantHttpActor = createParticipantHttpTestActor();\\nconst fetch = participantHttpActor.fetch;\\n\\nconst store = process.env.FIRST_SLICE_STORE ?? \\\"sqlite\\\";\\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\\nconst operatorAuthRequired =\\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \\\"true\\\";\\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \\\"\\\";\\nconst configuredProofOfWorkScopes = new Set(\\n  String(process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES ?? \\\"\\\")\\n    .split(/[\\\\s,]+/u)\\n    .filter(Boolean)\\n);\\nconst skipRuntimeCsvExports = [\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"].includes(\\n  String(process.env.UI_SMOKE_SKIP_RUNTIME_CSV_EXPORTS ?? \\\"\\\").toLowerCase()\\n);\\nconst skipOfflineAppShell = [\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"].includes(\\n  String(process.env.UI_SMOKE_SKIP_OFFLINE_APP_SHELL ?? \\\"\\\").toLowerCase()\\n);\\nconst skipWorkspaceRename = [\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"].includes(\\n  String(process.env.UI_SMOKE_SKIP_WORKSPACE_RENAME ?? \\\"\\\").toLowerCase()\\n);\\nconst busyStartTimeoutMs = Number.parseInt(\\n  process.env.UI_SMOKE_BUSY_START_TIMEOUT_MS ?? \\\"750\\\",\\n  10\\n);\\nconst logBusyStartTimeouts = [\\\"1\\\", \\\"true\\\", \\\"yes\\\", \\\"on\\\"].includes(\\n  String(process.env.UI_SMOKE_LOG_BUSY_START_TIMEOUTS ?? \\\"\\\").toLowerCase()\\n);\\nconst serverEntry = resolve(\\\"apps/api/dist/apps/api/src/index.js\\\");\\nconst failedImportSourceDocument = '{\\\"booklets\\\":[]}';\\nconst repairedImportSourceDocument =\\n  '<assessment><booklet key=\\\"booklet:recovered\\\" label=\\\"Recovered\\\"><unit key=\\\"unit-recovered\\\" label=\\\"Recovered Unit\\\" /></booklet></assessment>';\\nconst uploadedSourceDocument =\\n  '<Booklet><Metadata><Id>booklet:starter</Id><Label>Starter</Label></Metadata><BookletConfig><Config key=\\\"toolbar_show_unit_list\\\">TRUE</Config><Config key=\\\"ask_for_fullscreen\\\">ON</Config><Config key=\\\"show_fullscreen_button\\\">ON</Config><Config key=\\\"toolbar_show_reload_button\\\">TRUE</Config><Config key=\\\"unit_screenheader\\\">WITH_UNIT_TITLE</Config><Config key=\\\"unit_title\\\">OFF</Config></BookletConfig><Units><Unit id=\\\"unit-1\\\" label=\\\"Entry\\\" /><Testlet id=\\\"testlet:participant-route\\\" label=\\\"Participant Route Block\\\"><Unit id=\\\"unit-participant-route\\\" label=\\\"Participant Route\\\"><description>Read the participant prompt.</description><prompt>Explain how the starter example works.</prompt></Unit></Testlet><Testlet id=\\\"testlet:timed-paused\\\" label=\\\"Timed Paused Work\\\"><Restrictions><TimeMax minutes=\\\"5\\\" leave=\\\"allowed\\\" /></Restrictions><Unit id=\\\"unit-paused\\\" label=\\\"Paused Work\\\"><Definition><![CDATA[<section>Answer the direct Testcenter definition prompt.</section>]]></Definition></Unit></Testlet></Units></Booklet>';\\nlet smokeAdminSessionToken = \\\"\\\";\\n\\nconst readBrotliBase64Text = async fixturePath =>\\n  brotliDecompressSync(\\n    Buffer.from(await readFile(fixturePath, \\\"utf8\\\"), \\\"base64\\\")\\n  ).toString(\\\"utf8\\\");\\n\\nconst crc32Table = Array.from({ length: 256 }, (_, value) => {\\n  let crc = value;\\n  for (let bit = 0; bit < 8; bit += 1) {\\n    crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\\n  }\\n  return crc >>> 0;\\n});\\n\\nconst crc32 = content => {\\n  let crc = 0xffffffff;\\n  for (const byte of content) {\\n    crc = crc32Table[(crc ^ byte) & 0xff] ^ (crc >>> 8);\\n  }\\n  return (crc ^ 0xffffffff) >>> 0;\\n};\\n\\nconst createStoredZipBuffer = entries => {\\n  const localFileHeaders = [];\\n  const centralDirectoryHeaders = [];\\n  let offset = 0;\\n\\n  for (const entry of entries) {\\n    const fileName = Buffer.from(entry.fileName, \\\"utf8\\\");\\n    const content = Buffer.from(entry.content, \\\"utf8\\\");\\n    const checksum = crc32(content);\\n    const localHeader = Buffer.alloc(30 + fileName.length);\\n    localHeader.writeUInt32LE(0x04034b50, 0);\\n    localHeader.writeUInt16LE(20, 4);\\n    localHeader.writeUInt16LE(0x0800, 6);\\n    localHeader.writeUInt16LE(0, 8);\\n    localHeader.writeUInt32LE(0, 10);\\n    localHeader.writeUInt32LE(checksum, 14);\\n    localHeader.writeUInt32LE(content.length, 18);\\n    localHeader.writeUInt32LE(content.length, 22);\\n    localHeader.writeUInt16LE(fileName.length, 26);\\n    fileName.copy(localHeader, 30);\\n    localFileHeaders.push(localHeader, content);\\n\\n    const centralDirectoryHeader = Buffer.alloc(46 + fileName.length);\\n    centralDirectoryHeader.writeUInt32LE(0x02014b50, 0);\\n    centralDirectoryHeader.writeUInt16LE(20, 4);\\n    centralDirectoryHeader.writeUInt16LE(20, 6);\\n    centralDirectoryHeader.writeUInt16LE(0x0800, 8);\\n    centralDirectoryHeader.writeUInt16LE(0, 10);\\n    centralDirectoryHeader.writeUInt32LE(0, 12);\\n    centralDirectoryHeader.writeUInt32LE(checksum, 16);\\n    centralDirectoryHeader.writeUInt32LE(content.length, 20);\\n    centralDirectoryHeader.writeUInt32LE(content.length, 24);\\n    centralDirectoryHeader.writeUInt16LE(fileName.length, 28);\\n    centralDirectoryHeader.writeUInt32LE(offset, 42);\\n    fileName.copy(centralDirectoryHeader, 46);\\n    centralDirectoryHeaders.push(centralDirectoryHeader);\\n\\n    offset += localHeader.length + content.length;\\n  }\\n\\n  const centralDirectoryOffset = offset;\\n  const centralDirectory = Buffer.concat(centralDirectoryHeaders);\\n  const endOfCentralDirectory = Buffer.alloc(22);\\n  endOfCentralDirectory.writeUInt32LE(0x06054b50, 0);\\n  endOfCentralDirectory.writeUInt16LE(entries.length, 8);\\n  endOfCentralDirectory.writeUInt16LE(entries.length, 10);\\n  endOfCentralDirectory.writeUInt32LE(centralDirectory.length, 12);\\n  endOfCentralDirectory.writeUInt32LE(centralDirectoryOffset, 16);\\n\\n  );\\n  const participantEntryStartedRunId =\\n    participantEntryStartedPayload.currentRunState.testRun.testRunId;\\n  await page.waitForFunction(\\n    ([expectedSessionId, expectedDisplayName, expectedRunId]) =>\\n      document.querySelector(\\\"#participantRouteSessionLabel\\\")?.textContent?.trim() ===\\n        expectedSessionId &&\\n      document.querySelector(\\\"#participantRouteDisplayName\\\")?.textContent?.trim() ===\\n        expectedDisplayName &&\\n      document.querySelector(\\\"#participantRouteStatus\\\")?.textContent?.trim() ===\\n        \\\"running\\\" &&\\n      document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() ===\\n        expectedRunId &&\\n      document.querySelector(\\\"#participantRouteEntry\\\") == null,\\n    [\\n      participantEntrySignInSessionId,\\n      participantEntrySignInDisplayName,\\n      participantEntryStartedRunId\\n    ],\\n    { timeout: 15_000 }\\n  );\\n  assert.equal(\\n    await page.locator(\\\"#participantEntryIssueCode\\\").count(),\\n    0,\\n    \\\"Participant entry issue guidance should clear after a successful sign-in.\\\"\\n  );\\n  const originalSignInContext = await browser.newContext();\\n  participantHttpActor.observeContext(originalSignInContext);\\n  try {\\n    const originalSignInPage = await originalSignInContext.newPage();\\n    await originalSignInPage.goto(`${baseUrl}/app/participant?${new URLSearchParams({\\n      ui: \\\"original\\\", tenantKey, workspaceKey\\n    })}`, { waitUntil: \\\"networkidle\\\" });\\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \\\"originalLoginName\\\");\\n    await originalSignInPage.locator(\\\"#originalApplicationFooter\\\").waitFor();\\n    assert.deepEqual(await originalSignInPage.locator(\\\"#originalApplicationFooter nav a\\\").allTextContents(),\\n      [\\\"Barrierefreiheit\\\", \\\"Datenschutz\\\", \\\"Impressum\\\"]);\\n    assert.equal(await originalSignInPage.locator(\\\"#originalParticipantAccountButton\\\").count(), 0);\\n    await originalSignInPage.locator(\\\".login-submit svg[matButtonIcon]\\\").waitFor();\\n    await originalSignInPage.locator(\\\"#originalLoginName\\\").fill(participantEntrySignInLoginKey);\\n    await originalSignInPage.getByRole(\\\"button\\\", { name: \\\"Weiter\\\", exact: true }).click();\\n    await originalSignInPage.waitForFunction(\\n      ([sessionId, runId]) =>\\n        !document.querySelector(\\\"#originalParticipantLogin\\\") &&\\n        document.querySelector(\\\"#participantRouteSessionLabel\\\")?.textContent?.trim() === sessionId &&\\n        document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() === runId,\\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\\n    );\\n    // The optional layout must preserve the same durable run when returning\\n    // to its numbered Starter card and resuming from that card.\\n    await originalSignInPage.locator(\\\"#participantApplicationLogoButton\\\").click();\\n    await originalSignInPage.locator(\\\"#participantConfirmationContinueButton\\\").waitFor();\\n    await originalSignInPage.locator(\\\"#participantConfirmationStayButton\\\").click();\\n    assert.equal(await originalSignInPage.locator(\\\"#originalParticipantStarter\\\").count(), 0);\\n    await originalSignInPage.locator(\\\"#participantApplicationLogoButton\\\").click();\\n    await originalSignInPage.locator(\\\"#participantConfirmationContinueButton\\\").click();\\n    await originalSignInPage.locator(\\\"#originalParticipantStarter\\\").waitFor();\\n    assert.equal(await originalSignInPage.locator(\\\"#participantRouteEntry\\\").count(), 0);\\n    assert.equal(await originalSignInPage.locator(\\\"#participantRoutePlayer\\\").count(), 0);\\n    await originalSignInPage.locator(\\\"#participantApplicationHeader h1\\\").filter({ hasText: \\\"Übersicht\\\" }).waitFor();\\n    assert.equal(await originalSignInPage.locator(\\\"#originalApplicationFooter\\\").count(), 0);\\n    await originalSignInPage.locator(\\\"#originalParticipantAccountButton\\\").click();\\n    await originalSignInPage.locator(\\\"#originalParticipantAccountLogin\\\").waitFor();\\n    assert.equal((await originalSignInPage.locator(\\\"#originalParticipantAccountLogin\\\").textContent())?.trim(),\\n      participantEntrySignInLoginKey);\\n    assert.equal((await originalSignInPage.locator(\\\"#originalParticipantAccountGroup\\\").textContent())?.trim(),\\n      participantEntrySignInGroupKey);\\n    assert.equal(await originalSignInPage.locator(\\\"#originalParticipantLogoutButton\\\").isDisabled(), false);\\n    await originalSignInPage.keyboard.press(\\\"Escape\\\");\\n    await originalSignInPage.locator(\\\"#originalParticipantAccountLogin\\\").waitFor({ state: \\\"detached\\\" });\\n    assert.equal(await originalSignInPage.locator(\\\"#originalParticipantAccountButton\\\").evaluate(el => el === document.activeElement), true);\\n    const originalResumeCard = originalSignInPage.locator(\\\"#originalParticipantStarter mat-card[data-booklet-status='in_progress']\\\");\\n    assert.equal(await originalResumeCard.count(), 1);\\n    await originalResumeCard.getByRole(\\\"button\\\").click();\\n    await originalSignInPage.waitForFunction(\\n      ([sessionId, runId]) =>\\n        !document.querySelector(\\\"#originalParticipantStarter\\\") &&\\n        document.querySelector(\\\"#participantRouteSessionLabel\\\")?.textContent?.trim() === sessionId &&\\n        document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() === runId &&\\n        document.querySelector(\\\"#participantRouteStatus\\\")?.textContent?.trim() === \\\"running\\\",\\n      [participantEntrySignInSessionId, participantEntryStartedRunId]\\n    );\\n    await originalSignInPage.locator(\\\"#participantApplicationLogoButton\\\").click();\\n    await originalSignInPage.locator(\\\"#participantConfirmationContinueButton\\\").click();\\n    await originalSignInPage.locator(\\\"#originalParticipantStarter\\\").waitFor();\\n    const originalCredentialBeforeLogout = await originalSignInPage.evaluate(sessionId => {\\n      const state = JSON.parse(localStorage.getItem(\\\"testcenter-rewrite:participant-access:v1\\\") ?? \\\"{}\\\");\\n      return state.sessions?.find(([id]) => id === sessionId)?.[1];\\n    }, participantEntrySignInSessionId);\\n    assert.match(originalCredentialBeforeLogout, /^[A-Za-z0-9_-]{43}$/u);\\n    const originalStateBeforeLogout = await (await fetch(\\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } }\\n    )).json();\\n    await originalSignInPage.locator(\\\"#originalParticipantAccountButton\\\").click();\\n    const logoutCompleted = originalSignInPage.waitForResponse(response => response.request().method() === \\\"DELETE\\\" &&\\n      response.url().endsWith(`/sessions/${participantEntrySignInSessionId}/access`) && response.status() === 205);\\n    await originalSignInPage.locator(\\\"#originalParticipantLogoutButton\\\").click();\\n    await logoutCompleted;\\n    await originalSignInPage.locator(\\\"#originalParticipantLogin\\\").waitFor();\\n    await originalSignInPage.waitForFunction(() => document.activeElement?.id === \\\"originalLoginName\\\");\\n    assert.equal(new URL(originalSignInPage.url()).searchParams.has(\\\"participantSessionId\\\"), false);\\n    assert.equal((await fetch(`${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`,\\n      { headers: { authorization: `Bearer ${originalCredentialBeforeLogout}` } })).status, 401);\\n    await originalSignInPage.locator(\\\"#originalLoginName\\\").fill(participantEntrySignInLoginKey);\\n    await originalSignInPage.getByRole(\\\"button\\\", { name: \\\"Weiter\\\", exact: true }).click();\\n    await originalSignInPage.waitForFunction(expectedRunId =>\\n      document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() === expectedRunId,\\n      participantEntryStartedRunId);\\n    const restoredOriginalState = await (await fetch(\\n      `${baseUrl}/api/v1/participant/sessions/${participantEntrySignInSessionId}/current-state`\\n    )).json();\\n    assert.equal(restoredOriginalState.currentRunState.testRun.testRunId, participantEntryStartedRunId);\\n    assert.deepEqual(restoredOriginalState.currentRunState.testRun.unitResponses,\\n      originalStateBeforeLogout.currentRunState.testRun.unitResponses);\\n  } finally {\\n    await originalSignInContext.close();\\n  }\\n  // A second real login rotates access for this participant. Re-authenticate\\n  // the first browser through its UI; never inject the other browser's token.\\n  await page.locator(\\\"#participantRouteClearSessionButton\\\").click();\\n  await page.locator(\\\"#participantRouteEntry\\\").waitFor();\\n  await page.locator(\\\"#participantRouteSignInButton\\\").click();\\n  await page.waitForFunction(\\n    ([sessionId, runId]) =>\\n      document.querySelector(\\\"#participantRouteSessionLabel\\\")?.textContent?.trim() === sessionId &&\\n      document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() === runId &&\\n      document.querySelector(\\\"#participantRouteEntry\\\") == null,\\n    [participantEntrySignInSessionId, participantEntryStartedRunId]\\n  );\\n  stopAfter(\\\"participant-entry-sign-in\\\");\\n  logStep(\\\"participant-entry-start-after-sign-in\\\");\\n  await page.waitForFunction(\\n    ([expectedSessionId, expectedRunId]) =>\\n      document.querySelector(\\\"#participantRouteSessionLabel\\\")?.textContent?.trim() ===\\n        expectedSessionId &&\\n      document.querySelector(\\\"#participantRouteStatus\\\")?.textContent?.trim() ===\\n        \\\"running\\\" &&\\n      document.querySelector(\\\"#participantRouteRunId\\\")?.textContent?.trim() ===\\n        expectedRunId &&\\n      document.querySelector(\\\"#participantRouteEntry\\\") == null,\\n    [participantEntrySignInSessionId, participantEntryStartedRunId],\\n    { timeout: 15_000 }\\n  );\\n  await page.locator(\\\"#participantRouteFullscreenPrompt\\\").waitFor();\\n  await page\\n    .locator(\\\"#participantRouteScreenHeader\\\")\\n    .filter({ hasText: \\\"Entry\\\" })\\n    .waitFor();\\n  assert.equal(await page.locator(\\\"#participantRouteUnit\\\").count(), 0);\\n  await page.locator(\\\"#participantRouteFullscreenButton\\\").waitFor();\\n  await page.locator(\\\"#participantRouteEnterFullscreenButton\\\").click();\\n  await page.waitForFunction(() => Boolean(document.fullscreenElement));\\n  await page\\n    .locator(\\\"#participantRouteFullscreenStatus\\\")\\n    .filter({ hasText: \\\"active\\\" })\\nscripts/run-postgres-ui-smoke.mjs\\nscripts/smoke-ui.mjs\\nscripts/with-build-metadata.mjs\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634","create_time":1791051945.994785}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
