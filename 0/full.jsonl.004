ourceToken = await access().issueResourceCredential({ testRunId: run.testRunId, sessionToken: returnedToken });\\n    const returnedResourceAccess = { participantSessionId: session.participantSessionId, resourceToken: returnedResourceToken };\\n    await shutdown();\\n2477:const participantSignOutPattern = createRoutePattern(productionApiRoutes.participant.signOut);\\n2478:const participantResourcePathByRequest = new WeakMap<IncomingMessage, string>();\\n2479:const ownedParticipantRouteChecks: Array<[string, RegExp]> = [\\n2483:  [\\\"POST\\\", resumeSessionPattern], [\\\"DELETE\\\", participantSignOutPattern],\\n2492:const authorizeParticipantRoute = async (\\n2495:  for (const [method, pattern] of ownedParticipantRouteChecks) {\\n2509:      participantResourcePathByRequest.set(request, parts.join(\\\"/\\\"));\\n4186:const streamParticipantEvents = async (input: {\\n4491:      await authorizeParticipantRoute(services, request, pathname);\\n8381:        await streamParticipantEvents({\\n8412:        if (currentRunState.resourceBasePath) {\\n8416:          currentRunState.resourceBasePath += `/.access/${resourceToken}`;\\n8441:        const resourcePath = participantResourcePathByRequest.get(request) ?? decodeRouteGroup(\\n8550:            sendError(response, 400, \\\"participant_session_id_required\\\", \\\"participantSessionId is required.\\\");\\n8615:      const participantSignOutMatch = participantSignOutPattern.exec(pathname);\\n9616:        const resourceBasePath = readStringValue(resource, \\\"xml:base\\\", \\\"base\\\");\\n9622:          resourceBasePath,\\n13807:    const resourceBasePath = readXmlAttribute(\\n13838:      resourceBasePath,\\n31962:                resourceBasePath: `/api/v1/participant/sessions/${encodeURIComponent(participantSessionId)}/resources`\\n114:    bootstrap: \\\"/api/v1/admin/auth/bootstrap\\\",\\n{\\\"conclusion\\\":\\\"success\\\",\\\"remaining\\\":[],\\\"status\\\":\\\"completed\\\"}\\n\"}"}],"internal_chat_message_metadata_pas