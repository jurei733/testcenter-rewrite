ipts/smoke-participant-monitor-live.mjs","query":"sign-in|starter:launch","path":"smoke-ib-player.mjs"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n34:      @defer (when interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired)) {\n35:        @if (interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired)) {\n40:        *ngIf=\"!view.isParticipantPlayerFocused && !(interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired))\"\n154:            Password\n155:            <input id=\"participantPassword\" name=\"participantPassword\" type=\"password\" autocomplete=\"current-password\" [(ngModel)]=\"view.runtime.participantPassword\" (change)=\"view.persistState()\" />\n157:          <div *ngIf=\"view.participantCodeRequired\" class=\"participant-code-control\">\n159:              id=\"participantCodeInputIllustration\"\n166:              id=\"participantCodeInputCompanion\"\n175:              id=\"participantCode\"\n176:              name=\"participantCode\"\n178:              [(ngModel)]=\"view.runtime.participantCode\"\n182:              id=\"participantCodeKeypad\"\n188:                <span *ngFor=\"let slot of view.participantCodeSlots\" [class.is-filled]=\"slot < view.runtime.participantCode.length\">●</span>\n192:                  *ngFor=\"let option of view.participantCodeKeypadOptions\"\n194:                  [id]=\"'participantCodeKeypadValue-' + option.value\"\n199:                  id=\"participantCodeKeypadDelete\"\n203:                  [disabled]=\"!view.runtime.participantCode\"\n274:        <p id=\"participantCodePrompt\" class=\"hint\" *ngIf=\"view.participantCodeRequired\">\n  }\n\n  private async signInAndStartSingleBookletInternal(options: { quie