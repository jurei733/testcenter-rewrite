e = snapshot.sourceMediaType.toLowerCase();\n    return (\n      sourceDocument.length > MAX_PERSISTED_SOURCE_DOCUMENT_CHARS ||\n      mediaType.includes(\"zip\") ||\n      /^data:[^,]*;base64,/i.test(sourceDocument)\n    );\n  }\n}\nzsh:4: no matches found: packages/contracts/src/shell*.ts\n8965:  const holdLazyBookletPreload = async route => {\n8969:  await page.route(lazyBookletPreloadPattern, holdLazyBookletPreload);\n8971:  const lazyBookletPreloadResponsePromise = page\n9070:  const lazyBookletPreloadResponse = await lazyBookletPreloadResponsePromise;\n9087:  await page.unroute(lazyBookletPreloadPattern, holdLazyBookletPreload);\n","exit_code":0,"duration":{"secs":0,"nanos":10833},"formatted_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\nui_smoke_step=participant-verona-player\n{\"timestamp\":\"2026-10-03T17:59:50.188Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"6ae9e8d2-6b46-4c74-a638-eebdac806984\",\"method\":\"POST\",\"route\":\"POST /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/source-packages\",\"path\":\"/api/v1/tenants/ui-tenant-1791050296610/workspaces/ui-workspace-1791050296610/source\n{\"timestamp\":\"2026-10-03T17:59:50.208Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"432ea7fd-4870-4867-986c-e56d60ceb802\",\"method\":\"POST\",\"route\":\"POST /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/import-jobs\",\"path\":\"/api/v1/tenants/ui-tenant-1791050296610/workspaces/ui-workspace-1791050296610/import-job\n{\"timestamp\":\"2026-10-03T17:59:50.215Z\",\"level\":\"info\",\"event\":\"http_request_completed\",\"requestId\":\"4ab642e8-7be7-4b4b-bc81-232e9fc98d83\",\"method\":\"POST\",\"route\":\"POST /api/v1/tenants/:tenantKey/workspaces/:workspaceKey/content-releases/:contentReleaseId/activate\",\"path\":\"/api/v1/tenants/ui-tenant-1791050296610/workspaces/ui-wo\n{\"timestamp\":\"2026-10-03T17:59:50.224Z\",\"level\":\"info\",\"event\":\"http_re