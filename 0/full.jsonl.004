 600;\n}\n\nbutton:hover {\n  transform: translateY(-1px);\n}\n\nbutton:disabled {\n  cursor: wait;\n  opacity: 0.65;\n  transform: none;\n}\n\n.button-link {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 999px;\n  padding: 11px 16px;\n  font-family: \"Avenir Next\", \"Segoe UI\", sans-serif;\n  font-weight: 600;\n  text-decoration: none;\n  transition: transform 120ms ease, opacity 120ms ease;\n}\n\n.button-link:hover {\n  transform: translateY(-1px);\n}\n\n.hero-actions {\n  margin-top: 20px;\n}\n\n.local-demo-startup {\n  display: grid;\n  gap: 16px;\n  margin-top: 22px;\n  padding: 18px;\n  border: 1px solid rgba(31, 92, 84, 0.18);\n  border-radius: var(--radius-lg);\n  background:\n    radial-gradient(circle at top right, rgba(31, 92, 84, 0.16), transparent 38%),\n  background: white;\n}\n\n:root[data-interface-mode=\"original\"] {\n  --secondary-soft: #ccdfe5;\n}\n:root[data-interface-mode=\"original\"][data-application-theme=\"Sekundar\"] {\n  --secondary-soft: #ced5e6;\n}\n:root[data-interface-mode=\"original\"][data-application-theme=\"Erwachsene\"] {\n  --secondary-soft: #e1d7eb;\n}\n\n:root[data-interface-mode=\"original\"] .page.is-participant-page {\n  max-width: none;\n  padding: 0;\n}\n\n:root[data-interface-mode=\"original\"] .participant-stage > router-outlet {\n  display: none;\n}\n\n.page {\n  max-width: 1440px;\n  margin: 0 auto;\n  padding: 32px 20px 56px;\n}\n\n.page.is-busy .actions button,\n.page.is-busy .view-nav a {\n  pointer-events: none;\n  opacity: 0.7;\n  transform: none;\n}\n\n.hero {\n  display: grid;\n  grid-template-columns: 1.2fr 0.8fr;\n  gap: 18px;\n@font-face {\n  font-family: 'Nunito Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url('./assets/fonts/nunitosans/nunito-sans-v19-latin-regular.woff2') format('woff2');\n}\n@font-face {\n  font-family: 'Nunito Sans';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url('./assets/fonts/nunitosans/nunito