ss().authorizeResource(returnedResourceAccess), session);\\n@@\\n     await assert.rejects(access().authorize({ testRunId: run.testRunId, sessionToken: otherToken }), invalid);\\n+    await assert.rejects(access().authorizeResource({ ...returnedResourceAccess, participantSessionId: otherSession.participantSessionId }), invalid);\\n@@\\n     await assert.rejects(access().issueCredential({ participantSessionId: session.participantSessionId }), { errorCode: \\\"participant_access_expired\\\" });\\n+    await assert.rejects(access().authorizeResource(returnedResourceAccess), { errorCode: \\\"participant_access_expired\\\" });\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"npm exec tsc -- -b --pretty packages/domain packages/contracts packages/application packages/memory-store packages/file-store packages/sqlite-store packages/postgres-store apps/api > /tmp/testcenter-resource-capability-api-build.log 2>&1\",\"workdir\":\"/Users/julian/code/testcenter-rewrite/rewrite-app\",\"login\":false,\"yield_time_ms\":1000,\"max_output_tokens\":500}));\ntext(await tools.write_stdin({session_id:13290,chars:\"\",\"yield_time_ms\":1000,\"max_output_tokens\":1200}));\ntext(await tools.exec_command({cmd:\"rg -n 'ui_smoke_step=|diagnostic=' /tmp/testcenter-workspace-checkbox-chromium-diagnostic.log | tail -4 && tail -8 /tmp/testcenter-resource-capability-unit.log && rg -n 'test:integration:.*built' package.json | head -6\",\"workdir\":\"/Users/julian/code/testcenter-rewrite/rewrite-app\",\"login\":false,\"max_output_tokens\":1000}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634","create_time":1791046338.88176}}}
