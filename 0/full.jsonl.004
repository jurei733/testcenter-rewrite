ication/zip\",\nscripts/smoke-ib-player.mjs:237:    sourceDocument: `data:application/zip;base64,${sourcePackage.toString(\"base64\")}`\npackages/application/src/index.ts:572:  mediaType: \"application/zip\";\npackages/application/src/index.ts:3809:    normalizedFileName.endsWith(\".zip\") ||\npackages/application/src/index.ts:3810:    normalizedMediaType.includes(\"zip\")\npackages/application/src/index.ts:3861:    normalizedFileName.endsWith(\".zip\") ||\npackages/application/src/index.ts:3883:    normalizedFileName.endsWith(\".itcr.zip\") ||\npackages/application/src/index.ts:3888:  if (normalizedFileName.endsWith(\".zip\") || normalizedMediaType.includes(\"zip\")) {\npackages/application/src/index.ts:15112:      zipBuffer: Buffer;\npackages/application/src/index.ts:15115:  | { status: \"invalid_zip\" }\npackages/application/src/index.ts:15123:const findZipEndOfCentralDirectoryOffset = (zipBuffer: Buffer): number => {\npackages/application/src/index.ts:15124:  const minimumOffset = Math.max(0, zipBuffer.length - 65557);\npackages/application/src/index.ts:15125:  for (let offset = zipBuffer.length - 22; offset >= minimumOffset; offset -= 1) {\npackages/application/src/index.ts:15127:      zipBuffer.readUInt32LE(offset) === 0x06054b50 &&\npackages/application/src/index.ts:15128:      offset + 22 + zipBuffer.readUInt16LE(offset + 20) === zipBuffer.length\npackages/application/src/index.ts:15145:  zipBuffer: Buffer,\npackages/application/src/index.ts:15156:    zipBuffer.readUInt32LE(locatorOffset) !== 0x07064b50 ||\npackages/application/src/index.ts:15157:    zipBuffer.readUInt32LE(locatorOffset + 4) !== 0 ||\npackages/application/src/index.ts:15158:    zipBuffer.readUInt32LE(locatorOffset + 16) !== 1\npackages/application/src/index.ts:15162:  const recordOffset = readZipSafeUInt64LE(zipBuffer, locatorOffset + 8);\npackages/application/src/index.ts:15166:    zipBuffer.readUInt32LE(recordOffset) !== 0x06064b50\npackages/application/src/index.ts:15170:  const recordSiz