m?.comment === \"its a new comment\"\n  )?.reviewId;\n  assert.ok(officialReviewId);\n  await page.locator(\"#participantRouteNextUnitButton\").click();\n  await page\n    .locator(\"#participantRouteUnitKey\")\n    .filter({ hasText: \"CY-Unit.Sample-102\" })\n    .waitFor({ timeout: 15_000 });\n  await page.locator(\"#participantRoutePreviousUnitButton\").click();\n  await reviewController.frame\n    .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n    .waitFor({ timeout: 15_000 });\n  assert.equal(\n    await reviewController.frame\n      .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n      .isChecked(),\n    true\n  );\n  const reopenedReviewController = await openOriginalTestController(\n    \"Test_Ctrl-2a\",\n    \"Cy-Bklt_TC-2a\"\n  );\n  assert.equal(\n    reopenedReviewController.participantSessionId,\n    reviewController.participantSessionId\n  );\n  assert.equal(reopenedReviewController.testRunId, reviewController.testRunId);\n18180:    const controller = await openOriginalTestController(loginKey, bookletKey);\n18257:    const controller = await openOriginalTestController(\n18313:  const demoController = await openOriginalTestController(\n18366:  const freshDemoController = await openOriginalTestController(\n18372:  const reopenedDemoController = await openOriginalTestController(\n18410:  const reviewController = await openOriginalTestController(\n18477:  const reopenedReviewController = await openOriginalTestController(\n18511:  const reviewTextCodeController = await openOriginalTestController(\n18539:  const reviewSymbolCodeController = await openOriginalTestController(\n18573:  const protectedController = await openOriginalTestController(\n18676:  const resumedProtectedController = await openOriginalTestController(\n18703:  const hotRestartController = await openOriginalTestController(\n18756:  const restartedController = await openOriginalTestController(\n18807:  const completionController = await openOriginalTestController(\n19180:  co