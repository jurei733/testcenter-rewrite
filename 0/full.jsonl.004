tem of listTabs; let index = index\\\" class=\\\"list-item\\\"\\n          [class.selected]=\\\"currentIndex === index\\\" [attr.data-cy]=\\\"dataCy + '-list-' + index\\\"\\n          [attr.aria-current]=\\\"currentIndex === index ? 'page' : null\\\">{{ item }}</div>\\n      </ng-container>\\n    </div>\\n    <button *ngIf=\\\"showForward\\\" matIconButton class=\\\"nav-button next-button\\\"\\n      [id]=\\\"idPrefix + '-forward'\\\" [attr.data-cy]=\\\"dataCy + '-forward'\\\"\\n      aria-label=\\\"Weiter\\\" title=\\\"Weiter\\\" [disabled]=\\\"!canForward\\\" (click)=\\\"forward.emit()\\\">\\n      <svg viewBox=\\\"0 -960 960 960\\\" aria-hidden=\\\"true\\\"><path d=\\\"M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z\\\" /></svg>\\n    </button>\\n  `,\\n  styleUrl: \\\"./original-navigation-control.component.css\\\"\\n})\\nexport class OriginalNavigationControlComponent {\\n  @Input() idPrefix = \\\"originalNavigation\\\";\\n  @Input() dataCy = \\\"navigation\\\";\\n  @Input() label = \\\"\\\";\\n  @Input() labelMode: \\\"index\\\" | \\\"label\\\" | \\\"list\\\" = \\\"index\\\";\\n  @Input() currentIndex = 0;\\n  @Input() count = 0;\\n  @Input() showBackward = true;\\n  @Input() showForward = true;\\n  @Input() canBackward = false;\\n  @Input() canForward = false;\\n  @Output() readonly back = new EventEmitter<void>();\\n  @Output() readonly forward = new EventEmitter<void>();\\n\\n  get listTabs(): number[] {\\n    return Array.from({ length: this.count }, (_, index) => index + 1);\\n  }\\n}\\n      >\\n        <strong>{{ errorTitle }}</strong>\\n        <p id=\\\"participantVeronaPlayerErrorText\\\">{{ errorText }}</p>\\n        <details>\\n          <summary>Technical details</summary>\\n          <p id=\\\"participantVeronaPlayerErrorDetail\\\">{{ errorMessage }}</p>\\n        </details>\\n        <button\\n          id=\\\"participantVeronaReloadPlayerButton\\\"\\n          type=\\\"button\\\"\\n          class=\\\"secondary\\\"\\n          (click)=\\\"reload()\\\"\\n        >Reload Player</button>\\n      </section>\\n      <footer>\\n        <span id=\\\"participantVeronaSaveStatus\\\" aria-live=\\\"polite\\\">{{ saveStatusLabel }}</span>\\n        <button\\n          *ngIf=\\\"saveStatus === 'save_failed' || saveStatus === 'queued_offline'\\\"\\n          id=\\\"participantVeronaRetrySaveButton\\\"\\n          type=\\\"button\\\"\\n          class=\\\"ghost\\\"\\n          (click)=\\\"retrySave.emit()\\\"\\n        >\\n          Retry Save\\n        </button>\\n17780:  await page.locator(\\\"#originalUnitNavigation-label\\\").filter({ hasText: /Aufgabe\\\\s+1\\\\/2/ }).waitFor();\\n17781:  await expectButtonSelectorDisabled(\\\"#originalUnitNavigation-backward\\\");\\n17782:  await expectButtonSelectorEnabled(\\\"#originalUnitNavigation-forward\\\");\\n17783:  await page.locator(\\\"#originalUnitNavigation-forward\\\").click();\\n17784:  await page.locator(\\\"#originalUnitNavigation-label\\\").filter({ hasText: /2\\\\/2/ }).waitFor();\\n17785:  await page.locator(\\\"#originalUnitNavigation-backward\\\").click();\\n17786:  await page.locator(\\\"#originalUnitNavigation-label\\\").filter({ hasText: /1\\\\/2/ }).waitFor();\\n17788:  await page.locator(\\\"#originalUnitNavigation-label\\\").filter({ hasText: \\\"Aufgabe1\\\" }).waitFor();\\n17790:  assert.equal(await page.locator(\\\"#originalUnitNavigation-label\\\").count(), 0);\\n17792:  await page.locator(\\\"#originalUnitNavigation-label\\\").waitFor();\\n17793:  assert.equal(await page.locator(\\\"#originalUnitNavigation-backward\\\").count(), 0);\\n17794:  assert.equal(await page.locator(\\\"#originalUnitNavigation-forward\\\").count(), 0);\\n18856:  await expectButtonSelectorEnabled(\\\"#originalUnitNavigation-forward\\\");\\n18857:  await page.locator(\\\"#originalUnitNavigation-forward\\\").click();\\n18886:  await expectButtonSelectorEnabled(\\\"#originalUnitNavigation-forward\\\");\\n18887:  await page.locator(\\\"#originalUnitNavigation-forward\\\")