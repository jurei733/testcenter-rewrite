freshSeconds: 3\n          }));\n        }\n      }, { scope, initialEnabled });\n      for (let index = 0; index < 15; index += 1) {\n        await page.goto(`${TARGET_URL}/app/workspace?ui=REDACTED`);\n        const checkbox = page.locator('#autoRefreshEnabled');\n        await checkbox.waitFor();\n        const expected = await page.evaluate(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled);\n        assert.equal(await checkbox.isChecked(), expected, 'Native checked property must agree with persisted state when the control first appears.');\n        await checkbox.check();\n        await page.waitForFunction(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled === true);\n        assert.equal(await checkbox.isChecked(), true);\n        await checkbox.uncheck();\n        await page.waitForFunction(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled === false);\n        assert.equal(await checkbox.isChecked(), false);\n        await page.goto(`${TARGET_URL}/app/participant?ui=REDACTED`);\n        await checkbox.waitFor({ state: 'detached' });\n      }\n      assert.deepEqual(errors, []);\n      console.log(`PASS 15 immediate Workspace check/uncheck round trips, initial preference ${initialEnabled}; no sleeps or forced clicks`);\n      await context.close();\n    }\n  } finally { await browser.close(); }\n})().catch(error => { console.error(error); process.exitCode = 1; });\n","exit_code":0,"duration":{"secs":0,"nanos":16083},"formatted_output":"      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - if: ${{ matrix.playwright }}\n        run: npx playwright install --with-deps chromium\n      - name: Run ${{ matrix.check }}\n        run: ${{ matrix.command }}\n\n  verify-postgres:\n    runs-on: ubuntu-latest\n  