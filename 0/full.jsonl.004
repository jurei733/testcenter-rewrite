tDialog.afterClosed().subscribe(accepted => {\n+      this.logoutDialog = null;\n+      if (this.destroyed || this.view.runtime.participantSessionId.trim() !== sessionId) return;\n+      if (!accepted) {\n+        document.getElementById(\"originalParticipantAccountButton\")?.focus();\n+        return;\n+      }\n+      void this.view.signOutParticipant(sessionId).then(() => {\n+        if (!this.destroyed && this.view.isParticipantStarter && this.view.participantSignOutNotice()) {\n+          trigger.openMenu();\n+          queueMicrotask(() => document.getElementById(\"originalParticipantLogoutButton\")?.focus());\n+        }\n+      });\n+    });\n+  }\n+\n+  ngOnDestroy(): void {\n+    this.destroyed = true;\n+    this.logoutDialog?.close(false);\n+  }\n \n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-participant-logout-dialog.component.ts\nM /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/application-settings.service.ts\nM /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-overlay-theme.scss\nM /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/participant-view.facade.ts\nM /Users/julian/code/testcenter-rewrite/rewrite-app/apps/web/src/app/original-participant-account.component.ts\nM /Users/julian/code/testcenter-rewrite/rewrite-app/scripts/smoke-ui.mjs\n","stderr":""},"started_at_ms":1791053546663,"completed_at_ms":1791053546675}}
