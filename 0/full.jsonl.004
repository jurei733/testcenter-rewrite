 parameter\n      : stored;\n    this.select(selected === \"original\" ? \"original\" : \"rewrite\");\n  }\n\n  select(mode: InterfaceMode): void {\n    this.mode.set(mode);\n    document.documentElement.dataset[\"interfaceMode\"] = mode;\n    try {\n      window.localStorage.setItem(storageKey, mode);\n    } catch {\n      // Storage must never be required to select or use an interface.\n    }\n    // An explicit switch supersedes a deep link's old selection on reload.\n    const url = new URL(window.location.href);\n    if (url.searchParams.has(\"ui\")) {\n      url.searchParams.set(\"ui\", mode);\n      window.history.replaceState(window.history.state, \"\", url);\n    }\n  }\n}\nimport { Component, ViewEncapsulation } from \"@angular/core\";\n\n@Component({\n  selector: \"app-original-overlay-styles\",\n  standalone: true,\n  template: \"\",\n  styleUrl: \"./original-overlay-theme.scss\",\n  encapsulation: ViewEncapsulation.None\n})\nexport class OriginalOverlayStylesComponent {}\n{\"phase\":\"ended\",\"base\":\"0275d9e66059265225bfa6676b6395aa1bb5ddab\",\"lastCheckpoint\":\"01M41F4ZY1Z1S164SP4F0GY2PE\"}\n","stderr":"","aggregated_output":"apps/web/src/app/system-check-save-report-dialog.component.ts:79:            class=\"primary\"\napps/web/src/app/workspace-view.component.ts:73:          <button id=\"createTenantButton\" class=\"primary\" type=\"button\" [disabled]=\"!view.canCreateTenant\" (click)=\"view.createTenant()\">Create Tenant</button>\napps/web/src/app/workspace-view.component.ts:277:          <button id=\"applyStudyMonitorMatrixFiltersButton\" class=\"primary\" type=\"button\" [disabled]=\"!view.canUseWorkspaceScope\" (click)=\"view.applyStudyMonitorMatrixFilters()\">Apply Matrix Filters</button>\napps/web/src/app/workspace-view.component.ts:391:          <button id=\"refreshWorkspaceActivityButton\" class=\"primary\" type=\"button\" [disabled]=\"!view.canUseWorkspaceScope\" (click)=\"view.refreshWorkspaceActivity()\">Refresh Activity</button>\npac