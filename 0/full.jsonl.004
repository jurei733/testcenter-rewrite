.locator('#originalParticipantLogin').waitFor();\n    await page.locator('#originalApplicationFooter').waitFor();\n    assert.deepEqual(await page.locator('#originalApplicationFooter nav a').allTextContents(),\n      ['Barrierefreiheit', 'Datenschutz', 'Impressum']);\n    assert.match(await page.locator('#originalApplicationFooter .version-label').textContent(), /Version Rewrite/);\n    const footer = await page.locator('#originalApplicationFooter').boundingBox();\n    assert.ok(Math.abs(footer.y + footer.height - 900) <= 2, 'Original login footer must reach the viewport bottom');\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    await page.screenshot({ path: '/tmp/testcenter-original-login-footer-desktop.png', fullPage: true });\n    console.log('PASS Original login footer labels, order and truthful build identity; no signed-in menu');\n    const response = await page.request.post(`${TARGET_URL}/api/v1/participant/auth/sign-in`,\n      { data: { ...scope, loginKey: 'Test_Ctrl-2a', password: '123' } });\n    assert.equal(response.ok(), true);\n    const signedIn = await response.json();\n    const sessionId = signedIn.participantSession.participantSessionId;\n    await page.request.post(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/resume`,\n      { data: { bookletKey: 'Cy-Bklt_TC-2a' } });\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ participantSessionId: sessionId, ui: 'original' })}`);\n    await page.locator('#originalPlayerToolbar').waitFor();\n    const before = await page.request.get(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/current-state`);\n    const runId = (await before.json()).currentRunState.testRun.testRunId;\n    assert.equal(await page.locator('#originalApplicationFooter').count(), 0);\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    assert.equal(await page.locator('.application-footer').count(), 0);\n    await page.locator('#participantApplicationLogoButton').click();\n    if (await page.locator('#participantConfirmationContinueButton').count()) {\n      await page.locator('#participantConfirmationContinueButton').click();\n    }\n    await page.locator('#originalParticipantStarter').waitFor();\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.locator('#originalParticipantAccountLogin').waitFor();\n    assert.equal((await page.locator('#originalParticipantAccountLogin').textContent()).trim(), 'Test_Ctrl-2a');\n    assert.equal((await page.locator('#originalParticipantAccountGroup').textContent()).trim(),\n      signedIn.participantRosterEntry.groupLabel?.trim() || signedIn.participantSession.groupKey);\n    assert.equal(await page.locator('#originalParticipantLogoutButton').isDisabled(), true,\n      'Preview must not pretend local clearing revokes the access token.');\n    await page.keyboard.press('Escape');\n    await page.locator('#originalParticipantAccountLogin').waitFor({ state: 'detached' });\n    assert.equal(await page.locator('#originalParticipantAccountButton').evaluate(el => el === document.activeElement), true);\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.getByRole('button', { name: 'Nutzerinformationen schließen' }).click();\n    await page.locator('#originalParticipantAccountLogin').waitFor({ state: 'detached' });\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.locator('#originalParticipantAccountButton').click();\n    const menu = page.locator('.original-participant-account-menu');\n    await menu.waitFor();\n    await menu.evaluate(async element => {\n      await Promise.all(element.getAnimations({ subtree: true }).map(animation => animation.finished));\n    });\n    assert.equal(await menu.evaluate(el => getComputedStyle(el).opacity), '1');\n    assert.equal(await menu.evaluate(el => getComputedStyle(el).backgroundColor), 'rgb(255, 255, 255)',\n   