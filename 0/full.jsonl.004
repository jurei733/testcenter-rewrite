   const variableId = variable.getAttribute(\\\"id\\\")?.trim() ?? \\\"\\\";\\n        if (variableId) {\\n          variableIds.add(variableId);\\n        }\\n      }\\n    }\\n  }\\n  return variableIds;\\n};\\npackages/application/src/index.ts:5942:      const validationWarnings: WorkspaceParticipantRosterItem[\\\"validationWarnings\\\"] =\\npackages/application/src/index.ts:5947:        validationWarnings.push({\\npackages/application/src/index.ts:5955:            validationWarnings.push({\\npackages/application/src/index.ts:5974:              validationWarnings.push({\\npackages/application/src/index.ts:5979:              validationWarnings.push({\\npackages/application/src/index.ts:5990:        validationWarnings\\npackages/application/src/index.ts:7728:    \\\"validationWarningCodes\\\",\\npackages/application/src/index.ts:7729:    \\\"validationWarningMessages\\\",\\npackages/application/src/index.ts:7758:        item.validationWarnings.map(warning => warning.code).join(\\\"|\\\"),\\npackages/application/src/index.ts:7759:        item.validationWarnings.map(warning => warning.message).join(\\\"|\\\"),\\npackages/application/src/index.ts:14895:        // the dedicated XML validation path without leaking parser diagnostics.\\npackages/application/src/index.ts:16213:      // Player metadata validation reports malformed JSON during the normal import.\\npackages/application/src/index.ts:20650:      // Import validation rejects invalid schemes. Keep the condition variables\\npackages/application/src/index.ts:25200:            `Participant roster '${rosterDocument.sourceFileName}' failed Original Testcenter compatibility validation.`,\\npackages/application/src/index.ts:25749:            `Testtakers import failed compatibility validation (${error.errorCode}).`\\npackages/application/src/index.ts:30060:        ).filter(item => item.validationWarnings.length > 0);\\napps/api/src/index.ts:2501:    // Leave missing/blank identifier validation to the existing route hand