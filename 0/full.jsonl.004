{"timestamp":"2026-10-03T16:41:18.535Z","ordinal":66981,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a10167-18c0-7481-a114-505958d1a634","item":{"type":"CommandExecution","id":"exec-4ecf408e-619a-4ac8-9832-9c10455cca25","process_id":"70466","command":["/bin/zsh","-c","sed -n '118,205p' ../.github/workflows/rewrite-app-ci.yml && sed -n '1,90p' apps/web/src/app/rewrite-app-shell-persistence.service.ts && rg -n 'ci:browser:ops|ci:browser:quick' package.json && rg -n 'ui_smoke_step=attachment|ui_smoke_step=nav|ui_smoke_step=.*switch' /tmp/testcenter-ci-native-checkbox-ui-ops-failed.log | tail -20 && sed -n '1,135p' /tmp/playwright-test-synchronous-workspace-checkbox.js"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"read","cmd":"sed -n '118,205p' ../.github/workflows/rewrite-app-ci.yml","name":"rewrite-app-ci.yml","path":"../.github/workflows/rewrite-app-ci.yml"},{"type":"read","cmd":"sed -n '1,90p' apps/web/src/app/rewrite-app-shell-persistence.service.ts","name":"rewrite-app-shell-persistence.service.ts","path":"apps/web/src/app/rewrite-app-shell-persistence.service.ts"},{"type":"search","cmd":"rg -n 'ci:browser:ops|ci:browser:quick' package.json","query":"ci:browser:ops|ci:browser:quick","path":"package.json"},{"type":"search","cmd":"rg -n 'ui_smoke_step=attachment|ui_smoke_step=nav|ui_smoke_step=.*switch' /tmp/testcenter-ci-native-checkbox-ui-ops-failed.log","query":"ui_smoke_step=attachment|ui_smoke_step=nav|ui_smoke_step=.*switch","path":"testcenter-ci-native-checkbox-ui-ops-failed.log"},{"type":"read","cmd":"sed -n '1,135p' /tmp/playwright-test-synchronous-workspace-checkbox.js","name":"playwright-test-synchronous-workspace-checkbox.js","path":"/tmp/playwright-test-synchronous-workspace-checkbox.js"}],"source":"unified_exec_startup","status":"completed","stdout":"      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - if: ${{ matrix.playwright }}\n        run: npx playwright install --with-deps chromium\n      - name: Run ${{ matrix.check }}\n        run: ${{ matrix.command }}\n\n  verify-postgres:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    defaults:\n      run:\n        working-directory: REDACTED-app\n    services:\n      postgres:\n        image: postgres:16-alpine\n        env:\n          POSTGRES_DB: REDACTED_app\n          POSTGRES_USER: REDACTED\n          POSTGRES_PASSWORD: REDACTED\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd \"pg_isready -U REDACTED -d REDACTED_app\"\n          --health-interval 5s\n          --health-timeout 5s\n          --health-retries 10\n    env:\n      FIRST_SLICE_POSTGRES_URL: REDACTED\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - run: npm run typecheck\n      - run: npm run build\n      - run: npm run db:migrate:postgres:built\n      - run: npm run db:doctor:postgres:built\n      - name: Run Postgres runtime preflight\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n          APP_BUILD_TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n          FIRST_SLICE_STORE=postgres \\\n          RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=true \\\n          npm run preflight:runtime:built\n      - run: npm run test:integration:postgres:built\n      - name: Run protected Postgres startup smoke\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n          APP_BUILD_TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n          FIRST_SLICE_OPERATOR_AUTH_REQUIRED=true \\\n          npm run smoke:startup:postgres:built\n\n  verify-postgres-ui:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    defaults:\n      run:\n        working-directory: REDACTED-app\n    services:\n      postgres:\n        image: postgres:16-alpine\n        env:\n          POSTGRES_DB: REDACTED_app\n          POSTGRES_USER: REDACTED\n          POSTGRES_PASSWORD: REDACTED\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd \"pg_isready -U REDACTED -d REDACTED_app\"\n          --health-interval 5s\n          --health-timeout 5s\n          --health-retries 10\n    env:\n      FIRST_SLICE_POSTGRES_URL: REDACTED\n      FIRST_SLICE_OPERATOR_AUTH_REQUIRED: \"true\"\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\nimport { Injectable, inject } from \"@angular/core\";\n\nimport { createShellPersistenceStateHost } from \"./REDACTED-app-shell.state-hosts\";\nimport {\n  applyHydratedShellState,\n  createPersistedShellState\n} from \"./REDACTED-app-shell.storage\";\nimport {\n  type PersistedShellState,\n  SHELL_STORAGE_KEY\n} from \"./REDACTED-app-shell.types\";\nimport { RewriteAppUiStateService } from \"./REDACTED-app-ui-state.service\";\n\nconst MAX_PERSISTED_SOURCE_DOCUMENT_CHARS = 200_000;\n\n@Injectable({ providedIn: \"root\" })\nexport class RewriteAppShellPersistenceService {\n  private readonly uiState = inject(RewriteAppUiStateService);\n\n  private readonly workspaceState = this.uiState.workspace;\n  private readonly contentState = this.uiState.content;\n  private readonly runtimeState = this.uiState.runtime;\n  private readonly opsState = this.uiState.ops;\n\n  persistShellState(): void {\n    const snapshot = this.createStorageSafeSnapshot();\n    try {\n      window.localStorage.setItem(SHELL_STORAGE_KEY, JSON.stringify(snapshot));\n    } catch {\n      window.localStorage.setItem(\n        SHELL_STORAGE_KEY,\n        JSON.stringify({ ...snapshot, sourceDocument: \"\" })\n      );\n    }\n  }\n\n  hydrateShellState(): void {\n    const rawValue = window.localStorage.getItem(SHELL_STORAGE_KEY);\n    if (!rawValue) {\n      return;\n    }\n\n    try {\n      applyHydratedShellState(\n        this.createPersistenceStateHost(),\n        JSON.parse(rawValue) as Partial<PersistedShellState>\n      );\n      this.uiState.syncAdminSessionToken();\n    } catch {\n      // Ignore broken browser state and keep defaults.\n    }\n  }\n\n  private createPersistenceStateHost() {\n    return createShellPersistenceStateHost({\n      workspaceState: this.workspaceState,\n      contentState: this.contentState,\n      runtimeState: this.runtimeState,\n      opsState: this.opsState,\n      getActiveView: () => this.uiState.activeView,\n      setActiveView: nextValue => {\n        this.uiState.activeView = nextValue;\n      },\n      getShowRawDebug: () => this.uiState.showRawDebug,\n      setShowRawDebug: nextValue => {\n        this.uiState.showRawDebug = nextValue;\n      }\n    });\n  }\n\n  private createStorageSafeSnapshot(): PersistedShellState {\n    const snapshot = createPersistedShellState(this.createPersistenceStateHost());\n    if (this.shouldOmitSourceDocumentFromStorage(snapshot)) {\n      return { ...snapshot, sourceDocument: \"\" };\n    }\n    return snapshot;\n  }\n\n  private shouldOmitSourceDocumentFromStorage(\n    snapshot: PersistedShellState\n  ): boolean {\n    const sourceDocument = snapshot.sourceDocument.trim();\n    const mediaType = snapshot.sourceMediaType.toLowerCase();\n    return (\n      sourceDocument.length > MAX_PERSISTED_SOURCE_DOCUMENT_CHARS ||\n      mediaType.includes(\"zip\") ||\n      /^data:[^,]*;base64,/i.test(sourceDocument)\n    );\n  }\n}\n20:    \"ci:browser:quick\": \"npm run build && npm run smoke:ui:bug-report:built && npm run smoke:ui:offline-shell:built && npm run smoke:ui:system-check:built && npm run smoke:ui:content:built && npm run smoke:ui:json-roster:built && npm run smoke:ui:participant-entry:built && npm run smoke:ui:participant-review:built && npm run smoke:ui:proof-of-work:built && npm run smoke:ui:verona-player:built && npm run smoke:ui:ib-player:built && npm run smoke:ui:activation-roster-warnings:built\",\n23:    \"ci:browser:ops\": \"npm run build && npm run smoke:ui:delete-group-results:built && npm run smoke:ui:admin-workspace-access:built && npm run smoke:ui:admin-delete:built && npm run smoke:ui:workspace-rename:built && npm run smoke:ui:workspace-delete:built && npm run smoke:ui:operator-auth:built\",\n777:2026-10-03T16:09:46.7255381Z ui_smoke_step=nav-ops\n981:2026-10-03T16:10:07.9874941Z ui_smoke_step=nav-workspace-bootstrap\n1046:2026-10-03T16:10:11.3935531Z ui_smoke_step=nav-ops-admin-management\n1397:2026-10-03T16:11:29.1098164Z ui_smoke_step=nav-content\n8224:2026-10-03T16:18:12.0412194Z ui_smoke_step=nav-runtime\n9304:2026-10-03T16:20:47.6242439Z ui_smoke_step=nav-content-blocked-activation\n9349:2026-10-03T16:20:54.0125335Z ui_smoke_step=nav-content-after-blocking-run\n9350:2026-10-03T16:20:54.3027596Z ui_smoke_step=nav-workspace-activity\n9376:2026-10-03T16:20:58.5393319Z ui_smoke_step=nav-content-after-activity-subject\n9430:2026-10-03T16:21:10.2027518Z ui_smoke_step=nav-runtime-before-complete\n9528:2026-10-03T16:21:21.2280987Z ui_smoke_step=attachment-manager\nconst assert = require('node:assert/strict');\nconst { chromium } = require('playwright');\nconst TARGET_URL = process.env.TARGET_URL || 'http://127.0.0.1:4329'; // Owned public-fixture server.\nconst scope = {\n  tenantKey: 'ui-tenant-1791028184550-test-controller',\n  workspaceKey: 'ui-workspace-1791028184550-test-controller'\n};\n(async () => {\n  const browser = await chromium.launch({ headless: false });\n  try {\n    for (const initialEnabled of [true, false]) {\n      const context = await browser.newContext();\n      const page = await context.newPage();\n      const errors = [];\n      page.on('pageerror', error => errors.push(error.message));\n      await page.addInitScript(({ scope, initialEnabled }) => {\n        if (!localStorage.getItem('testcenter-REDACTED-app-shell')) {\n          localStorage.setItem('testcenter-REDACTED-app-shell', JSON.stringify({\n            ...scope, autoRefreshEnabled: initialEnabled, autoRefreshSeconds: 3\n          }));\n        }\n      }, { scope, initialEnabled });\n      for (let index = 0; index < 15; index += 1) {\n        await page.goto(`${TARGET_URL}/app/workspace?ui=REDACTED`);\n        const checkbox = page.locator('#autoRefreshEnabled');\n        await checkbox.waitFor();\n        const expected = await page.evaluate(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled);\n        assert.equal(await checkbox.isChecked(), expected, 'Native checked property must agree with persisted state when the control first appears.');\n        await checkbox.check();\n        await page.waitForFunction(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled === true);\n        assert.equal(await checkbox.isChecked(), true);\n        await checkbox.uncheck();\n        await page.waitForFunction(() => JSON.parse(localStorage.getItem('testcenter-REDACTED-app-shell')).autoRefreshEnabled === false);\n        assert.equal(await checkbox.isChecked(), false);\n        await page.goto(`${TARGET_URL}/app/participant?ui=REDACTED`);\n        await checkbox.waitFor({ state: 'detached' });\n      }\n      assert.deepEqual(errors, []);\n      console.log(`PASS 15 immediate Workspace check/uncheck round trips, initial preference ${initialEnabled}; no sleeps or forced clicks`);\n      await context.close();\n    }\n  } finally { await browser.close(); }\n})().catch(error => { console.error(error); process.exitCode = 1; });\n","stderr":"","aggregated_output":"      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - if: ${{ matrix.playwright }}\n        run: npx playwright install --with-deps chromium\n      - name: Run ${{ matrix.check }}\n        run: ${{ matrix.command }}\n\n  verify-postgres:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    defaults:\n      run:\n        working-directory: REDACTED-app\n    services:\n      postgres:\n        image: postgres:16-alpine\n        env:\n          POSTGRES_DB: REDACTED_app\n          POSTGRES_USER: REDACTED\n          POSTGRES_PASSWORD: REDACTED\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd \"pg_isready -U REDACTED -d REDACTED_app\"\n          --health-interval 5s\n          --health-timeout 5s\n          --health-retries 10\n    env:\n      FIRST_SLICE_POSTGRES_URL: REDACTED\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: REDACTED-app/package-lock.json\n      - run: npm ci\n      - run: npm run typecheck\n      - run: npm run build\n      - run: npm run db:migrate:postgres:built\n      - run: npm run db:doctor:postgres:built\n      - name: Run Postgres runtime preflight\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n          APP_BUILD_TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n          FIRST_SLICE_STORE=postgres \\\n          RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=true \\\n          npm run preflight:runtime:built\n      - run: npm run test:integration:postgres:built\n      - name: Run protected Postgres startup smoke\n        run: |\n          APP_BUILD_SHA=\"${GITHUB_SHA::12}\" \\\n          APP_BUILD_TIMESTAMP=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \\\n          FIRST_SLICE_OPERATOR_AUTH_REQUIRED=true \\\n          npm run smoke:startup:postgres:built\n\n  verify-postgres-ui:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    defaults:\n      run:\n        working-directory: REDACTED-app\n    services:\n      postgres:\n        image: postgres:16-alpine\n        env:\n          POSTGR