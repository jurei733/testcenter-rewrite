section .heading { font-size: 30px; }\napps/web/src/styles.css:140:  pointer-events: none;\napps/web/src/styles.css:142:  transform: none;\napps/web/src/styles.css:179:  text-transform: uppercase;\napps/web/src/styles.css:312:  text-transform: uppercase;\napps/web/src/styles.css:368:  transform: translateY(-1px);\napps/web/src/styles.css:634:  text-transform: uppercase;\napps/web/src/styles.css:790:  text-transform: uppercase;\napps/web/src/styles.css:804:  transform: translateY(-1px);\napps/web/src/styles.css:810:  transform: none;\napps/web/src/styles.css:825:  transform: translateY(-1px);\napps/web/src/styles.css:877:  text-transform: uppercase;\napps/web/src/styles.css:921:  text-transform: uppercase;\napps/web/src/styles.css:944:  text-transform: uppercase;\napps/web/src/styles.css:999:  text-transform: uppercase;\napps/web/src/styles.css:1032:  text-transform: uppercase;\napps/web/src/styles.css:1102:  transform: translateY(-1px);\napps/web/src/styles.css:1109:  text-transform: uppercase;\napps/web/src/styles.css:1162:  text-transform: uppercase;\napps/web/src/styles.css:1379:  text-transform: uppercase;\napps/web/src/styles.css:1418:  text-transform: uppercase;\napps/web/src/styles.css:1486:  text-transform: uppercase;\napps/web/src/styles.css:1513:  text-transform: uppercase;\napps/web/src/styles.css:1544:  text-transform: uppercase;\napps/web/src/styles.css:1561:  text-transform: none;\napps/web/src/styles.css:1601:  text-transform: uppercase;\napps/web/src/styles.css:1626:  text-transform: uppercase;\napps/web/src/styles.css:1704:  text-transform: uppercase;\napps/web/src/styles.css:1766:  text-transform: uppercase;\napps/web/src/styles.css:1817:  text-transform: uppercase;\napps/web/src/styles.css:1900:  text-transform: uppercase;\napps/web/src/styles.css:1947:  text-transform: uppercase;\napps/web/src/styles.css:1984:  text-transform: uppercase;\napps/web/src/styles.css:2028:  text-transform: uppercase;\napps/web/src/styles.css:2069:  text-transform: uppercase;\napps/web/src/styles.css:2127:  text-transform: uppercase;\napps/web/src/styles.css:2167:  text-transform: uppercase;\napps/web/src/styles.css:2204:  text-transform: uppercase;\napps/web/src/styles.css:2249:  text-transform: uppercase;\napps/web/src/styles.css:2314:  text-transform: uppercase;\napps/web/src/styles.css:2344:  text-transform: uppercase;\napps/web/src/styles.css:2408:  text-transform: uppercase;\napps/web/src/styles.css:2443:  text-transform: uppercase;\napps/web/src/styles.css:2495:  text-transform: uppercase;\napps/web/src/styles.css:2593:  text-transform: uppercase;\napps/web/src/styles.css:2693:  text-transform: uppercase;\napps/web/src/styles.css:2731:    transform: translateX(-35%);\napps/web/src/styles.css:2734:    transform: translateX(210%);\n      `${baseUrl}/api/v1/participant/test-runs/${controller.testRunId}/save-progress`,\n      {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ currentUnitKey: targetUnitKey, status: \"running\" })\n      }\n    );\n    assert.equal(response.status, 409);\n    const payload = await response.json();\n    assert.equal(payload.error, \"booklet_navigation_denied\");\n    assert.equal(payload.details?.direction, direction);\n    assert.deepEqual(payload.details?.deniedReasons, deniedReasons);\n  };\n  const runOriginalControllerCompletenessCase = async ({\n    loginKey,\n    bookletKey,\n    secondUnitKey,\n    policy,\n    deniedReasons = [\"presentation_incomplete\", \"response_incomplete\"]\n  }) => {\n    const controller = await openOriginalTestController(loginKey, bookletKey);\n    assert.ok(controller.testRunId);\n    const frame = controller.frame;\n    await frame\n      .getByText(\n        \"Testung Controller: Aufgabe1: Check response complete and presentation complete\",\n        { exact: true }\n      )\n      .waitFor({ timeout: 15_000 });\n\n    if (policy === \"off\") {\n      await expectButtonSelectorEnabled(\"#participantRouteNextUnitButton\");\n    } else {\n      await expectButtonSelectorEnabled(\"#participantRouteNextUnitButton\");\n      assert.equal(\n        await page.locator(\"#participantRouteNavigationNotice\").count(),\n        0\n      );\n      await page.locator(\"#participantRouteNextUnitButton\").click();\n      await page.locator(\"#participantRouteNavigationNotice\").waitFor();\n      await page\n        .locator(\"#participantRouteUnitKey\")\n        .filter({ hasText: \"CY-Unit.Sample-101\" })\n        .waitFor();\n      await assertOriginalControllerCompletenessDenied(\n        controller,\n        return (\n          Object.keys(JSON.parse(response).unitState?.dataParts ?? {}).length > 0\n        );\n      } catch {\n        return false;\n      }\n    }\n  );\n  assert.equal(\n    savedHotRestartState.currentRunState.testRun.currentUnitKey,\n    \"CY-Unit.Sample-102\"\n  );\n  const restartedController = await openOriginalTestController(\n    \"Test_Ctrl-7\",\n    \"Cy-Bklt_TC-4\"\n  );\n  assert.notEqual(\n    restartedController.participantSessionId,\n    hotRestartController.participantSessionId\n  );\n  assert.notEqual(restartedController.testRunId, hotRestartController.testRunId);\n  await page\n    .locator(\"#participantRouteUnitKey\")\n    .filter({ hasText: \"CY-Unit.Sample-100\" })\n    .waitFor({ timeout: 15_000 });\n  const cleanHotRestartState = await pollJsonWithPredicate(\n    `${baseUrl}/api/v1/participant/sessions/${restartedController.participantSessionId}/current-state`,\n    payload =>\n      payload?.currentRunState?.testRun?.currentUnitKey ===\n        \"CY-Unit.Sample-100\" &&\n      Object.keys(payload.currentRunState.testRun.unitResponses ?? {}).length ===\n        0 &&\n      Object.keys(payload.currentRunState.testRun.testletTimers ?? {}).length === 0\n  );\n  assert.equal(\n    cleanHotRestartState.currentRunState.executionMode.alwaysNewSession,\n    true\n","stderr":"","aggregated_output":"🎭 Playwright Skill - Universal