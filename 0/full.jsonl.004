{"timestamp":"2026-10-03T19:17:18.545Z","ordinal":68941,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a10167-18c0-7481-a114-505958d1a634","item":{"type":"CommandExecution","id":"exec-bec4b9ee-82d3-458c-805d-36e53b08aa0f","process_id":"65330","command":["/bin/zsh","-lc","rg -n 'article|can|is|disabled|busy' apps/web/src/app/participant-view.component.html | head -100 && sed -n '1,220p' /tmp/playwright-test-participant-logout.js"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"search","cmd":"rg -n 'article|can|is|disabled|busy' apps/web/src/app/participant-view.component.html","query":"article|can|is|disabled|busy","path":"participant-view.component.html"},{"type":"read","cmd":"sed -n '1,220p' /tmp/playwright-test-participant-logout.js","name":"playwright-test-participant-logout.js","path":"/tmp/playwright-test-participant-logout.js"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\nrg: apps/web/src/app/participant-view.component.html: IO error for operation on apps/web/src/app/participant-view.component.html: No such file or directory (os error 2)\nconst assert = require('node:assert/strict');\nconst { chromium } = require('playwright');\nconst TARGET_URL = 'http://127.0.0.1:56757';\n(async () => {\n  const browser = await chromium.launch({ headless: false });\n  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n  const errors = [];\n  page.on('pageerror', error => errors.push(error.message));\n  let token, sessionId;\n  page.on('response', async response => {\n    if (response.ok() && /\\/participant\\/(auth\\/sign-in|starter:launch)$/u.test(new URL(response.url()).pathname)) {\n      const payload = await response.json().catch(() => null);\n      if (payload?.sessionToken) { token = payload.sessionToken; sessionId = payload.participantSession.participantSessionId; }\n    }\n  });\n  const state = async () => {\n    const response = await fetch(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: `Bearer ${token}` } });\n    assert.equal(response.status, 200);\n    return (await response.json()).currentRunState;\n  };\n  try {\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ tenantKey: 'demo-tenant', workspaceKey: 'demo-workspace', loginKey: 'student-demo', bookletKey: 'booklet:demo', ui: 'rewrite' })}`);\n    const answer = 'Saved through the visible UI before participant logout.';\n    const playerAnswer = page.frameLocator('#participantVeronaPlayerFrame').locator('#demoPlayerAnswer');\n    await playerAnswer.waitFor();\n    const savedResponse = page.waitForResponse(response => response.url().endsWith('/save-progress') && response.status() === 200 && String(response.request().postDataJSON()?.unitResponse ?? '').includes(answer));\n    await playerAnswer.fill(answer);\n    await savedResponse;\n    await page.locator('#participantVeronaSaveStatus').filter({ hasText: 'saved' }).waitFor();\n    const saved = await state();\n    const runId = saved.testRun.testRunId;\n    const serializedAnswer = saved.testRun.unitResponses['unit-intro'];\n    assert.ok(serializedAnswer.includes(answer));\n    const oldToken = token;\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ participantSessionId: sessionId, ui: 'original' })}`);\n    await page.locator('#participantApplicationLogoButton').click();\n    await page.locator('#participantConfirmationContinueButton').click();\n    await page.locator('#originalParticipantStarter').waitFor();\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.locator('#originalParticipantLogoutButton').waitFor();\n    assert.equal(await page.locator('#originalParticipantLogoutButton').isDisabled(), false);\n    await page.locator('#originalParticipantLogoutButton').click();\n    await page.locator('#originalParticipantLogoutTitle').waitFor();\n    assert.deepEqual(await page.locator('.original-participant-logout-dialog mat-dialog-actions button').allTextContents(), ['Hier bleiben', 'Abmelden']);\n    await page.screenshot({ path: '/tmp/testcenter-original-participant-logout-confirmation-desktop.png', fullPage: true });\n    await page.keyboard.press('Escape');\n    await page.locator('#originalParticipantLogoutTitle').waitFor({ state: 'detached' });\n    assert.equal(await page.locator('#originalParticipantAccountButton').evaluate(el => el === document.activeElement), true);\n    assert.equal((await state()).testRun.unitResponses['unit-intro'], serializedAnswer);\n    await page.locator('#originalParticipantAccountButton').click();\n    console.log('stage=original-account-ready');\n    const logoutPattern = `**/api/v1/participant/sessions/${sessionId}/access`;\n    await page.route(logoutPattern, route => route.fulfill({ status: 503, contentType: 'application/json', body: JSON.stringify({ error: 'temporary_logout_failure', message: 'Retry logout.' }) }));\n    await page.locator('#originalParticipantLogoutButton').click();\n    await page.locator('#originalParticipantLogoutConfirmButton').click();\n    await page.locator('#originalParticipantLogoutNotice').filter({ hasText: 'Abmelden fehlgeschlagen' }).waitFor();\n    console.log('stage=logout-failure-retry-ready');\n    await page.screenshot({ path: '/tmp/testcenter-original-participant-logout-retry.png', fullPage: true });\n    console.log(await page.locator('#originalParticipantLogoutButton').evaluate(el => {\n      const r = el.getBoundingClientRect(), top = document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2);\n      return { rect: r.toJSON(), topTag: top?.tagName, topId: top?.id, topClass: top?.className,\n        ancestors: Array.from(el.closest('.cdk-overlay-pane').querySelectorAll('.mat-mdc-menu-panel,.mat-mdc-menu-content')).map(p => ({ rect: p.getBoundingClientRect().toJSON(), overflow: getComputedStyle(p).overflow, scrollTop: p.scrollTop })) };\n    }));\n    assert.equal(await page.locator('#originalParticipantStarter').count(), 1);\n    assert.equal((await state()).testRun.unitResponses['unit-intro'], serializedAnswer);\n    await page.unroute(logoutPattern);\n    await page.locator('#originalParticipantLogoutButton').click();\n    await page.locator('#originalParticipantLogoutConfirmButton').click();\n    await page.locator('#originalParticipantLogin').waitFor();\n    console.log('stage=desktop-signed-out');\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    assert.equal(new URL(page.url()).searchParams.has('participantSessionId'), false);\n    assert.equal(await page.locator('#originalLoginName').evaluate(el => el === document.activeElement), true);\n    const rejected = await fetch(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: `Bearer ${oldToken}` } });\n    assert.equal(rejected.status, 401);\n    await page.screenshot({ path: '/tmp/testcenter-original-participant-signed-out.png', fullPage: true });\n    await page.locator('#originalLoginName').fill('student-demo');\n    await page.getByRole('button', { name: 'Weiter', exact: true }).click();\n    await page.waitForFunction(expected => document.querySelector('#participantRouteRunId')?.textContent?.trim() === expected, runId);\n    assert.notEqual(token, oldToken);\n    const restored = await state();\n    assert.equal(restored.testRun.testRunId, runId);\n    assert.equal(restored.testRun.unitResponses['unit-intro'], serializedAnswer);\n    const restoredPlayer = await (await page.locator('#participantVeronaPlayerFrame').elementHandle()).contentFrame();\n    await restoredPlayer.waitForFunction(expected => document.querySelector('#demoPlayerAnswer')?.value === expected, answer);\n    console.log('stage=same-run-answer-restored');\n    awai