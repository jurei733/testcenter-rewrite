Pattern,\\n      productionApiRoutes.participant.exportReviewsCsv\\n    ],\\n    [\\\"GET\\\", participantReviewExportPattern, productionApiRoutes.participant.exportReviews],\\n    [\\\"POST\\\", participantReviewListPattern, productionApiRoutes.participant.createReview],\\n    [\\\"PATCH\\\", participantReviewDetailPattern, productionApiRoutes.participant.updateReview],\\n    [\\\"DELETE\\\", participantReviewDetailPattern, productionApiRoutes.participant.deleteReview],\\n    [\\\"POST\\\", unlockTestletPattern, productionApiRoutes.participant.unlockTestlet],\\n1861:    adminSession: { adminSessionId: string; token?: string; revokedAt: string | null };\\n1874:  assert.equal(revokedOtherSession.body.adminSession.token, undefined);\\n{\\\"browser\\\":[{\\\"conclusion\\\":\\\"success\\\",\\\"name\\\":\\\"verify-memory-sqlite (ui-full)\\\",\\\"status\\\":\\\"completed\\\"},{\\\"conclusion\\\":\\\"\\\",\\\"name\\\":\\\"verify-memory-sqlite (ui-ops)\\\",\\\"status\\\":\\\"in_progress\\\"}],\\\"conclusion\\\":\\\"\\\",\\\"failed\\\":[],\\\"status\\\":\\\"in_progress\\\"}\\n\"}","type":"input_text"},{"text":"{}","type":"input_text"},{"text":"{\"chunk_id\":\"0af3b7\",\"wall_time_seconds\":1.000893542,\"session_id\":10315,\"original_token_count\":0,\"output\":\"\"}","type":"input_text"}],"type":"custom_tool_call_output"},{"encrypted_content":"REDACTED","id":"rs_0f77002cf3a055dd016ac13a0a906487d29616c5e9bf34039e","internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_0f77002cf3a055dd016ac13a27c8fc87d28e4beca2fd086790","internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_0f77002cf3a055dd016ac13a4b010c87d29c9f8f670a06f5d4","internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634"},"summary":[],"type":"reasoning"},{"encrypted_content":"REDACTED","id":"rs_0f77002cf3a055dd016ac13a6e28cc87d2adea4737b985d9da","internal_chat_message_metadata_passthrough":{"turn_id":"01a10167-18c0-7481-a114-505958d1a634"},"summary":[],"type":"reasoning"},{"call_id":"call_qPtF2nY3bSmc8eqyEhpfvGaE","id":"ctc_0f77002cf3a055dd016ac13a8c2ad487d2a954143ba4af5fb5","input":"text(await tools.apply_patch(\"*** Begin Patch\\n*** Update File: /Users/julian/code/testcenter-rewrite/rewrite-app/apps/api/src/integration.test.ts\\n@@\\n type JsonResponse\u003cT\u003e = {\\n@@\\n };\\n+\\n+// Test actors retain only credentials returned by their real login. Negative\\n+// authorization cases use raw fetch or an explicit Authorization override.\\n+const participantHttpTokens = new Map\u003cstring, string\u003e();\\n+const participantHttpOwners = new Map\u003cstring, string\u003e();\\n+const captureParticipantHttpActor = (rootUrl: string, path: string, payload: unknown): void =\u003e {\\n+  if (!path.startsWith(\\\"/api/v1/participant/\\\") || !payload || typeof payload !== \\\"object\\\") return;\\n+  const response = payload as Record\u003cstring, any\u003e;\\n+  const state = response.currentRunState ?? response.runtimeState ?? response;\\n+  const sessionId = state.participantSession?.participantSessionId;\\n+  if (typeof sessionId === \\\"string\\\" \u0026\u0026 typeof response.sessionToken === \\\"string\\\") {\\n+    participantHttpTokens.set(`${rootUrl}\\\\n${sessionId}`, response.sessionToken);\\n+  }\\n+  const run = state.testRun;\\n+  if (typeof run?.testRunId === \\\"string\\\" \u0026\u0026 typeof run.participantSessionId === \\\"string\\\") {\\n+    participantHttpOwners.set(`${rootUrl}\\\\n${run.testRunId}`, run.participantSessionId);\\n+  }\\n+};\\n+const participantHttpHeaders = (rootUrl: string, path: string, body?: unknown): Record\u003cstring, string\u003e =\u003e {\\n+  const session = /^\\\\/api\\\\/v1\\\\/participant\\\\/sessions\\\\/([^/]+)\\\\//u.exec(path);\\n+  const run = /^\\\\/api\\\\/v1\\\\/participant\\\\/test-runs\\\\/([^/]+)\\\\//u.exec(path);\\n+  const sessionId = session ? decodeURIComponent(session[1]!) : run\\n+    ? participantHttpOwners.get(`${rootUrl}\\\\n${decodeURIComponent(run[1]!)}`)\\n+    : path === \\\"/api/v1/participant/starter:launch\\\" \u0026\u0026 body \u0026\u0026 typeof body === \\\"object\\\"\\n+      ? (body as { participantSessionId?: string }).participantSessionId : undefined;\\n+  if (!sessionId) return {};\\n+  const sessionToken = participantHttpTokens.get(`${rootUrl}\\\\n${sessionId}`) ?? sessionId;\\n+  return { authorization: `Bearer ${sessionToken}` };\\n+};\\n@@\\n     headers: {\\n       \\\"content-type\\\": \\\"application/json\\\",\\n+      ...participantHttpHeaders(rootUrl, path, init?.body),\\n@@\\n-  return {\\n+  const text = await response.text();\\n+  const payload = text ? JSON.parse(text) : null;\\n+  if (response.ok) captureParticipantHttpActor(rootUrl, path, payload);\\n+  return {\\n     status: response.status,\\n-    body: (await response.json()) as T,\\n+    body: payload as T,\\n@@\\n   const response = await fetch(baseUrl + path, {\\n     method: init?.method ?? \\\"GET\\\",\\n-    headers: init?.headers\\n+    headers: { ...participantHttpHeaders(baseUrl, path), ...(init?.headers ?? {}) }\\n@@\\n   const response = await fetch(rootUrl + path, {\\n     method: init?.method ?? \\\"GET\\\",\\n-    headers: init?.headers\\n+    headers: { ...participantHttpHeaders(rootUrl, path), ...(init?.headers ?? {}) }\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"npm exec tsc -- -b --pretty packages/domain packages/contracts packages/application packages/memory-store packages/file-store packages/sqlite-store packages/postgres-store apps/api \u003e /tmp/testcenter-participant-http-auth-build.log 2\u003e\u00261\",\"workdir\":\"/Users/julian/code/testcenter-rewrite/rewrite-app\",\"login\":false,\"yield_time_ms\":1000,\"max_output_tokens\":500}));\ntext(await tools.exec_command({cmd:\"git diff --s