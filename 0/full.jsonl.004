{"timestamp":"2026-10-03T19:16:09.552Z","ordinal":68909,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a10167-18c0-7481-a114-505958d1a634","item":{"type":"CommandExecution","id":"exec-6a4b1179-3583-44ef-93da-ed97c35ac5cb","process_id":"9155","command":["/bin/zsh","-lc","GODEBUG=http2client=0 gh run view 37145806260 --json status,conclusion,jobs --jq '{status,conclusion,unfinished:[.jobs[]|select(.status!=\"completed\")|{name,status}],failed:[.jobs[]|select(.conclusion!=\"success\" and .status==\"completed\")|{name,conclusion}]}'"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"unknown","cmd":"GODEBUG=http2client=0 gh run view 37145806260 --json status,conclusion,jobs --jq '{status,conclusion,unfinished:[.jobs[]|select(.status!=\"completed\")|{name,status}],failed:[.jobs[]|select(.conclusion!=\"success\" and .status==\"completed\")|{name,conclusion}]}'"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n{\"conclusion\":\"\",\"failed\":[],\"status\":\"in_progress\",\"unfinished\":[{\"name\":\"verify-memory-sqlite (ui-ops)\",\"status\":\"in_progress\"},{\"name\":\"verify-memory-sqlite (ui-quick)\",\"status\":\"in_progress\"}]}\n","stderr":"","aggregated_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n{\"conclusion\":\"\",\"failed\":[],\"status\":\"in_progress\",\"unfinished\":[{\"name\":\"verify-memory-sqlite (ui-ops)\",\"status\":\"in_progress\"},{\"name\":\"verify-memory-sqlite (ui-quick)\",\"status\":\"in_progress\"}]}\n","exit_code":0,"duration":{"secs":2,"nanos":187302750},"formatted_output":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n{\"conclusion\":\"\",\"failed\":[],\"status\":\"in_progress\",\"unfinished\":[{\"name\":\"verify-memory-sqlite (ui-ops)\",\"status\":\"in_pro