, 200);\n    return (await response.json()).currentRunState;\n  };\n  try {\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ tenantKey: 'demo-tenant', workspaceKey: 'demo-workspace', loginKey: 'student-demo', bookletKey: 'booklet:demo', ui: 'rewrite' })}`);\n    await page.locator('#participantRouteUnitResponse').waitFor();\n    const answer = 'Saved through the visible UI before participant logout.';\n    await page.locator('#participantRouteUnitResponse').fill(answer);\n    const savedResponse = page.waitForResponse(response => response.url().endsWith('/save-progress') && response.status() === 200);\n    await page.getByRole('button', { name: 'Save Paused', exact: true }).click();\n    await savedResponse;\n    await page.waitForFunction(() => document.querySelector('#participantRouteUnitResponse')?.value === 'Saved through the visible UI before participant logout.');\n    const saved = await state();\n    const runId = saved.testRun.testRunId;\n    assert.equal(saved.testRun.unitResponses['unit-intro'], answer);\n    const oldToken = token;\n    await page.goto(`${TARGET_URL}/app/participant?${new URLSearchParams({ participantSessionId: sessionId, ui: 'original' })}`);\n    await page.locator('#participantApplicationLogoButton').click();\n    await page.locator('#participantConfirmationContinueButton').click();\n    await page.locator('#originalParticipantStarter').waitFor();\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.locator('#originalParticipantLogoutButton').waitFor();\n    assert.equal(await page.locator('#originalParticipantLogoutButton').isDisabled(), false);\n    const logoutPattern = `**/api/v1/participant/sessions/${sessionId}/access`;\n    await page.route(logoutPattern, route => route.fulfill({ status: 503, contentType: 'application/json', body: JSON.stringify({ error: 'temporary_logout_failure', message: 'Retry logout.' }) }));\n    await page.locator('#originalParticipantLogoutButton').click();\n    await page.locator('#originalParticipantLogoutNotice').filter({ hasText: 'Abmelden fehlgeschlagen' }).waitFor();\n    assert.equal(await page.locator('#originalParticipantStarter').count(), 1);\n    assert.equal((await state()).testRun.unitResponses['unit-intro'], answer);\n    await page.unroute(logoutPattern);\n    await page.locator('#originalParticipantLogoutButton').click();\n    await page.locator('#originalParticipantLogin').waitFor();\n    assert.equal(await page.locator('#originalParticipantAccountButton').count(), 0);\n    assert.equal(new URL(page.url()).searchParams.has('participantSessionId'), false);\n    assert.equal(await page.locator('#originalLoginName').evaluate(el => el === document.activeElement), true);\n    const rejected = await fetch(`${TARGET_URL}/api/v1/participant/sessions/${sessionId}/current-state`, { headers: { authorization: `Bearer ${oldToken}` } });\n    assert.equal(rejected.status, 401);\n    await page.screenshot({ path: '/tmp/testcenter-original-participant-signed-out.png', fullPage: true });\n    await page.locator('#originalLoginName').fill('student-demo');\n    await page.getByRole('button', { name: 'Weiter', exact: true }).click();\n    await page.waitForFunction(expected => document.querySelector('#participantRouteRunId')?.textContent?.trim() === expected, runId);\n    assert.notEqual(token, oldToken);\n    const restored = await state();\n    assert.equal(restored.testRun.testRunId, runId);\n    assert.equal(restored.testRun.unitResponses['unit-intro'], answer);\n    await page.locator('#participantApplicationLogoButton').click();\n    await page.locator('#participantConfirmationContinueButton').click();\n    await page.locator('#originalParticipantStarter').waitFor();\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.locator('#originalParticipantAccountButton').click();\n    await page.locator('#originalParticipantLogoutButton').waitFor();\n    assert.ok((await page.locator('.original-participant-account-menu').boundingBox()).width <= 366);\n    await page.locator('#originalParticipantLogoutButton').focus();\n    await page.keyboard.press('Enter');\n    await page.locator('#originalParticipantLogin').waitFor();\n    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth), false);\n    assert.deepEqual(errors, []);\n    console.log('PASS Original participant logout: real server revocation, retry, same-run answer restoration, desktop/mobile keyboard and focus');\n  } finally { await browser.close(); }\n})().catch(error => { console.error(error.message); process.exitCode = 1; });\nexport async function performParticipantSignOut(input: {\n  participantSessionId: string;\n  readCredential: (sessionId: string) => string | null;\n  revoke: (sessionId: string, token: string) => Promise<unknown>;\n  forgetCredential: (sessionId: string, expectedToken: string) => boolean;\n  clearSignedInState: () => void;\n}): Promise<\"signed_out\" | \"renewed\"> {\n  const token = input.readCredential(input.participantSessionId);\n  if (!token) throw new Error(\"Participant access is unavailable.\");\n  await input.revoke(input.participantSessionId, token);\n  // A different tab/login may renew this exact participant while logout is\n  // in flight. Never erase that newer credential or its visible session.\n  const current = input.readCredential(input.participantSessionId);\n  if (current && current !== token) return \"renewed\";\n  if (!input.forgetCredential(input.participantSessionId, token)) {\n    const renewed = input.readCredential(input.participantSessionId);\n    if (renewed && renewed !== token) return \"renewed\";\n  }\n  // A quota failure cannot restore access: the server has revoked this token.\n  // Clearing the view must not delete foreground/worker answer queues.\n  input.clearSignedInState();\n  return \"signed_out\";\n}\n2618:    this.clearStoredParticipantSession(\n2623:  async signOutParticipant(): Promise<void> {\n2639:          this.clearStoredParticipantSession(\"Signed out. Sign in again to continue your saved test.\", true);\n2871:        this.clearStoredParticipantSession();\n3015:  private clearStoredParticipantSession(\n"},"started_at_ms":1791051813358,"completed_at_ms":1791051813361}}
