{"timestamp":"2026-10-03T19:17:45.759Z","ordinal":68953,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a10167-18c0-7481-a114-505958d1a634","item":{"type":"CommandExecution","id":"exec-b044930a-1cdf-4d43-b3d8-3751f17b01be","process_id":"66535","command":["/bin/zsh","-lc","sed -n '11520,11650p' scripts/smoke-ui.mjs && sed -n '1,170p' scripts/smoke-ui.mjs && rg -n 'process.cwd|FIRST_SLICE_|import.meta.url' apps/api/src/index.ts | tail -55 && rg -n 'templateUrl|participantPlayer|can.*Return|can.*Leave|is.*Busy|app-verona' apps/web/src/app/participant-view.component.ts | tail -75 && sed -n '1,130p' package.json"],"cwd":"file:///Users/julian/code/testcenter-rewrite/rewrite-app","parsed_cmd":[{"type":"read","cmd":"sed -n '11520,11650p' scripts/smoke-ui.mjs","name":"smoke-ui.mjs","path":"scripts/smoke-ui.mjs"},{"type":"read","cmd":"sed -n '1,170p' scripts/smoke-ui.mjs","name":"smoke-ui.mjs","path":"scripts/smoke-ui.mjs"},{"type":"search","cmd":"rg -n 'process.cwd|FIRST_SLICE_|import.meta.url' apps/api/src/index.ts","query":"process.cwd|FIRST_SLICE_|import.meta.url","path":"index.ts"},{"type":"search","cmd":"rg -n 'templateUrl|participantPlayer|can.*Return|can.*Leave|is.*Busy|app-verona' apps/web/src/app/participant-view.component.ts","query":"templateUrl|participantPlayer|can.*Return|can.*Leave|is.*Busy|app-verona","path":"participant-view.component.ts"},{"type":"read","cmd":"sed -n '1,130p' package.json","name":"package.json","path":"package.json"}],"source":"unified_exec_startup","status":"completed","stdout":"/Users/julian/.zprofile:source:8: no such file or directory: /Users/julian/.bashrc\n        .inputValue(),\n      protocolResponse\n    );\n    await participantHttpActor.goto(page,\n      `${baseUrl}/participant?participantSessionId=${encodeURIComponent(\n        protocolParticipantSessionId\n      )}`,\n      { waitUntil: \"domcontentloaded\" }\n    );\n    await page\n      .locator(\"#participantVeronaPlayerVersion\")\n      .filter({ hasText: `API ${protocolPlayer.playerApiVersion}` })\n      .waitFor({ timeout: 30_000 });\n    if (apiMajor === \"2\") {\n      await page\n        .frameLocator(\"#participantVeronaPlayerFrame\")\n        .getByText(\"Official Verona 2 restored page\", { exact: true })\n        .waitFor({ timeout: 30_000 });\n    }\n    assert.equal(\n      await page\n        .frameLocator(\"#participantVeronaPlayerFrame\")\n        .locator(`input[name='${protocolInputName}']`)\n        .inputValue(),\n      protocolResponse\n    );\n  }\n  stopAfter(\"participant-verona-2-5-players\");\n\n  logStep(\"participant-official-abi-player-family\");\n  const abiPlayerPackage =\n    officialProtocolCorpus.veronaPlayerFamilyPackages.find(\n      playerPackage => playerPackage.family === \"ABI scripted survey\"\n    );\n  assert.ok(abiPlayerPackage, \"The official ABI player fixture should be pinned.\");\n  const abiTenantKey = `${tenantKey}-verona-abi`;\n  const abiWorkspaceKey = `${workspaceKey}-verona-abi`;\n  const abiBookletKey = \"BOOKLET.OFFICIAL.ABI-3.3\";\n  const abiUnitKey = \"UNIT.OFFICIAL.ABI-3.3\";\n  const abiLoginKey = \"student-official-abi\";\n  const abiResponse = \"Abi-42\";\n  const [abiPlayerDocument, abiDefinitionDocument] = await Promise.all([\n    readBrotliBase64Text(\n      resolve(\n        \"test-fixtures/original-testcenter\",\n        abiPlayerPackage.playerFixture\n      )\n    ),\n    readFile(\n      resolve(\n        \"test-fixtures/original-testcenter\",\n        abiPlayerPackage.definitionFixture\n      ),\n      \"utf8\"\n    ).then(encoded => Buffer.from(encoded.trim(), \"base64\").toString(\"utf8\"))\n  ]);\n  const abiPlayerZip = createStoredZipBuffer([\n    {\n      fileName: \"export/imsmanifest.xml\",\n      content: `\n        <manifest xmlns=\"http://www.imsglobal.org/xsd/imscp_v1p1\">\n          <resources>\n            <resource identifier=\"${abiBookletKey}\" href=\"booklets/Booklet.xml\" />\n            <resource identifier=\"${abiUnitKey}\" href=\"units/Unit.xml\" />\n            <resource identifier=\"${abiPlayerPackage.playerKey}\" href=\"players/Player.html\" />\n          </resources>\n        </manifest>\n      `\n    },\n    {\n      fileName: \"export/booklets/Booklet.xml\",\n      content: `\n        <Booklet>\n          <Metadata>\n            <Id>${abiBookletKey}</Id>\n            <Label>Official ABI scripted survey</Label>\n          </Metadata>\n          <Units>\n            <Unit id=\"${abiUnitKey}\" label=\"ABI survey\" />\n          </Units>\n        </Booklet>\n      `\n    },\n    {\n      fileName: \"export/units/Unit.xml\",\n      content: `\n        <Unit>\n          <Metadata>\n            <Id>${abiUnitKey}</Id>\n            <Label>Official ABI survey</Label>\n          </Metadata>\n          <Definition player=\"${abiPlayerPackage.playerKey}\" type=\"${abiPlayerPackage.unitDefinitionType}\"><![CDATA[${abiDefinitionDocument}]]></Definition>\n        </Unit>\n      `\n    },\n    {\n      fileName: \"export/players/Player.html\",\n      content: abiPlayerDocument\n    }\n  ]);\n  await sendSmokeJson(`${baseUrl}/api/v1/platform/tenants`, {\n    body: {\n      tenantKey: abiTenantKey,\n      displayName: \"Official ABI Player\"\n    }\n  });\n  await sendSmokeJson(\n    `${baseUrl}/api/v1/tenants/${abiTenantKey}/workspaces`,\n    {\n      body: {\n        workspaceKey: abiWorkspaceKey,\n        displayName: \"Official ABI Player\"\n      }\n    }\n  );\n  const abiWorkspaceApiUrl =\n    `${baseUrl}/api/v1/tenants/${abiTenantKey}` +\n    `/workspaces/${abiWorkspaceKey}`;\n  const abiSourceResponse = await sendSmokeJson(\n    `${abiWorkspaceApiUrl}/source-packages`,\n    {\n      body: {\n        fileName: \"official-abi-3.3-browser-smoke.zip\",\n        mediaType: \"application/zip\",\n        sourceDocument: `data:application/zip;base64,${abiPlayerZip.toString(\"base64\")}`\n      }\n    }\n  );\n  const abiSourcePayload = await abiSourceResponse.json();\n  const abiImportResponse = await sendSmokeJson(\n    `${abiWorkspaceApiUrl}/import-jobs`,\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { dirname, resolve } from \"node:path\";\nimport { setTimeout as delay } from \"node:timers/promises\";\nimport { brotliDecompressSync } from \"node:zlib\";\n\nimport { chromium } from \"playwright\";\nimport QRCode from \"qrcode\";\nimport { createParticipantHttpTestActor } from \"./participant-http-test-actor.mjs\";\n\nconst participantHttpActor = createParticipantHttpTestActor();\nconst fetch = participantHttpActor.fetch;\n\nconst store = process.env.FIRST_SLICE_STORE ?? \"sqlite\";\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\nconst operatorAuthRequired =\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \"true\";\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \"\";\nconst configuredProofOfWorkScopes = new Set(\n  String(process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES ?? \"\")\n    .split(/[\\s,]+/u)\n    .filter(Boolean)\n);\nconst skipRuntimeCsvExports = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_RUNTIME_CSV_EXPORTS ?? \"\").toLowerCase()\n);\nconst skipOfflineAppShell = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_OFFLINE_APP_SHELL ?? \"\").toLowerCase()\n);\nconst skipWorkspaceRename = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_SKIP_WORKSPACE_RENAME ?? \"\").toLowerCase()\n);\nconst busyStartTimeoutMs = Number.parseInt(\n  process.env.UI_SMOKE_BUSY_START_TIMEOUT_MS ?? \"750\",\n  10\n);\nconst logBusyStartTimeouts = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_LOG_BUSY_START_TIMEOUTS ?? \"\").toLowerCase()\n);\nconst serverEntry = resolve(\"apps/api/dist/apps/api/src/index.js\");\nconst failedImportSourceDocument = '{\"booklets\":[]}';\nconst repairedImportSourceDocument =\n  '<assessment><booklet key=\"booklet:recovered\" label=\"Recovered\"><unit key=\"unit-recovered\" label=\"Recovered Unit\" /></booklet></assessment>';\nconst uploadedSourceDocument =\n  '<Booklet><Metadata><Id>booklet:starter</Id><Label>Starter</Label></Metadata><BookletConfig><Config key=\"toolbar_show_unit_list\">TRUE</Config><Config key=\"ask_for_fullscreen\">ON</Config><Config key=\"show_fullscreen_button\">ON</Config><Config key=\"toolbar_show_reload_button\">TRUE</Config><Config key=\"unit_screenheader\">WITH_UNIT_TITLE</Config><Config key=\"unit_title\">OFF</Config></BookletConfig><Units><Unit id=\"unit-1\" label=\"Entry\" /><Testlet id=\"testlet:participant-route\" label=\"Participant Route Block\"><Unit id=\"unit-participant-route\" label=\"Participant Route\"><description>Read the participant prompt.</description><prompt>Explain how the starter example works.</prompt></Unit></Testlet><Testlet id=\"testlet:timed-paused\" label=\"Timed Paused Work\"><Restrictions><TimeMax minutes=\"5\" leave=\"allowed\" /></Restrictions><Unit id=\"unit-paused\" label=\"Paused Work\"><Definition><![CDATA[<section>Answer the direct Testcenter definition prompt.</section>]]></Definition></Unit></Testlet></Units></Booklet>';\nlet smokeAdminSessionToken = \"\";\n\nconst readBrotliBase64Text = async fixturePath =>\n  brotliDecompressSync(\n    Buffer.from(await readFile(fixturePath, \"utf8\"), \"base64\")\n  ).toString(\"utf8\");\n\nconst crc32Table = Array.from({ length: 256 }, (_, value) => {\n  let crc = value;\n  for (let bit = 0; bit < 8; bit += 1) {\n    crc = (crc & 1) !== 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;\n  }\n  return crc >>> 0;\n});\n\nconst crc32 = content => {\n  let crc = 0xffffffff;\n  for (const byte of content) {\n    crc = crc32Table[(crc ^ byte) & 0xff] ^ (crc >>> 8);\n  }\n  return (crc ^ 0xffffffff) >>> 0;\n};\n\nconst createStoredZipBuffer = entries => {\n  const localFileHeaders = [];\n  const centralDirectoryHeaders = [];\n  let offset = 0;\n\n  for (const entry of entries) {\n    const fileName = Buffer.from(entry.fileName, \"utf8\");\n    const content = Buffer.from(entry.content, \"utf8\");\n    const checksum = crc32(content);\n    const localHeader = Buffer.alloc(30 + fileName.length);\n    localHeader.writeUInt32LE(0x04034b50, 0);\n    localHeader.writeUInt16LE(20, 4);\n    localHeader.writeUInt16LE(0x0800, 6);\n    localHeader.writeUInt16LE(0, 8);\n    localHeader.writeUInt32LE(0, 10);\n    localHeader.writeUInt32LE(checksum, 14);\n    localHeader.writeUInt32LE(content.length, 18);\n    localHeader.writeUInt32LE(content.length, 22);\n    localHeader.writeUInt16LE(fileName.length, 26);\n    fileName.copy(localHeader, 30);\n    localFileHeaders.push(localHeader, content);\n\n    const centralDirectoryHeader = Buffer.alloc(46 + fileName.length);\n    centralDirectoryHeader.writeUInt32LE(0x02014b50, 0);\n    centralDirectoryHeader.writeUInt16LE(20, 4);\n    centralDirectoryHeader.writeUInt16LE(20, 6);\n    centralDirectoryHeader.writeUInt16LE(0x0800, 8);\n    centralDirectoryHeader.writeUInt16LE(0, 10);\n    centralDirectoryHeader.writeUInt32LE(0, 12);\n    centralDirectoryHeader.writeUInt32LE(checksum, 16);\n    centralDirectoryHeader.writeUInt32LE(content.length, 20);\n    centralDirectoryHeader.writeUInt32LE(content.length, 24);\n    centralDirectoryHeader.writeUInt16LE(fileName.length, 28);\n    centralDirectoryHeader.writeUInt32LE(offset, 42);\n    fileName.copy(centralDirectoryHeader, 46);\n    centralDirectoryHeaders.push(centralDirectoryHeader);\n\n    offset += localHeader.length + content.length;\n  }\n\n  const centralDirectoryOffset = offset;\n  const centralDirectory = Buffer.concat(centralDirectoryHeaders);\n  const endOfCentralDirectory = Buffer.alloc(22);\n  endOfCentralDirectory.writeUInt32LE(0x06054b50, 0);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 8);\n  endOfCentralDirectory.writeUInt16LE(entries.length, 10);\n  endOfCentralDirectory.writeUInt32LE(centralDirectory.length, 12);\n  endOfCentralDirectory.writeUInt32LE(centralDirectoryOffset, 16);\n\n  return Buffer.concat([\n    ...localFileHeaders,\n    centralDirectory,\n    endOfCentralDirectory\n  ]);\n};\n\nconst readStoredZipTextEntries = archive => {\n  const entries = new Map();\n  let offset = 0;\n  while (\n    offset + 30 <= archive.length &&\n    archive.readUInt32LE(offset) === 0x04034b50\n  ) {\n    assert.equal(archive.readUInt16LE(offset + 8), 0);\n    const contentLength = archive.readUInt32LE(offset + 18);\n    const fileNameLength = archive.readUInt16LE(offset + 26);\n    const extraLength = archive.readUInt16LE(offset + 28);\n    const fileNameStart = offset + 30;\n    const contentStart = fileNameStart + fileNameLength + extraLength;\n    const contentEnd = contentStart + contentLength;\n    assert.ok(contentEnd <= archive.length);\n    entries.set(\n      archive\n        .subarray(fileNameStart, fileNameStart + fileNameLength)\n        .toString(\"utf8\"),\n      archive.subarray(contentStart, contentEnd).toString(\"utf8\")\n    );\n    offset = contentEnd;\n  }\n  return entries;\n};\n\nclass UiSmokeEarlyExit extends Error {\n  constructor(step) {\n    super(`UI smoke stopped after requested step: ${step}`);\n    this.name = \"UiSmokeEarlyExit\";\n    this.step = step;\n  }\n}\n\nconst createSmokeFetchInit = url =>\n  url && participantHttpActor.isParticipant(url)\n    ? { headers: participantHttpActor.headers(url) }\n    : smokeAdminSessionToken\n    ? {\n        headers: {\n          authorization: `Bearer ${smokeAdminSessionToken}`\n        }\n      }\n572:    const connectionString = process.env.FIRST_SLICE_POSTGRES_URL;\n575:        \"FIRST_SLICE_POSTGRES_URL is required when FIRST_SLICE_STORE=postgres.\"\n583:      schemaVersion: POSTGRES_FIRST_SLICE_SCHEMA_VERSION,\n607:    \"FIRST_SLICE_MAX_JSON_BODY_BYTES\",\n611:    \"FIRST_SLICE_MAX_SOURCE_PACKAGE_JSON_BODY_BYTES\",\n616:      \"FIRST_SLICE_MAX_PARTICIPANT_PROGRESS_JSON_BODY_BYTES\",\n632:    \"FIRST_SLICE_OPERATOR_AUTH_REQUIRED\",\n636:    \"FIRST_SLICE_HSTS_ENABLED\",\n640:    \"FIRST_SLICE_ADMIN_LOGIN_MAX_FAILURES\",\n644:    \"FIRST_SLICE_ADMIN_LOGIN_FAILURE_WINDOW_MS\",\n648:    \"FIRST_SLICE_ADMIN_PASSWORD_MIN_LENGTH\",\n653:      `FIRST_SLICE_ADMIN_PASSWORD_MIN_LENGTH must be between 1 and ${adminPasswordPolicy.maximumLength}.`\n657:    process.env.FIRST_SLICE_ADMIN_PASSWORD_PATTERN ??\n664:      \"FIRST_SLICE_ADMIN_PASSWORD_PATTERN must contain between 1 and 1024 characters.\"\n671:      \"FIRST_SLICE_ADMIN_PASSWORD_PATTERN must be a valid JavaScript regular expression.\"\n681:    \"FIRST_SLICE_PROOF_OF_WORK_SECRET\",\n682:    process.env.FIRST_SLICE_PROOF_OF_WORK_SECRET\n685:    \"FIRST_SLICE_PROOF_OF_WORK_PREVIOUS_SECRET\",\n686:    process.env.FIRST_SLICE_PROOF_OF_WORK_PREVIOUS_SECRET\n690:      \"FIRST_SLICE_PROOF_OF_WORK_SECRET is required when proof-of-work scopes are enabled.\"\n695:      \"FIRST_SLICE_PROOF_OF_WORK_SECRET is required when FIRST_SLICE_PROOF_OF_WORK_PREVIOUS_SECRET is configured.\"\n703:      \"FIRST_SLICE_PROOF_OF_WORK_PREVIOUS_SECRET must differ from FIRST_SLICE_PROOF_OF_WORK_SECRET.\"\n707:    \"FIRST_SLICE_PROOF_OF_WORK_MAX_NUMBER\",\n712:      `FIRST_SLICE_PROOF_OF_WORK_MAX_NUMBER must be between 1 and ${MAXIMUM_PROOF_OF_WORK_MAX_NUMBER}.`\n716:    \"FIRST_SLICE_PROOF_OF_WORK_TTL_MS\",\n724:      `FIRST_SLICE_PROOF_OF_WORK_TTL_MS must be between ${MINIMUM_PROOF_OF_WORK_TTL_MS} and ${MAXIMUM_PROOF_OF_WORK_TTL_MS}.`\n728:    \"FIRST_SLICE_PARTICIPANT_LOGIN_MAX_FAILURES\",\n732:    \"FIRST_SLICE_PARTICIPANT_LOGIN_FAILURE_WINDOW_MS\",\n736:    process.env.FIRST_SLICE_PARTICIPANT_TIME_ZONE?.trim() || \"Europe/Berlin\";\n742:    \"FIRST_SLICE_BOOTSTRAP_DEMO\",\n747:      \"REQUIRE_LOGIN_PASSWORD cannot be combined with FIRST_SLICE_BOOTSTRAP_DEMO: the demo login is passwordless.\"\n753:      \"FIRST_SLICE_BOOTSTRAP_DEMO cannot be combined with secret-file administrator bootstrap.\"\n863:        firstSliceFilePresent: Boolean(process.env.FIRST_SLICE_FILE),\n864:        firstSliceSqliteFilePresent: Boolean(process.env.FIRST_SLICE_SQLITE_FILE),\n865:        firstSlicePostgresUrlPresent: Boolean(process.env.FIRST_SLICE_POSTGRES_URL),\n867:          process.env.FIRST_SLICE_MAX_JSON_BODY_BYTES\n870:          process.env.FIRST_SLICE_MAX_SOURCE_PACKAGE_JSON_BODY_BYTES\n873:          process.env.FIRST_SLICE_MAX_PARTICIPANT_PROGRESS_JSON_BODY_BYTES\n878:          process.env.FIRST_SLICE_BOOTSTRAP_ADMIN_USERNAME\n881:          process.env.FIRST_SLICE_BOOTSTRAP_ADMIN_DISPLAY_NAME\n884:          process.env.FIRST_SLICE_BOOTSTRAP_ADMIN_PASSWORD_FILE\n887:          process.env.FIRST_SLICE_ADMIN_LOGIN_MAX_FAILURES\n890:          process.env.FIRST_SLICE_ADMIN_LOGIN_FAILURE_WINDOW_MS\n893:          process.env.FIRST_SLICE_ADMIN_PASSWORD_MIN_LENGTH\n896:          process.env.FIRST_SLICE_ADMIN_PASSWORD_PATTERN\n899:          process.env.FIRST_SLICE_PROOF_OF_WORK_SCOPES\n902:          process.env.FIRST_SLICE_PROOF_OF_WORK_SECRET\n905:          process.env.FIRST_SLICE_PROOF_OF_WORK_PREVIOUS_SECRET\n908:          process.env.FIRST_SLICE_PROOF_OF_WORK_MAX_NUMBER\n911:          process.env.FIRST_SLICE_PROOF_OF_WORK_TTL_MS\n914:          process.env.FIRST_SLICE_PARTICIPANT_LOGIN_MAX_FAILURES\n917:          process.env.FIRST_SLICE_PARTICIPANT_LOGIN_FAILURE_WINDOW_MS\n2978:  resolve(process.cwd(), \"dist/apps/web/browser\"),\n2980:    new URL(\"../../../../../../dist/apps/web/browser\", import.meta.url)\n9375:if (import.meta.url === `file://${process.argv[1]}`) {\n296:          <button id=\"participantRouteClearSessionButton\" class=\"ghost\" type=\"button\" [disabled]=\"!view.player.canClearSession\" (click)=\"view.clearSession()\">Leave Session</button>\n606:            <app-verona-player-host\n671:            </app-verona-player-host>\n{\n  \"name\": \"testcenter-rewrite-app\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=22 <23\"\n  },\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"build\": \"npm run build:core && npm run build:web\",\n    \"build:core\": \"tsc -b packages/domain packages/contracts packages/application packages/memory-store packages/file-store packages/sqlite-store packages/postgres-store apps/api\",\n    \"build:web\": \"ng build rewrite-app-web\",\n    \"ci\": \"npm run typecheck && npm run test:unit && npm run build && npm run test:compatibility:built && npm run test:integration && npm run smoke:startup:sqlite && FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/preflight-ci.sqlite npm run db:migrate:sqlite:built && FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/preflight-ci.sqlite RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=false npm run preflight:runtime:built && npm run smoke:shutdown:sqlite && npm run smoke:ui && npm run smoke:ui:operator-auth && npm run smoke:local-demo\",\n    \"ci:static\": \"npm run typecheck && npm run test:unit && npm run build && FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/preflight-ci-static.sqlite npm run db:migrate:sqlite:built && FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/preflight-ci-static.sqlite RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=false npm run preflight:runtime:built\",\n    \"ci:storage\": \"npm run test:integration && npm run smoke:startup:file && npm run smoke:shutdown:file && npm run smoke:startup:sqlite && npm run smoke:shutdown:sqlite\",\n    \"ci:browser:quick\": \"npm run build && npm run smoke:ui:bug-report:built && npm run smoke:ui:offline-shell:built && npm run smoke:ui:system-check:built && npm run smoke:ui:content:built && npm run smoke:ui:json-roster:built && npm run smoke:ui:participant-entry:built && npm run smoke:ui:participant-review:built && npm run smoke:ui:proof-of-work:built && npm run smoke:ui:verona-player:built && npm run smoke:ui:ib-player:built && npm run smoke:ui:activation-roster-warnings:built\",\n    \"ci:browser:review\": \"npm run build && npm run smoke:ui:review-readiness:built && npm run smoke:ui:monitor-review:built && npm run smoke:ui:monitor-detail-review:built && npm run smoke:ui:run-detail-review:built && npm run smoke:ui:unit-detail-review:built && npm run smoke:ui:participant-detail-review:built\",\n    \"ci:browser:monitor\": \"npm run build && npm run smoke:ui:participant-monitor-live:built && npm run smoke:ui:monitor-bulk:built && npm run smoke:ui:monitor-auto-next:built && npm run smoke:ui:monitor-finish-all:built && npm run smoke:ui:open-run-sync:built && npm run smoke:ui:activation-blocking-runtime:built\",\n    \"ci:browser:ops\": \"npm run build && npm run smoke:ui:delete-group-results:built && npm run smoke:ui:admin-workspace-access:built && npm run smoke:ui:admin-delete:built && npm run smoke:ui:workspace-rename:built && npm run smoke:ui:workspace-delete:built && npm run smoke:ui:operator-auth:built\",\n    \"ci:deployability\": \"npm run build && FIRST_SLICE_STORE=file FIRST_SLICE_FILE=./.data/deployability-ci.json npm run db:migrate:file:built && FIRST_SLICE_STORE=file FIRST_SLICE_FILE=./.data/deployability-ci.json npm run db:doctor:file:built && APP_BUILD_SHA=${APP_BUILD_SHA:-local-deployability} APP_BUILD_TIMESTAMP=${APP_BUILD_TIMESTAMP:-1970-01-01T00:00:00Z} FIRST_SLICE_STORE=file FIRST_SLICE_FILE=./.data/deployability-ci.json RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=true npm run preflight:runtime:built && FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/deployability-ci.sqlite npm run db:migrate:sqlite:built && APP_BUILD_SHA=${APP_BUILD_SHA:-local-deployability} APP_BUILD_TIMESTAMP=${APP_BUILD_TIMESTAMP:-1970-01-01T00:00:00Z} FIRST_SLICE_STORE=sqlite FIRST_SLICE_SQLITE_FILE=./.data/deployability-ci.sqlite RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=true npm run preflight:runtime