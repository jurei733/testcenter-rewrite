{"timestamp":"2026-10-08T04:56:52.422Z","ordinal":95009,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a07cfb-af30-7a62-8a81-f821103d611a","turn_id":"01a1199d-3152-75c1-89b7-3e60b92f4af5","item":{"type":"CommandExecution","id":"exec-ba720a29-1ba8-447e-86d6-6e2b4ebb4b3f","process_id":"41905","command":["/bin/zsh","-c","cat /tmp/playwright-test-controller-radio-matrix-20261008.js"],"cwd":"file:///Users/julian/Documents/Codex/2026-08-13/arbeite-im-repo-users-julian-code","parsed_cmd":[{"type":"read","cmd":"cat /tmp/playwright-test-controller-radio-matrix-20261008.js","name":"playwright-test-controller-radio-matrix-20261008.js","path":"/tmp/playwright-test-controller-radio-matrix-20261008.js"}],"source":"unified_exec_startup","status":"completed","stdout":"const TARGET_FRONTEND_ROOT = process.env.TARGET_FRONTEND_ROOT;\nif (!TARGET_FRONTEND_ROOT) throw new Error('Immutable production frontend required.');\n(async () => {\n  const { readFile, mkdtemp } = require('node:fs/promises');\n  const { tmpdir } = require('node:os');\n  const { join } = require('node:path');\n  const { pathToFileURL } = require('node:url');\n  const projectRoot = '/Users/julian/code/testcenter-rewrite/rewrite-app';\n  process.chdir(projectRoot);\n  const artifacts = await mkdtemp(join(tmpdir(), 'testcenter-controller-radio-matrix-'));\n  console.log(`owned_radio_artifacts=${artifacts}`);\n  const source = await readFile(join(projectRoot, 'scripts/smoke-ui.mjs'), 'utf8');\n  const slice = (start, end) => {\n    const from = source.indexOf(start);\n    const to = source.indexOf(end, from + start.length);\n    if (from < 0 || to < 0) throw new Error(`Actual smoke section missing: ${start}`);\n    return source.slice(from, to);\n  };\n  const common = source.slice(0, source.indexOf('await ensureDataDirectory();'));\n  const controllerSection = slice('  logStep(\"participant-original-test-controller\");', '  const enterOriginalControllerTimedTestlet = async');\n  const controllerCases = process.env.RADIO_SCOPE === 'single'\n    ? slice('  await runOriginalControllerCompletenessCase({\\n    loginKey: \"REDACTED\"',\n      '  await runOriginalControllerCompletenessCase({\\n    loginKey: \"REDACTED\"')\n    : slice('  await runOriginalControllerCompletenessCase({\\n    loginKey: \"Test_Ctrl-18\"',\n      '  const hotReturnTimedController =');\n  const diagnosticSection = controllerSection.replace(\n    '  const completeOriginalControllerUnit = async frame => {',\n    '  const completeOriginalControllerUnit = async frame => {\\n    await diagnoseRadio(frame);'\n  );\n  if (diagnosticSection === controllerSection) throw new Error('Radio diagnostic marker missing.');\n  const setup = `\nconst ownedArtifacts = ${JSON.stringify(artifacts)};\nprocess.env.FIRST_SLICE_SQLITE_FILE = resolve(ownedArtifacts, 'owned.sqlite');\nconst port = await allocatePort();\nconst baseUrl = 'http://127.0.0.1:' + port;\nconst child = spawn(process.execPath, [serverEntry], {\n  cwd: ${JSON.stringify(TARGET_FRONTEND_ROOT)}, stdio: 'inherit',\n  env: { ...process.env, PORT: String(port), FIRST_SLICE_STORE: 'sqlite',\n    FIRST_SLICE_OPERATOR_AUTH_REQUIRED: 'true', FIRST_SLICE_BOOTSTRAP_DEMO: 'true', FIRST_SLICE_XML_SCHEMA_PROFILE: 'legacy-compatibility' }\n});\nlet browser;\nlet context;\nlet page;\ntry {\n  await pollJson(baseUrl + '/readyz');\n  const signedIn = await fetchAdminSignIn(baseUrl, 'demo-admin', 'demo-admin-password');\n  assert.equal(signedIn.status, 200);\n  smokeAdminSessionToken = (await signedIn.json()).sessionToken;\n  assert.ok(smokeAdminSessionToken);\n  browser = await chromium.launch({ headless: false, channel: process.env.RADIO_BROWSER_CHANNEL || 'chrome' });\n  console.log('radio_browser=' + browser.version());\n  context = await browser.newContext();\n  participantHttpActor.observeContext(context);\n  await context.tracing.start({ screenshots: true, snapshots: true, sources: true });\n  await context.addInitScript(() => {\n    const docId = Math.random().toString(36).slice(2);\n    for (const type of ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click', 'input', 'change']) {\n      document.addEventListener(type, event => {\n        const target = event.target;\n        if (type === 'click' || target?.matches?.('input[type=radio]') || target?.closest?.('#next-page')) {\n          console.log('radio-diag-event=' + JSON.stringify({ docId, type, trusted: event.isTrusted,\n            tag: target.tagName, id: target.id, cy: target.getAttribute('data-cy'), checked: target.checked,\n            x: event.clientX, y: event.clientY, ready: document.readyState }));\n        }\n      }, { capture: true, passive: true });\n    }\n  });\n  page = await context.newPage();\n  page.on('console', message => { if (message.text().startsWith('radio-diag')) console.log(message.text()); });\n  page.on('framenavigated', frame => { if (frame !== page.mainFrame()) console.log('radio-frame-navigation=' + frame.url().slice(0, 80)); });\n  page.on('pageerror', error => console.error('radio-page-error=' + error.message));\n  let operatorLeaks = 0;\n  page.on('request', request => {\n    if (request.url().startsWith(baseUrl + '/api/v1/participant/') && request.headers().authorization === 'Bearer ' + smokeAdminSessionToken) operatorLeaks++;\n    if (request.url().includes('/save-progress')) console.log('radio-save=' + (request.postData() || '').slice(0, 1800));\n  });\n  await page.goto(baseUrl + '/app/participant', { waitUntil: 'domcontentloaded' });\n  const tenantKey = 'controller-radio-' + Date.now();\n  const workspaceKey = tenantKey;\n  const logStep = step => console.log('radio_step=' + step);\n  const expectButtonSelectorEnabled = async selector => {\n    await page.locator(selector).waitFor();\n    await page.waitForFunction(selector => !document.querySelector(selector)?.disabled, selector);\n    assert.equal(await page.locator(selector).isEnabled(), true);\n  };\n  const fillAndCommit = async (selector, value) => { await page.locator(selector).fill(value); await page.locator(selector).press('Tab'); };\n  const originalCorpusRoot = resolve('test-fixtures/original-testcenter');\n  const officialProtocolCorpus = JSON.parse(await readFile(resolve(originalCorpusRoot, 'corpus.json'), 'utf8'));\n  const diagnoseRadio = async frame => {\n    const radio = frame.locator('[data-cy=\"TestController-radio1-Aufg1\"]');\n    const handle = await radio.elementHandle();\n    console.log('radio_diag_before=' + JSON.stringify({\n      box: await radio.boundingBox(),\n      host: await page.locator('#participantVeronaPlayerFrame').evaluate(element => {\n        const r = element.getBoundingClientRect();\n        return { rect: r.toJSON(), scrollY, viewport: [innerWidth, innerHeight],\n          hit: document.elementFromPoint(r.x + 15, Math.max(1, r.y + 15))?.tagName,\n          style: { zoom: getComputedStyle(element).zoom, transform: getComputedStyle(element).transform },\n          srcdocLength: element.srcdoc.length };\n      }),\n      inner: await radio.evaluate(element => { const r = element.getBoundingClientRect();\n        return { rect: r.toJSON(), scrollY, viewport: [innerWidth, innerHeight], checked: element.checked,\n          count: document.querySelectorAll('[data-cy=\"TestController-radio1-Aufg1\"]').length,\n          hit: document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2)?.outerHTML.slice(0, 250),\n          style: { zoom: getComputedStyle(element).zoom, transform: getComputedStyle(element).transform } }; })\n    }));\n    radioDiagnosticHandle = handle;\n  };\n  let radioDiagnosticHandle;\n`;\n  const run = `\n  ${controllerCases}\n  assert.equal(operatorLeaks, 0);\n  console.log('radio_actual_cases_passed=true');\n} catch (error) {\n  console.error('radio_actual_failure=' + error.message);\n  if (page) {\n    await page.screenshot({ path: resolve(ownedArtifacts, 'failure.png'), fullPage: true }).catch(() => {});\n    const frame = page.frameLocator('#participantVeronaPlayerFrame');\n    console.log('radio_diag_after=' + JSON.stringify(await frame.locator('[data-cy=\"TestController-radio1-Aufg1\"]').evaluate(element => ({\n      checked: element.checked, outer: element.outerHTML, rect: element.getBoundingClientRect().toJSON(),\n      viewport: [innerWidth, innerHeight], scrollY,\n      body: document.body.textContent.slice(0, 500) })).catch(e => ({ error: e.message }))));\n  }\n  throw error;\n} finally {\n  if (context) await context.tracing.stop({ path: resolve(ownedArtifacts, 'trace.zip') });\n  if (browser) await browser.close();\n  await stopChild(child);\n}\n`;\n  let moduleSource = common + setup + diagnosticSection + run;\n  moduleSource = moduleSource.replace(/from \"\\.\\/([^\"\\n]+)\"/g, (_, file) => `from ${JSON.stringify(pathToFileURL(join(projectRoot, 'scripts', file)).href)}`);\n  moduleSource = moduleSource.replace('from \"playwright\"', `from ${JSON.stringify(pathToFileURL(require.resolve('playwright', { paths: [projectRoot] }).replace(/index\\.js$/, 'index.mjs')).href)}`);\n  moduleSource = moduleSource.replace('from \"qrcode\"', `from ${JSON.stringify(pathToFileURL(require.resolve('qrcode', { paths: [projectRoot] })).href)}`);\n  await import('data:text/javascript;base64,' + Buffer.from(moduleSource).toString('base64'));\n})().catch(error => { console.error(error.message); process.exitCode = 1; });\n","stderr":"","aggregated_output":"const TARGET_FRONTEND_ROOT = process.env.TARGET_FRONTEND_ROOT;\nif (!TARGET_FRONTEND_ROOT) throw new Error('Immutable production frontend required.');\n(async () => {\n  const { readFile, mkdtemp } = require('node:fs/promises');\n  const { tmpdir } = require('node:os');\n  const { join } = require('node:path');\n  const { pathToFileURL } = require('node:url');\n  const projectRoot = '/Users/julian/code/testcenter-rewrite/rewrite-app';\n  process.chdir(projectRoot);\n  const artifacts = await mkdtemp(join(tmpdir(), 'testcenter-controller-radio-matrix-'));\n  console.log(`owned_radio_artifacts=${artifacts}`);\n  const source = await readFile(join(projectRoot, 'scripts/smoke-ui.mjs'), 'utf8');\n  const slice = (start, end) => {\n    const from = source.indexOf(start);\n    const to = source.indexOf(end, from + start.length);\n    if (from < 0 || to < 0) throw new Error(`Actual smoke section missing: ${start}`);\n    return source.slice(from, to);\n  };\n  const common = source.slice(0, source.indexOf('await ensureDataDirectory();'));\n  const controllerSection = slice('  logStep(\"participant-original-test-controller\");', '  const enterOriginalControllerTimedTestlet = async');\n  const controllerCases = process.env.RADIO_SCOPE === 'single'\n    ? slice('  await runOriginalControllerCompletenessCase({\\n    loginKey: \"REDACTED\"',\n      '  await runOriginalControllerCompletenessCase({\\n    loginKey: \"REDACTED\"')\n    : slice('  await runOriginalControllerCompletenessCase({\\n    loginKey: \"Test_Ctrl-18\"',\n      '  const hotReturnTimedController =');\n  const diagnosticSection = controllerSection.replace(\n    '  const completeOriginalControllerUnit = async frame => {',\n    '  const completeOriginalControllerUnit = async frame => {\\n    await diagnoseRadio(frame);'\n  );\n  if (diagnosticSection === controllerSection) throw new Error('Radio diagnostic marker missing.');\n  const setup = `\nconst ownedArtifacts = ${JSON.stringify(artifacts)};\nprocess.env.FIRST_SLICE_SQLITE_FILE = resolve(ownedArtifacts, 'owned.sqlite');\nconst port = await allocatePort();\nconst baseUrl = 'http://127.0.0.1:' + port;\nconst child = spawn(process.execPath, [serverEntry], {\n  cwd: ${JSON.stringify(TARGET_FRONTEND_ROOT)}, stdio: 'inherit',\n  env: { ...process.env, PORT: String(port), FIRST_SLICE_STORE: 'sqlite',\n    FIRST_SLICE_OPERATOR_AUTH_REQUIRED: 'true', FIRST_SLICE_BOOTSTRAP_DEMO: 'true', FIRST_SLICE_XML_SCHEMA_PROFILE: 'legacy-compatibility' }\n});\nlet browser;\nlet context;\nlet page;\ntry {\n  await pollJson(baseUrl + '/readyz');\n  const signedIn = await fetchAdminSignIn(baseUrl, 'demo-admin', 'demo-admin-password');\n  assert.equal(signedIn.status, 200);\n  smokeAdminSessionToken = (await signedIn.json()).sessionToken;\n  assert.ok(smokeAdminSessionToken);\n  browser = await chromium.launch({ headless: false, channel: process.env.RADIO_BROWSER_CHANNEL || 'chrome' });\n  console.log('radio_browser=' + browser.version());\n  context = await browser.newContext();\n  participantHttpActor.observeContext(context);\n  await context.tracing.start({ screenshots: true, snapshots: true, sources: true });\n  await context.addInitScript(() => {\n    const docId = Math.random().toString(36).slice(2);\n    for (const type of ['pointerdown', 'mousedown', 'pointerup', 'mouseup', 'click', 'input', 'change']) {\n      document.addEventListener(type, event => {\n        const target = event.target;\n        if (type === 'click' || target?.matches?.('input[type=radio]') || target?.closest?.('#next-page')) {\n          console.log('radio-diag-event=' + JSON.stringify({ docId, type, trusted: event.isTrusted,\n            tag: target.tagName, id: target.id, cy: target.getAttribute('data-cy'), checked: target.checked,\n            x: event.clientX, y: event.clientY, ready: document.readyState }));\n        }\n      }, { capture: true, passive: true });\n    }\n  });\n  page = await context.newPage();\n  page.on('console', message => { if (message.text().startsWith('radio-diag')) console.log(message.text()); });\n  page.on('framenavigated', frame => { if (frame !== page.mainFrame()) console.log('radio-frame-navigation=' + frame.url().slice(0, 80)); });\n  page.on('pageerror', error => console.error('radio-page-error=' + error.message));\n  let operatorLeaks = 0;\n  page.on('request', request => {\n    if (request.url().startsWith(baseUrl + '/api/v1/participant/') && request.headers().authorization === 'Bearer ' + smokeAdminSessionToken) operatorLeaks++;\n    if (request.url().includes('/save-progress')) console.log('radio-save=' + (request.postData() || '').slice(0, 1800));\n  });\n  await page.goto(baseUrl + '/app/participant', { waitUntil: 'domcontentloaded' });\n  const tenantKey = 'controller-radio-' + Date.now();\n  const workspaceKey = tenantKey;\n  const logStep = step => console.log('radio_step=' + step);\n  const expectButtonSelectorEnabled = async selector => {\n    await page.locator(selector).waitFor();\n    await page.waitForFunction(selector => !document.querySelector(selector)?.disabled, selector);\n    assert.equal(await page.locator(selector).isEnabled(), true);\n  };\n  const fillAndCommit = async (selector, value) => { await page.locator(selector).fill(value); await page.locator(selector).press('Tab'); };\n  const originalCorpusRoot = resolve('test-fixtures/original-testcenter');\n  const officialProtocolCorpus = JSON.parse(await readFile(resolve(originalCorpusRoot, 'corpus.json'), 'utf8'));\n  const diagnoseRadio = async frame => {\n    const radio = frame.locator('[data-cy=\"TestController-radio1-Aufg1\"]');\n    const handle = await radio.elementHandle();\n    console.log('radio_diag_before=' + JSON.stringify({\n      box: await radio.boundingBox(),\n      host: await page.locator('#participantVeronaPlayerFrame').evaluate(element => {\n        const r = element.getBoundingClientRect();\n        return { rect: r.toJSON(), scrollY, viewport: [innerWidth, innerHeight],\n          hit: document.elementFromPoint(r.x + 15, Math.max(1, r.y + 15))?.tagName,\n          style: { zoom: getComputedStyle(element).zoom, transform: getComputedStyle(element).transform },\n          srcdocLength: element.srcdoc.length };\n      }),\n      inner: await radio.evaluate(element => { const r = element.getBoundingClientRect();\n        return { rect: r.toJSON(), scrollY, viewport: [innerWidth, innerHeight], checked: element.checked,\n          count: document.querySelectorAll('[data-cy=\"TestController-radio1-Aufg1\"]').length,\n          hit: document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2)?.outerHTML.slice(0, 250),\n          style: { zoom: getComputedStyle(element).zoom, transform: getComputedStyle(element).transform } }; })\n    }));\n    radioDiagnosticHandle = handle;\n  };\n  let radioDiagnosticHandle;\n`;\n  const run = `\n  ${controllerCases}\n  assert.equal(operatorLeaks, 0);\n  console.log('radio_actual_cases_passed=true');\n} catch (error) {\n  console.error('radio_actual_failure=' + error.message);\n  if (page) {\n    await page.screenshot({ path: resolve(ownedArtifacts, 'failure.png'), fullPage: true }).catch(() => {});\n    const frame = page.frameLocator('#participantVeronaPlayerFrame');\n    console.log('radio_diag_after=' + JSON.stringify(await frame.locator('[data-cy=\"TestController-radio1-Aufg1\"]').evaluate(element => ({\n      checked: element.checked, outer: element.outerHTML, rect: element.getBoundingClientRect().toJSON(),\n      viewport: [innerWidth, innerHeight], scrollY,\n      body: document.body.textContent.slice(0, 500) })).catch(e => ({ error: e.message }))));\n  }\n  throw error;\n} finally {\n  if (context) await context.tracing.stop({ path: resolve(ownedArtifacts, 'trace.zip') });\n  if (browser) await browser.close();\n  await stopChild(child);\n}\n`;\n  let moduleSource = common + setup + diagnosticSection + run;\n  moduleSource = moduleSource.replace(/from \"\\.\\/([^\"\\n]+)\"/g, (_, file) => `from ${JSON.stringify(pathToFileURL(join(projectRoot, 'scripts', file)).href)}`);\n  moduleSource = moduleSource.replace('from \"playwright\"', `from ${JSON.stringify(pathToFileURL(require.resolve('playwright', { paths: [projectRoot] }).replace(/index\\.js$/, 'index.mjs')).href)}`);\n  moduleSource = moduleSource.replace('from \"qrcode\"', `from ${JSON.stringify(pathToFileURL(require.resolve('qrcode', { paths: [projectRoot] })).href)}`);\n  await import('data:text/javascript;base64,' + Buffer.from(moduleSource).toString('base64'));\n})().catch(error => { console.error(error.message); process.exitCode = 1; }