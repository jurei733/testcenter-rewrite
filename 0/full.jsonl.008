height: 100%; min-height: 0; }\n.is-original-player .verona-player-frame { height: 100%; min-height: 0; }\n.is-original-player .participant-review-panel,\n.is-original-player .unit-rail {\n  margin: 0;\n  padding: 15px;\n  border: 0;\n  border-radius: 0;\n  background: white;\n}\n.is-original-player .unit-rail-grid { grid-template-columns: 1fr; }\n.is-original-player .unit-chip { max-width: 100%; }\n.is-original-player .form-grid { grid-template-columns: 1fr; }\n.original-player-menu { font-family: 'Nunito Sans', sans-serif; }\n@use '@angular/material' as mat;\n@use './original-base-palettes' as palettes;\n\n@mixin apply() {\n  @include mat.theme((\n    color: (primary: palettes.$primary-palette, tertiary: palettes.$tertiary-palette),\n    typography: 'Nunito Sans',\n    density: 0\n  ));\n  --mat-sys-primary: var(--secondary);\n  --mat-sys-secondary: var(--secondary-soft);\n  --mat-sys-on-primary: #fff;\n  --mat-sys-primary-container: #fff;\n  --mat-sys-on-secondary-container: var(--secondary);\n  --mat-sys-surface: #fff;\n  --mat-sys-surface-container: #fff;\n  --mat-sys-outline-variant: var(--secondary);\n  @include mat.button-overrides((filled-container-shape: 10px, tonal-container-shape: 10px, outlined-container-shape: 10px));\n}\n"},"started_at_ms":1791437806833,"completed_at_ms":1791437806833}}
