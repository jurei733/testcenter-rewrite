tNavigationRequest(unitNavigationTarget.NEXT)\\\">\\n    </tc-navigation-control>\\n  }\\n  @if (tcs.booklet?.config?.navbar_page_label !== 'HIDDEN' && (pageNavContext.maxIndex > 0) && !isLoading) {\\n    <tc-navigation-control [navContext]=\\\"pageNavContext\\\"\\n                           dataCy=\\\"page-navigation\\\"\\n                           (back)=\\\"gotoPreviousPage()\\\"\\n                           (forward)=\\\"gotoNextPage()\\\">\\n    </tc-navigation-control>\\n  }\\n\\n  @if (showGlobalForward && !isLoading) {\\n    <button matButton=\\\"tonal\\\" class=\\\"nav-button\\\" data-cy=\\\"separate-unit-forward-button\\\"\\n            [disabled]=\\\"!unitNavContext.isForwardAllowed && !pageNavContext.isForwardAllowed\\\"\\n            (click)=\\\"onNavForward()\\\">\\n      Weiter\\n      <mat-icon svgIcon=\\\"chevron_right\\\" iconPositionEnd></mat-icon>\\n    </button>\\n  }\\n</div>\\n\\n@if (!isLoading) {\\n  <div class=\\\"toolbar-header flex-row\\\" data-cy=\\\"unit-screenheader\\\">\\n    @if (tcs.booklet?.config?.toolbar_unit_label !== 'HIDDEN') {\\n      <p data-cy=\\\"unit-title\\\">{{toolbarUnitLabel}}</p>\\n    }\\n\\n    <div class=\\\"toolbar-right\\\" data-cy=\\\"toolbar-right\\\">\\n      @if ((tcs.testMode.showTimeLeft || tcs.booklet?.config?.toolbar_show_time_left === 'TRUE') && timerValue) {\\n        <p data-cy=\\\"time-value\\\">Verbleibende Zeit: {{timerValue.timeLeftString}}</p>\\n      }\\n\\n      @if (tcs.testMode.canReview) {\\n        <button mat-button matTooltip=\\\"Kommentar verfassen\\\" data-cy=\\\"send-comments\\\"\\n                (click)=\\\"sideNavContent = 'review-form'; sidenav.toggle()\\\">\\n          <mat-icon svgIcon=\\\"rate_review\\\"></mat-icon>\\n          Kommentare\\n        </button>\\n      }\\n\\n      @if (tcs.booklet?.config?.toolbar_show_unit_list === 'TRUE' || tcs.testMode.showUnitMenu) {\\n        <button matButton data-cy=\\\"unit-menu\\\"\\n                (click)=\\\"sideNavContent = 'unit-menu'; sidenav.toggle()\\\">\\n          <mat-icon svgIcon=\\\"clock_loader_60\\\"></mat-icon>\\n          Bearbeitungsstand\\n        </button>\\n      }\\n\\n      @if (!(tcs.booklet?.config?.toolbar_show_fullscreen_button === 'FALSE' &&\\n             tcs.booklet?.config?.toolbar_show_reload_button === 'FALSE')) {\\n        <button matIconButton class=\\\"menu-button\\\" [matMenuTriggerFor]=\\\"menu\\\">\\n          <mat-icon svgIcon=\\\"more_vert\\\"></mat-icon>\\n        </button>\\n        <mat-menu #menu=\\\"matMenu\\\">\\n          @if (tcs.booklet?.config?.toolbar_show_fullscreen_button !== 'FALSE') {\\n            <button mat-menu-item (click)=\\\"toggleFullScreen()\\\" data-cy=\\\"fullscreen\\\">\\n              <mat-icon svgIcon=\\\"arrows_output\\\"></mat-icon>\\n              <span>Vollbild</span>\\n            </button>\\n          }\\n          @if (tcs.booklet?.config?.toolbar_show_reload_button !== 'FALSE') {\\n            <button mat-menu-item (click)=\\\"reload()\\\" data-cy=\\\"reloadPage\\\">\\n              <mat-icon svgIcon=\\\"autorenew\\\"></mat-icon>\\n              <span>Neu laden</span>\\n            </button>\\n          }\\n        </mat-menu>\\n      }\\n    </div>\\n  </div>\\n}\\n\\n<mat-sidenav-container>\\n  <mat-sidenav #sidenav mode=\\\"over\\\" position=\\\"end\\\" opened=\\\"false\\\" (openedStart)=\\\"reviewComponent?.onOpen()\\\">\\n    @if (sideNavContent === 'review-form') {\\n      <tc-review-panel (close)=\\\"sidenav.close()\\\"></tc-review-panel>\\n    } @else {\\n      <tc-unit-menu (close)=\\\"sidenav.close()\\\"></tc-unit-menu>\\n    }\\n  </mat-sidenav>\\n\\n  <mat-sidenav-content>\\n    <router-outlet></router-outlet>\\n    @if (isLoading) {\\n      <div class=\\\"loading-overlay\\\">\\n        <tc-loading-progress [progress]=\\\"tcs.totalLoadingProgress\\\" heading=\\\"Gleich geht's los!\\\"></tc-loading-progress>\\n      </div>\\n    }\\n  </mat-sidenav-content>\\n\\n</mat-sidenav-container>\\n\"}"},{"type":"input_t