enter-original-welcome-production-final-smoke.log\n.data/original-welcome-reference-20261004/testcenter-original-welcome-reference-isolated-development.log\n.data/original-welcome-reference-20261004/testcenter-original-welcome-all-units.log\n.data/original-login-reference-20261004/testcenter-original-login-development-smoke.log\n","stderr":"","aggregated_output":".data/integration-sqlite.sqlite.82461.original-group-monitor.sqlite\n.data/integration-sqlite.sqlite.82461.original-test-controller.sqlite\n.data/first-slice.sqlite.7565.original-test-controller.sqlite\n.data/integration-file.json.81385.original-group-monitor\n.data/original-system-check-2-file-20260803.json\n.data/integration-sqlite.sqlite.27896.original-group-monitor.sqlite\n.data/integration-file.json.95754.current-original-booklet-config\n.data/run-selection-20261005.G48v9l/testcenter-participant-variant-ehn4Y6/original-resumed.png\n.data/integration-sqlite.sqlite.26218.current-original-booklet-config.sqlite\n.data/run-selection-20261005.G48v9l/testcenter-participant-presence-browser-kBEGbw/original-1280-lost.png\n.data/run-selection-20261005.G48v9l/testcenter-participant-presence-browser-kBEGbw/original-390-lost.png\n.data/run-selection-20261005.G48v9l/testcenter-participant-variant-AKfPCo/original-resumed.png\n.data/original-group-monitor-sqlite-20260803.sqlite.55700.original-group-monitor.sqlite\n.data/integration-file.json.95754.original-test-controller\n.data/run-selection-20261005.G48v9l/testcenter-participant-variant-GT3Oea/original-resumed.png\n.data/original-welcome-reference-20261004/testcenter-original-welcome-development-final-smoke.log\n.data/original-welcome-reference-20261004/testcenter-original-welcome-production-final-smoke.log\n.data/original-welcome-reference-20261004/testcenter-original-welcome-reference-isolated-development.log\n.data/original-welcome-reference-20261004/testcenter-original-welcome-all-units.log\n.data/original-login-reference-20261004/testcenter-original-login-devel