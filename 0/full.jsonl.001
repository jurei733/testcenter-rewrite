{"timestamp":"2026-10-29T07:45:38.007Z","ordinal":12863,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_072bdb5bd672bfb7016ae2f9860a8881919b3d7353d7ba6e80","status":"completed","call_id":"call_34abda367506443d8b520c11dcea1162","name":"exec","input":"text(await tools.exec_command({cmd:\"python3 - <<'PY'\\nfrom pathlib import Path\\np=Path('scripts/native-monitor-lifecycle.test.mjs');s=p.read_text().replace('function managerFixture(){\\\\n const controller=new AbortController(),streams=new Map(),writes=[];', 'function managerFixture(controller=new AbortController()){\\\\n const streams=new Map(),writes=[];');p.write_text(s+'''\\nfor(const stage of ['lock','terminate'])test('finish retries exact owned targets after a lost '+stage+' response',t=>{\\n clock(t);const f=managerFixture();f.manager.connect('A');\\n let rows=[finishPacket('9007199254740993'),finishPacket('9007199254740994',{status:'locked'})];\\n f.backend.getSessionsMonitor=()=>rx.of(rows);const failure=Error('Owned '+stage+' failure');let first=true;\\n const write=f.backend[stage==='lock'?'lock':'command'];f.backend[stage==='lock'?'lock':'command']=function(...args){\\n  const result=write.apply(this,args);if(first){first=false;return rx.throwError(()=>failure);}return result;\\n };\\n let seen,completed=false;f.manager.commandFinishEverything().subscribe({next:()=>{completed=true;},error:error=>{seen=error;}});\\n t.mock.timers.tick(1500);assert.equal(seen,failure);assert.equal(completed,false);\\n rows=rows.map(row=>({...row,testState:{...row.testState,status:'locked'}}));\\n f.manager.commandFinishEverything().subscribe({next:()=>{completed=true;}});assert.equal(completed,false);t.mock.timers.tick(1500);\\n assert.equal(completed,true);assert.deepEqual(f.writes.at(-1),{type:'terminate',args:['lock'],ids:['9007199254740993']});f.manager.disconnect();\\n});\\ntest('an interrupted finish retains its exact targets across manager retirement in the same access',t=>{\\n clock(t);const f=managerFixture();f.manager.connect('A');f.backend.getSessionsMonitor=()=>rx.of([finishPacket('9007199254740993')]);\\n const sub=f.manager.commandFinishEverything().subscribe();sub.unsubscribe();f.manager.disconnect();t.mock.timers.tick(2000);assert.equal(f.writes.length,1);\\n const next=managerFixture(f.controller);next.manager.connect('A');next.backend.getSessionsMonitor=()=>rx.of([finishPacket('9007199254740993',{status:'locked'}),finishPacket('9007199254740994',{status:'locked'})]);\\n next.manager.commandFinishEverything().subscribe();t.mock.timers.tick(1500);assert.deepEqual(next.writes.at(-1).ids,['9007199254740993']);next.manager.disconnect();\\n});\\ntest('a finish recovery plan cannot cross a native access replacement',t=>{\\n clock(t);const old=managerFixture();old.manager.connect('A');old.backend.getSessionsMonitor=()=>rx.of([finishPacket('9007199254740993')]);old.manager.commandFinishEverything().subscribe();old.controller.abort();old.manager.disconnect();\\n const next=managerFixture();next.manager.connect('A');next.backend.getSessionsMonitor=()=>rx.of([finishPacket('9007199254740993',{status:'locked'})]);next.manager.commandFinishEverything().subscribe();t.mock.timers.tick(1500);assert.deepEqual(next.writes.at(-1).ids,[]);assert.equal(old.writes.length,1);next.manager.disconnect();\\n});\\ntest('recovery excludes targets now terminated or pending and never broadens to unrelated locked tests',t=>{\\n clock(t);const f=managerFixture();f.manager.connect('A');f.backend.getSessionsMonitor=()=>rx.of([finishPacket('1'),finishPacket('2')]);const sub=f.manager.commandFinishEverything().subscribe();sub.unsubscribe();\\n f.backend.getSessionsMonitor=()=>rx.of([finishPacket('1',{status:'locked',CONTROLLER:'TERMINATED'}),finishPacket('2',{status:'pending'}),finishPacket('3',{status:'locked'})]);\\n f.manager.commandFinishEverything().subscribe();t.mock.timers.tick(1500);assert.deepEqual(f.writes.at(-1).ids,[]);f.manager.disconnect();\\n});\\n''')\\np=Path('scripts/native-monitor-session.test.mjs');s=p.read_text();s=s.replace(\\\"code=code.replaceAll(\\\\\\\"'@angular/core'\\\\\\\",JSON.stringify(import.meta.resolve('@angular/core')));\\\", \\\"code=code.replaceAll(\\\\\\\"'@angular/core'\\\\\\\",JSON.stringify(import.meta.resolve('@angular/core'))).replace(\\\\\\\"import('altcha-lib')\\\\\\\",'Promise.resolve(globalThis.__nativeMonitorChallengeFixture)');\\\");p.write_text(s+'''\\ntest('retiring a login owner rejects late credentials and revokes only its orphan access',()=>fixture(async values=>{\\n const pending=deferred(),requests=[],owner=new AbortController();globalThis.fetch=async(path,options)=>{requests.push({path,options});return options.method==='DELETE'?response(''):pending.promise;};\\n const session=new NativeMonitorSessionService(),login=session.login('owned','REDACTED',owner.signal),rejected=assert.rejects(login);owner.abort();assert.equal(session.busy(),false);\\n pending.resolve(response(access('orphan')));await rejected;assert.equal(session.access(),null);assert.equal(values.has(storageKey),false);assert.equal(session.problem(),'');\\n assert.deepEqual(requests.filter(r=>r.options.method==='DELETE').map(r=>r.options.headers.AuthToken),['orphan']);\\n}));\\ntest('a retired credential failure cannot start proof-of-work or change replacement login state',()=>fixture(async()=>{\\n const old=deferred(),current=deferred(),owner=new AbortController(),requests=[];globalThis.fetch=async(path,options)=>{requests.push(path);return requests.length===1?old.promise:current.promise;};\\n const session=new NativeMonitorSessionService(),oldLogin=session.login('old','REDACTED',owner.signal),oldRejected=assert.rejects(oldLogin);\\n const next=session.login('current','REDACTED');owner.abort();old.resolve(response('Brute Force protection active',400));await oldRejected;\\n assert.equal(session.busy(),true);assert.equal(session.problem(),'');assert.deepEqual(requests,['/session/login','/session/login']);\\n current.resolve(response(access('current')));await next;assert.equal(session.access().token,'current');assert.equal(session.problem(),'');\\n}));\\ntest('a late failed login cannot overwrite a newer successful login problem state',()=>fixture(async()=>{\\n const old=deferred();let first=true;globalThis.fetch=async()=>{if(first){first=false;return old.promise;}return response(access('current'));};\\n const session=new NativeMonitorSessionService(),prior=session.login('old','REDACTED'),rejected=assert.rejects(prior);await session.login('current','REDACTED');old.resolve(response('old failure',401));await rejected;\\n assert.equal(session.access().token,'current');assert.equal(session.problem(),'');assert.equal(session.busy(),false);\\n}));\\ntest('retiring a proof-of-work login stops its workers and sends no proof completion',()=>fixture(async()=>{\\n const saved={document:globalThis.document,Worker:globalThis.Worker,solver:globalThis.__nativeMonitorChallengeFixture};\\n const work=deferred(),started=deferred(),workers=[],requests=[];globalThis.document={baseURI:'https://owned.example/'};\\n globalThis.Worker=class{constructor(){this.stopped=false;workers.push(this);}terminate(){this.stopped=true;}};\\n globalThis.__nativeMonitorChallengeFixture={solveChallengeWorkers:(factory)=>{if(typeof factory==='function')factory();started.resolve();return work.promise;}};\\n globalThis.fetch=async(path,options)=>{requests.push({path,method:options.method});return path==='/session/login'?response('Brute Force protection active',400):response({challenge:'owned',salt:'owned',algorithm:'SHA-256',signature:'owned',maxNumber:1});};\\n try{const owner=new AbortController(),session=new NativeMonitorSessionService(),login=session.login('owned','REDACTED',owner.signal),rejected=assert.rejects(login);\\n  await started.promise;owner.abort();work.resolve({number:1});await rejected;assert.ok(workers.length);assert.ok(workers.every(w=>w.stopped));\\n  assert.deepEqual(requests,[{path:'/session/login',method:'PUT'},