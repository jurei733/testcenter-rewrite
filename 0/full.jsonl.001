{"timestamp":"2026-10-29T07:38:22.225Z","ordinal":12816,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a181fb-0089-7a62-ac60-6258f492d54a","turn_id":"01a18695-87cd-7aa0-b257-6c7fc577e31f","item":{"type":"CommandExecution","id":"exec-a6658702-2727-492c-9f13-515ec9740f50","process_id":"62128","command":["/bin/zsh","-lc","sed -n '1,125p' apps/web/src/app/native-monitor/group-monitor/group-monitor.interfaces.ts\nrg -n -A25 -B4 'hasPending|isPending|hasState|isLocked' apps/web/src/app/native-monitor/group-monitor/test-session/test-session.util.ts | head -115\nsed -n '165,195p' scripts/native-monitor-lifecycle.test.mjs\ncat apps/web/src/app/native-monitor/group-monitor/backend.service.ts | tail -72\nrg -n 'solveChallengeWorkers' node_modules/altcha-lib -g '*.d.ts' | head -6\ncat package.json | head -48"],"cwd":"file:///Users/julian/Documents/Codex/2026-10-20/en/work/testcenter-native-monitor-ui/rewrite-app","parsed_cmd":[{"type":"read","cmd":"sed -n '1,125p' apps/web/src/app/native-monitor/group-monitor/group-monitor.interfaces.ts","name":"group-monitor.interfaces.ts","path":"apps/web/src/app/native-monitor/group-monitor/group-monitor.interfaces.ts"},{"type":"search","cmd":"rg -n -A25 -B4 'hasPending|isPending|hasState|isLocked' apps/web/src/app/native-monitor/group-monitor/test-session/test-session.util.ts","query":"hasPending|isPending|hasState|isLocked","path":"test-session.util.ts"},{"type":"read","cmd":"sed -n '165,195p' scripts/native-monitor-lifecycle.test.mjs","name":"native-monitor-lifecycle.test.mjs","path":"scripts/native-monitor-lifecycle.test.mjs"},{"type":"read","cmd":"cat apps/web/src/app/native-monitor/group-monitor/backend.service.ts","name":"backend.service.ts","path":"apps/web/src/app/native-monitor/group-monitor/backend.service.ts"},{"type":"search","cmd":"rg -n solveChallengeWorkers node_modules/altcha-lib -g '*.d.ts'","query":"solveChallengeWorkers","path":"altcha-lib"},{"type":"read","cmd":"cat package.json","name":"package.json","path":"package.json"}],"source":"unified_exec_startup","status":"completed","aggregated_output":"import type { TestSessionChange } from '../common/test-session-change.interface';\nimport type { BookletDef, BookletStateDef, BookletStateOptionDef, TestletDef, UnitDef } from '../shared/shared.module';\n\nexport interface GroupMonitorConfig {\n  checkForIdleInterval: number;\n}\n\nexport type TestSessionData = Readonly<TestSessionChange>;\n\nexport interface TestSession {\n  readonly data: TestSessionData;\n  readonly state: TestSessionSuperState;\n  readonly current: UnitContext | null;\n  readonly booklet: Booklet | BookletError;\n  readonly clearedCodes: string[] | null;\n  readonly timeLeft: Record<string, number> | null;\n  readonly bookletStates: { [state: string]: string } | null;\n}\n\nexport const TestSessionsSuperStates = ['monitor_group', 'demo', 'pending', 'locked', 'error',\n  'controller_terminated', 'connection_lost', 'paused', 'focus_lost', 'idle',\n  'connection_websocket', 'connection_polling', 'ok'] as const;\nexport type TestSessionSuperState = typeof TestSessionsSuperStates[number];\n\nexport type TestViewDisplayOptionKey = keyof TestViewDisplayOptions;\n\n// analogous to GroupMonitorProfileFilterField in Testtakers.xsd\nexport const testSessionFilterTargetLists = {\n  advanced: [\n    'groupName',\n    'bookletId',\n    'blockId',\n    'testState',\n    'mode',\n    'bookletSpecies',\n    'unitId'\n  ],\n  basic: [\n    'bookletLabel',\n    'personLabel',\n    'state',\n    'blockLabel',\n    'unitLabel',\n    'bookletStates'\n  ]\n} as const;\n\nexport const testSessionFilterTargets = [\n  ...testSessionFilterTargetLists.basic,\n  ...testSessionFilterTargetLists.advanced\n] as const;\n\nexport const testSessionFilterTypeLists = {\n  basic: ['substring', 'equal'],\n  advanced: ['regex']\n} as const;\n\nexport const testSessionFilterTypes = [\n  ...testSessionFilterTypeLists.basic,\n  ...testSessionFilterTypeLists.advanced\n] as const;\n\nexport type TestSessionFilterType = (typeof testSessionFilterTypes)[number];\n\nexport type TestSessionFilterTarget = (typeof testSessionFilterTargets)[number];\n\nexport interface TestSessionFilter {\n  target: TestSessionFilterTarget;\n  value: string | string[];\n  id: string;\n  label: string;\n  subValue?: string;\n  type: TestSessionFilterType;\n  not: boolean;\n}\n\nexport const isTestSessionFilter = (obj: object): obj is TestSessionFilter => ('target' in obj) &&\n  ('value' in obj) && ('id' in obj) && ('label' in obj) && ('type' in obj) && ('not' in obj) &&\n  (typeof obj.type === 'string') && (typeof obj.target === 'string') &&\n  (typeof obj.label === 'string') && (typeof obj.not === 'boolean') &&\n  (testSessionFilterTypes as readonly string[]).includes(obj.type) &&\n  (testSessionFilterTargets as readonly string[]).includes(obj.target);\n\nexport const isAdvancedTestSessionFilterTarget =\n  (target: TestSessionFilterTarget): boolean => (testSessionFilterTargetLists.advanced)\n    .some(t => t === target);\n\nexport const isAdvancedTestSessionFilterType =\n  (type: TestSessionFilterType): boolean => testSessionFilterTypeLists.advanced\n    .some(t => t === type);\n\nexport interface MonitorProfileTestViewDisplayOptions {\n  blockColumn: ColumnOption;\n  unitColumn: ColumnOption;\n  view: ViewOption;\n  groupColumn: ColumnOption;\n  bookletColumn: ColumnOption;\n  bookletStatesColumns: string[];\n  autoselectNextBlock: boolean;\n}\n\nexport type ColumnOption = 'show' | 'hide';\nexport type ViewOption = 'full' | 'medium' | 'small';\nexport type YesNoOption = 'yes' | 'no';\n\nexport const isColumnOption = (v: string): v is ColumnOption => ['show', 'hide'].includes(v);\nexport const isViewOption = (v: string): v is ViewOption => ['full', 'medium', 'small'].includes(v);\nexport const isYesNoOption = (v: string): v is YesNoOption => ['yes', 'no'].includes(v);\n\nexport interface TestViewDisplayOptions extends MonitorProfileTestViewDisplayOptions {\n  highlightSpecies: boolean;\n  manualChecking: boolean;\n}\n\nexport interface Profile {\n  id: string;\n  label: string;\n  settings: { [key: string]: string };\n  filtersEnabled: { [key: string]: string };\n  filters: TestSessionFilter[];\n}\n\nexport const testSessionFilterListEntrySources = ['base', 'quick', 'profile', 'custom'] as const;\n\nexport type TestSessionFilterListEntrySource = typeof testSessionFilterListEntrySources[number];\n16-    const option = session.bookletStates?.[stateId] || state?.default;\n17-    return option ? state?.options[option]?.label : undefined;\n18-  }\n19-\n20:  static hasState(state: Record<string, unknown>, key: string, value: string | null = null): boolean {\n21-    return ((typeof state[key] !== 'undefined') && ((value !== null) ? (state[key] === value) : true));\n22-  }\n23-\n24-  static isPaused(session: TestSession): boolean {\n25:    return TestSessionUtil.hasState(session.data.testState, 'CONTROLLER', 'PAUSED');\n26-  }\n27-\n28:  static isLocked(session: TestSession): boolean {\n29:    return TestSessionUtil.hasState(session.data.testState, 'status', 'locked');\n30-  }\n31-\n32-  static analyzeTestSession(session: TestSessionChange, booklet: Booklet | BookletError): TestSession {\n33-    const current = (isBooklet(booklet) && session.unitName) ?\n34-      TestSessionUtil.getCurrent(booklet.units, session.unitName) :\n35-      null;\n36-    return {\n37-      data: session,\n38-      state: TestSessionUtil.getSuperState(session),\n39-      current: current && current.unit ? current : null,\n40-      booklet,\n41-      timeLeft: TestSessionUtil.parseJsonState<{ [timerId: string]: number }>(session.testState, 'TESTLETS_TIMELEFT'),\n42-      clearedCodes: TestSessionUtil.parseJsonState<string[]>(session.testState, 'TESTLETS_CLEARED_CODE'),\n43-      bookletStates: TestSessionUtil.parseJsonState<{ [state: string]: string }>(session.testState, 'BOOKLET_STATES')\n44-    };\n45-  }\n46-\n47-  static stateString(state: Record<string, string>, keys: string[], glue = ''): string {\n48-    return keys\n49:      .map((key: string) => (TestSessionUtil.hasState(state, key) ? state[key] : null))\n50-      .filter(value => value !== null)\n51-      .join(glue);\n52-  }\n53-\n54-  private static getSuperState(session: TestSessionData): TestSessionSuperState {\n55-    const state = session.testState;\n56-\n57:    if (this.hasState(state, 'status', 'pending')) {\n58-      return 'pending';\n59-    }\n60:    if (this.hasState(state, 'status', 'locked')) {\n61-      return 'locked';\n62-    }\n63:    if (this.hasState(state, 'CONTROLLER', 'ERROR')) {\n64-      return 'error';\n65-    }\n66:    if (this.hasState(state, 'CONTROLLER', 'TERMINATED')) {\n67-      return 'controller_terminated';\n68-    }\n69:    if (this.hasState(state, 'CONTROLLER', 'TERMINATED_PAUSED')) {\n70-      return 'controller_terminated';\n71-    }\n72:    if (this.hasState(state, 'CONNECTION', 'LOST')) {\n73-      return 'connection_lost';\n74-    }\n75:    if (this.hasState(state, 'CONTROLLER', 'PAUSED')) {\n76-      return 'paused';\n77-    }\n78:    if (this.hasState(state, 'FOCUS', 'HAS_NOT')) {\n79-      return 'focus_lost';\n80-    }\n81-    if (TestSessionUtil.idleSinceMinutes(session) > 5) {\n82-      return 'idle';\n83-    }\n84:    if (this.hasState(state, 'CONNECTION', 'WEBSOCKET')) {\n85-      return 'connection_websocket';\n86-    }\n87:    if (this.hasState(state, 'CONNECTION', 'POLLING')) {\n88-      return 'connection_polling';\n89-    }\n90-    return 'ok';\n91-  }\n92-\n93-  private static idleSinceMinutes(testSession: TestSessionData): number {\n94-    return (Date.now() - testSession.timestamp * 1000) / (1000 * 60);\n95-  }\n96-\n97-  private static parseJsonState<T>(testStateObject: Record<string, string>, key: string): T | null {\n98-    if (typeof testStateObject[key] === 'undefined') {\n99-      return null;\n100-    }\n101-\n102-    const stateValueString = testStateObject[key];\n103-\n104-    try {\n105-      return JSON.parse(stateValueString);\n106-    } catch (error) {\n107-      return null;\n108-    }\n109-  }\n110-\n111-  private static getCurrent(\n112-    testlet: Testlet,\n});\ntest('mixed, missing and obsolete Booklet-state values sort without killing the live monitor',()=>{\n const f=managerFixture();const state={id:'route',label:'Route',default:'a',options:{a:{label:'Alpha'},b:{label:'Beta'}}};\n const row=(id,states,values)=>({data:{testId:id},booklet:{states,species:'owned'},bookletStates:values});\n const rows=[row('1',{route:state},{route:'b'}),row('2',{},{}),row('3',{route:state},{}),row('4',{route:state},{route:'obsolete'})];\n const sorted=f.manager.sortSessions({active:'bookletState:route',direction:'asc'},rows);assert.deepEqual(sorted.map(x=>x.data.testId),['3','1','2','4']);\n // Use the real production stats/filter/sort subscription with absent states.\n const material={getBooklet:name=>rx.of({metadata:{label:name},species:'owned',states:name==='A'?{route:state}:{}})};\n const manager=new TestSessionManager(f.backend,material);manager.connect('mixed');manager.sortBy$.next({active:'bookletState:route',direction:'asc'});\n const packet=(id,name,values)=>({testId:id,bookletName:name,personLabel:id,timestamp:1,testState:{BOOKLET_STATES:JSON.stringify(values)}});\n f.streams.get('mixed').next([packet('1','A',{route:'b'}),packet('2','B',{})]);assert.equal(manager.sessions.length,2);\n f.streams.get('mixed').next([packet('1','A',{route:'obsolete'}),packet('2','B',{}),packet('3','A',{})]);assert.equal(manager.sessions.length,3);assert.equal(manager.sessions[0].data.testId,'3');manager.disconnect();\n});\ntest('finish locks materialized pending tests but never sends terminate to pending or nonpositive IDs',t=>{\n clock(t);const f=managerFixture();f.manager.connect('A');\n f.streams.get('A').next([\n  {testId:'9007199254740993',personLabel:'Running',bookletName:'BOOK',testState:{status:'running',CONNECTION:'POLLING'},timestamp:1},\n  {testId:'9007199254740994',personLabel:'Pending',bookletName:'BOOK',testState:{status:'pending'},timestamp:1},\n  {testId:'0',personLabel:'Ghost',bookletName:'BOOK',testState:{status:'pending'},timestamp:1}\n ]);\n f.manager.commandFinishEverything().subscribe();assert.deepEqual(f.writes[0].ids,['9007199254740994','9007199254740993']);t.mock.timers.tick(1500);assert.deepEqual(f.writes[1].ids,['9007199254740993']);f.manager.disconnect();\n});\ntest('the actual Goto producer uses captured targets and cannot start after its group was retired',()=>{\n const f=managerFixture();f.manager.connect('A');\n const block={id:'B1',blockId:'B1',restrictions:{},children:[{id:'UNIT',alias:'owned-target',label:'Owned'}]};\n const row=id=>({data:{testId:id,bookletName:'BOOK'},booklet:{species:'owned',states:{},units:{children:[block]}},timeLeft:{B1:0}});\n const a=row('9007199254740993'),b=row('9007199254740994'),selection={element:block};\n f.manager._checked={other:b};f.manager.testCommandGoto(selection,7,[a]).subscribe();assert.deepEqual(f.writes[0],{type:'goto',args:['id','owned-target','| closed timeblock reopened - new remaining time 7'],ids:['9007199254740993']});\n f.writes.length=0;const pending=f.manager.testCommandGoto(selection,7,[a]);f.manager.connect('B');pending.subscribe();assert.deepEqual(f.writes,[]);f.manager.disconnect();\n});\nfor(const action of ['Pause','Resume','Unlock'])for(const transition of ['group','access'])test(action+' cannot outlive its '+transition+' context',()=>{\nimport {Injectable,inject} from '@angular/core';\nimport {BehaviorSubject,EMPTY,Observable,of,Subject,timer} from 'rxjs';\nimport {catchError,exhaustMap,map,tap} from 'rxjs/operators';\nimport type {BookletError,CommandResponse,Profile,TestSessionData} from './group-monitor.interfaces';\nimport type {ConnectionStatus} from '../shared/shared.module';\nimport {NativeMonitorSessionService} from '../native-session.service';\nimport {parseNativeMonitorSnapshot,nativeMonitorSelectionBody,nativeMonitorBookletFileId} from '../native-monitor-wire';\n@Injectable()\nexport class BackendService {\n private readonly session=inject(NativeMonitorSessionService);\n readonly connectionStatus$=new BehaviorSubject<ConnectionStatus>('initial');\n readonly problem$=new BehaviorSubject('');\n private readonly connectionClosed=new Subject<void>();\n readonly connectionClosed$=this.connectionClosed.asObservable();\n get cacheIdentity(){return this.session.access();}\n get accessSignal(){return this.session.accessSignal;}\n private request(method:string,path:string,body?:unknown,raw=false):Observable<string>{\n  return new Observable(subscriber=>{\n   const abort=new AbortController();\n   void this.session.text(method,path,body,undefined,raw,abort.signal)\n    .then(text=>{if(!subscriber.closed){subscriber.next(text);subscriber.complete();}})\n    .catch(error=>{if(!subscriber.closed)subscriber.error(error);});\n   return()=>abort.abort();\n  });\n }\n getSessionsMonitor(groupName:string):Observable<TestSessionData[]>{\n  return this.request('GET','/monitor/group/'+encodeURIComponent(groupName)+'/test-sessions').pipe(map(parseNativeMonitorSnapshot));\n }\n observeSessionsMonitor(groupName:string):Observable<TestSessionData[]>{\n  return timer(0,5000).pipe(exhaustMap(()=>{\n   this.connectionStatus$.next('polling-fetch');\n   return this.getSessionsMonitor(groupName).pipe(\n    tap(()=>{this.connectionStatus$.next('polling-sleep');this.problem$.next('');}),\n    // An error is never an empty successful snapshot. The next tick can retry.\n    catchError(error=>{this.connectionStatus$.next('error');this.problem$.next(error instanceof Error?error.message:'Verbindungsfehler');return EMPTY;})\n   );\n  }));\n }\n cutConnection(){this.connectionClosed.next();this.connectionStatus$.next('initial');this.problem$.next('');}\n getBooklet(name:string):Observable<string|BookletError>{return this.request('GET','/booklet/'+encodeURIComponent(nativeMonitorBookletFileId(name))).pipe(catchError(error=>of({error:error.status===404?'missing-file':'general',species:null} as BookletError)));}\n private write(path:string,ids:string[],fields:Record<string,unknown>={},method='POST'):Observable<CommandResponse>{\n  return this.request(method,path,nativeMonitorSelectionBody(ids,fields),true).pipe(map(()=>({commandType:String(fields['keyword']??(path.endsWith('/unlock')?'unlock':'lock')),testIds:ids})),tap(()=>this.problem$.next('')),catchError(error=>{this.problem$.next(error instanceof Error?error.message:'Befehl fehlgeschlagen');throw error;}));\n }\n command(keyword:string,args:string[],testIds:string[]):Observable<CommandResponse>{return this.write('/monitor/command',testIds,{keyword,arguments:args,timestamp:Date.now()/1000},'PUT');}\n unlock(group:string,ids:string[]){return this.write('/monitor/group/'+encodeURIComponent(group)+'/tests/unlock',ids);}\n lock(group:string,ids:string[]){return this.write('/monitor/group/'+encodeURIComponent(group)+'/tests/lock',ids);}\n getProfile(id:string):Observable<Profile>{return this.request('GET','/monitor/profile/'+encodeURIComponent(id)).pipe(map(text=>JSON.parse(text) as Profile));}\n}\n{\n  \"name\": \"testcenter-rewrite-app\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"engines\": {\n    \"node\": \">=22 <23\"\n  },\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"build\": \"npm run build:core && npm run provision:xml-schemas:built && npm run build:web\",\n    \"provision:xml-schemas\": \"npm run build:core && npm run provision:xml-schemas:built\",\n    \"provision:xml-schemas:built\": \"node ./scripts/provision-xml-schemas.mjs\",\n    \"build:core\": \"tsc -b packages/domain packages/contracts packages/application packages/memory-store packages/file-store packages/sqlite-store packages/postgres-store apps/api\",\n    \"build:web\": \"ng build rewrite-app-web\",\n    \"ci\": \"npm run typecheck && npm run test:unit && npm run build && npm run test:compatibility:built && np