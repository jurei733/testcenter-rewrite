.pipe(\\n    tap(()=>{this.connectionStatus$.next('polling-sleep');this.problem$.next('');}),\\n    // An error is never an empty successful snapshot. The next tick can retry.\\n    catchError(error=>{this.connectionStatus$.next('error');this.problem$.next(error instanceof Error?error.message:'Verbindungsfehler');return EMPTY;})\\n   );\\n  }));\\n }\\n cutConnection(){this.connectionClosed.next();this.connectionStatus$.next('initial');this.problem$.next('');}\\n getBooklet(name:string):Observable<string|BookletError>{return this.request('GET','/booklet/'+encodeURIComponent(nativeMonitorBookletFileId(name))).pipe(catchError(error=>of({error:error.status===404?'missing-file':'general',species:null} as BookletError)));}\\n private write(path:string,ids:string[],fields:Record<string,unknown>={},method='POST'):Observable<CommandResponse>{\\n  return this.request(method,path,nativeMonitorSelectionBody(ids,fields),true).pipe(map(()=>({commandType:String(fields['keyword']??(path.endsWith('/unlock')?'unlock':'lock')),testIds:ids})),tap(()=>this.problem$.next('')),catchError(error=>{this.problem$.next(error instanceof Error?error.message:'Befehl fehlgeschlagen');throw error;}));\\n }\\n command(keyword:string,args:string[],testIds:string[]):Observable…588 tokens truncated…test.mjs scripts/controller-player-input.test.mjs scripts/participant-unit-labels.test.mjs scripts/participant-review-download.test.mjs scripts/participant-unit-label-reload.test.mjs scripts/current-original-booklet-config-smoke.test.mjs scripts/custom-text-value-reference.test.mjs scripts/attachment-custom-text-reference.test.mjs scripts/attachment-manager-lifecycle.test.mjs scripts/custom-text-editor-state.test.mjs scripts/workspace-auto-refresh-smoke.test.mjs scripts/attachment-qr-scanner.test.mjs scripts/original-review-panel.test.mjs scripts/original-participant-confirmation.test.mjs scripts/original-error-timestamp.test.mjs scripts/verona-ready-error.test.mjs scripts/participant-error-reception.test.m