inishPacket('9007199254740994')]);f.manager.commandFinishEverything().subscribe();\nscripts/native-monitor-lifecycle.test.mjs:248:test('a failed finish snapshot never writes stale targets or reports successful completion',t=>{\nscripts/native-monitor-lifecycle.test.mjs:252:for(const transition of ['group','access','disconnect'])test('finish pending snapshot cannot outlive '+transition+' context',t=>{\nscripts/native-monitor-lifecycle.test.mjs:255: assert.equal(fresh.observed,false);fresh.next([finishPacket('9007199254740993')]);t.mock.timers.tick(2000);assert.deepEqual(f.writes,[]);f.manager.disconnect();\n","exit_code":0,"duration":{"secs":0,"nanos":12125}},"started_at_ms":1793259361182,"completed_at_ms":1793259361182}}
