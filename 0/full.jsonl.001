'page-1',\\n    validPages: [{id: 'page-1', label: 'Introduction'}, {id: 'page-2', label: 'Review'}]},\\n  fieldTimestamps: {dataParts: {answer: 100}, unitState: {presentationProgress: 101, responseProgress: 101},\\n    playerState: {currentPage: 102, validPages: 102}}});\\nconst matches = state => matchesMergedReturnBaseline(JSON.stringify(state), answer);\\n\\ntest('an answer-only intermediate save cannot freeze the retention baseline', () => {\\n  const state = fixture(); state.unitState.responseProgress = 'none';\\n  assert.equal(matches(state), false);\\n});\\ntest('complete progress with a stale Player save still cannot freeze the baseline', () => {\\n  const state = fixture(); state.fieldTimestamps.playerState = {currentPage: 90, validPages: 90};\\n  assert.equal(matches(state), false);\\n});\\ntest('all three persisted fixture notifications qualify without modifying the envelope', () => {\\n  const raw = JSON.stringify(fixture()); assert.equal(matchesMergedReturnBaseline(raw, answer), true);\\n  assert.equal(raw, JSON.stringify(fixture()));\\n});\\ntest('equal capture milliseconds remain valid for ordered notifications', () => {\\n  const state = fixture(); state.fieldTimestamps.unitState = {presentationProgress: 100, responseProgress: 100};\\n  state.fieldTimestamps.playerState = {currentPage: 100, validPages: 100}; assert.equal(matches(state), true);\\n});\\ntest('wrong answer bytes, types and page payloads cannot qualify', () => {\\n  for (const mutate of [s => {s.unitState.dataParts.answer += ' ';}, s => {s.dataPartValueTypes.answer = 'object';},\\n    s => {s.playerState.validPages[1].label = 'Changed';}, s => {s.playerState.currentPage = 'page-2';}]) {\\n    const state = fixture(); mutate(state); assert.equal(matches(state), false);\\n  }\\n});\\ntest('missing, fractional and reversed capture clocks cannot qualify', () => {\\n  for (const mutate of [s => {delete s.fieldTimestamps;}, s => {s.fieldTimestamps.dataParts.answer = 1.5;},\\n    s => {s.fieldTimestamps.unitState.responseProgress = 99;}]) {\\n    const state = fixture(); mutate(state); assert.equal(matches(state), false);\\n  }\\n});\\ntest('malformed responses fail closed', () => {\\n  for (const raw of [undefined, '', 'null', '{}', '{']) assert.equal(matchesMergedReturnBaseline(raw, answer), false);\\n});\\ndiff --git a/rewrite-app/scripts/current-original-booklet-config-smoke.mjs b/rewrite-app/scripts/current-original-booklet-config-smoke.mjs\\nindex adaab818..bbf8bfbd 100644\\n--- a/rewrite-app/scripts/current-original-booklet-config-smoke.mjs\\n+++ b/rewrite-app/scripts/current-original-booklet-config-smoke.mjs\\n@@ -6,6 +6,7 @@ import { brotliDecompressSync } from \\\"node:zlib\\\";\\n import { join } from \\\"node:path\\\";\\n import { reloadParticipantUnitLabelPlayer } from \\\"./participant-unit-label-smoke.mjs\\\";\\n import { matchesVeronaSavedResponse } from \\\"./verona-save-response-match.mjs\\\";\\n+import { captureSmokeCaseFailure } from \\\"./smoke-case-failure.mjs\\\";\\n import { runBoundedSmokeCases } from \\\"./bounded-smoke-cases.mjs\\\";\\n \\n const fixtureRoot = new URL(\\\"../test-fixtures/original-testcenter/\\\", import.meta.url);\\n@@ -68,8 +69,10 @@ export async function runCurrentOriginalBookletConfigSmoke({ browser, baseUrl,\\n   // Within a group each case uses a different real participant account.\\n   for (const ui of [\\\"rewrite\\\", \\\"original\\\"]) for (const width of [1280, 390]) await runBoundedSmokeCases(cases,caseConcurrency,async item=>{\\n     const context = await browser.newContext({ viewport: { width, height: 900 } });\\n+    let page;\\n     try {\\n-      const page = await context.newPage(), errors = [];\\n+      page = await context.newPage();\\n+      const errors = [];\\n       let operatorLeaks = 0;\\n       page.on(\\\"pageerror\\\", error => errors.push(String(error)));\\n       page.on(\\\"request\\\", request => {\\n@@ -165,6 +168,7 @@ export async function runCurrentOriginalBookletConfigSmoke({ browser, baseUrl,\\n       passed++;\\n     } catch(error) {\\n       report(`current_original_booklet_config=${ui}/${width}/${item.number}:failed`);\\n+      await captureSmokeCaseFailure(error, page, {suite: \\\"current-original-booklet-config\\\", ui, width, number: item.number});\\n       throw error;\\n     } finally {\\n       await context.close();\\ndiff --git a/rewrite-app/scripts/smoke-ui.mjs b/rewrite-app/scripts/smoke-ui.mjs\\nindex 36ad5cb8..040ad9b7 100644\\n--- a/rewrite-app/scripts/smoke-ui.mjs\\n+++ b/rewrite-app/scripts/smoke-ui.mjs\\n@@ -23,6 +23,8 @@ import { captureResultGroupSnapshot, assertGroupDeletionMatchesSnapshot,\\n   assertResultGroupRemoved, assertResultGroupRetained } from \\\"./group-result-deletion-check.mjs\\\";\\n import { withChromiumIbRuntime } from \\\"./chromium-ib-runtime.mjs\\\";\\n import { runParticipantUnitLabelSmoke } from \\\"./participant-unit-label-smoke.mjs\\\";\\n+import { matchesMergedReturnBaseline } from \\\"./merged-return-baseline.mjs\\\";\\n+import { smokeCaseFailures } from \\\"./smoke-case-failure.mjs\\\";\\n import { runCurrentOriginalBookletConfigSmoke } from \\\"./current-original-booklet-config-smoke.mjs\\\";\\n import { setWorkspaceAutoRefreshEnabled } from \\\"./workspace-auto-refresh-smoke.mjs\\\";\\n import { createAttachmentQrCameraVideo } from \\\"./attachment-camera-fixture.mjs\\\";\\n@@ -10905,8 +10907,8 @@ try {\\n   await mergedReturnFrame.locator(\\\"#playerAnswer\\\").fill(mergedReturnAnswer);\\n   const mergedReturnBefore = (\\n     await pollJsonWithPredicate(mergedReturnStateUrl, payload =>\\n-      payload?.currentRunState?.testRun?.unitResponses?.[veronaUnitKey]?.includes(\\n-        mergedReturnAnswer\\n+      matchesMergedReturnBaseline(\\n+        payload?.currentRunState?.testRun?.unitResponses?.[veronaUnitKey], mergedReturnAnswer\\n       )\\n     )\\n   ).currentRunState;\\n@@ -19026,6 +19028,22 @@ try {\\n     // and immediate radio click. Keep the checked-state assertion unchanged.\\n     await page.locator(\\\"#participantVeronaPlayerFrame\\\").scrollIntoViewIfNeeded();\\n     await page.locator(\\\"#participantVeronaPlayerFrame\\\").screenshot();\\n+    // Painting the owner does not ensure that its embedded document has had\\n+    // a render opportunity. Keep the first native click inside the child;\\n+    // no input retry, forced action or DOM-dispatched event is used.\\n+    let childPaintTimer;\\n+    try {\\n+      await Promise.race([\\n+        frame.locator('[data-cy=\\\"TestController-radio1-Aufg1\\\"]').evaluate(\\n+          () => new Promise(done => requestAnimationFrame(() => requestAnimationFrame(done)))\\n+        ),\\n+        new Promise((_, reject) => {\\n+          childPaintTimer = setTimeout(() => reject(\\n+            new Error(\\\"Original Player did not render before native radio input.\\\")\\n+          ), 2_000);\\n+        })\\n+      ]);\\n+    } finally { clearTimeout(childPaintTimer); }\\n     await frame\\n       .locator('[data-cy=\\\"TestController-radio1-Aufg1\\\"]')\\n       .check();\\n@@ -26470,9 +26488,11 @@ try {\\n           }), undefined, { timeout: 2_000 });\\n         } catch (captureError) { navigation = { unavailable: String(captureError).split(\\\"\\\\nCall log:\\\")[0] }; }\\n         await writeFile(resolve(failureDirectory, \\\"failure.json\\\"), JSON.stringify({\\n-          error: String(error?.message ?? error).split(\\\"\\\\nCall log:\\\")[0], navigation\\n+          error: String(error?.message ?? error).split(\\\"\\\\nCall log:\\\")[0], navigation, ownedCases: smokeCaseFailures(error).map(item => item.evidence)\\n         }, null, 2) + \\\"\\\\n\\\");\\n-        await page.screenshot({ path: resolve(failureDirectory, \\\"failure.png\\\"), fullPage: true });\\n+        const childFailure = smokeCaseFailures(error).find(item => item.screenshot);\\n+        if (childFailure) await writeFile(resolve(failureDirectory, \\\"failure.png\\\"), childFailure.screenshot);\\n+        else await page.screenshot({ path: resolve(failureDirectory, \\\"failure.png\\\"), fullPage: true });\\n         process.stderr.write(`UI smoke failure screenshot: ${failureDirectory}/failure.png\\\\n`);\\n       } catch (captureError) {\\n         // A full disk or a closed browser must not replace the actual test failure.\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a184d1-912e-70d0-9d86-694502899ef9","create_time":1793232753.470076}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
