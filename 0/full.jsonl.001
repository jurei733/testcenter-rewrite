terminate to pending or nonpositive IDs',t=>{\n clock(t);const f=managerFixture();f.manager.connect('A');\n f.streams.get('A').next([\n  {testId:'9007199254740993',personLabel:'Running',bookletName:'BOOK',testState:{status:'running',CONNECTION:'POLLING'},timestamp:1},\n  {testId:'9007199254740994',personLabel:'Pending',bookletName:'BOOK',testState:{status:'pending'},timestamp:1},\n  {testId:'0',personLabel:'Ghost',bookletName:'BOOK',testState:{status:'pending'},timestamp:1}\n ]);\n f.manager.commandFinishEverything().subscribe();assert.deepEqual(f.writes[0].ids,['9007199254740994','9007199254740993']);t.mock.timers.tick(1500);assert.deepEqual(f.writes[1].ids,['9007199254740993']);f.manager.disconnect();\n});\ntest('the actual Goto producer uses captured targets and cannot start after its group was retired',()=>{\n const f=managerFixture();f.manager.connect('A');\nimport {Injectable,inject} from '@angular/core';\nimport {BehaviorSubject,EMPTY,Observable,of,Subject,timer} from 'rxjs';\nimport {catchError,exhaustMap,map,tap} from 'rxjs/operators';\nimport type {BookletError,CommandResponse,Profile,TestSessionData} from './group-monitor.interfaces';\nimport type {ConnectionStatus} from '../shared/shared.module';\nimport {NativeMonitorSessionService} from '../native-session.service';\nimport {parseNativeMonitorSnapshot,nativeMonitorSelectionBody,nativeMonitorBookletFileId} from '../native-monitor-wire';\n@Injectable()\nexport class BackendService {\n private readonly session=inject(NativeMonitorSessionService);\n readonly connectionStatus$=new BehaviorSubject<ConnectionStatus>('initial');\n readonly problem$=new BehaviorSubject('');\n private readonly connectionClosed=new Subject<void>();\n readonly connectionClosed$=this.connectionClosed.asObservable();\n get cacheIdentity(){return this.session.access();}\n get accessSignal(){return this.session.accessSignal;}\n private request(method:string,path:string,body?:unknown,raw=false):Observable<string>{\n  return new Observable(subscriber=>{\n   const abort=new AbortController();\n   void this.session.text(method,path,body,undefined,raw,abort.signal)\n    .then(text=>{if(!subscriber.closed){subscriber.next(text);subscriber.complete();}})\n    .catch(error=>{if(!subscriber.closed)subscriber.error(error);});\n   return()=>abort.abort();\n  });\n }\n getSessionsMonitor(groupName:string):Observable<TestSessionData[]>{\n  return this.request('GET','/monitor/group/'+encodeURIComponent(groupName)+'/test-sessions').pipe(map(parseNativeMonitorSnapshot));\n }\n observeSessionsMonitor(groupName:string):Observable<TestSessionData[]>{\n  return timer(0,5000).pipe(exhaustMap(()=>{\n   this.connectionStatus$.next('polling-fetch');\n   return this.getSessionsMonitor(groupName).pipe(\n    tap(()=>{this.connectionStatus$.next('polling-sleep');this.problem$.next('');}),\n    // An error is never an empty successful snapshot. The next tick can retry.\n    catchError(error=>{this.connectionStatus$.next('error');this.problem$.next(error instanceof Error?error.message:'Verbindungsfehler');return EMPTY;})\n   );\n  }));\n }\n cutConnection(){this.connectionClosed.next();this.connectionStatus$.next('initial');this.problem$.next('');}\n getBooklet(name:string):Observable<string|BookletError>{return this.request('GET','/booklet/'+encodeURIComponent(nativeMonitorBookletFileId(name))).pipe(catchError(error=>of({error:error.status===404?'missing-file':'general',species:null} as BookletError)));}\n private write(path:string,ids:string[],fields:Record<string,unknown>={},method='POST'):Observable<CommandResponse>{\n  return this.request(method,path,nativeMonitorSelectionBody(ids,fields),true).pipe(map(()=>({commandType:String(fields['keyword']??(path.endsWith('/unlock')?'unlock':'lock')),testIds:ids})),tap(()=>this.problem$.next('')),catchError(error=>{this.problem$.next(error instanceof Error?error.message:'Befehl fehlgeschlagen');throw error;}));\n }\n command(keyword:string,args:string[],testIds:string[]):Observable<CommandResponse>{return this.write('/monitor/command',testIds,{keyword,arguments:args,timestamp:Date.now()/1000},'PUT');}\n unlock(group:string,ids:string[]){return this.write('/monitor/group/'+encodeURIComponent(group)+'/tests/unlock',ids);}\n lock(group:string,ids:string[]){return this.write('/monitor/group/'+encodeURIComponent(group)+'/tests/lock',ids);}\n getProfile(id:string):Observable<Profile>{return this.request('GET','/monitor/profile/'+encodeURIComponent(id)).pipe(map(text=>JSON.parse(text) as Profile));}\n}\ntest:frontend-state node --test scripts/app-initial-route.test.mjs scripts/bounded-smoke-cases.test.mjs scripts/participant-command-completion-journal.test.mjs scripts/participant-controller-completion-reference.test.mjs scripts/participant-controller-timer-reference.test.mjs scripts/participant-command-handler-reference.test.mjs scripts/shell-lifecycle.test.mjs scripts/runtime-read-context.test.mjs scripts/monitor-goto-selection.test.mjs scripts/monitor-booklet-errors.test.mjs scripts/service-worker-save.test.mjs scripts/participant-access-credentials.test.mjs scripts/participant-http-test-actor.test.mjs scripts/drain-smoke-response.test.mjs scripts/smoke-deadline.test.mjs scripts/timer-smoke-supervision.test.mjs scripts/smoke-route-failure-gate.test.mjs scripts/participant-sign-out.test.mjs scripts/participant-session-links.test.mjs scripts/participant-entry-lifecycle.test.mjs scripts/participant-save-barrier.test.mjs scripts/participant-save-drain.test.mjs scripts/participant-response-clock-capture.test.mjs scripts/participant-test-log-identities.test.mjs scripts/participant-navigation-completeness.test.mjs scripts/operator-run-links.test.mjs scripts/participant-run-request-match.test.mjs scripts/verona-save-response-match.test.mjs scripts/event-stream-watchdog.test.mjs scripts/browser-compatibility-presentation.test.mjs scripts/password-confirmation.test.mjs scripts/original-admin-login.test.mjs scripts/original-administration-controller.test.mjs