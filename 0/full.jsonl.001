llständig\\\" view=\\\"full\\\" groupColumn=\\\"show\\\"/><Profile id=\\\"small\\\" label=\\\"Kurz\\\" view=\\\"small\\\"/></GroupMonitor></Profiles>'+earlyRoster+`<Group id=\\\"${group}\\\" label=\\\"Owned Monitor Group\\\"><Login name=\\\"${monitorName}\\\" pw=\\\"${password}\\\" mode=\\\"monitor-group\\\"><Profile id=\\\"full\\\"/><Profile id=\\\"small\\\"/></Login>`+[one,two].map(name=>`<Login name=\\\"${name}\\\" pw=\\\"${password}\\\" mode=\\\"run-hot-return\\\"><Booklet>${name===one?presetBooklet:'OWNED.UI.BOOK'}</Booklet></Login>`).join('')+'</Group>');\\n await services.workspaceAdminRead.importParticipantRoster({...scope,rosterText:initialRoster});\\n const people=[];\\n for(const name of[one,two]){\\nearly-loops 2\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a18695-87cd-7aa0-b257-6c7fc577e31f","create_time":1793260422.921041}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
