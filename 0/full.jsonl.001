{id:j.id,name:j.name})),live:jobs.filter(j=>j.status!==\"completed\").map(j=>({id:j.id,name:j.name,status:j.status}))});}else text({i,result:r[i]});}\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a18695-87cd-7aa0-b257-6c7fc577e31f","create_time":1793259323.8944561}}}
