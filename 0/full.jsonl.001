onst waitForOriginalControllerCompletenessDenial = async (\n    controller,\n// Preserve the failing child page before its owned context is closed. Only\n// control geometry/state is recorded; never input values or request headers.\nexport async function captureSmokeCaseFailure(error, page, scope) {\n  if (!error || typeof error !== 'object' || !Object.isExtensible(error) || error.ownedSmokeCase) return;\n  const evidence = {scope, url: page?.url(), message: String(error.message ?? error).split('\\nCall log:')[0]};\n  let screenshot;\n  if (page && !page.isClosed()) {\n    try {\n      evidence.dom = await page.locator('html').evaluate(() => ({\n        path: location.pathname, mode: document.documentElement.dataset.interfaceMode,\n        readyState: document.readyState, visibility: document.visibilityState,\n        viewport: [innerWidth, innerHeight], activeElement: document.activeElement?.id,\n        controls: ['participantLoginKey', 'participantPassword', 'participantRouteSignInButton'].map(id => {\n          const element = document.getElementById(id);\n          if (!element) return {id, present: false};\n          const box = element.getBoundingClientRect(), style = getComputedStyle(element);\n          const hiddenAncestors = [];\n          for (let parent = element; parent; parent = parent.parentElement) {\n            const css = getComputedStyle(parent);\n            if (parent.hidden || parent.inert || css.display === 'none' || css.visibility === 'hidden') {\n              hiddenAncestors.push({tag: parent.tagName, id: parent.id, hidden: parent.hidden,\n                inert: parent.inert, display: css.display, visibility: css.visibility});\n            }\n          }\n          return {id, present: true, disabled: element.matches(':disabled'), readOnly: element.readOnly,\n            classes: element.className, display: style.display, visibility: style.visibility,\n            rect: {x: box.x, y: box.y, width: box.width, height: box.height}, hiddenAncestors};\n        })\n      }), undefined, {timeout: 2_000});\n    } catch (captureError) {evidence.domUnavailable = String(captureError).split('\\nCall log:')[0];}\n    try {screenshot = await page.screenshot({fullPage: false, timeout: 5_000});}\n    catch (captureError) {evidence.screenshotUnavailable = String(captureError).split('\\nCall log:')[0];}\n  }\n  // Non-enumerable binary evidence must not explode an exception's log output.\n  Object.defineProperty(error, 'ownedSmokeCase', {value: {evidence, screenshot}});\n}\n\nexport function smokeCaseFailures(error) {\n  if (error instanceof AggregateError) return error.errors.flatMap(smokeCaseFailures);\n  return error?.ownedSmokeCase ? [error.ownedSmokeCase] : [];\n}\nconst clock = value => Number.isSafeInteger(value) && value >= 0;\n\n// The owned fixture sends answer, progress and Player state in three ordered\n// notifications. Freeze the unchanged-state baseline only after all three have\n// persisted. Later retention assertions still compare the exact envelope.\nexport function matchesMergedReturnBaseline(raw, answer) {\n  try {\n    const state = JSON.parse(raw);\n    const unit = state.unitState, player = state.playerState, times = state.fieldTimestamps;\n    const answerAt = times?.dataParts?.answer;\n    const progressAt = times?.unitState?.responseProgress;\n    const presentationAt = times?.unitState?.presentationProgress;\n    const pageAt = times?.playerState?.currentPage;\n    const pagesAt = times?.playerState?.validPages;\n    return state.kind === 'verona_unit_state' && state.version === 1 &&\n      unit?.dataParts?.answer === answer && unit.unitStateDataType === 'verona-smoke@1' &&\n      state.dataPartValueTypes?.answer === 'string' &&\n      unit.presentationProgress === 'complete' && unit.responseProgress === 'complete' &&\n      player?.currentPage === 'page-1' && Array.isArray(player.validPages) && player.validPages.length === 2 &&\n      player.validPages[0]?.id === 'page-1' && player.validPages[0]?.label === 'Introduction' &&\n      player.validPages[1]?.id === 'page-2' && player.validPages[1]?.label === 'Review' &&\n      [answerAt, progressAt, presentationAt, pageAt, pagesAt].every(clock) &&\n      progressAt >= answerAt && presentationAt >= answerAt &&\n      pageAt >= Math.max(progressAt, presentationAt) && pagesAt >= Math.max(progressAt, presentationAt);\n  } catch {return false;}\n}\n","exit_code":0,"duration":{"secs":0,"nanos":9750}},"started_at_ms":1793232426244,"completed_at_ms":1793232426244}}
{"timestamp":"2026-10-29T00:07:06.251Z","ordinal":12396,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a184fb-550b-72b2-bb2d-2cb70fce7771","call_id":"call_6451380238644196b03fce5a0b4cfa1a","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"1d849d\",\"wall_time_seconds\":0.00000975,\"exit_code\":0,\"original_token_count\":1303,\"output\":\"      testRunId: resumePayload.testRun?.testRunId\\n    };\\n  };\\n  const checkOriginalControllerRadio = async frame => {\\n    // Complete a real viewport render of the opaque frame before native input.\\n    // Chrome can target its owner when check() combines an off-screen scroll\\n    // and immediate radio click. Keep the checked-state assertion unchanged.\\n    await page.locator(\\\"#participantVeronaPlayerFrame\\\").scrollIntoViewIfNeeded();\\n    await page.locator(\\\"#participantVeronaPlayerFrame\\\").screenshot();\\n    await frame\\n      .locator('[data-cy=\\\"TestController-radio1-Aufg1\\\"]')\\n      .check();\\n  };\\n  const completeOriginalControllerUnit = async frame => {\\n    await checkOriginalControllerRadio(frame);\\n    await frame.locator(\\\"#next-page\\\").click();\\n    await frame\\n      .getByText(\\\"Presentation complete\\\", { exact: true })\\n      .waitFor({ timeout: 15_000 });\\n  };\\n  const waitForOriginalControllerCompletenessDenial = async (\\n    controller,\\n// Preserve the failing child page before its owned context is closed. Only\\n// control geometry/state is recorded; never input values or request headers.\\nexport async function captureSmokeCaseFailure(error, page, scope) {\\n  if (!error || typeof error !== 'object' || !Object.isExtensible(error) || error.ownedSmokeCase) return;\\n  const evidence = {scope, url: page?.url(), message: String(error.message ?? error).split('\\\\nCall log:')[0]};\\n  let screenshot;\\n  if (page && !page.isClosed()) {\\n    try {\\n      evidence.dom = await page.locator('html').evaluate(() => ({\\n        path: location.pathname, mode: document.documentElement.dataset.interfaceMode,\\n        readyState: document.readyState, visibility: document.visibilityState,\\n        viewport: [innerWidth, innerHeight], activeElement: document.activeElement?.id,\\n        controls: ['participantLoginKey', 'participantPassword', 'participantRouteSignInButton'].map(id => {\\n          const element = document.getElementById(id);\\n          if (!element) return {id, present: false};\\n          const box = element.getBoundingClientRect(), style = getComputedStyle(element);\\n          const hiddenAncestors = [];\\n          for (let parent = element; parent; parent = parent.parentElement) {\\n            const css = getComputedStyle(parent);\\n            if (parent.hidden || parent.inert || css.display === 'none' || css.visibility === 'hidden') {\\n              hiddenAncestors.push({tag: parent.tagName, id: parent.id, hidden: parent.hidden,\\n                inert: parent.inert, display: css.display, visibility: css.visibility});\\n            }\\n          }\\n          return {id, present: true, disabled: element.matches(':disabled'), readOnly: element.readOnly,\\n            classes: element.className, display: style.display, visibility: style.visibility,\\n            rect: {x: box.x, y: box.y, width: box.width, height: box.height}, hiddenAncestors};\\n        })\\n      }), undefined, {timeout: 2_000});\\n    } catch (captureError) {evidence.domUnavailable = String(captureError).split('\\\\nCall log:')[0];}\\n    try {screenshot = await page.screenshot({fullPage: false, timeout: 5_000});}\\n    catch (captureError) {evidence.screenshotUnavailable = String(captureError).split('\\\\nCall log:')[0];}\\n  }\\n  // Non-enumerable binary evidence must not explode an exception's log output.\\n  Object.defineProperty(error, 'ownedSmokeCase', {value: {evidence, screenshot}});\\n}\\n\\nexport function smokeCaseFailures(error) {\\n  if (error instanceof AggregateError) return error.errors.flatMap(smokeCaseFailures);\\n  return error?.ownedSmokeCase ? [error.ownedSmokeCase] : [];\\n}\\nconst clock = value => Number.isSafeInteger(value) && value >= 0;\\n\\n// The owned fixture sends answer, progress and Player state in three ordered\\n// notifications. Freeze the unchanged-state baseline only after all three have\\n// persisted. Later retention assertions still compare the exact envelope.\\nexport function matchesMergedReturnBaseline(raw, answer) {\\n  try {\\n    const state = JSON.parse(raw);\\n    const unit = state.unitState, player = state.playerState, times = state.fieldTimestamps;\\n    const answerAt = times?.dataParts?.answer;\\n    const progressAt = times?.unitState?.responseProgress;\\n    const presentationAt = times?.unitState?.presentationProgress;\\n    const pageAt = times?.playerState?.currentPage;\\n    const pagesAt = times?.playerState?.validPages;\\n    return state.kind === 'verona_unit_state' && state.version === 1 &&\\n      unit?.dataParts?.answer === answer && unit.unitStateDataType === 'verona-smoke@1' &&\\n      state.dataPartValueTypes?.answer === 'string' &&\\n      unit.presentationProgress === 'complete' && unit.responseProgress === 'complete' &&\\n      player?.currentPage === 'page-1' && Array.isArray(player.validPages) && player.validPages.length === 2 &&\\n      player.validPages[0]?.id === 'page-1' && player.validPages[0]?.label === 'Introduction' &&\\n      player.validPages[1]?.id === 'page-2' && player.validPages[1]?.label === 'Review' &&\\n      [answerAt, progressAt, presentationAt, pageAt, pagesAt].every(clock) &&\\n      progressAt >= answerAt && presentationAt >= answerAt &&\\n      pageAt >= Math.max(progressAt, presentationAt) && pagesAt >= Math.max(progressAt, presentationAt);\\n  } catch {return false;}\\n}\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a184d1-912e-70d0-9d86-694502899ef9","create_time":1793232426.251846}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
