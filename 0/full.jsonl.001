h).split()[0];base=git('ls-remote','entire-eu','refs/heads/main').split()[0]\n api_path='/api/v1/repos/01M4D7PKRMDFGXT94HKPF8YFK7/trails/'+str(a.trail)\n r=subprocess.run(['entire','api','--jurisdiction','us',api_path+'/gates'],text=True,capture_output=True,cwd=repo,check=True);state=json.loads(r.stdout)\n if state['head_sha']!=head:raise SystemExit('Trail and branch heads differ; wait for import or select the correct trail.')\n if (out/'run.json').exists():\n  run=json.loads((out/'run.json').read_text())\n  if run['head']!=head or run['base']!=base:raise SystemExit('Saved reviews are stale; use a new output directory after rebasing.')\n  if not (out/'decision.json').exists():raise SystemExit('Existing review is incomplete; native hold remains. Inspect the failed run before retrying.')\n else:\n  out.mkdir(parents=True,exist_ok=True);out.chmod(0o700)\n  pending={'event':'request_changes','body':'Local Codex review is pending for exact head '+head+'. Workflow hold only: do not merge while reviews are missing, stale, failed or inconclusive. Final approval still requires all applicable CI and qualification gates.'}\n  subprocess.run(['entire','api','--jurisdiction','us','-X','POST',api_path+'/approvals','--input','-'],input=json.dumps(pending),text=True,capture_output=True,cwd=repo,check=True)\n  for sha in (head,base):\n   if subprocess.run(['git','-C',str(repo),'cat-file','-e',sha+'^{commit}'],capture_output=True).returncode:subprocess.run(['git','-C',str(repo),'fetch','entire-eu',sha],check=True)\n  checkout=repo.parent/('testcenter-local-review-'+head[:12])\n  if checkout.exists():\n   if subprocess.check_output(['git','-C',str(checkout),'rev-parse','HEAD'],text=True).strip()!=head:raise SystemExit('Existing review checkout has another head.')\n  else:subprocess.run(['git','-C',str(repo),'worktree','add','--detach',str(checkout),head],check=True)\n  result=subprocess.run([sys.executable,str(here/'run.py'),'--repo',str(checkout),'--base',base,'--out',str(out)])\n  if result.returncode not in (0,2):raise SystemExit('Reviewer infrastructure failed; native hold remains.')\n subprocess.run([sys.executable,str(here/'publish.py'),'--repo',str(repo),'--reports',str(out),'--branch',a.branch,'--trail',str(a.trail)],check=True)\n publication=json.loads((out/'publication.json').read_text())\n for role,session in publication['sessionIds'].items():\n  # Explicitly configured for this user's already-authorized public uploads.\n  # The remote-head prerequisite guarantees attach cannot rewrite shared code.\n  if git('ls-remote','entire-eu','refs/heads/'+a.branch).split()[0]!=head:raise SystemExit('Head changed before review attachment.')\n  log=out/(role+'.attach.log')\n  if log.exists() and 'Pushed checkpoint metadata' in log.read_text():continue\n  r=subprocess.run(['entire','session','attach',session,'--agent','codex','--commit',head,'--review','--force'],text=True,capture_output=True,cwd=repo);log.write_text(r.stdout+r.stderr)\n  if r.returncode:raise SystemExit('Review published; transcript attachment failed. Inspect '+str(log))\n print('Local review publication complete. No automatic approval, merge or deployment.')\n\nif __name__=='__main__':main()\n","exit_code":0,"duration":{"secs":0,"nanos":9375}},"started_at_ms":1793232416941,"completed_at_ms":1793232416941}}
