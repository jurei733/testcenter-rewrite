'time': 648.4000000059605, 'frame': 'child'}, {'type': 'pointerdown', 'trusted': True, 'checked': False, 'x': 159.5, 'y': 130.5, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 648.4000000059605, 'phase': 'after', 'frame': 'child'}, {'type': 'click', 'trusted': True, 'checked': True, 'x': 159, 'y': 130, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.3000000119209, 'frame': 'child'}, {'type': 'click', 'trusted': True, 'checked': True, 'x': 159, 'y': 130, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.3000000119209, 'phase': 'after', 'frame': 'child'}, {'type': 'input', 'trusted': True, 'checked': True, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.5, 'frame': 'child'}, {'type': 'input', 'trusted': True, 'checked': True, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.5, 'phase': 'after', 'frame': 'child'}, {'type': 'change', 'trusted': True, 'checked': True, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.6000000238419, 'frame': 'child'}, {'type': 'change', 'trusted': True, 'checked': True, 'defaultPrevented': False, 'path': [{'tag': 'INPUT', 'id': '', 'cy': 'TestController-radio1-Aufg1'}, {'tag': 'LABEL', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': '', 'cy': None}, {'tag': 'FIELDSET', 'id': '', 'cy': None}, {'tag': 'DIV', 'id': 'unit', 'cy': None}, {'tag': 'FORM', 'id': '', 'cy': None}, {'tag': 'BODY', 'id': '', 'cy': None}], 'time': 649.6000000238419, 'phase': 'after', 'frame': 'child'}]\n","exit_code":0,"duration":{"secs":0,"nanos":8583}},"started_at_ms":1793232387562,"completed_at_ms":1793232387562}}
