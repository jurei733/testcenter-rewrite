ponent, OriginalToastContainerComponent, ParticipantStatusStylesComponent, OriginalParticipantConfirmationLauncherComponent, OriginalParticipantInformationLauncherComponent, OriginalParticipantErrorLauncherComponent],\n  template: `\n    <app-participant-status-styles />\n    @defer (on immediate) {\n      <app-participant-debug-launcher [state]=\"view.debugRunState\" [run]=\"view.consoleRun\" />\n    }\n    @defer (when interfaceMode.mode() === 'original') {\n      @if (interfaceMode.mode() === 'original') {\n        <app-original-toast-container />\n      }\n    }\n    <div class=\"stack\" [class.is-original-player]=\"interfaceMode.mode() === 'original' && view.isParticipantPlayerFocused\">\n      @defer (when interfaceMode.mode() === 'original' && view.isParticipantPlayerFocused) {\n        @if (interfaceMode.mode() === 'original' && view.isParticipantPlayerFocused) {\n          <app-original-player-surface-styles />\n        }\n      }\n      @defer (when interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired)) {\n        @if (interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired)) {\n          <app-original-participant-entry />\n        }\n      }\n      <article\n        *ngIf=\"!view.isParticipantPlayerFocused && !(interfaceMode.mode() === 'original' && (view.isParticipantStarter || view.isParticipantLogin && !view.participantCodeRequired))\"\n        id=\"participantRouteEntry\"\n        class=\"card participant-entry-card\"\n      >\n        <header class=\"participant-entry-hero\">\n          <div>\n            <span id=\"participantLoginSidepanelTitle\">{{ view.customText('login_sidepanel_title', 'Welcome to the IQB Testcenter') }}</span>\n            <h2 id=\"participantCustomLoginSubtitle\">{{ view.customText('login_subtitle', 'Start or Resume Test') }}</h2>\n            <p id=\"participantLoginSidepanelSubtitle\">{{ view.customText('login_sidepanel_subtitle', 'Use a direct link or enter the assigned workspace and login key. The test opens the assigned booklet directly.') }}</p>\n          </div>\n          <div class=\"participant-entry-status\">\n            <span>Session Status</span>\n            <strong id=\"participantEntryStatus\">{{ view.player.runStatus }}</strong>\n            <small id=\"participantEntryNextStep\">\n              {{ view.player.nextStepLabel }} · {{ view.player.nextStepDetail }}\n            </small>\n          </div>\n        </header>\n        <img\n          id=\"participantLoginIllustration\"\n          class=\"participant-assigned-asset\"\n          *ngIf=\"applicationSettings.assetUrl('loginIllustration') as assetUrl\"\n          [src]=\"assetUrl\"\n          alt=\"\"\n        />\n        <section\n          id=\"applicationIntroContent\"\n          class=\"configured-application-content\"\n          *ngIf=\"applicationSettings.settings().introHtml.trim()\"\n          [innerHTML]=\"applicationSettings.settings().introHtml\"\n        ></section>\n        <section\n          id=\"browserCompatibilityWarning\"\n          class=\"browser-compatibility-banner\"\n          *ngIf=\"view.isParticipantLogin && browserCompatibility.warning as warning\"\n          role=\"status\"\n          aria-live=\"polite\"\n          [attr.data-browser-family]=\"warning.browser\"\n          [attr.data-browser-version]=\"warning.version\"\n        >\n          <span class=\"browser-compatibility-icon\" aria-hidden=\"true\">!</span>\n          <span id=\"browserCompatibilityWarningMessage\">{{ warning.message }}</span>\n        </section>\n      <button id=\"playerPopup\" type=\"button\">Open player help</button>\n      <button id=\"playerClipboard\" type=\"button\">Use player clipboard</button>\n      <button id=\"playerRuntimeError\" type=\"button\">Report runtime error</button>\n      <script>\n        let sessionId = \"\";\n        let currentPage = \"page-1\";\n        window.__ownedVeronaInputEvents = [];\n        const sendState = (includeLog = true) => {\n          const answer = document.querySelector(\"#playerAnswer\").value;\n          parent.postMessage({\n            type: \"vopStateChangedNotification\",\n            sessionId,\n            unitState: {\n              dataParts: { answer },\n              unitStateDataType: \"verona-smoke@1\"\n            },\n            ...(includeLog ? { log: [{\n              key: \"PLAYER_STATE_CHANGED\",\n              timeStamp: Date.now(),\n              content: answer\n            }] } : {})\n          }, \"*\");\n          parent.postMessage({\n            type: \"vopStateChangedNotification\",\n            sessionId,\n            unitState: {\n              presentationProgress: \"complete\",\n              responseProgress: answer ? \"complete\" : \"none\"\n            }\n          }, \"*\");\n          parent.postMessage({\n            type: \"vopStateChangedNotification\",\n            sessionId,\n            playerState: {\n              currentPage,\n              validPages: [\n                { id: \"page-1\", label: \"Introduction\" },\n                { id: \"page-2\", label: \"Review\" }\n              ]\n            }\n          }, \"*\");\n        };\n        addEventListener(\"message\", event => {\n          if (event.data?.type === \"vopPageNavigationCommand\") {\n            currentPage = String(event.data.target || \"\");\n            document.querySelector(\"#playerCurrentPage\").textContent = currentPage;\n            sendState(false);\n            return;\n          }\n          if (event.data?.type === \"vopPlayerConfigChangedNotification\") {\n            document.querySelector(\"#playerConfig\").textContent = JSON.stringify(event.data.playerConfig);\n            const count = Number(document.querySelector(\"#playerConfigChangeCount\").textContent || \"0\");\n            document.querySelector(\"#playerConfigChangeCount\").textContent = String(count + 1);\n            return;\n          }\n          if (event.data?.type === \"vopNavigationDeniedNotification\") {\n            document.querySelector(\"#playerNavigationDenied\").textContent = JSON.stringify(event.data.reason);\n            return;\n          }\n          if (event.data?.type !== \"vopStartCommand\") return;\n          sessionId = event.data.sessionId;\n          document.querySelector(\"#playerSessionId\").textContent = sessionId;\n          const startCount = Number(document.querySelector(\"#playerStartCount\").textContent || \"0\");\n          document.querySelector(\"#playerStartCount\").textContent = String(startCount + 1);\n          document.querySelector(\"#playerDefinition\").textContent = event.data.unitDefinition;\n          document.querySelector(\"#playerConfig\").textContent = JSON.stringify(event.data.playerConfig);\n          document.querySelector(\"#playerStartPage\").textContent = String(event.data.playerConfig?.startPage || \"\");\n          currentPage = String(event.data.playerState?.currentPage || event.data.playerConfig?.startPage || \"page-1\");\n          document.querySelector(\"#playerCurrentPage\").textContent = currentPage;\n          document.querySelector(\"#playerAnswer\").value = event.data.unitState?.dataParts?.answer || \"\";\n          document.querySelector(\"#playerAnswer\").addEventListener(\"input\", event => {\n            window.__ownedVeronaInputEvents.push({ timeStamp: Date.now(), inputType: event.inputType,\n              isTrusted: event.isTrusted, data: event.data, answer: event.target.value });\n            window.__ownedVeronaInputEvents = window.__ownedVeronaInputEvents.slice(-32);\n            sendState(true);\n          });\n          parent.postMessage({\n            type: \"vopStateChangedNotification\",\n            sessionId,\n            unitState: null\n          }, \"*\");\n          parent.postMessage({\n            type: \"vopStateChangedNotification\",\n            sessionId,\n            playerState: null\n          }, \"*\");\n\nclass UiSmokeEarlyExit extends Error {\n  constructor(step) {\n    super(`UI smoke stopped after requested step: ${step}`);\n    this.name = \"UiSmokeEarlyExit\";\n    this.step = step;\n  }\n}\n\nconst createSmokeFetchInit = url =>\n  url && participantHttpActor.isParticipant(url)\n    ? { headers: participantHttpActor.headers(url) }\n    : smokeAdminSessionToken\n    ? {\n        headers: {\n          authorization: `Bearer ${smokeAdminSessionToken}`\n        }\n      }\n    : undefined;\n\nconst sendSmokeJson = async (url, { method = \"POST\", body } = {}) => {\n  const response = await fetch(url, {\n    method,\n    headers: {\n      \"content-type\": \"application/json\",\n      ...(participantHttpActor.isParticipant(url)\n        ? participantHttpActor.headers(url, body)\n        : smokeAdminSessionToken\n        ? { authorization: `Bearer ${smokeAdminSessionToken}` }\n        : {})\n    },\n    body: body === undefined ? undefined : JSON.stringify(body)\n  });\n\n  if (!response.ok) {\n    throw new Error(\n      `Unexpected status ${response.status} for ${method} ${url}: ${await response.text()}`\n    );\n  }\n\n  return response;\n};\n\nconst sendSmokeJsonAndDrain = async (url, options) => {\n  const response = await sendSmokeJson(url, options);\n  try {\n    await drainSmokeResponse(response);\n  } catch (cause) {\n    throw new Error(`Smoke fixture ${options?.method ?? \"POST\"} ${new URL(url).pathname} body drain failed`, { cause });\n\n  assert.equal(participantOperatorCredentialLeakCount, 0,\n    \"Participant browser requests must not carry the signed-in operator credential.\");\n  serverFailureGate.assertHealthy();\n  successMessage = `UI smoke passed for store=${store} at http://127.0.0.1:${port}/app\\n`;\n} catch (error) {\n  if (!(error instanceof UiSmokeEarlyExit)) {\n    process.stderr.write(`UI smoke failure at ${page?.url() ?? \"unopened page\"}: ${String(error?.stack ?? error)}\\n`);\n    if(originalSampleTrace){\n      try{\n        const directory=resolve(artifactDirectory??await mkdtemp(resolve(tmpdir(),\"original-sample-failure-\")),\"original-sample\");\n        await originalSampleTrace.write(directory);\n        await page.locator(\"#participantVeronaPlayerFrame\").screenshot({path:resolve(directory,\"player.png\"),timeout:2000});\n      }catch(diagnosticError){process.stderr.write(`Original sample diagnostic unavailable: ${String(diagnosticError)}\\n`);}\n      finally{originalSampleTrace.stop();}\n    }\n    if (page && !page.isClosed()) {\n      const inputEvents = await Promise.all(page.frames().map(frame => frame.locator(\"html\").evaluate(() =>\n        window.__ownedVeronaInputEvents ?? null, undefined, { timeout: 1_000 }).catch(() => null)));\n      process.stderr.write(`Owned Verona input events: ${JSON.stringify(inputEvents.filter(Boolean))}\\n`);\n    }\n    if (page && !page.isClosed()) {\n      try {\n        const failureDirectory = failureArtifactDirectory ?? await mkdtemp(resolve(tmpdir(), \"testcenter-ui-failure-\"));\n        await mkdir(failureDirectory, { recursive: true });\n        let navigation;\n        try {\n          navigation = await page.locator(\"html\").evaluate(() => ({\n            path: location.pathname, focused: document.hasFocus(), visibility: document.visibilityState,\n            starterScroll: (() => {\n              const sentinel=document.querySelector(\"#participantStarterBottomSentinel\"),button=document.querySelector(\"#participantStarterScrollButton\");\n              const box=sentinel?.getBoundingClientRect(),buttonBox=button?.getBoundingClientRect();\n              return {viewport:[innerWidth,innerHeight],scroll:[scrollX,scrollY],\n                sentinel:box?{top:box.top,bottom:box.bottom,left:box.left,right:box.right}:null,\n                button:buttonBox?{top:buttonBox.top,bottom:buttonBox.bottom,display:getComputedStyle(button).display}:null,\n                entryStatus:document.querySelector(\"#participantEntryStatus\")?.textContent?.trim()??null};\n            })(),\n            activeElement: { id: document.activeElement?.id, tag: document.activeElement?.tagName },\n            events: window.__ownedNavigationEvents ?? [],\n            links: [...document.querySelectorAll(\"[data-view-nav]\")].map(element => {\n              const box = element.getBoundingClientRect(), style = getComputedStyle(element);\n              return { view: element.getAttribute(\"data-view-nav\"), href: element.getAttribute(\"href\")?.split(\"?\")[0],\n                x: box.x, y: box.y, width: box.width, height: box.height,\n                display: style.display, visibility: style.visibility, pointerEvents: style.pointerEvents };\n            })\n          }), undefined, { timeout: 2_000 });\n        } catch (captureError) { navigation = { unavailable: String(captureError).split(\"\\nCall log:\")[0] }; }\n        await writeFile(resolve(failureDirectory, \"failure.json\"), JSON.stringify({\n          error: String(error?.message ?? error).split(\"\\nCall log:\")[0], navigation\n        }, null, 2) + \"\\n\");\n        await page.screenshot({ path: resolve(failureDirectory, \"failure.png\"), fullPage: true });\n        process.stderr.write(`UI smoke failure screenshot: ${failureDirectory}/failure.png\\n`);\n      } catch (captureError) {\n        // A full disk or a closed browser must not replace the actual test failure.\n        process.stderr.write(`UI smoke failure screenshot unavailable: ${String(captureError)}\\n`);\n      }\n    }\n    const bugReport = await page\n      ?.locator(\"#bugReportText\")\n      .innerText({ timeout: 1_000 })\nimport { originalSystemCheckCustomTextDefaults } from \"@testcenter-rewrite-app/contracts/system-check-custom-texts\";\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { access, mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, resolve } from \"node:path\";\nimport { setTimeout as delay } from \"node:timers/promises\";\nimport { brotliDecompressSync } from \"node:zlib\";\n\nimport { chromium } from \"playwright\";\nimport QRCode from \"qrcode\";\nimport { originalParticipantCustomTextDefaults, parseVeronaUnitResponse } from \"@testcenter-rewrite-app/contracts\";\nimport { mergeCapturedVeronaUnitResponse } from \"@testcenter-rewrite-app/contracts/participant-response-capture\";\nimport { createParticipantHttpTestActor } from \"./participant-http-test-actor.mjs\";\nimport { drainSmokeResponse } from \"./drain-smoke-response.mjs\";\nimport { observeOriginalSample } from \"./original-sample-diagnostics.mjs\";\nimport { waitForOriginalSampleResource } from \"./original-sample-readiness.mjs\";\nimport { matchesVeronaSavedResponse } from \"./verona-save-response-match.mjs\";\nimport { matchesParticipantRunRequest } from \"./participant-run-request-match.mjs\";\nimport { captureResultGroupSnapshot, assertGroupDeletionMatchesSnapshot,\n  assertResultGroupRemoved, assertResultGroupRetained } from \"./group-result-deletion-check.mjs\";\nimport { withChromiumIbRuntime } from \"./chromium-ib-runtime.mjs\";\nimport { runParticipantUnitLabelSmoke } from \"./participant-unit-label-smoke.mjs\";\nimport { runCurrentOriginalBookletConfigSmoke } from \"./current-original-booklet-config-smoke.mjs\";\nimport { setWorkspaceAutoRefreshEnabled } from \"./workspace-auto-refresh-smoke.mjs\";\nimport { createAttachmentQrCameraVideo } from \"./attachment-camera-fixture.mjs\";\nimport { createServerRequestFailureGate } from \"./server-request-failure-gate.mjs\";\n\nconst participantHttpActor = createParticipantHttpTestActor();\nconst fetch = participantHttpActor.fetch;\n\nconst store = process.env.FIRST_SLICE_STORE ?? \"sqlite\";\nconst browserChannel = process.env.UI_SMOKE_BROWSER_CHANNEL?.trim() || undefined;\nconst headful = [\"1\", \"true\", \"yes\", \"on\"].includes(\n  String(process.env.UI_SMOKE_HEADFUL ?? \"\").toLowerCase()\n);\nconst artifactDirectory = process.env.UI_SMOKE_ARTIFACT_DIR?.trim();\nconst failureArtifactDirectory = process.env.UI_SMOKE_FAILURE_ARTIFACT_DIR?.trim() || artifactDirectory;\nconst frontendRoot = process.env.UI_SMOKE_FRONTEND_ROOT?.trim();\nconst attachmentQrCameraFile = process.env.UI_SMOKE_ATTACHMENT_QR_CAMERA_FILE?.trim();\nconst verifyAttachmentVisibility = process.env.UI_SMOKE_VERIFY_ATTACHMENT_VISIBILITY === \"true\";\nif (verifyAttachmentVisibility && !headful) throw new Error(\"Native camera visibility verification requires a headful browser.\");\nif (verifyAttachmentVisibility && attachmentQrCameraFile) throw new Error(\"Native visibility verification requires the image-mode camera fixture before QR auto-capture.\");\nconst operatorAuthRequired =\n  process.env.FIRST_SLICE_OPERATOR_AUTH_REQUIRED === \"true\";\nconst stopAfterStep = process.env.UI_SMOKE_STOP_AFTER_STEP ?? \"\";\n","exit_code":0,"duration":{"secs":0,"nanos":12209}},"started_at_ms":1793229740432,"completed_at_ms":1793229740432}}
