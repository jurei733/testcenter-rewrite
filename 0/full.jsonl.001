k() combines an off-screen scroll\n    // and immediate radio click. Keep the checked-state assertion unchanged.\n    await page.locator(\"#participantVeronaPlayerFrame\").scrollIntoViewIfNeeded();\n    await page.locator(\"#participantVeronaPlayerFrame\").screenshot();\n    await frame\n      .locator('[data-cy=\"TestController-radio1-Aufg1\"]')\n      .check();\n  };\n  const completeOriginalControllerUnit = async frame => {\n    await checkOriginalControllerRadio(frame);\n    await frame.locator(\"#next-page\").click();\n    await frame\n      .getByText(\"Presentation complete\", { exact: true })\n      .waitFor({ timeout: 15_000 });\n  };\n  const waitForOriginalControllerCompletenessDenial = async (\n    0\n  );\n  // Original markedNo remains clickable so the controller can explain\n  // incomplete presentation/response without moving to another task.\n  await expectButtonSelectorEnabled(\"#originalUnitNavigation-forward\");\n  await page.locator(\"#originalUnitNavigation-forward\").click();\n  await page.locator(\"#participantRouteNavigationNotice\").waitFor();\n  await page\n    .locator(\"#participantRouteUnitKey\")\n    .filter({ hasText: \"CY-Unit.Sample-101\" })\n    .waitFor({ state: \"attached\" });\n  await checkOriginalControllerRadio(completionControllerFrame);\n  assert.equal(\n    await page.locator(\"#participantRouteNextUnitButton\").isDisabled(),\n    false\n  );\n  await completionControllerFrame.locator(\"#next-page\").dispatchEvent(\"click\");\nfiles ['failure.png', 'failure.json', 'original-sample/trace.json']\nfailure {\n  \"error\": \"locator.check: Clicking the checkbox did not change its state\",\n  \"navigation\": {\n    \"path\": \"/app/participant\",\n    \"focused\": true,\n    \"visibility\": \"visible\",\n    \"starterScroll\": {\n      \"viewport\": [\n        1280,\n        720\n      ],\n      \"scroll\": [\n        0,\n        0\n      ],\n      \"sentinel\": null,\n      \"button\": null,\n      \"entryStatus\": null\n    },