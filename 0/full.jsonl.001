inateIds) : EMPTY),\n+    // Rendered rows may still await XML, or retain an older poll. Finish uses\n+    // one fresh complete native snapshot, then keeps those exact targets even\n+    // when the successful lock changes later snapshots to status=locked.\n+    return defer(() => current() ? this.bs.getSessionsMonitor(group).pipe(\n+      take(1),\n+      switchMap(rows => {\n+        if (!current()) return EMPTY;\n+        const unlocked = rows.filter(row => BigInt(row.testId) > 0n &&\n+          !TestSessionUtil.hasState(row.testState, 'status', 'locked'));\n+        const lockIds = unlocked.map(row => row.testId);\n+        const terminateIds = unlocked.filter(row =>\n+          !TestSessionUtil.hasState(row.testState, 'status', 'pending') &&\n+          !TestSessionUtil.hasState(row.testState, 'CONTROLLER', 'TERMINATED') &&\n+          (TestSessionUtil.hasState(row.testState, 'CONNECTION', 'POLLING') ||\n+            TestSessionUtil.hasState(row.testState, 'CONNECTION', 'WEBSOCKET')))\n+          .map(row => row.testId);\n+        return this.bs.lock(group, lockIds).pipe(\n+          delay(1500),\n+          mergeMap(() => current() ? this.bs.command('terminate', ['lock'], terminateIds) : EMPTY)\n+        );\n+      }),\n       takeUntil(this.disconnected$),\n       takeUntil(fromEvent(scope, 'abort'))\n     ) : EMPTY);\nimport {raceWithSmokeDeadline} from './smoke-deadline.mjs';\n\n// The deadline includes receiving the entire response body, not only headers.\nexport async function readNativeSmokeResponse(url, init = {}, {timeoutMs = 20_000, fetchImpl = fetch} = {}) {\n  const controller = new AbortController();\n  const failure = Error('Owned native request timed out.');\n  const signal = init.signal ? AbortSignal.any([init.signal, controller.signal]) : controller.signal;\n  const response = (async () => {\n    const result = await fetchImpl(url, {...init, signal});\n    const text = await result.text();\n    return {ok: result.ok, status: result.status, text};\n  })();\n  return raceWithSmokeDeadline(response, timeoutMs, () => {\n    controller.abort(failure);\n    throw failure;\n  });\n}\n\nexport async function stopNativeSmokeServer(child, {timeoutMs = 10_000, killGraceMs = 2_000} = {}) {\n  if (child.exitCode !== null || child.signalCode !== null) return;\n  let onClose, onError;\n  const closed = new Promise((done, reject) => {\n    onClose = done; onError = reject;\n    child.once('close', onClose); child.once('error', onError);\n  });\n  let timedOut = false;\n  const failure = Error('Owned native server shutdown timed out.');\n  try {\n    child.kill('SIGTERM');\n    await raceWithSmokeDeadline(closed, timeoutMs, async () => {\n      timedOut = true;\n      child.kill('SIGKILL');\n      await raceWithSmokeDeadline(closed, killGraceMs, () => {throw failure;});\n    });\n    if (timedOut) throw failure;\n  } finally {\n    child.removeListener('close', onClose); child.removeListener('error', onError);\n  }\n}\n\n","exit_code":0,"duration":{"secs":0,"nanos":7750}},"started_at_ms":1793229173236,"completed_at_ms":1793229173236}}
