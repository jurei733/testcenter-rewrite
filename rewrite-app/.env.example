PORT=4310
SHUTDOWN_DRAIN_DELAY_MS=1000
FIRST_SLICE_MAX_JSON_BODY_BYTES=1048576
FIRST_SLICE_MAX_SOURCE_PACKAGE_JSON_BODY_BYTES=75497472
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_REQUEST_TIMEOUT_MS=120000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
APP_BUILD_SHA=local-dev
APP_BUILD_TIMESTAMP=2026-05-11T00:00:00Z
FIRST_SLICE_OPERATOR_AUTH_REQUIRED=true
FIRST_SLICE_BOOTSTRAP_DEMO=false
FIRST_SLICE_PARTICIPANT_TIME_ZONE=Europe/Berlin
FIRST_SLICE_ADMIN_LOGIN_MAX_FAILURES=5
FIRST_SLICE_ADMIN_LOGIN_FAILURE_WINDOW_MS=1800000
FIRST_SLICE_ADMIN_PASSWORD_MIN_LENGTH=8
FIRST_SLICE_ADMIN_PASSWORD_PATTERN=^.*$
FIRST_SLICE_PARTICIPANT_LOGIN_MAX_FAILURES=5
FIRST_SLICE_PARTICIPANT_LOGIN_FAILURE_WINDOW_MS=1800000
RUNTIME_PREFLIGHT_REQUIRE_BUILD_METADATA=false
RUNTIME_PREFLIGHT_SKIP_STORAGE_DOCTOR=false

# Optional direct error-report delivery. Configure both values to enable it.
# The token is server-only and needs permission to create issues in the repository.
BUG_REPORT_GITHUB_REPOSITORY=owner/repository
BUG_REPORT_GITHUB_TOKEN=

# Supported values: memory | file | sqlite | postgres
FIRST_SLICE_STORE=sqlite

# Used when FIRST_SLICE_STORE=file
FIRST_SLICE_FILE=./.data/first-slice.json

# Used when FIRST_SLICE_STORE=sqlite
FIRST_SLICE_SQLITE_FILE=./.data/first-slice.sqlite

# Used when FIRST_SLICE_STORE=postgres
FIRST_SLICE_POSTGRES_URL=postgresql://rewrite:rewrite@127.0.0.1:5433/rewrite_app

# Docker Compose host ports
REWRITE_APP_PORT=4310
POSTGRES_PORT=5433
POSTGRES_DB=rewrite_app
POSTGRES_USER=rewrite
POSTGRES_PASSWORD=rewrite
