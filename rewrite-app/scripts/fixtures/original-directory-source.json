        "<form [formGroup]=\"newworkspaceform\">\n  <h1 mat-dialog-title>Neuer Arbeitsbereich</h1>\n\n  <mat-dialog-content>\n    <p>\n      <mat-form-field>\n        <input matInput formControlName=\"name\" placeholder=\"Name\">\n      </mat-form-field>\n    </p>\n    <div>\n      <p>Nach dem Anlegen des Arbeitsbereiches können Sie die Zugriffsrechte zuweisen.\n      </p>\n    </div>\n  </mat-dialog-content>\n\n  <mat-dialog-actions>\n    <button mat-raised-button type=\"submit\" [mat-dialog-close]=\"newworkspaceform\" [disabled]=\"newworkspaceform.invalid\">Speichern</button>\n    <button mat-raised-button [mat-dialog-close]=\"false\">Abbrechen</button>\n  </mat-dialog-actions>\n\n</form>\n"
