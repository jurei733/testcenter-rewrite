    {
      "path": "frontend/src/app/superadmin/confirm-with-password/confirm-with-password.component.ts",
      "sha256": "34e926ff6eb8e7f30860aacaf6dcdbd85f2785ce0974bed25770b8c97029780d",
      "excerpts": [
        "import { MAT_DIALOG_DATA } from '@angular/material/dialog';\nimport { Component, EventEmitter, Inject } from '@angular/core';\nimport { FormGroup, Validators, FormControl } from '@angular/forms';\n\n@Component({\n    templateUrl: './confirm-with-password.component.html',\n    standalone: false\n})\n\nexport class ConfirmWithPasswordComponent {\n  passwordform = new FormGroup({\n    pw: new FormControl('', [Validators.required, Validators.minLength(7)])\n  });\n\n  errorMessage = '';\n\n  readonly passwordSubmit = new EventEmitter<string>();\n\n  // `content` and `confirmText` are optional: callers that only need a title (plus the fixed\n  // \"please re-enter your password\" wording and default \"Bestätigen\") can omit both.\n  constructor(\n    @Inject(MAT_DIALOG_DATA) public data: { title: string; content?: string; confirmText?: string }\n  ) {}\n\n  submit(): void {\n    if (this.passwordform.invalid) {\n      return;\n    }\n    this.errorMessage = '';\n    this.passwordSubmit.emit(this.passwordform.get('pw')?.value ?? '');\n  }\n\n  clearError(): void {\n    this.errorMessage = '';\n  }\n}\n"
      ]
    },
    {
      "path": "frontend/src/app/superadmin/confirm-with-password/confirm-with-password.component.html",
      "sha256": "86934bc9775f7c7cab4ee92e01a1e9dcea22ac1ad76fa6726199ad688587c3a0",
      "excerpts": [
        "<form data-cy=\"dialog-change-superadmin\" [formGroup]=\"passwordform\" (ngSubmit)=\"submit()\" autocomplete=\"off\">\n  <h1 mat-dialog-title>{{data.title}}</h1>\n\n  <mat-dialog-content>\n    @if (data.content) {\n      <p>{{data.content}}</p>\n    }\n    <div>\n      <p>Bitte geben Sie zur Sicherheit Ihr eigenes Kennwort noch einmal ein.</p>\n    </div>\n    <p>\n      <mat-form-field>\n        <input data-cy=\"dialog-change-superadmin-pw\" matInput type=\"password\" formControlName=\"pw\" placeholder=\"Kennwort\" autocomplete=\"new-password\"\n               (input)=\"clearError()\">\n      </mat-form-field>\n    </p>\n    @if (errorMessage) {\n      <tc-alert data-cy=\"dialog-change-superadmin-error\" level=\"error\" [text]=\"errorMessage\"></tc-alert>\n    }\n  </mat-dialog-content>\n\n  <mat-dialog-actions>\n    <button mat-raised-button data-cy=\"pw-submit\" type=\"submit\" [disabled]=\"passwordform.invalid\">{{data.confirmText || 'Bestätigen'}}</button>\n    <button mat-raised-button [mat-dialog-close]=\"false\">Abbrechen</button>\n  </mat-dialog-actions>\n</form>\n"
      ]
    }
  ]
}
