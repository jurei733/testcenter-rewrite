{
  "name": "@testcenter-rewrite-app/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/packages/contracts/src/index.js",
  "types": "dist/packages/contracts/src/index.d.ts",
  "exports": {
    "./participant-run-command": {
      "types": "./dist/packages/contracts/src/participant-run-command.d.ts",
      "default": "./dist/packages/contracts/src/participant-run-command.js"
    },
    "./participant-starter-exit": {
      "types": "./dist/packages/contracts/src/participant-starter-exit.d.ts",
      "default": "./dist/packages/contracts/src/participant-starter-exit.js"
    },
    "./booklet-completeness": {
      "types": "./dist/packages/contracts/src/booklet-completeness.d.ts",
      "default": "./dist/packages/contracts/src/booklet-completeness.js"
    },
    ".": {
      "types": "./dist/packages/contracts/src/index.d.ts",
      "default": "./dist/packages/contracts/src/index.js"
    },
    "./participant-roster": {
      "types": "./dist/packages/contracts/src/participant-roster.d.ts",
      "default": "./dist/packages/contracts/src/participant-roster.js"
    },
    "./participant-response-capture": {
      "types": "./dist/packages/contracts/src/participant-response-capture.d.ts",
      "default": "./dist/packages/contracts/src/participant-response-capture.js"
    },
    "./participant-response-order": {
      "types": "./dist/packages/contracts/src/participant-response-order.d.ts",
      "default": "./dist/packages/contracts/src/participant-response-order.js"
    },
    "./participant-response-field-timestamps": {
      "types": "./dist/packages/contracts/src/participant-response-field-timestamps.d.ts",
      "default": "./dist/packages/contracts/src/participant-response-field-timestamps.js"
    }
  },
  "dependencies": {
    "@testcenter-rewrite-app/domain": "0.0.0"
  },
  "devDependencies": {
    "@iqb/responses": "5.2.2",
    "@iqbspecs/coding-scheme": "3.4.1",
    "@iqbspecs/response": "2.0.0"
  }
}
