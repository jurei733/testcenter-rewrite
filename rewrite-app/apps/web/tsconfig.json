{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/web",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [],
    "lib": ["ES2022", "dom"],
    "useDefineForClassFields": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
