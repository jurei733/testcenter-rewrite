  "files": [
    {
      "path": "frontend/src/app/attachment-manager/components/attachment-overview/attachment-overview.component.html",
      "sha256": "919d1a85593a101f862bb65821e3040bda24fcb571dab609163df463f8e2ce40",
      "source": "<mat-sidenav-container class=\"{{mobileView ? 'mobile' : 'desktop'}}\">\n  <mat-sidenav #sidenav opened=\"true\" [mode]=\"mobileView ? 'over' : 'side'\" fixedInViewport=\"true\" fixedTopGap=\"55\" class=\"toolbar\">\n    <div class=\"corner-menu\">\n      <button\n        *ngIf=\"sidenav.opened\"\n        mat-icon-button\n        [matTooltip]=\"('Seiteleiste' | customtext:'am_sidebar_button' | async) || ''\"\n        matTooltipPosition=\"above\"\n        (click)=\"sidebarClick()\"\n      >\n        <mat-icon svgIcon=\"close\"></mat-icon>\n      </button>\n    </div>\n\n    <h2>Verwaltung der Aufgabenanhänge</h2>\n    <ng-container *ngIf=\"attachments.data[selectedAttachmentIndex] as selectedAttachment; then attachmentSelected; else commonControls\">\n    </ng-container>\n\n    <ng-template #attachmentSelected let-selectedAttachment>\n      <h3>{{selectedAttachment | AttachmentTitle }}</h3>\n      <div class=\"toolbar-section\" *ngIf=\"selectedAttachment.dataType === 'missing'\">\n        <tc-alert level=\"warning\" text=\"Dieser Anhang muss noch hinzugefügt werden.\"></tc-alert>\n      </div>\n\n      <div class=\"toolbar-section\">\n        <table>\n          <tr>\n            <td>Typ:</td>\n            <td>\n              <ng-container *ngIf=\"selectedAttachment.attachmentType === 'capture-image'\">\n                {{'Foto einer Seite' | customtext:'am_attachment_type_capture-image' | async}}\n              </ng-container>\n            </td>\n          </tr>\n          <tr>\n            <td>Variable:</td>\n            <td>{{selectedAttachment.variableId}}</td>\n          </tr>\n          <tr>\n            <td>Testperson:</td>\n            <td>{{selectedAttachment.personLabel}}</td>\n          </tr>\n          <tr>\n            <td>Test:</td>\n            <td>{{selectedAttachment.testLabel}}</td>\n          </tr>\n          <tr>\n            <td>Aufgabe:</td>\n            <td>{{selectedAttachment.unitLabel}}</td>\n          </tr>\n        </table>\n      </div>\n\n      <ng-container *ngIf=\"selectedAttachment.attachmentFileIds.length\">\n        <div class=\"toolbar-section\" style=\"text-align: center\">\n          <button mat-mini-fab aria-label=\"Previous instance from this image-attachment\" (click)=\"previousAttachmentId()\">\n            <mat-icon svgIcon=\"chevron_left\"></mat-icon>\n          </button>\n          {{selectedAttachmentFileIndex + 1 }} / {{selectedAttachment.attachmentFileIds.length}}\n          <button mat-mini-fab aria-label=\"Next instance from this image-attachment\" (click)=\"nextAttachmentId()\">\n            <mat-icon svgIcon=\"chevron_right\"></mat-icon>\n          </button>\n        </div>\n\n        <div class=\"toolbar-section\" *ngIf=\"selectedAttachment.dataType === 'image'\">\n          <div id=\"previewImage\" [style.background-image]=\"'url(' + selectedAttachmentImage + ')'\"></div>\n        </div>\n      </ng-container>\n\n      <div class=\"toolbar-section\">\n        <button\n          mat-raised-button\n          class=\"control\"\n          *ngIf=\"selectedAttachment.attachmentType === 'capture-image'\"\n          (click)=\"$event.stopPropagation(); downloadPageTemplate()\"\n          matTooltip=\"Seitenvorlage neu ausdrucken\"\n        >\n          <mat-icon svgIcon=\"description\"></mat-icon>\n          Seitenvorlage\n        </button>\n        <button\n          mat-raised-button\n          class=\"control\"\n          *ngIf=\"selectedAttachment.dataType !== 'missing'\"\n          (click)=\"deleteAttachment()\"\n          matTooltip=\"{{'Anhang Löschen' | customtext:'am_button_delete_attachment' | async}}\"\n        >\n          <mat-icon svgIcon=\"delete\"></mat-icon>\n          {{'Anhang Löschen' | customtext:'am_button_delete_attachment' | async}}\n        </button>\n      </div>\n\n      <div [class.toolbar-section-bottom]=\"!selectedAttachment.attachmentFileIds.length\">\n        <ng-container *ngTemplateOutlet=\"commonControls\"></ng-container>\n      </div>\n    </ng-template>\n\n    <ng-template #commonControls>\n      <div class=\"toolbar-section\">\n        <tc-add-attachment></tc-add-attachment>\n      </div>\n      <div class=\"toolbar-section\" *ngIf=\"attachmentTypes.includes('capture-image')\">\n        <h3>{{'Werkzeuge' | customtext:'am_tools_headline' | async}}</h3>\n        <button mat-raised-button (click)=\"downloadAllPageTemplates()\">\n          <mat-icon svgIcon=\"library_books\"></mat-icon>\n          Alle Seitenvorlagen herunterladen\n        </button>\n      </div>\n    </ng-template>\n  </mat-sidenav>\n\n  <mat-sidenav-content>\n    <div class=\"adminbackground\">\n      <div class=\"corner-menu\">\n        <button\n            *ngIf=\"!sidenav.opened && (this.selectedAttachmentIndex === -1)\"\n            mat-icon-button\n            [matTooltip]=\"('Anhang hinzufügen' | customtext:'am_add_button' | async) || ''\"\n            matTooltipPosition=\"above\"\n            (click)=\"addClick()\"\n        >\n          <mat-icon svgIcon=\"add-circle\"></mat-icon>\n        </button>\n      </div>\n\n      <table mat-table matSort [dataSource]=\"attachments\" class=\"attachment-table\">\n\n        <ng-container matColumnDef=\"personLabel\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"personLabel\">Person</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            {{element.personLabel}}\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"testLabel\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"testLabel\">Test</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            {{element.testLabel}}\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"unitLabel\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"unitLabel\">Aufgabe</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            {{element.unitLabel}}\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"attachmentType\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"attachmentType\">Typ</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            <ng-container *ngIf=\"element.attachmentType === 'capture-image'\">\n              {{'Foto einer Seite' | customtext:'am_attachment_type_capture-image' | async}}\n            </ng-container>\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"variableId\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"variableId\">Variable</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            {{element.variableId}}\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"lastModified\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"lastModified\">Letzte Änderung</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            {{element.lastModified | date: 'dd.MM.yy HH:mm'}}\n          </td>\n        </ng-container>\n\n        <ng-container matColumnDef=\"status\">\n          <th mat-header-cell *matHeaderCellDef mat-sort-header=\"status\">Dateien</th>\n          <td mat-cell *matCellDef=\"let element; let i = index\" (click)=\"selectAttachment(i)\">\n            <tc-alert *ngIf=\"!element.attachmentFileIds.length\" level=\"warning\" text=\"0\"></tc-alert>\n            <tc-alert *ngIf=\"element.attachmentFileIds.length\" level=\"success\" text=\"{{element.attachmentFileIds.length}}\" ></tc-alert>\n          </td>\n        </ng-container>\n\n        <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\n        <tr mat-row\n            *matRowDef=\"let row; columns: displayedColumns; let i = index\"\n            [class]=\"{ selected: (i === selectedAttachmentIndex) }\"\n        ></tr>\n      </table>\n    </div>\n  </mat-sidenav-content>\n</mat-sidenav-container>"
    },
    {
      "path": "frontend/src/app/attachment-manager/components/capture-image/capture-image.component.html",
      "sha256": "4d8b55d34c56d59f7c3a5ecb2d8922dc721961de12fddd7d04f67a8e3f19fec7",
      "source": "<mat-sidenav-container class=\"{{mobileView ? 'mobile' : 'desktop'}}\">\n  <mat-sidenav #sidenav opened=\"true\" [mode]=\"mobileView ? 'over' : 'side'\" fixedInViewport=\"true\" fixedTopGap=\"55\" class=\"toolbar\">\n\n    <div class=\"corner-menu\" *ngIf=\"sidenav.opened\">\n      <button\n          mat-icon-button\n          [matTooltip]=\"('Seiteleiste' | customtext:'am_sidebar_button' | async) || ''\"\n          matTooltipPosition=\"above\"\n          (click)=\"sidenav.toggle()\"\n      >\n        <mat-icon svgIcon=\"close\"></mat-icon>\n      </button>\n    </div>\n\n    <h2>\n      {{'Seite aufnehmen' | customtext:'am_capture_image' | async}}\n    </h2>\n    <div class=\"toolbar-section hidden\" [class.show]=\"state === 'capture'\">\n      <div>\n        <mat-form-field appearance=\"fill\">\n          <mat-label>{{'Verfügbare Cameras' | customtext:'am_available_cameras' | async}}</mat-label>\n          <mat-select (selectionChange)=\"selectCamera($event.value)\" [(ngModel)]=\"selectedCameraId\" name=\"camera\">\n            <mat-option *ngFor=\"let camera of cameras | keyvalue\" [value]=\"camera.key\">\n              {{camera.value}}\n            </mat-option>\n          </mat-select>\n        </mat-form-field>\n        <br>\n        <mat-checkbox class=\"example-margin\" (change)=\"toggleFlash($event.checked)\" [disabled]=\"!hasFlash\">\n          {{'Blitz' | customtext:'gm_flash_checkbox' | async}}\n        </mat-checkbox>\n      </div>\n    </div>\n\n    <div class=\"toolbar-section\" *ngIf=\"this.attachmentLabel\">\n      <p>Seite gehört zu: <b>{{attachmentLabel}}</b></p>\n      <button mat-raised-button data-cy=\"dialog-confirm\" (click)=\"uploadImage()\">\n        Upload\n      </button>\n    </div>\n\n    <div class=\"toolbar-section hidden\" [class.show]=\"state === 'confirm' || state === 'error'\">\n      <button mat-raised-button data-cy=\"new-capture\" (click)=\"reset()\">Neue Aufnahme</button>\n    </div>\n\n    <div class=\"toolbar-section-bottom\">\n      <div class=\"toolbar-section\">\n        <a mat-raised-button [routerLink]=\"'..'\">\n          {{'Zurück zur Übersicht' | customtext:'am_goto_attachment_overview' | async}}\n        </a>\n      </div>\n    </div>\n\n  </mat-sidenav>\n\n  <mat-sidenav-content>\n    <div class=\"corner-menu\" *ngIf=\"!sidenav.opened\">\n      <button\n        mat-icon-button\n        [matTooltip]=\"('Einstellungen' | customtext:'gm_settings_tooltip' | async) || ''\"\n        matTooltipPosition=\"above\"\n        (click)=\"sidenav.toggle()\"\n      >\n        <mat-icon svgIcon=\"menu\"></mat-icon>\n      </button>\n    </div>\n\n    <div class=\"adminbackground hidden\" [class.show]=\"state === 'capture'\">\n      <div id=\"toolbar\">\n        <tc-alert\n          level=\"info\"\n          customtext=\"am_capture_image_instructions\"\n          text=\"Halten Sie die Seite so in die Kamera, dass der aufgedruckte QR-Code in der oberen linken Ecke liegt\"\n        ></tc-alert>\n      </div>\n\n      <div id=\"video-container\">\n        <div\n          id=\"video-clip\"\n          [style.aspect-ratio]=\"pageDesign.width + ' / ' + pageDesign.height\"\n          [style.width]=\"pageDesign.width > pageDesign.height ? '100%' : 'auto'\"\n          [style.height]=\"pageDesign.width <= pageDesign.height ? '100%' : 'auto'\"\n        >\n          <video #video id=\"video\" autoplay></video>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"adminbackground hidden\" [class.show]=\"state === 'confirm'\">\n      <div id=\"canvas-container\">\n        <canvas #canvas id=\"canvas\" [style.aspect-ratio]=\"pageDesign.width + ' / ' + pageDesign.height\"></canvas>\n      </div>\n    </div>\n\n    <div class=\"adminbackground hidden\" [class.show]=\"state === 'wait'\">\n      Bitte warten...\n    </div>\n\n    <div class=\"adminbackground hidden\" [class.show]=\"state === 'error'\">\n      <tc-alert level=\"error\" [text]=\"error\"></tc-alert>\n    </div>\n  </mat-sidenav-content>\n</mat-sidenav-container>\n\n\n\n\n\n\n\n\n\n"
    },
    {
      "path": "frontend/src/app/attachment-manager/components/add-attachment/add-attachment.component.html",
      "sha256": "6b542e2bdf0f95d936904b59e150781416cfbaf08bdaf23fc7fd33733842ef5a",
      "source": "<div>\n  <h3>{{'Anhang hinzufügen' | customtext:'am_add_headline' | async}}</h3>\n  <a mat-raised-button [routerLink]=\"'../capture-image'\">\n    <mat-icon svgIcon=\"photo_camera\"></mat-icon>\n    {{'Seite aufnehmen' | customtext:'am_capture_image' | async}}\n  </a>\n</div>"
    },
    {
      "path": "backend/src/helper/AttachmentTemplate.class.php",
      "sha256": "df91b9d6ac59440d366dca837681394b504a6ca911e57fb71b2deb293c01d4b2",
      "source": "<?php\n/** @noinspection PhpUnhandledExceptionInspection */\ndeclare(strict_types=1);\n// TODO unit-test\n\nclass AttachmentTemplate {\n  private const DEFAULT_LABEL_TEMPLATE = \"%TESTTAKER% | %BOOKLET% | %UNIT% | %VAR%\";\n\n  public static function render(?string $labelTemplate, Attachment ...$attachments): string {\n    $title = (count($attachments) > 1)\n      ? implode(', ',\n        array_unique(\n          array_map(\n            function(Attachment $attachment): string {\n              return $attachment->_groupLabel;\n            },\n            $attachments\n          )\n        )\n      )\n      : self::applyTemplate($attachments[0], $labelTemplate);\n\n    $pdf = new TCPDF('P', 'mm', 'A4', true, 'UTF-8', false);\n    $pdf->SetCreator('IQB-Testcenter');\n    $pdf->SetTitle($title);\n    $pdf->setPrintHeader(false);\n    $pdf->setPrintFooter(false);\n\n    foreach ($attachments as $attachment) {\n      $label = self::applyTemplate($attachment, $labelTemplate);\n\n      $pdf->AddPage();\n      $pdf->Bookmark($label, 0, 0, '', 'B', array(0, 64, 128));\n\n      $pdf->MultiCell(0, 15, $label, 0, 'C');\n\n      $style = array(\n        'border' => 0,\n        'vpadding' => 0,\n        'hpadding' => 0,\n        'fgcolor' => array(0, 0, 0),\n        'bgcolor' => false, //array(255,255,255)\n        'module_width' => 1, // width of a single module in points\n        'module_height' => 1 // height of a single module in points\n      );\n      $pdf->write2DBarcode($attachment->attachmentId, 'QRCODE,L', 20, 20, 40, 40, $style, 'N');\n    }\n\n    return $pdf->Output('/* ignored */', 'S');\n  }\n\n  private static function applyTemplate(Attachment $attachment, ?string $labelTemplate = null): string {\n    return str_replace(\n      [\n        '%GROUP%',\n        '%TESTTAKER%',\n        '%BOOKLET%',\n        '%UNIT%',\n        '%VAR%',\n        '%LOGIN%',\n        '%CODE%'\n      ],\n      [\n        $attachment->_groupName,\n        $attachment->personLabel,\n        $attachment->_bookletName,\n        $attachment->_unitName,\n        $attachment->variableId,\n        $attachment->_loginName,\n        $attachment->_loginNameSuffix\n      ],\n      $labelTemplate ?? self::DEFAULT_LABEL_TEMPLATE\n    );\n  }\n}"
    }
  ]
}
